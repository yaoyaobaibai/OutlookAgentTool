{
  "flow_id": "acubuy_create_pr",
  "flow_name": "Acubuy - 创建采购申请",
  "system_id": "acubuy",
  "description": "在 Acubuy 系统中创建采购申请 (PR)",
  "version": "1.0",
  
  "browser": {
    "type": "chrome",
    "headless": false,
    "slow_mo": 500
  },
  
  "steps": [
    {
      "step_id": "login",
      "name": "登录 Acubuy",
      "type": "system_login",
      "wait_after": 3000
    },
    {
      "step_id": "navigate_to_pr",
      "name": "导航到 PR 创建页",
      "type": "navigate",
      "url": "/pr/create",
      "wait_after": 3000
    },
    {
      "step_id": "fill_pr_info",
      "name": "填写 PR 信息",
      "type": "form",
      "fields": [
        {
          "name": "pr_number",
          "selector": "{{selectors.pr_number}}",
          "value": "{{pr_number}}",
          "type": "fill"
        },
        {
          "name": "description",
          "selector": "{{selectors.description}}",
          "value": "{{description}}",
          "type": "fill"
        },
        {
          "name": "amount",
          "selector": "{{selectors.amount}}",
          "value": "{{amount}}",
          "type": "fill"
        },
        {
          "name": "currency",
          "selector": "{{selectors.currency}}",
          "value": "{{currency}}",
          "type": "select"
        },
        {
          "name": "request_date",
          "selector": "{{selectors.request_date}}",
          "value": "{{request_date}}",
          "type": "datepicker",
          "datepicker_config": "{{selectors.date_picker}}"
        },
        {
          "name": "department",
          "selector": "{{selectors.department}}",
          "value": "{{department}}",
          "type": "select"
        }
      ],
      "wait_after": 1000
    },
    {
      "step_id": "upload_quote",
      "name": "上传报价单",
      "type": "attachments",
      "attachments": [
        {
          "category": "{{attach_category}}",
          "file_path": "{{attach_file_path}}",
          "description": "{{attach_description}}"
        }
      ]
    },
    {
      "step_id": "submit",
      "name": "提交申请",
      "type": "action",
      "actions": [
        {
          "selector": "#btnSubmit",
          "type": "click"
        }
      ],
      "wait_after": 5000
    }
  ],
  
  "variables": {
    "pr_number": "",
    "description": "",
    "amount": "",
    "currency": "USD",
    "request_date": "",
    "department": "General",
    "attach_category": "Quote",
    "attach_file_path": "",
    "attach_description": "Vendor quotation"
  }
}
