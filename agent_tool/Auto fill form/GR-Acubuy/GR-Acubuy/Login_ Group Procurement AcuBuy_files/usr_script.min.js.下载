var ivUsr = {};

$.extend(ivUsr, {
	_container: null,

	changeID: function (newID, mergeAuths) {
		document.mainForm.x_action.value = 'changeID';
		document.mainForm.x_loginName.value = newID;
		if (mergeAuths === true)
			document.mainForm.x_auth_merge.value = 1;
		submit();
	},

	/**
	 * Start checking for authentication mode changes to
	 * hide / unhide the corresponding password field.
	 *
	 * @param {string} authenticationModeId DOM identifier of the input field for the authentication mode.
	 * @param {string} passwordId DOM identifier of the password input field.
	 * @param {string} mfaId DOM identifier of the MFA activation input field.
	 */
	startUpdatingAuthenticationModeChange: function (authenticationModeId, passwordId, mfaId) {
		var $passwordInput = $('#' + passwordId),
			$passwordControl = $passwordInput.closest('[data-iv-control]'),
			$mfaInput = $('#' + mfaId),
			$mfaControl = $mfaInput.closest('[data-iv-control]'),
			$authenticationInput = $('#' + authenticationModeId),
			hasAuthenticationModeVisible = $authenticationInput.parents('[data-iv-control=' + authenticationModeId + ']').length > 0;

		$passwordInput.css('transition', 'none');
		$mfaInput.css('transition', 'none');

		ivUsr.updatePasswordVisibility($passwordControl, $mfaControl, !hasAuthenticationModeVisible || $authenticationInput.val().toLowerCase() === 'true');

		$authenticationInput
			.off('change.ivalua')
			.on('change.ivalua', function (evt) {
				$passwordControl
					.css('visibility', evt.target.value.toLowerCase() === 'true' ? 'visible' : 'hidden');
				$mfaControl
					.css('visibility', evt.target.value.toLowerCase() === 'true' ? 'visible' : 'hidden');
			})
	},

	/**
	 * Update the password field visibility.
	 *
	 * @param {any} $passwordControl jQuery password field.
	 * @param {any} $mfaControl jQuery MFA activation checkbox.
	 * @param {boolean} isVisible should the password field be visible?
	 */
	updatePasswordVisibility: function ($passwordControl, $mfaControl, isVisible) {
		$passwordControl
			.css('visibility', isVisible ? 'visible' : 'hidden');
		$mfaControl.css('visibility', isVisible ? 'visible' : 'hidden');
	},

	/**
	 * Start checking password rules:
	 *  - run an initial check
	 *  - listen to change and key events on the 2 password fields.
	 * Use a debouncer to avoid triggering the check too frequently.
	 */
	startCheckPassword: function () {
		if (!this._container) return false;

		const $container = $('#' + this._container);
		if (!$container || !$container.length) return false;

		const $txtNewPassword = $container.find('.pwd-field'),
			$txtNewPasswordConfirm = $container.find('.pwd-conf-field'),
			$rules = $container.find('.pwd-rules-list');

		const checkPasswordDebounced = $.debounce(100, ivUsr.checkPassword($txtNewPassword, $txtNewPasswordConfirm, $rules));

		$txtNewPassword
			.on("change.usr", checkPasswordDebounced)
			.on("keyup.usr", checkPasswordDebounced);

		$txtNewPasswordConfirm
			.on("change.usr", checkPasswordDebounced)
			.on("keyup.usr", checkPasswordDebounced);
	},

	/**
	 * Event handler started when user click on the button attached to, for example cmdSave in RegistrationExtranetManageMethods or new_passward.ascx.cs :
	 *  - fires on click on button,
	 *  - fires on Enter
	 */
	onSubmitOrEnter: function (event) {
		if (!this._container) return false;

		const $container = $('#' + this._container);
		if (!$container || !$container.length) return true;

		const $txtNewPassword = $container.find('.pwd-field'),
			$txtNewPasswordConfirm = $container.find('.pwd-conf-field'),
			$rules = $container.find('.pwd-rules-list');

		let result = { isValid: true, errors: [] };
		ivUsr.checkPassword($txtNewPassword, $txtNewPasswordConfirm, $rules, result)();

		if (result.isValid) {
			ivNotificationMessage.remove(ivClient.get($txtNewPassword, ivClient.properties.id));
			return true;
		}

		ivNotificationMessage.AddMsg(result.errors.join('<br/>')
			, null
			, ivValidator.cssClass.error
			, ivNotificationMessage.msgContainer.page
			, null
			, ivClient.get($txtNewPassword, ivClient.properties.id));

		return false;
	},

	/**
	 * Check if the rules to fill the password fields are respected.
	 * @param {any} $newPassword jQuery element to the password field.
	 * @param {any} $newPasswordConfirmed jQuery element to the password confirmation field.
	 * @param {any} $pwdRules jQuery element to the rules container.
	 * @param { isValid: true, errors: [] } result element to save result of validation, and eventual errors.
	 */
	checkPassword: function ($newPassword, $newPasswordConfirmed, $pwdRules, result) {
		return function (evt) {
			var passwordValue = $newPassword.val();
			var isCurrentRuleValid = true;
			var areAllRulesValid = true;
			var errors = [];

			// Check if both password are identical
			isCurrentRuleValid = passwordValue === $newPasswordConfirmed.val();
			areAllRulesValid = areAllRulesValid && isCurrentRuleValid;

			let $rule = $pwdRules.find(`[data-code='pwd_cfpwd_diff']`);
			if (!isCurrentRuleValid) {
				errors.push($rule.text());
			}
			ivUsr.updatePasswordRule($rule, isCurrentRuleValid);

			// Check other rules
			$pwdRules.find('.pwd-rule')
				.each(function (_, rule) {
					var $rule = $(rule),
						code = $rule.data('code'),
						isValidatable = $rule.data('validatable') === true;

					if (code === 'pwd_cfpwd_diff' || !isValidatable)
						return;

					isCurrentRuleValid = ivUsr.isRegexValid(passwordValue, $rule.data('pattern'), $rule.data('nb'));
					areAllRulesValid = areAllRulesValid && isCurrentRuleValid;
					if (!isCurrentRuleValid) {
						errors.push($rule.text());
					}
					ivUsr.updatePasswordRule($rule, isCurrentRuleValid);
				});

			if (result) {
				result.isValid = areAllRulesValid;
				result.errors = errors;
			}
		}
	},

	/**
	 * Update the rule style depending of its truthness.
	 * @param {any} $rule jQuery element to the rule container.
	 * @param {boolean} isValid rule validity.
	 */
	updatePasswordRule: function ($rule, isValid) {
		if (!$rule) return;

		const ariaLabel = isValid
			? ivScope.GetText('/usr/util_ctrl|pw_constraint_valid')
			: ivScope.GetText('/usr/util_ctrl|pw_constraint_invalid');

		$rule
			.toggleClass('pwd-rule-valid', isValid)
			.toggleClass('pwd-rule-invalid', !isValid)
			.find('i')
				.toggleClass('fa-check', isValid)
				.toggleClass('fa-times', !isValid)
				.attr('aria-label', ariaLabel);
	},

	/**
	 * Check the validity of a value relatively to some pattern.
	 * @param {string} value Value to check.
	 * @param {string} pattern Pattern to respect.
	 * @param {number} nbOcc Number of occurrences needed of this pattern.
	 */
	isRegexValid: function (value, pattern, nbOcc) {
		var resultRegexTest = value.match(new RegExp(pattern, 'g'));
		return !!resultRegexTest && resultRegexTest.length >= nbOcc;
	}
});


var ivUsrProfilAuth = (function ($) {
	'use scrict';

	return {
		/**
		 * After the page /usr/profil_auth_compare is loaded,
		 * try to highlight, disable or remove authorizations in the 2 panels based on selected profiles
		 */
		initProfilAuthCompare: function (authsHighlightLeft
			, authsHighlightRight
			, authsToRemoveLeft
			, authsToRemoveRight
			, authsToDisabledLeft
			, authsToDisabledRight) {

			$.each(authsHighlightLeft, function (i, v) {
				if (v != null && v != '')
					$('.profil_auth_compare__auth-frame-left :checked[value="' + v + '"]').parent().addClass('highlightDiffRight');
			});

			$.each(authsHighlightRight, function (i, v) {
				if (v != null && v != '')
					$('.profil_auth_compare__auth-frame-right :checked[value="' + v + '"]').parent().addClass('highlightDiffLeft');
			});

			$.each(authsToRemoveLeft, function (i, v) {
				if (v != null && v != '')
					$('.profil_auth_compare__auth-frame-left :checkbox[value="' + v + '"]').parent().hide();
			});

			$.each(authsToRemoveRight, function (i, v) {
				if (v != null && v != '')
					$('.profil_auth_compare__auth-frame-right :checkbox[value="' + v + '"]').parent().hide();
			});			

			$.each(authsToDisabledLeft, function (i, v) {
				if (v != null && v != '')
					$('.profil_auth_compare__auth-frame-left :checkbox[value="' + v + '"]').attr('disabled', 'disabled');
			});

			$.each(authsToDisabledRight, function (i, v) {
				if (v != null && v != '')
					$('.profil_auth_compare__auth-frame-right :checkbox[value="' + v + '"]').attr('disabled', 'disabled');
			});
		},
		profilEdit: function (sel) {
			if (sel.val() != null && sel.val() != '')
				modalPopup({ url: ivScope.ModalUrl("usr", "profil_manage") + '/' + sel.val() });
			else
				alert(ivScope.GetText("select_profil"));

			return false;
		},
		profilDuplicate: function (sel) {
			if (sel.val() != null && sel.val() != '') {
				modalPopup({
					url: ivScope.ModalUrl("usr", "profil_manage") + '?copy_from=' + sel.val()
				});
			} else {
				alert(ivScope.GetText("select_profil"));
			}
			return false;
		},
		savePrx: function (prx) {
			$('#current_tab').val(prx);
		},
	};
}(jQuery));