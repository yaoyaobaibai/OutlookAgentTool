var ivWorkflow = (function ($) {
	'use strict';

	return {

		selector: {
			fields: '[data-workflow]'
		},

		dialog: {
			self: function () {
				return $('#workflow_mass_action_dialog');
			},
			header: function () {
				return this.self().find('.header');
			},
			buttonpane: function () {
				return this.self().find('.actions');
			},
			actButtons: function () {
				return this.buttonpane().find('button');
			},
			actValButton: function () {
				return this.buttonpane().find('button.val');
			},
			actRefButton: function () {
				return this.buttonpane().find('button.ref');
			},
			alert: function () {
				return this.self().find('.alert');
			},
			alertHeader: function () {
				return this.self().find('.alert .alert-header');
			},
			alertContent: function () {
				return this.self().find('.alert .alert-content');
			},
			comment: function () {
				return this.self().find('.comment');
			},
			commentHeader: function () {
				return this.self().find('.comment .comment-header');
			},
			commentContent: function () {
				return this.self().find('.comment .comment-content');
			},
			commentTextbox: function () {
				return this.self().find('.comment .comment-content textarea');
			}
		},

		tasks: [],

		addTask: function (id) {
			if (ivClient.is.checked(id)) {
				if ($.grep(ivWorkflow.tasks, function (value) { return value.actKey == __ivHtmlControls[id].actKey; }).length == 0)
					ivWorkflow.tasks.push(__ivHtmlControls[id]);
			}
			else {
				ivWorkflow.tasks = $.grep(ivWorkflow.tasks, function (value) { return value.actKey != __ivHtmlControls[id].actKey; });
			}
		},

		massValidate: function (event) {
			this.massAction(event, 'validate');
		},

		massRefuse: function (event) {
			this.massAction(event, 'refuse');
		},

		massAction: function (event, action) {
			var actionEnabled,
				commentMandatory,
				actionTitle;

			this.dialog.alert().css("display", "none");
			this.dialog.comment().css("display", "none");
			this.dialog.actButtons().addClass('hidden');

			if (action === 'validate') {
				actionEnabled = 'actValEnabled';
				commentMandatory = 'actValMandatoryComment';
				actionTitle = ivScope.GetText('/wfl/wfl_task_browse|mass_validation');
			}
			else {
				actionEnabled = 'actRefEnabled';
				commentMandatory = 'actRefMandatoryComment';
				actionTitle = ivScope.GetText('/wfl/wfl_task_browse|mass_refusal');
			}

			var confirmTaskCollection = [],
				commentTaskCollection = [];
			$.each(this.tasks, function () {
				if (this[actionEnabled] === false)
					confirmTaskCollection.push(this);
				if (this[commentMandatory] === true && $.inArray(this, confirmTaskCollection) < 0)
					commentTaskCollection.push(this);
			});

			var targetName = ivClient.get(event.target, ivClient.properties.name);

			if (confirmTaskCollection.length > 0 || commentTaskCollection.length > 0) {
				if (ivWorkflow.dialog.header())
					ivWorkflow.dialog.header().text(actionTitle.toString());

				if (action === 'validate')
					ivWorkflow.dialog.actValButton().removeClass('hidden');
				else
					ivWorkflow.dialog.actRefButton().removeClass('hidden');

				if (confirmTaskCollection.length > 0) {
					var frameTitle;
					if (confirmTaskCollection.length === ivWorkflow.tasks.length) {
						frameTitle = ivScope.GetText('/wfl/wfl_task_browse|wfl_mass_action_incompatible_warning_all')
							.replace('{0}', actionTitle);
						ivWorkflow.dialog.buttonpane().addClass('hidden');
					}
					else {
						frameTitle = ivScope.GetText('/wfl/wfl_task_browse|wfl_mass_action_incompatible_warning')
							.replace('{0}', confirmTaskCollection.length)
							.replace('{1}', ivWorkflow.tasks.length)
							.replace('{2}', actionTitle);
						ivWorkflow.dialog.buttonpane().removeClass('hidden');
					}

					if (ivWorkflow.dialog.alert())
						ivWorkflow.dialog.alert().css("display", "inherit").find(':first-child').removeClass('hidden');
					if (ivWorkflow.dialog.alertHeader())
						ivWorkflow.dialog.alertHeader().text(frameTitle);

					ivWorkflow.dialog.alertContent().children().remove();
					$.each(confirmTaskCollection, function () {
						ivWorkflow.dialog.alertContent().append("<li class='item'>" + this.actProcessLabel + '-' + this.actLabel + '-' + this.actObjectLabel + '</li>');
					});
					ivWorkflow.dialog.alertContent().css("display", "inherit");
				}
				else {
					ivWorkflow.dialog.buttonpane().removeClass('hidden');
				}

				if (commentTaskCollection.length > 0) {
					ivWorkflow.dialog.actButtons().addClass('disable');
					if (commentTaskCollection.length === ivWorkflow.tasks.length) {
						frameTitle = ivScope.GetText('/wfl/wfl_task_browse|wfl_mass_action_mandatory_comment_all');
					}
					else {
						frameTitle = ivScope.GetText('/wfl/wfl_task_browse|wfl_mass_action_mandatory_comment')
							.replace('{0}', commentTaskCollection.length)
							.replace('{1}', ivWorkflow.tasks.length)
							.replace('{2}', actionTitle);
						ivWorkflow.dialog.buttonpane().css('display', 'inherit');
					}

					if (ivWorkflow.dialog.comment()) {
						ivWorkflow.dialog.commentTextbox().attr('aria-label', frameTitle);
						ivWorkflow.dialog.comment().css("display", "inherit").find(':first-child').removeClass('hidden');
					}
					if (ivWorkflow.dialog.commentHeader())
						ivWorkflow.dialog.commentHeader().text(frameTitle);

					ivWorkflow.dialog.commentTextbox()
						.val('')
						.focus()
						.on('keyup', function () {
							if ($(this).val().length > 0)
								ivWorkflow.dialog.actButtons().removeClass('disable');
							else
								ivWorkflow.dialog.actButtons().addClass('disable');
						});

					ivWorkflow.dialog.comment().css("display", "inherit");
				}

				$('#workflow_mass_action_dialog').modal('setting', {
					onDeny: function () { return ivWorkflow.proceedMassAction(targetName); },
					onApprove: function () { return ivWorkflow.proceedMassAction(targetName); },
					onShow: function () { $('#mainForm').append($(this).parents('.ui.dimmer:first')); } // Attaches modal components into the #mainForm's <form>
				});

				$('#workflow_mass_action_dialog').modal('show');
			}
			else {
				ivWorkflow.proceedMassAction(targetName);
			}
		},

		proceedMassAction: function (postBackName) {
			if (ivWorkflow.dialog.actButtons().hasClass('disable')) {
				return false;
			}

			ivWorkflow.tasks = [];
			__doPostBack(postBackName, '');
			return true;
        },
        RefreshActivityBrowse: function (processCode, actCode) {
            if (!window._needRefresh) {
                return;
		}
            if (!ivCallMethod.RefreshActivityBrowseCell) {
				ivCallMethodHandler.prototype.RefreshActivityBrowseCell = function (processCode, actCode) {
					this.invoke(ivScope.AjaxUrl("wfl", "activity_browse", null, "methodname=RefreshActivityBrowse"),
						{ processCode: processCode, actCode: actCode }
						, function (cellContent) {
							var $cell = $('.wfl-delegation-phc.' + 'phc_' + processCode + '_' + actCode);
							$cell.html('');
                            $cell.html(cellContent);
                            ivWorkflow.RefreshActivityErrors(processCode, actCode);
                        }
                        , null
                        , null);
	};
            }
            ivCallMethod.RefreshActivityBrowseCell(processCode, actCode);
            window._needRefresh = false;
        },
        RefreshActivityErrors: function (processCode, actCode) {
            if (!ivCallMethod.RefreshActivityErrorsCell) {
                ivCallMethodHandler.prototype.RefreshActivityErrorsCell = function (processCode, actCode) {
                    this.invoke(ivScope.AjaxUrl("wfl", "activity_browse", null, "methodname=RefreshActivityErrors"),
                        { processCode: processCode, actCode: actCode }
                        , function (cellContent) {
                            var $cell = $('.phcError_' + processCode + '_' + actCode);
                            $cell.html('');
                            $cell.html(cellContent);
                        }
                        , null
                        , null);
                };
            }
            ivCallMethod.RefreshActivityErrorsCell(processCode, actCode);
		},

		/*
		 * unselect value of the activity selector
		 */ 
		clearActivitySelectedValue: function () {
			const id = filter_control.filter(function (f) { return f.ID == 'ddlActivity' })[0].ClientID;
			ivDropdownSelector.removeSelectedValue($('#' + id));
		}
	};
}(jQuery));