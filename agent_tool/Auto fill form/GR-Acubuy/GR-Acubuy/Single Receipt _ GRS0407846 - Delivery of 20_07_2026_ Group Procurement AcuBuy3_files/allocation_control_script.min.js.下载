var ivAllocationControl = ivAllocationControl || {};
$.extend(ivAllocationControl, {
	resetGridNewvalues: function (txtAllocTemplateId) {
		ivClient.set(txtAllocTemplateId, ivClient.properties.value, "");
		$('[data-new_objects=true]').val("");
	},
	totalDuePercent: 1,
	totalTaxExclField: '.totalht-amount',
	totalTaxInclField: '.total-amount input',
	taxMode: null,
	updateAmountRemainingSuccess: function (result) {
		var remainingCtrl = $('.remaining-amount');
		var remainingCtrlCurrencyScale = remainingCtrl.hasClass("has_currency_scale");
		var t = ivDynamicCalculation.arrondi(result, remainingCtrlCurrencyScale);
		var new_value = ivDynamicCalculation.formatPrecision(t, remainingCtrlCurrencyScale);

		ivClient.set(remainingCtrl, ivClient.properties.value, new_value);
	},
	getTotalSelector: function () {
		if (ivAllocationControl.taxMode === 'incl')
			return ivAllocationControl.totalTaxInclField;
		else
			return ivAllocationControl.totalTaxExclField;
	},
	totalAmountToAllocate: function () {
		var totalAmount = ConvertTo(ivClient.get($(ivAllocationControl.getTotalSelector()), ivClient.properties.value), 'double');
		return totalAmount * ivAllocationControl.totalDuePercent;
	},
	updateRemainingToAllocate: function () {
		if (!ivCallMethod.updateRemainingAllocation) {
			ivCallMethodHandler.prototype.updateRemainingAllocation = function () {
				var totalHTAmount = ivAllocationControl.totalAmountToAllocate();

				if ($('.amount-allocation-line').length == 0)
					return;
				var allocationAmounts = [];
				var allocationIds = [];
				$('.amount-allocation-line').each(
					function () {
						var amount = Nbr(ivClient.get($(this), ivClient.properties.value));
						if (!(Number.isNaN(amount))) {
							allocationAmounts.push(amount);
							allocationIds.push($(this).closest('tr').attr('data-id'));
						}
						else return;
					});
this.invoke(ivScope.AjaxUrl("ord", "allocation_control", null, "methodname=UpdateAmountResidualAllocationAjax"), { allocationAmounts: allocationAmounts, totalHTAmount: totalHTAmount, allocationIds: allocationIds },
					ivAllocationControl.updateAmountRemainingSuccess, null, null);
			};
		}
		ivCallMethod.updateRemainingAllocation();
	},
	updateAllocationRemaining: function () {
		ivAllocationControl.updateRemainingToAllocate();
	},
	changeAllocationAmount: function (ctrl) {
		var allAmountCtrl = $('#' + ctrl);
		var $allocationLine = allAmountCtrl.closest('.allocation-line');
		var allPercentageCtrl = $allocationLine.find(".percent-allocation-line");

		var total = ConvertTo(ivClient.get($(ivAllocationControl.getTotalSelector()), ivClient.properties.value), 'double');
		var amount = ConvertTo(ivClient.get(allAmountCtrl, ivClient.properties.value), 'double');
		var totalDueAmount = total * ivAllocationControl.totalDuePercent;

		var percentage = 0;

		if (total != 0) {
			percentage = amount / totalDueAmount * 100;
		}

		var new_value = FormatValue(percentage, 2);

		ivAllocationControl.setValueWithoutChange(allPercentageCtrl, new_value);
	},
	changeAllocationPercentage: function (ctrl) {
		var allPercentageCtrl = $('#' + ctrl);
		var $allocationLine = allPercentageCtrl.closest('.allocation-line');
		var allAmountCtrl = $allocationLine.find(".amount-allocation-line");

		if (allAmountCtrl) {
			var total = ConvertTo(ivClient.get($(ivAllocationControl.getTotalSelector()), ivClient.properties.value), 'double');
			var percentage = ConvertTo(ivClient.get(allPercentageCtrl, ivClient.properties.value), 'double');
			var amount = percentage / 100 * total;
			var totalDueAmount = amount * ivAllocationControl.totalDuePercent;

			var allAmountCtrlCurrencyScale = allAmountCtrl.hasClass("has_currency_scale");
			var t = ivDynamicCalculation.arrondi(totalDueAmount, allAmountCtrlCurrencyScale);
			var new_value = ivDynamicCalculation.formatPrecision(t, allAmountCtrlCurrencyScale);

			ivAllocationControl.setValueWithoutChange(allAmountCtrl, new_value);
		}
	},

	// Update allocation amounts based on percentages
	// Only usefull on ord/item_manage. For other pages (ex invoice_manage) allocations are well calculated on server side 
	updateAllocationAmounts: function (){
		$('.percent-allocation-line').each(function () {
			ivAllocationControl.changeAllocationPercentage(ivClient.get($(this), ivClient.properties.id));
		});
	},
	setValueWithoutChange: function (ctrl, value) {
		var onChange = __ivHtmlControls[ivClient.get(ctrl, ivClient.properties.id)].onChange;
		__ivHtmlControls[ivClient.get(ctrl, ivClient.properties.id)].onChange = "";
		ivClient.set(ctrl, ivClient.properties.value, value);
		__ivHtmlControls[ivClient.get(ctrl, ivClient.properties.id)].onChange = onChange;
	},
	SelAllocationValues: {},
	SelAllocationValuesRow: {},
	SelSavedValuesCol: function (elemId, hiddenFieldId, allId, uniqueKey) {
		if (typeof this.SelAllocationValues[allId] === 'undefined')
			this.SelAllocationValuesRow = {};
		var SelectorValue = ivClient.get("#" + elemId, ivClient.properties.value);
		this.SelAllocationValuesRow[uniqueKey] = SelectorValue;
		this.SelAllocationValues[allId] = this.SelAllocationValuesRow;
		const hdnSelValues = document.getElementById(hiddenFieldId);
		if (hdnSelValues) {
			hdnSelValues.value = JSON.stringify(this.SelAllocationValues);
		}
	},
});
$(document).ready(function () {
	$(document).on('change.amount', '.amount-allocation-line', ivAllocationControl.updateRemainingToAllocate);
});

