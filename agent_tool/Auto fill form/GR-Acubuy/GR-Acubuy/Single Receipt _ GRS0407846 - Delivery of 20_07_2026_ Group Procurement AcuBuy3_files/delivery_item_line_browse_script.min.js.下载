var ivDeliveryItemLineBrowse = ivDeliveryItemLineBrowse || {};
$.extend(ivDeliveryItemLineBrowse, {
	setAllocationsItems: function (delivId, gridId, colCheckId) {
		var $hdnCheck = $('#hdnColCheckValues');
		var itemIds = __ivCtrl[gridId].cb[colCheckId];
		ivClient.set($hdnCheck, ivClient.properties.value, itemIds);
		if (itemIds.length > 0) {
			modalPopup({ 'url': ivScope.ModalUrl("ord", "delivery_item_set_allocation") + '?deliv_id=' + delivId, size: 'fullscreen' });
		}
	},
});