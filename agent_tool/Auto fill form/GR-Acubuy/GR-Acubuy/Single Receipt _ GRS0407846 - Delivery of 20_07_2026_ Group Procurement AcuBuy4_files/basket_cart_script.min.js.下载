//vars
var __headerCartContainerID = 'headerCartContainer';
var __addToCartMsgClass = '.pdt-adding-message';
var __notAddedToCartMsgClass = '.pdt-notadded-message';
var basketBtntrigger;
function ivCaddy(clientid)
{
	__ivCtrl[clientid] = this;
	this.ClientID = clientid;
	this.Control = $get(clientid);
}
ivCaddy.prototype =
{
	_globalBasketId: null,
	_hdnAddItem: null,
	_hdnBasketId: null,
	_gridTotalId: null,
	_ddlBasket: null,
	_upcGlobal: null,
	_upcTotal: null,
	_phcBasket: null,
	_phcEditTitle: null,
	_SaveState: null,
	_frameUrl: null,
	_timer: null,
	_lstWaitItems: '',
	_action: null,
	_gridClientId:null,
	addItems: function (strItems, strFeature, isCross) {
		if ($('#rightPanel').hasClass('collapsed'))
			$("#rightPanel_btnPanelOpen").trigger('click');

		this._hdnAddItem.val(strItems);
		this._hdnAddFeature.val(strFeature);
		this._hdnAddIsCross.val(isCross);

		if (this._ddlBasket.length == 0 || this._ddlBasket.val().length == 0)
			this.TunedPostBack(this._upcGlobal[0].id, 'basket_cart');
		else
			this.TunedPostBack(this._ddlBasket[0].id, 'basket_cart');
	},
	TunedPostBack: function (eventTarget, eventArgument) {
		// always use window._ivUpdatePanel PostBack with carefully setted options
		// (the basket cart need to work both when it is loaded in normal mode and AJAX mode)
		__doPostBack(eventTarget, eventArgument, this.getPostBackOptions());
	},
	getPostBackOptions: function () {
		var $form = $('.shopping_container').find('form');
		if ($form.length > 0) {
			if ($form[0]._initialAction === undefined)
				$form[0]._initialAction = $form[0].action;
			//  add the hidden fields needed for window._ivUpdatePanel which is responsible of the PostBack
			window.addHiddenToForm('__EVENTTARGET', '__EVENTTARGET', '', $form[0]);
			window.addHiddenToForm('__EVENTARGUMENT', '__EVENTARGUMENT', '', $form[0]);
			return { 'form': $form[0] };
		}
		return null;
	},
	cleanHiddens: function () {
		this._hdnAddItem.val('');
		this._hdnBasketId.val('');
	},
	checkout: function () {
		var basketId = this._ddlBasket.val();
		if (basketId && basketId != -1 && !isNaN(parseInt(basketId))) {
			if (!mobileMode)
				upperWindow.location.href = ivScope.PageUrl("ord", "basket_manage") + '/' + basketId;
			else
				upperWindow.location.href = ivScope.PageUrl("ord", "basket_manage_mobile").replace("page.aspx", "mobile.aspx") + '/' + basketId;
		}
	},
	bookmark: function () {
		var basketId = this._ddlBasket.val();
		if (basketId && !isNaN(parseInt(basketId)))
				modalPopup({ 'autoOpen': 'true',
				'title': ivScope.GetText("add_clause", false),
				'url': ivScope.ModalUrl("ord", "basket_catalog_bookmark") + '?basket=' + basketId
			});
	},
	addItemOutCatalog: function (title, fam) {
		var basketId = this._ddlBasket.length == 0 ? '' : this._ddlBasket.val();
		basketId = basketId && !isNaN(parseInt(basketId)) ? basketId : '';
			modalPopup({ 'autoOpen': 'true', 'title': title,
			'url': ivScope.ModalUrl("ord", "item_manage") + '?modal=true&outCatalog=1&fam=' + fam + '&basket=' + basketId
		});
	},
	refreshCaddy: function () {
		if (this._ddlBasket.length == 0 || this._ddlBasket.val().length == 0)
			this.TunedPostBack(this._upcGlobal[0].id, 'basket_cart');
		else
			this.TunedPostBack(this._ddlBasket[0].id, 'basket_cart');
	},
	refreshTotal: function () {
		this.TunedPostBack(this._upcTotal[0].id, 'basket_cart');
	},
	refreshBasket: function (basketId) {
		this._hdnBasketId.val(basketId);
		this.refreshCaddy();
	},
	replaceBasket: function () {
		if (this._ddlBasket.length == 0)
			return;
		this._phcBasket.get(0).style.position = 'relative';
		this._phcBasket.stop().animate({ top: '0px' }, 0);
	},
	onEndResponse: function (executor, eventArgs, args) {
		if (!executor.get_responseAvailable())
			return;
		var response = executor.get_object();
		autoSetCartSize();

		var baksetHeaderCount = upperWindow.$('.basket-cart .counter-item');
		var count = response['headerBasketCount'];
		if (count == 0)
			baksetHeaderCount.hide();
		else
			baksetHeaderCount.show();
		baksetHeaderCount.text(count);

		$('#hdnBasketMenu').val(response['headerMenu']);

			if (typeof (addBasketCallback) == 'function') {
		addBasketCallback(executor, args);
			}
	},
	refreshHeader: function (action, param) {
		var reqAjax = new ivAsyncRequest();
		reqAjax.UpdateProgressUID = null;
		reqAjax.AsyncPostBackTimeout = -1;
		this._action = action;
		reqAjax.OnEndResponse = this.onEndResponse;
		reqAjax.ModuleName = 'ord';
		reqAjax.PageName = 'basket_catalog';
		reqAjax.Url = ivScope.AjaxUrl("ord", "basket_catalog");
		reqAjax.Data = 'action=refreshHeader';
		if (action && action.length > 0)
			reqAjax.Data += '&' + action + '=true';
		if (param && param.length > 0)
			reqAjax.Data += '&param=' + param;
		reqAjax.Args = this;
		reqAjax.AsyncRequest();
	},
	edit_title: function () {
		var basketId = this._ddlBasket.val();
		if (basketId && !isNaN(parseInt(basketId))) {
			if (this._phcEditTitle.length == 0)
				return;
			if (this._phcEditTitle.closest('.fields').parent().is(':hidden')) {
				this.hideDdlBasket();
				this.showTitle();
				this._phcEditTitle.parent().css('width', '100%');
				var strLength = this._phcEditTitle.val().length * 2;
				this._phcEditTitle.focus();
				this._phcEditTitle[0].setSelectionRange(strLength, strLength);
			}
			else {
				this.hideTitle();
				this.showDdlBasket();
			}
		}
	},
	save_title: function () {
		this.TunedPostBack(this._upcGlobal[0].id, 'basket_cart');
	},
	hideTitle: function () {
		if (!this._phcEditTitle.closest('.fields').parent().hasClass('hidden'))
			this._phcEditTitle.closest('.fields').parent().addClass('hidden');
	},
	showTitle: function () {
		if (this._phcEditTitle.closest('.fields').parent().hasClass('hidden'))
			this._phcEditTitle.closest('.fields').parent().removeClass('hidden');
	},
	hideDdlBasket: function () {
		if (!this._ddlBasket.closest('.fields').parent().hasClass('hidden'))
			this._ddlBasket.closest('.fields').parent().addClass('hidden');
	},
	showDdlBasket: function () {
		if (this._ddlBasket.closest('.fields').parent().hasClass('hidden'))
			this._ddlBasket.closest('.fields').parent().removeClass('hidden');
	},
	updateMobileCounter: function () {
		var $container = $('.shopping_container');
		if ($container.length > 0) {
			var div = $container.find('.bktContent');
			var counter = $('.shopping_count');
			var counterCurrentValue = parseInt(counter.text(), 10);
			if (isNaN(counterCurrentValue))
				counterCurrentValue = 0;
			var counterNewValue = 0;

			if (div.length > 0) {
				$container.removeClass('empty');
				$container.find('#shoppingContainerEmpty').hide();
				counterNewValue = div.find('[data-iv-control="' + this._gridClientId + '"] [data-object-type="ord_item"]').length;
				counter.text(counterNewValue);
			}
			else {
				$container.addClass('empty');
				$container.find('#shoppingContainerEmpty').show();
				counter.text('');
			}
		}
	},

	floatModuloJsCompatible: function (number, divider) {
		var numDecCount = number.toString().indexOf('.') >= 0 ? number.toString().split('.')[1].length : 0;
		var divDecCount = divider.toString().indexOf('.') >= 0 ? divider.toString().split('.')[1].length : 0;
		var decimalCount = Math.max(numDecCount, divDecCount);
		var numInt = parseInt(number.toFixed(decimalCount).replace('.', ''));
		var divInt = parseInt(divider.toFixed(decimalCount).replace('.', ''));
		var rest = (numInt % divInt) / Math.pow(10, decimalCount);
		return rest;
	},

	isValidQty: function (qty, constraints, errors) {
		var isValid = true;
		var prompt;
		constraints = constraints || {};
		if (qty <= 0) {
			isValid = false;
			prompt = ivScope.GetText('prompt_compare_to_value'); // {name} must be {compareOperator} {compareValue}
			prompt = prompt.replace('{name}', ivScope.GetText('error_txtquantity'));
			prompt = prompt.replace('{compareOperator}', '>');
			prompt = prompt.replace('{compareValue}', FormatValue(0));
		} else
		if (!isNaN(constraints.minQuantity) && qty < constraints.minQuantity) {
			isValid = false;
			prompt = ivScope.GetText('prompt_compare_to_value'); // {name} must be {compareOperator} {compareValue}
			prompt = prompt.replace('{name}', ivScope.GetText('error_txtquantity'));
			prompt = prompt.replace('{compareOperator}', '>=');
			prompt = prompt.replace('{compareValue}', FormatValue(constraints.minQuantity));
		} else
		if (!isNaN(constraints.soldByQty) && this.floatModuloJsCompatible(qty, constraints.soldByQty) != 0) {
			isValid = false;
			prompt = ivScope.GetText('prompt_multiple_of_value'); // {name} must be a multiple of {compareValue}
			prompt = prompt.replace('{name}', ivScope.GetText('error_txtquantity'));
			prompt = prompt.replace('{compareValue}', FormatValue(constraints.soldByQty));
		}
		if (!isValid)
			errors.push(prompt);
		return isValid;
	},

	isValidValueInSelQty: function (selQty, errors) {
		var inputId = selQty.attr('data-selector');
		var minQuantity = Nbr(selQty.attr('data-min-qty'));
		var soldByQty = Nbr(selQty.attr('data-sold-by-qty'));
		var $field = $(ivValidator.selector.field(inputId));
		var qty = Nbr($field.val());

		return this.isValidQty(qty, { minQuantity, soldByQty }, errors);
	},

	checkNewSelQtyInBasket: function (oitemId) {
		var selQty = $('.qty-selector[data-item-id="' + oitemId + '"]');
		var inputId = selQty.attr('data-selector');
		var $field = $(ivValidator.selector.field(inputId));
		var errors = [];
		var isValid = this.isValidValueInSelQty(selQty, errors);

		ivValidator.remove.prompt($field);
		if (!isValid) {
			ivValidator.add.prompt($field, errors);
			this.disableCheckoutButton($field);
		} else {
			this.updateCheckoutButtonState($field);
		}
	},

	updateTotalPriceOitem: function (oitem_id) {
		if (!ivCallMethod.refreshTotalPrice) {
			ivCallMethodHandler.prototype.refreshTotalPrice = function (oitem_id) {
				var qty = $('.qty-selector[data-item-id="' + oitem_id + '"] div.text').html()
				this.invoke(ivScope.AjaxUrl("ord", "basket_catalog", null, "methodname=GetTotalPriceOItem"), { oitem_id: oitem_id, qty: qty},
					caddy.updateTotalPriceSuccess, null, null);
			};
		}
		ivCallMethod.refreshTotalPrice(oitem_id);
	},
	updateTotalPriceSuccess: function (result) {
		var oitem_id = result['oitem_id'];
		var value = result['value'];
		if (value != null) 
			$('tr[data-id="' + oitem_id + '"] .bktPrice:first').html(result['value']);
	},
	refreshCartTotal: function (event, force_refresh) {
		if (force_refresh != undefined || $(event.target).attr('data-value') != undefined || event.key == "Enter") {
			caddy.updateTotalGrid();
			if ($('.cart-total-currency').length)
				caddy.updateTotalCurrencyGrid();
		}
	},
	updateTotalGrid: function () {
		if (!ivCallMethod.refreshTotalGrid) {
			ivCallMethodHandler.prototype.refreshTotalGrid = function () {
				this.invoke(ivScope.AjaxUrl("ord", Page == "basket_light_manage" ? "basket_information_manage" : "basket_catalog", PathInfo, "methodname=GetCartTotalPrice"), {},
					caddy.updateTotalGridSuccess, null, null);
			};
		}
		ivCallMethod.refreshTotalGrid();
	},

	updateTotalGridSuccess: function (result) {
		caddy.updateTotalGridSuccessGlobal(result, 'cart-total');
		caddy.handleCheckoutBtnState('bktContent');
	},

	handleCheckoutBtnState: function (gridClass) {
		$('.btnValid').toggleClass('disable', ($('.' + gridClass + ' tbody>tr').length == 0));
	},

	updateTotalGridSuccessGlobal: function (result, eltname) {
		if (eltname != undefined) {
			var nb_item = 0;
			var listPkval = [];
			for (i = 0; i < result.length; i++) {
				nb_item += result[i]['item_number'];
				var currency = result[i]['currency_label'];
				var price = result[i]['total_formated'];
				var pkval = result[i]['pkval'];
				listPkval[pkval] = true;
				if ($('.' + eltname + ' tr[data-id="' + pkval + '"]').length) {
					$('.' + eltname + ' tr[data-id="' + pkval + '"] td.item-price').html(price);
				}
				else {
					if (caddy._gridTotalId != null) {
						var newline = __ivCtrl[caddy._gridTotalId].template.replace(/new_object/g, pkval);
						var html = $('<tr/>', { html: newline });
						$(html).find('tr').attr('data-id', pkval);
						$(html).find('tr').show();
						$(html).find('.item-price').html(price);
						$(html).find('.item-currency').html(currency);
						$('.' + eltname + ' tbody').prepend(html.html());
					}
				}
			}

			$('.' + eltname + ' tbody tr:not([data-id=""])').each(function () {
				if (listPkval[$(this).attr('data-id')] != true)
					$(this).remove();

			});
			if (caddy._globalBasketId && ivClient.get(caddy._ddlBasket, ivClient.properties.value) == caddy._globalBasketId)
				ivShoppingCart.updateItemCount(nb_item);
		}

	},

	disableCheckoutButton: function (field) {
		// disable checkout button
		var checkoutBtn = field.closest('.basket_cart').find('.btnValid');
		checkoutBtn.addClass('disabled');
	},

	updateCheckoutButtonState: function (field) {
		var caddy = this;
		// enable checkout button if there is no more errors on any ordered items
		var isValidAll = true;
		var errors = [];
		var cartContainer = field.closest('.basket_cart');
		cartContainer.find('.qty-selector').each(function () {
			var selQty = $(this);
			isValidAll &= caddy.isValidValueInSelQty(selQty, errors);
		});

		if (isValidAll) {
			var checkoutBtn = field.closest('.basket_cart').find('.btnValid');
			checkoutBtn.removeClass("disabled");
		}
		return isValidAll;
	},

	handleItemDelete: function (event) {
		var caddy = this;
		var $obj = $(event.target);
		var oitem_id = $obj.closest("[data-object-type='ord_item']").attr("data-id");
		if (!ivCallMethod.basketItemDelete) {
			ivCallMethodHandler.prototype.basketItemDelete = function (oitem_id) {
				this.invoke(ivScope.AjaxUrl("ord", "basket_catalog", null, "methodname=GridDeleteItem"), { caddy_id: caddy.ClientID, oitem_id: oitem_id },
					caddy.handleItemDeleteSuccess, null, null);
			};
		}
		ivCallMethod.basketItemDelete(oitem_id);
	},

	handleItemDeleteSuccess: function (result) {
		result = result || {};
		if (!result.is_error) {
			var caddy = __ivCtrl[result.caddy_id];
			var $item = $(caddy.Control).find("[data-object-type='ord_item'][data-id='" + result.oitem_id + "']");
			if ($item.length > 0) {
				$item.remove();
				caddy.updateCheckoutButtonState($item);
			}
			caddy.refreshTotal();
		}
	}
};

function createHeaderCart(showCart, scrollToEnd, onLoadCallBack) {
	if (showCart == undefined)
		showCart = true;
	if (scrollToEnd == undefined)
		scrollToEnd = false;
	var $container = $('#' + __headerCartContainerID);
	var $iframe = $('<iframe src="' + ivScope.IframeUrl("ord", "basket_catalog") + '" class="iframe-cart-container" frameBorder="0" />');
	$iframe.css('width', '0px').css('height', '0px');
	$container.append($iframe);
	$container.data('cartInit', true);
	$container.data('iframe', true);
	$iframe.load(function (event) {
		if (this.contentDocument) {
			$container.addClass('header-cart-container');
			if (showCart) {
				showHeaderCart($container, false);
				setCartSize($container, $iframe, event);
				if (scrollToEnd) {
					$(this.contentDocument).find('.basket_cart').scrollTop($(this.contentDocument).find('.bktContent').outerHeight(true));
				}
			}
			if (onLoadCallBack) {
				onLoadCallBack($iframe, $container);
			}
		}
	});
}

function replaceHeaderCartTarget(targetID) {
	var $container = $('#' + __headerCartContainerID);
	$container.data('targetID', targetID);
	$container.data('cartInit', true);
}

function toggleHeaderCart(showOnly, event)
{
	if (showOnly == undefined)
		showOnly = false;
	var $container = $('#' + __headerCartContainerID);
	if (!$container.data('cartInit')) {
		if (Module == 'pdt' && Page == 'item_browse') {
			replaceHeaderCartTarget($('[iddivcart]').attr('iddivcart'));
			$container.addClass('header-cart-container');
			toggleHeaderCart(false);
			return;
		}
		createHeaderCart();
		$('#headerCartContainer').css('display', 'block');
		$('iframe.iframe-cart-container').css('display', 'block');
		return;
	}

	var targetID = $container.data('targetID');
	if ($('#' + targetID).length > 0)
		$container = $('#' + targetID);
	if (!$container.is(':visible')) {
		$container.addClass('header-cart-container');
		showHeaderCart($container, true, event);
		$('#headerCartContainer').css('display', 'block');
		$('iframe.iframe-cart-container').css('display', 'block');
		return false;
	}
	else if (!showOnly) {
		$container.slideUp(200);
	}
}

function openHeaderCart() {

	var $container = $('#' + __headerCartContainerID);
	var targetID = $container.data('targetID');
	if ($('#' + targetID).length > 0)
		$container = $('#' + targetID);
	var isVisible = $container.is(':visible');

	if (isVisible && $container.data('iframe') === true)
		return;

	if (!isVisible && !$container.data('cartInit')) {
		if (!targetID) {
			if (Module == 'pdt' && Page == 'item_browse')
			{
				replaceHeaderCartTarget($('[iddivcart]').attr('iddivcart'));
				$container.addClass('header-cart-container');
				toggleHeaderCart(false);
				return;
			}
			else {
				createHeaderCart(true, true);
				return;
			}
		}
		else {
			$container.addClass('header-cart-container');
		}
	}
	if (!isVisible) {
		$container.slideDown(200, function () {
			if ($container.data('iframe') === true) {
				var iframeDoc = $container.find('iframe')[0].contentDocument;
				$(iframeDoc).find('.basket_cart').scrollTop($(iframeDoc).find('.bktContent').outerHeight(true))
			}
			else {
				$container.find('.basket_cart').scrollTop($container.find('.bktContent').outerHeight(true))
			}
			$('.basket_cart, .pdt_caddy, .bktAmountHolder').on('click', function (event, ui) {
				event.stopImmediatePropagation();
				return false;
			});
			$('body').one('click', function () {
				if (window.location.href.indexOf('pdt/item_browse') > -1) {
					if ($('.header-cart-container') && $('.header-cart-container').is(':visible'))
						toggleHeaderCart(false);
				}
				else if ($('#headerCartContainer').is(':visible'))
					toggleHeaderCart(false);
			});
		});
		setCartMaxHeight($container);
	}
	else {		
		$container.find('.basket_cart').scrollTop($container.find('.bktContent').outerHeight(true))
		setCartMaxHeight($container);
	}
}

function showHeaderCart($container, setHeight, event) {
	$container.slideDown(200, function () {
		$('.basket_cart, .pdt_caddy, .bktAmountHolder').on('click', function (event, ui) {
			event.stopImmediatePropagation();
			return false;
		});
		$('body').one('click', function () {
			if (window.location.href.indexOf('pdt/item_browse') > -1) {
				if ($('.header-cart-container') && $('.header-cart-container').is(':visible'))
					toggleHeaderCart(false);
			}
			else if ($('#headerCartContainer').is(':visible'))
				toggleHeaderCart(false);
		});
	});
	if (setHeight)
		autoSetCartSize(event);
}

function autoSetCartSize(event) {
	var $container = upperWindow.$('#' + __headerCartContainerID);
	if (!$container.data('cartInit'))
		return;
	var $iframe = null;
	if ($container.data('iframe') && $container.find('iframe').length > 0) {
		$iframe = $container.find('iframe');
	}

	var targetID = $container.data('targetID');
	if ($('#' + targetID).length > 0) {
		$container = $('#' + targetID);
	}
	setCartSize($container, $iframe);
}

function setCartSize($container, $iframe) {
		
	if ($iframe && $iframe.length > 0) {
		var iframe = $iframe[0];
		var margin = 64;
		$iframe.css('width', '').css('height', '');
		var w = $(iframe.contentDocument).find('.basket_cart').outerWidth(true);
		if ($(iframe.contentDocument).find('.bktContent').outerWidth(true) > w)
			w = $(iframe.contentDocument).find('.bktContent').outerWidth(true);
		$iframe.css('width', (w + margin) + 'px');
		$iframe.css('height', $(iframe.contentDocument).find('.basket_cart').outerHeight(true) + 'px');
	}
	setCartMaxHeight($container);
}

function setCartMaxHeight($container) {
	var $basketContent = $container.find('.basket_cart');
	if ($basketContent.length > 0) {
		var top = $basketContent.offset().top;
		var maxH = $(window).height() - top - $('#footer').height();
		if ($basketContent.height() >= maxH)
			$basketContent.css('padding-right', '20px'); //scroll bar
		$basketContent.css('max-height', maxH + 'px').css('overflow', 'auto');
	}
	else if ($container.data('iframe') && $container.find('iframe').length > 0) {
		var $iframe = $container.find('iframe');
		var iframeDoc = $iframe[0].contentDocument;
		$basketContent = $(iframeDoc).find('.basket_cart');
		$basketContent.css('max-height', '');
		var top = $container.offset().top;
		var maxH = $(upperWindow).height() - top - upperWindow.$('#footer').height();
		if ($basketContent.height() >= maxH)
			$iframe.css('width', ($iframe.width() + 20) + 'px'); //scroll bar
		$basketContent.css('max-height', maxH + 'px').css('overflow', 'auto');
	}
}

function refreshHeaderCart() {
	var $container = $('#' + __headerCartContainerID);
	if ($container.data('cartInit')) {
		var targetID = $container.data('targetID');
		if ($('#' + targetID).length > 0)
			$container = $('#' + targetID);

		var isVisible = $container.is(':visible');
		if ($container.data('iframe')) {
			$container.find('iframe').remove();
			$container.data('cartInit', false);
			if (isVisible)
				createHeaderCart(true, true);
		}
		else if ($container.find('.basket_cart').length > 0) {
			var up = $container.find('.basket_cart');
			if (up.attr('name'))
				this.TunedPostBack(up.attr('name'), 'basket_cart');
		}
	}
}

