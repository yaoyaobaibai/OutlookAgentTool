function handleChangeQty(event) {
	var dropdown = ivDropdownSelector.getDropdown(event.target);
	var value = dropdown.find('.search').val();
	var hidden = dropdown.find(ivDropdownSelector.selector.inputHidden);
	var oldValue = ivClient.get(hidden.attr('id'), 'value');
	if (value === "")
		value = oldValue;
	ivClient.set(hidden.attr('id'), ivClient.properties.data, "dataType", "uDouble");
	var datasource = ivDropdownSelector.getDataSource(dropdown);
	if (datasource.filter(function (ds) { return ds.pkval == value }).length == 0) {
		var newvalDatasource = {};
		newvalDatasource["pkval"] = value;
		newvalDatasource["label"] = value;
		datasource.push(newvalDatasource);
		ivDropdownSelector.setDatasource(dropdown, datasource, []);
	}
	dropdown.find('.search').val(value);
	ivClient.set(hidden.attr('id'), ivClient.properties.value, value);
	dropdown.find(ivDropdownSelector.selector.textboxDisplay).removeClass('filtered');
	dropdown.blur();
}

function handleBasketChange(event) {
	let newBasketId = caddy._ddlBasket.val();
	if (caddy._hdnBasketId.val().length == 0 || caddy._hdnBasketId.val() != newBasketId) {
		caddy.refreshBasket(newBasketId);
	}
}

$(document).ready(function () {
	$(document).on('change.basketcart', '.iv-mobile .qty-selector .search', handleChangeQty);
	$(document).on('change.basketcart', '.selector-control.basket_list .selector-hidden-field', handleBasketChange);
});