//resize catalog mosaic
var _catalogItemMinWidth = 280;
function CatalogListViewResize(lvClientID, repeatColumns) {
	var windowResizeEvent = false;
	if ($('#' + lvClientID).length == 0)
		return;
	if (window.event && window.event.type == 'resize' 
		|| (window.event && window.event.target && window.event.target instanceof XMLHttpRequest))
		windowResizeEvent = true;
	var minWidth = _catalogItemMinWidth;
	var minHeight = 100
	var scrollBarSize = 1;
	if (repeatColumns > 1) {
		if (windowResizeEvent) {
			var contentWidth = $('#content').width();
			if (contentWidth > 0) {
				$('#' + lvClientID).find('.swiper-container').css('width', lvWidth + 'px');
				$('#' + lvClientID).css('width', contentWidth + 'px');
			}
			$('#' + lvClientID).find('.pdt-listview-header').css('height', 'auto');
			//$('#' + lvClientID).find('.lv-item.inline, .pdt-listview-item, .pdt-listview-header, .pdt-listview-content, .pdt-listview-footer').css('width', 'auto');
			$('#' + lvClientID).find('.swiper-container').css('width', 'auto');
			$('#' + lvClientID).css('width', 'auto');
		}
		var lvWidth = $('#' + lvClientID).width();
		var webpartResize = false;
		if (this.webPart) {
			scrollBarSize = 15;
			var webPartContainer = $('#' + lvClientID).parents('.is_part');
			if (webPartContainer.length > 0) {
				webPartContainer.css('display', 'none');
				if (webPartContainer.parent().length > 0) {
					var cWidth = (webPartContainer.parent()[0].clientWidth ? webPartContainer.parent()[0].clientWidth : webPartContainer.parent().width()) - 15;
					if (cWidth > 0 && cWidth < lvWidth) {
						$('#' + lvClientID).find('.swiper-container').css('width', cWidth + 'px');
						$('#' + lvClientID).css('width', cWidth + 'px');
						lvWidth = cWidth;
					}
				}
				webPartContainer.css('display', '');
				webpartResize = true;
				minWidth = (!mobileMode ? 200 : 150);
			}
		}

		if (!webpartResize) {
			var $frame = $('#' + lvClientID).parents('.frame:first');
			if ($frame.length > 0) {
				$('#' + lvClientID).css('display', 'none');
				var cWidth = ($frame[0].clientWidth ? $frame[0].clientWidth : $frame.width());
				$('#' + lvClientID).css('display', '');
				if (cWidth > 0 && cWidth < lvWidth) {
					$('#' + lvClientID).find('.swiper-container').css('width', cWidth + 'px');
					$('#' + lvClientID).css('width', cWidth + 'px');
					lvWidth = cWidth;
				}
			}
			else if ($('#content').length > 0) {
				var cWidth = ($('#content')[0].clientWidth ? $('#content')[0].clientWidth : $('#content').width()) - 6;
				if (cWidth > 0 && cWidth < lvWidth) {
					$('#' + lvClientID).find('.swiper-container').css('width', cWidth + 'px');
					$('#' + lvClientID).css('width', cWidth + 'px');
					lvWidth = cWidth;
				}
			}
		}
		//lvWidth = lvWidth - scrollBarSize;
		$('#' + lvClientID).find('.swiper-container').css('width', lvWidth + 'px');
		$('#' + lvClientID).css('width', lvWidth + 'px');
		var lvMargin = $('#' + lvClientID + ' .lv-item.inline:first').outerWidth(true) - $('#' + lvClientID + ' .lv-item.inline:first').width();
		var itemWidth = Math.floor((lvWidth - (repeatColumns * lvMargin)) / repeatColumns);
		if (itemWidth < minWidth
			//&& !(modalMode && !windowResizeEvent)
			) { //fix width calculation for modal popup
			itemWidth = minWidth;
			$('#' + lvClientID).find('.swiper-container').css('width', (repeatColumns * (itemWidth + lvMargin)) + 'px');
			//$('#' + lvClientID).css('width', (repeatColumns * (itemWidth + lvMargin)) + 'px');
		}
		//$('#' + lvClientID).find('.lv-item.inline, .pdt-listview-item, .pdt-listview-header, .pdt-listview-content, .pdt-listview-footer').css('width', itemWidth + 'px');
			
		var headerHeight = 0;
		$('#' + lvClientID).find('table.pdt-listview-header').each(function () {
			var h = $(this).height();
			if (h > headerHeight) {
				headerHeight = h;
			}
		});
		if (headerHeight > 0)
			$('#' + lvClientID).find('table.pdt-listview-header').css('height', headerHeight + 'px');

		var contentHeight = 0;
		$('#' + lvClientID).find('.pdt-listview-content').each(function () {
			var h = $(this).outerHeight();
			if (h > contentHeight) {
				contentHeight = h;
			}
		});
		if (contentHeight > 0)
			$('#' + lvClientID).find('.pdt-listview-content').css('height', contentHeight + 'px');

		var $content = $('#' + lvClientID).find('.pdt-listview-content:first');
		var wForm = 0;
		var formCount = 0;
		$content.find('td.form').each(function () {
			var w = $(this).width();
			if (w > wForm)
				wForm = w;
			formCount++;
		});
		var wInfo = $content.width() - (formCount * wForm);
		var infoCount = $content.find('.txt-info').length;
		if (infoCount > 0)
			$('#' + lvClientID).find('.pdt-listview-content .txt-info').css('width', (wInfo / infoCount) + 'px');
	}
	else {
		//$('#' + lvClientID).find('.lv-item.inline').css('width', 'auto');
		//$('#' + lvClientID).find('.swiper-container').css('width', 'auto');
		//$('#' + lvClientID).css('width', 'auto');
		var itemWidth = 0;
		$('#' + lvClientID).find('.lv-item.inline').each(function () {
			var w = $(this).width();
			if (w > itemWidth)
				itemWidth = w;
		});
		if (itemWidth < minWidth)
			itemWidth = minWidth;
		//$('#' + lvClientID).find('.lv-item.inline, .pdt-listview-item, .pdt-listview-header, .pdt-listview-content, .pdt-listview-footer').css('width', itemWidth + 'px');
	}
}

