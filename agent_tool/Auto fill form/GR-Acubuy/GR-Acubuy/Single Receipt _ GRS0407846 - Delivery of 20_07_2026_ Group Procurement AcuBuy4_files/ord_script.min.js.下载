var $ivOrd = $ivOrd || {};

$.extend($ivOrd, {
	isPriceConditionsActivated: false,
	totalTaxesSelector: '.totaltaxes-amount input',
	txtTotalAmountID : null,
	txtTotalHTAmountID: null,
	tvaMode: null,
	currencyScale: null,
	productItemId: null,
	msTimer: 500,

	updateNewTaxLineOnChange: function (new_id) {
		if(new_id==undefined)
			new_id = $ivOrd.getNewTaxLineId();
		var ctrl_id = ivClient.get($('tr [new_id="' + new_id + '"] .taxable-amount'), ivClient.properties.id);
		__ivHtmlControls[ctrl_id].onChange = __ivHtmlControls[ctrl_id].onChange.replace(/new_object/g, 'tr_' + -new_id);
	},
	getNewTaxLineId: function () {
		var grdTva = $('.grdTvaUpdate');
		var new_id = $('#' + $('#' + grdTva.attr('id')).find('.insert:first').attr('newObjectIds')).val().split(',')[0];
		return new_id;
	},
	changeTaxableEvent: function (ctrl) {
		var taxableCtrl = $('#'+ctrl);
		var $taxLine = taxableCtrl.closest('.tax-line');
		var taxAmountCtrl = $taxLine.find(".tax-line-amount");
		var taxCodeCtrl = $taxLine.find(".tax-line-code");
		var tvaCode = ivClient.get($(taxCodeCtrl).find('[data-tva-code]'), ivClient.properties.value);
		var taxable = ConvertTo(ivClient.get(taxableCtrl, ivClient.properties.value), 'double');
		var taxAmountCtrlCurrencyScale = taxAmountCtrl.find("div").hasClass("has_currency_scale");

		var taxValue = parseFloat(dicTaxValues[tvaCode]['tva_value'].replace(',', '.')) / 100.0;
		var isWht = dicTaxValues[tvaCode]['is_wht'];
		var whtValue = 0;
		if (isWht)
			whtValue = parseFloat(dicTaxValues[tvaCode]['wht_value'].replace(',', '.')) / 100.0;
		var newTaxAmount = $ivOrd.arrondi(taxable * taxValue, taxAmountCtrlCurrencyScale);
		if (whtValue != 0)
			newTaxAmount -= $ivOrd.arrondi(taxable * whtValue, taxAmountCtrlCurrencyScale);

		ivClient.set($(taxAmountCtrl).find('[data-price-entry]'), ivClient.properties.value, $ivOrd.formatPrecision(newTaxAmount, taxAmountCtrlCurrencyScale));
	},
	updateTVAAmount: function (txtTotalAmountID, txtTotalHTAmountID) {
		updateArrayTVA();
		var totalTTCCtrl = $("#" + txtTotalAmountID);
		if (ConvertTo($('#' + txtTotalHTAmountID).val(), 'Double') == '')
			var total = 0;
		else
			var total = parseFloat($ivOrd.removeNumberFormatToDefault(ConvertTo($('#' + txtTotalHTAmountID).val(), 'Double')));
		var totalTTCCtrlCurrencyScale = totalTTCCtrl.parent("div").hasClass("has_currency_scale");
		var totalTTC = total;
		var taxRateOK = true;
		for (var tvaIndex in AmountTaxCtrlsId) {
			var taxAmountCtrl = $('#' + AmountTaxCtrlsId[tvaIndex]);
			var taxRateCtrl = $('#' + TaxCtrlsId[tvaIndex]);
			var taxRate = getInvoiceTaxRate(taxRateCtrl);
			if (taxRate !== 1) {
				var whtRate = 0;
				var tvaCode = $(taxRateCtrl[0]).val();
				var isWht = false;
				if (tvaCode != undefined && tvaCode != '')
					isWht = dicTaxValues[tvaCode]['is_wht'];
				if (isWht)
					whtRate = parseFloat(dicTaxValues[tvaCode]['wht_value'].replace(',', '.'))/100;
				var taxableAmountCtrl = $('#' + TaxableAmountCtrlsId[tvaIndex]);
				if (ConvertTo(ivClient.get(taxableAmountCtrl, ivClient.properties.value), 'Double') == '')
					var taxableAmount = 0;
				else
					var taxableAmount = parseFloat($ivOrd.removeNumberFormatToDefault(ConvertTo(ivClient.get(taxableAmountCtrl, ivClient.properties.value), 'Double')));
				var amount = taxableAmount ? taxableAmount : total;
				var amountTacCtrlCurrencyScale = taxAmountCtrl.parent("div").hasClass("has_currency_scale");
				var taxAmount = $ivOrd.arrondi(taxRate * amount, amountTacCtrlCurrencyScale);
				if (isWht)
					taxAmount -= $ivOrd.arrondi(whtRate * amount, amountTacCtrlCurrencyScale);
				totalTTC += taxAmount;
				ivClient.set(taxAmountCtrl, ivClient.properties.value, $ivOrd.formatPrecision(taxAmount, amountTacCtrlCurrencyScale));
			} else
				taxRateOK = false;
		}
		if (taxRateOK)
			ivClient.set(totalTTCCtrl, ivClient.properties.value, $ivOrd.formatPrecision(totalTTC, totalTTCCtrlCurrencyScale));
	},
	updateTVAAmounTTC: function (txtTotalAmountID, txtTotalHTAmountID) {
		updateArrayTVA();
		var totalHTCtrl = $("#" + txtTotalHTAmountID);
		var totalHTCtrlCurrencyScale = totalHTCtrl.parent("div").hasClass("has_currency_scale");
		var taux = 0;
		for (var tvaIndex in AmountTaxCtrlsId) {
			var tauxCtrl = $('#' + TaxCtrlsId[tvaIndex]);
			var taxRate = getInvoiceTaxRate(tauxCtrl);
			if (taxRate !== 1) {
				taux += taxRate;
				var tvaCode = $(tauxCtrl[0]).val();
				var isWht = false;
				if (tvaCode != undefined && tvaCode != '')
					isWht = dicTaxValues[tvaCode]['is_wht'];
				var whtRate = 0;
				if (isWht)
					whtRate = parseFloat(dicTaxValues[tvaCode]['wht_value'].replace(',', '.')) / 100;
				taux -= whtRate;
			}
		}
		if (ConvertTo($('#' + txtTotalAmountID).val(), 'Double') == '')
			var total = 0;
		else
			var total = parseFloat($ivOrd.removeNumberFormatToDefault(ConvertTo($('#' + txtTotalAmountID).val(), 'Double')));
		var totalHT;
		if (taux != 0)
			totalHT = total / (1 + taux);
		else
			totalHT = total;
		for (var tvaIndex in AmountTaxCtrlsId) {
			var TVACtrl = $('#' + AmountTaxCtrlsId[tvaIndex]);
			var tauxCtrl = $('#' + TaxCtrlsId[tvaIndex]);
			var taux = getInvoiceTaxRate(tauxCtrl);
			if (taux !== 1) {
				var tvaCode = $(tauxCtrl[0]).val();
				var isWht = false;
				if (tvaCode != undefined && tvaCode != '')
					isWht = dicTaxValues[tvaCode]['is_wht'];
				var amountTacCtrlCurrencyScale = TVACtrl.parent("div").hasClass("has_currency_scale");
				var taxAmount = $ivOrd.arrondi(taux * totalHT, amountTacCtrlCurrencyScale);
				if (isWht) {
					var whtRate = parseFloat(dicTaxValues[tvaCode]['wht_value'].replace(',', '.')) / 100;
					var whtAmount = $ivOrd.arrondi(whtRate * totalHT, amountTacCtrlCurrencyScale);
					taxAmount -= whtAmount;
				}
				ivClient.set(TVACtrl, ivClient.properties.value, $ivOrd.formatPrecision(taxAmount, amountTacCtrlCurrencyScale));
			}
		}
		ivClient.set(totalHTCtrl, ivClient.properties.value, $ivOrd.formatPrecision(totalHT, totalHTCtrlCurrencyScale));
	},
	updateTotalTaxesAmount: function (deletedLine) {
		updateArrayTVA(deletedLine);
		var oldTotalTaxesCtrl = $($ivOrd.totalTaxesSelector);
		var newTotalTaxesCtrl = 0;
		var totalTaxesCtrlCurrencyScale = oldTotalTaxesCtrl.parent("div").hasClass("has_currency_scale");

		for (var tvaIndex in AmountTaxCtrlsId) {
			if (ConvertTo(ivClient.get(AmountTaxCtrlsId[tvaIndex], ivClient.properties.value), 'Double') != '')
				newTotalTaxesCtrl += parseFloat($ivOrd.removeNumberFormatToDefault(ConvertTo(ivClient.get(AmountTaxCtrlsId[tvaIndex], ivClient.properties.value), 'Double'))); //
		}
		ivClient.set(oldTotalTaxesCtrl, ivClient.properties.value, $ivOrd.formatPrecision(newTotalTaxesCtrl, totalTaxesCtrlCurrencyScale));
	},
	updateTotalAmount: function (txtTotalAmountID, txtTotalHTAmountID) {
		if (ConvertTo(ivClient.get(txtTotalHTAmountID, ivClient.properties.value), 'Double') == '')
			var totalTTC = 0;
		else
			var totalTTC = parseFloat($ivOrd.removeNumberFormatToDefault(ConvertTo(ivClient.get(txtTotalHTAmountID, ivClient.properties.value), 'Double'))); //
		var totalTTCCtrl = $("#" + txtTotalAmountID);
		var TotalTaxesCtrl = $($ivOrd.totalTaxesSelector);
		var totalTTCCtrlCurrencyScale = totalTTCCtrl.parent("div").hasClass("has_currency_scale");

		if (ConvertTo(ivClient.get(TotalTaxesCtrl, ivClient.properties.value), 'Double') != '')
			totalTTC += parseFloat($ivOrd.removeNumberFormatToDefault(ConvertTo(ivClient.get(TotalTaxesCtrl, ivClient.properties.value), 'Double')));
		ivClient.set(totalTTCCtrl, ivClient.properties.value, $ivOrd.formatPrecision(totalTTC, totalTTCCtrlCurrencyScale));
	},
	updateHTAmount: function (txtTotalAmountID, txtTotalHTAmountID) {
		if (ConvertTo($('#' + txtTotalAmountID).val(), 'Double') == '')
			var totalHT = 0;
		else
			var totalHT = parseFloat($ivOrd.removeNumberFormatToDefault(ConvertTo($('#' + txtTotalAmountID).val(), 'Double')));
		var totalHTCtrl = $("#" + txtTotalHTAmountID);
		var TotalTaxesCtrl = $($ivOrd.totalTaxesSelector);
		var totalHTCtrlCurrencyScale = totalHTCtrl.parent("div").hasClass("has_currency_scale");

		if (ConvertTo(ivClient.get(TotalTaxesCtrl, ivClient.properties.value), 'Double') != '')
			totalHT -= parseFloat($ivOrd.removeNumberFormatToDefault(ConvertTo(ivClient.get(TotalTaxesCtrl, ivClient.properties.value), 'Double')));
		ivClient.set(totalHTCtrl, ivClient.properties.value, $ivOrd.formatPrecision(totalHT, totalHTCtrlCurrencyScale));
	},
	updateTotalAmountDelete: function (txtTotalAmountID, txtTotalHTAmountID) {
		var deletedLine = $(event.target).parents('tr:first').attr('id');
		$ivOrd.updateTotalTaxesAmount(deletedLine);
		$ivOrd.updateTotalAmount(txtTotalAmountID, txtTotalHTAmountID);
	},
	updateDueDate: function ($payTerm, dueDate, $invDate, isExtranet) {
		// Do not initialize/udpate the due date if no payment terms are selected
		if (ivClient.get($payTerm, ivClient.properties.value) == '')
			return;

		if (!ivCallMethod.updateDueDate) {
			ivCallMethodHandler.prototype.updateDueDate = function (invD, payTerm) {
				this.invoke(ivScope.AjaxUrl("ord", "invoice_manage_tab" + (isExtranet ? "_extranet" : ""), null, "methodname=GetDueDateFromPayTerm"), { invD: invD, payTerm: payTerm },
					$ivOrd.selectDueDate, null, dueDate);
			};
		}
		ivCallMethod.updateDueDate($invDate.val(), $payTerm.val());
	},
	selectDueDate: function (dueDateVal, dueDateId) {
		ivClient.set(dueDateId, ivClient.properties.value, new Date(ConvertToDate(dueDateVal))); 
	},

	formatPrecision: function (val, hasCurrencyScale) {
		var currentPrecision = 2;
		if (hasCurrencyScale && $ivOrd.currencyScale != null)
		currentPrecision = $ivOrd.currencyScale;
		else if (decimalPrecision)
			currentPrecision = decimalPrecision;
		return FormatValue(val, currentPrecision);
	},

	arrondi: function (val, hasCurrencyScale) {
		// Same method in expense_item_manage_script.js, invoice_item_line_browse_script.js and inv_dyn_calculation_script.js.
		// Will be factorized in v176.

		// Fix needed because of a calculation default due to the internal representation of floating-points number:
		// in JS: 36.925 * 100 = 3692.4999999999995 and not 3692.5
		return ConvertTo($ivOrd.formatPrecision(Math.round(val + "e+10") + "e-10", hasCurrencyScale), 'double');
	},

	removeNumberFormatToDefault: function (strFormattedNumber) {
		// Remove all spaces
		strFormattedNumber = strFormattedNumber.split(' ').join('');
		//WE NEED TO REMOVE JUST THE NUMBER GROUP SEPARATOR AND CHANGE THE DECIMAL ONE FOR '.'. Then we can parse it to native Float.
		if (!strFormattedNumber)
			return '';
		strFormattedNumber = strFormattedNumber.split(ivScope.UserNumberFormat.NumberGroupSeparator).join('');
		//Now we replace the decimal separator by '.'
		strFormattedNumber = strFormattedNumber.replace(ivScope.UserNumberFormat.NumberDecimalSeparator, '.');

		return strFormattedNumber;
	},

	updateTaxableAmount: function (taxableAmounts, iitemid, taxid, value) {
		if (taxableAmounts[iitemid] == undefined)
			taxableAmounts[iitemid] = new Array();
		taxableAmounts[iitemid][taxid] = value;
	},

	updateTotalAmountWithoutPriceConditions: function () {
		// Update total amount
		var itemUnitPrice = ConvertTo(ivClient.get($(".update-total-on-change-field-unit-price"), ivClient.properties.value), "double");
		var itemQuantity = ConvertTo(ivClient.get($(".update-total-on-change-field-quantity"), ivClient.properties.value), "double");
		var discountPercent = ConvertTo(ivClient.get($(".update-total-on-change-field-discount-percent"), ivClient.properties.value), "double");
		var newTotal = itemQuantity * (itemUnitPrice - (discountPercent * itemUnitPrice / 100));

		$ivOrd.updateScaledRoundedTotalAmountAndAllocationAmounts(newTotal);
	},

	updateScaledRoundedTotalAmountAndAllocationAmounts: function (newTotalAmount) {
		var $totalTaxExclField = $(".totalht-amount input");
		var totalAmountCtrlCurrencyScale = $totalTaxExclField.parent("div").hasClass("has_currency_scale");
		var t = ivDynamicCalculation.arrondi(newTotalAmount, totalAmountCtrlCurrencyScale);
		var new_value = ivDynamicCalculation.formatPrecision(t, totalAmountCtrlCurrencyScale);

		ivClient.set(ivClient.get($totalTaxExclField, ivClient.properties.id), ivClient.properties.value, new_value);

		// Update allocation amounts based on percentages
		if (typeof (ivAllocationControl) != 'undefined')
			ivAllocationControl.updateAllocationAmounts();
	},


	// delay KeyUp event (Update Total Amount With/Without Price Conditions)
	delayKeyUp: function (callback, ms) {
		var timer = 0;
		return function () {
			var context = this,
				args = arguments;
			clearTimeout(timer);
			timer = setTimeout(function () {
				callback.apply(context, args);
			}, ms || 0);
		};
	}

});


$(function () {

	if (!$ivOrd.isPriceConditionsActivated) {

		$(document).off("keyup.item")
				   .on("keyup.item", ".update-total-on-change-field", $ivOrd.delayKeyUp(function (e) {

				var prQuantity = ConvertTo(ivClient.get($(".update-total-on-change-field-quantity"), ivClient.properties.value), "double");
				if (!$.isNumeric(prQuantity))
					return; 

				// Update Total Amount without Price Conditions
				$ivOrd.updateTotalAmountWithoutPriceConditions();

				var quantityClientId = ivClient.get($(".update-total-on-change-field-quantity"), ivClient.properties.id);
				var unitPriceClientId = ivClient.get($(".update-total-on-change-field-unit-price"), ivClient.properties.id);

				// Update Price according to the new Quantity
				if ($ivOrd.productItemId && e.target.id === quantityClientId)
					__doPostBack(unitPriceClientId);

	    }, $ivOrd.msTimer));
	}
});