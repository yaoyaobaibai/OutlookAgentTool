var ivShoppingCart = ivShoppingCart || {};
$.extend(ivShoppingCart, {
	counterItemSelector: '.basket_cart_link_container .counter-item',
	updateItemCount: function (nb_item) {
		var
			value = Nbr(nb_item),
			$shoppingCart = $('.iv-shopping-cart'),
			$badge = ivClient.get($shoppingCart, ivClient.properties.role, ivClient.roles.additionalLabel);

		if ($shoppingCart.length > 0) {
			if (value) {
				$badge.removeClass(ivClient.cssClass.hidden);
				if (value > 99) {
					nb_item = '99+';
				}
				ivClient.set($shoppingCart, ivClient.properties.additionalLabel, nb_item);
			}
		else {
				$badge.addClass(ivClient.cssClass.hidden);
				ivClient.set($shoppingCart, ivClient.properties.additionalLabel, '');
			}
		}
	}
});