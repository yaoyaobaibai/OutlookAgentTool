String.prototype.escapeHTML = function () {
	return this.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
};

String.prototype.unescapeHTML = function () {
	return this.replace(/<\/?[^>]+>/gi, '').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>');
};

String.prototype.format = function () {
	var txt = this,
		i = arguments.length;
	var args = arguments;
	if (i === 1 && Array.isArray(arguments[0])) {
		args = arguments[0];
		i = args.length;
	}
	while (i--) {
		txt = txt.replace(new RegExp('\\{' + i + '\\}', 'gm'), args[i]);
	}
	return txt.toString();
};

Date.prototype.getNbDaysInMonth = function () {
	var d = new Date(this.getFullYear(), this.getMonth() + 1, 0);
	return d.getDate();
};

RegExp.escape = function (s) {
	return s.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
};