/*
 * Ivalua Guides (DAP)
 *
 * Note that back-end files and ajax methods might refer 'guide' as 'flow' since we started
 * with that naming convention. The labels for users were later modified to use 'guide'.
 * So, 'flow' and 'guide' mean the same thing. Similarly, 'flow step' and 'guide step' are same.
 * E.g. FlowService refers to the service layer for 'Guide'
 */
(function () {

	'use strict';

	let ivGuide = window.ivGuide || {};

	window.ivGuide = ivGuide;

	/*
	 * Configuration for the ivGuide
	 */
	const appConfig = {
		/*
		 * Query string to pass along for the configuration context modal
		 * so that we can link back to enter Guide Studio
		 */
		queryStringEnterGuideStudio: 'enter_guide_studio_after_ctx',
		/*
		 * Guide flow guid
		 */
		queryStringGuideStart: 'guide_start',
		/*
		 * Guide referral system like ivalua_academy
		 */
		queryStringGuideRef: 'guide_ref',
		/*
		 * For ivalua academy learning object id
		 */
		queryStringGuideLoId: 'guide_lo_id',
		/*
		 * These are guide pages where we exclude the Guide Studio. 
		 * We don't want Guide Studio to show up.
		 */
		excludePages: ['/dap/flow_step_manage', '/dap/flow_manage'],
		/*
		 * CSS classes for the DAP guides that is used to identify what state are we in
		 * on the load of the application. 
		 * We're able to tell if we're in 'Guide Studio' v/s 'Guide Player' etc.
		 */
		cssClassNames: {
			/*
			 * Guide studio
			 */
			guideStudio: 'dap-guide-studio',
			/*
			 * Guide player for the end user
			 */
			guidePlayer: 'dap-guide-player'
		},
		/*
		 * Text codes for the text table
		 */
		textCodes: {
			cancel: 'cancel',
			next: 'next',
			prev: 'prev',
			yes: 'yes',
			no: 'no',
			close: 'Close',
			plus: 'plus',
			minus: 'minus',
			dapGuideStudioNotEditableTitle: 'dap_guide_studio_not_editable_title',
			dapGuideStudioNotEditableDesc: 'dap_guide_studio_not_editable_desc',
			dapGuideStudioUnpublish: 'dap_guide_studio_unpublish',
			dapGuideStudioPlusInfo: 'dap_guide_studio_plus_info',
			dapGuidePlayerWelcomeTitle: 'dap_guide_player_welcome_title',
			dapGuidePlayerWelcomeDesc: 'dap_guide_player_welcome_desc',
			dapGuidePlayerWelcomeStart: 'dap_guide_player_welcome_start',
			dapGuidePlayerRunningTitle: 'dap_guide_player_running_title',
			dapGuidePlayerRunningDesc: 'dap_guide_player_running_desc',
			dapGuidePlayerExit: 'dap_guide_player_exit',
			dapGuidePlayerExitTitle: 'dap_guide_player_exit_title',
			dapGuidePlayerExitDesc: 'dap_guide_player_exit_desc',
			dapGuidePlayerSkipDesc: 'dap_guide_player_skip_desc',
			dapGuidePlayerCongraTtile: 'dap_guide_player_congra_title',
			dapGuidePlayerCongraDesc: 'dap_guide_player_congra_desc',
			dapGuidePlayerReasonNext: 'dap_guide_player_reason_next',
			dapGuidePlayerReasonRuleEmpty: 'dap_guide_player_reason_rule_empty',
			dapGuidePlayerReasonRuleEqual: 'dap_guide_player_reason_rule_equal',
			dapGuidePlayerComplete: 'dap_guide_player_complete',
			dapGuidePlayerProgressStep: 'dap_guide_player_progress_step',
			dapGuidePlayerProgressOutOf: 'dap_guide_player_progress_out_of'
		},
		/*
		 * This is direction we want to move if we don't find the current step
		 */
		directionToMove: {
			prev: 'prev',
			next: 'next'
		},
		/*
		 * Prefix for certain control identifier we want to use.
		 */
		ctrlIdentifierPrefix: {
			/*
			 * Main navigation top
			 */
			mainNavTop: 'main-nav-top|',
			/*
			 * Main navigation sub menu
			 */
			mainNavSub: 'main-nav-sub|',
			/*
			 * Grid control
			 */
			grid: 'grid|',
			/*
			 * DCC table
			 */
			dccTable: 'dcc-table|',
			/*
			 * Button contextual menu item
			 */
			buttonContextMenuItem: 'button-context-menu-item|',
			/*
			 * This is the prefix that is used to determine if the control is part of the header.
			 * The prefix is generated automatically by the platform for all controls inside the header.
			 */
			header: 'header_'
		},
		/*
		 * Step completion type
		 */
		stepComplType: {
			next: 'next',
			rule: 'rule'
		},
		/*
		 * Step completion rule operators
		 */
		stepRuleOper: {
			empty: 'not_empty',
			equal: 'equal_to'
		},
		/*
		 * These are the names used for the ivControl type in platform. These are also used in attribute 'data-iv-control'
		 */
		ivControlTypeName: {
			buttonControl: 'buttonControl',
			checkBoxControl: 'checkBoxControl',
			grid: 'grid',
			imageControl: 'imageControl',
			searchBoxControl: 'searchBoxControl',
			selectorControl: 'selectorControl',
			tabPageControl: 'tabPageControl',
			textBoxControl: 'textBoxControl'
		},
		/*
		 * These controls will be setup for auto next onclick.
		 */
		autoNextOnClickControlNames: [
			'buttonControl',
			'imageControl',
			'tabPageControl'
		],
		/*
		 * These controls will be setup for auto next onchange.
		 */
		autoNextOnChangeControlNames: [
			'checkBoxControl',
			'searchBoxControl',
			'selectorControl',
			'textBoxControl'
		]
	}

	/*
	 * State of the ivGuide
	 */
	let appState = {
		guideStudio: {
			/*
			 * Div that has the action buttons for add step
			 */
			divAction: null,
			/*
			 * Button for the add step
			 */
			divActionBtnAdd: null
		},
		/*
		 * Store current FlowStepGuid value
		 */
		currentFlowStepGuid: null,
		/*
		 * True if user is using the reselect action for a given flow step in Guide Studio. 
		 */
		isReselectStepCtrl: false,
		/*
		 * True if the selected guide is editable in Guide Studio
		 */
		isGuideStudioGuideEditable: false,
		/*
		 * This is the last selected control.
		 * 
		 */
		$lastSelectedCtrl: null,
		/*
		 * This is the DAP box setup to outline the control. This is only used for the controls.
		 * The navigation will use the border for the navigation list items.
		 * This is the reference to the 'four' div that is used to build the box.
		 * This is used for both 'Guide Studio' and 'Guide Player' but with different styling.
		 */
		guideBoxFourSides: {
			divTop: null,
			divBottom: null,
			divLeft: null,
			divRight: null
		},
		/*
		 * This is the desired current page URL to use for the flow step.
		 * This is what we will use to store for the flow step page URL.
		 * e.g. /buy/homepage/adm?q1=v1&q2=v2 => /buy/homepage/adm
		 * e.g. /ctr/contract_manage/123 => /ctr/contract_manage
		 */
		currentPageDesiredPageUrl: '',
		/*
		 * For the modal mode, we also want the parent page URL
		 */
		currentParentPageDesiredPageUrl: '',
		/*
		 * The previous 'setInterval id' for the keep watching.
		 * We want to clear this after we are done/reset.
		 */
		keepWatchingSetIntervalId: null,
		/*
		 * This is the current step control
		 */
		$stepCtrl: null,
		/*
		 * True if the current step is AutoPostBack
		 */
		isStepAutoPostBack: false,
		/*
		 * If true we are auto moving to next step
		 * E.g. for 'textBoxControl' we will auto move to next step
		 */
		isStepAutoMoveProcessing: false,
	};

	/*
	 * IvGuide
	 */
	$.extend(ivGuide, {
		/*
		 * Initialize the application
		 */
		init: function () {

			appState.currentPageDesiredPageUrl = this.getCurrentDesiredPageUrl();
			appState.currentParentPageDesiredPageUrl = this.getCurrentParentDesiredPageUrl();

			setupWelcomeMsgHtml();
			setupExitMsgHtml();
			setupCongratulationMsgHtml();
			setupGuideAlreadyRunningMsgHtml();
			setupGuideNotEditableMsgHtml();
			setupFlowStepIncrDecrButton();

			var guideToStartFlowGuid = getAnyDirectLinkToStartGuide();

			appState.guideBoxFourSides = createGuideBox(ivGuide.isGuideStudio());

			if (modalMode) {

				if (upperWindow.ivGuide.getIsReselectStepCtrl()) {
					appState.isReselectStepCtrl = upperWindow.ivGuide.getIsReselectStepCtrl();
				}

				appState.currentFlowStepGuid = upperWindow.ivGuide.getCurrentFlowStepGuid();
			}

			if (ivGuide.isGuideStudio()) {

				/*
				 * Guide Studio
				 */

				flowSessionService.isGuideStudioGuideEditable().then((isEditable) => {

					appState.isGuideStudioGuideEditable = isEditable;

					if (appState.isGuideStudioGuideEditable) {

						setupGuideStudioMouseOverHandler();
						setupGuideActionDiv();
						setupHandlerForMainNavForGuideStudio();

						// show popup on navigation for guide studio
						showPopupOnNavigate();

						displayPlusButtonInfoMsg();

					} else {

						showGuideNotEditableMsg();
					}

				}, (error) => {

				});

			} else if (guideToStartFlowGuid) {

				// Check for any referral from external system if any
				flowSessionService.addSessionDataForExternalSystem().then(() => {
					ivGuide.startGuidePlayer(guideToStartFlowGuid);
				});
			}
			else if (ivGuide.isGuidePlayer()) {

				/*
				 * Guide Player
				 */
				continueGuide();
			} else {

				/*
				 * Check if we've any guide to auto start for this page.
				 */
				var autoStartGuideFlowGuid = this.getAutoStartGuideForPage();

				if (autoStartGuideFlowGuid) {
					ivGuide.startGuidePlayer(autoStartGuideFlowGuid);
				}
			}
		},
		/*
		 * Enter the guide studio.
		 */
		enterGuideStudio: function () {

			// We want to make sure that they have selected the context or else we will show the context modal
			if (ivScope.hasConfigurationContext || ivScope.snpContextCheckExclusionEnable) {
				ivGuide.toggleGuideStudio();
			} else {

				const queryString = 'modal=true&' + appConfig.queryStringEnterGuideStudio + '=1'

				window.modalPopup({
					url: window.ivScope.ModalUrl('snp', 'configuration_context_manage', null, queryString),
					autoOpen: 'true'
				});
			}

			return false;
		},
		/*
		 * Exit the guide studio.
		 */
		exitGuideStudio: function () {
			ivGuide.toggleGuideStudio();
		},
		/*
		 * True if we're using the guide studio.
		 */
		isGuideStudio: function () {

			for (let i = 0; i < appConfig.excludePages.length; i++) {
				if (document.location.pathname.indexOf(appConfig.excludePages[i]) >= 0) {
					return false;
				}
			}

			return document.body.classList.contains(appConfig.cssClassNames.guideStudio);
		},
		/*
		 * True if we're using the guide player
		 */
		isGuidePlayer: function () {
			return document.body.classList.contains(appConfig.cssClassNames.guidePlayer);
		},
		/*
		 * Get current desired page url
		 * e.g. /ctn/document_browse/?use_case=main_page_ctr
		 * e.g. /buy/homepage/adm
		 */
		getCurrentDesiredPageUrl: function () {
			return document.body.getAttribute('dap-page');
		},
		/*
		 * Get current parent desired page url
		 * This is the parent page of the modal where we are in
		 */
		getCurrentParentDesiredPageUrl: function () {
			return upperWindow.document.body.getAttribute('dap-page');
		},
		/*
		 * Get guid for the auto start guide for this page if any
		 */
		getAutoStartGuideForPage: function () {
			return document.body.getAttribute('dap-auto-start');
		},
		/*
		 * Toggle the guide studio.
		 * If we are already in guide studio then we will get out.
		 */
		toggleGuideStudio: function () {

			let url = ivScope.AjaxUrl("dap", "ajax_method", null, "methodname=ToggleGuideStudio");

			let param = null;

			ivCallMethod.invoke(url, param, function (result) {
				location.reload();
			}, function () {

			});
		},
		/*
		 * Add or edit a flow step
		 *
		 * @flowStepGuid - If provided then we will consider this as edit step. Provide null or else.
		 */
		showFlowStepManage: function (flowStepGuid) {

			appState.currentFlowStepGuid = flowStepGuid;

			var stepCtrlIdentifier = null;

			toggleDivActionVisibility(false);
			resetGuideBoxState();
			resetGuideBorderState();

			let queryString = null;

			if (appState.$lastSelectedCtrl) {

				stepCtrlIdentifier = getCtrlIdentifier();

				const $ctrl = getStepCtrlObj(stepCtrlIdentifier);

				queryString = 'step_page_url_arg=' + appState.currentPageDesiredPageUrl
					+ '&step_ctrl_identifier_arg=' + stepCtrlIdentifier
					+ '&is_reselect_step_ctrl=' + appState.isReselectStepCtrl;

				if (modalMode) {
					// This is the upperWindow page
					queryString += '&step_parent_page_url_arg=' + appState.currentParentPageDesiredPageUrl;
				}

				const ctrlTypeName = ivControlUtility.getControlTypeName($ctrl);

				if (ctrlTypeName) {

					queryString += '&step_ctrl_type_arg=' + ctrlTypeName;

					if (ivControlUtility.getControlTypeName($ctrl) == appConfig.ivControlTypeName.selectorControl) {

						const selectorCode = ivControlUtility.getSelectorCode($ctrl);

						if (selectorCode) {
							queryString += '&step_ctrl_sel_code_arg=' + selectorCode;
						}
					}
				}
			}

			if (!flowStepGuid) {
				/*
				 * Add a step
				 */

				renderPopup(null, null, getCtrlIdentifier(), 'N/A', 'N/A', 'right center', 0, 0, false, 0, 0, 0, null, null, null, true, null, null);

				setTimeout(() => {

					// We want to keep menu open while we try to add step to have visual reference
					if (stepCtrlIdentifier && stepCtrlIdentifier.indexOf(appConfig.ctrlIdentifierPrefix.mainNavSub) >= 0) {
						openMainNavMenu($ctrl);
					}
				}, 50);
			}
			else {
				/*
				* Edit flow step or Reselect a control identifier
				*/

				ivGuide.showPopup(flowStepGuid, false, appConfig.directionToMove.next, stepCtrlIdentifier);
			}

			/*
			 * Also - bind the modalOnClose event handler to hide popup. 
			 * This is automatically cleared once executed.
			 */
			modalOnClose = () => {
				toggleDivActionVisibility(true);
				hideAllPopup();
			};

			// Must provide the flow_step_guid for the edit of step
			const pathInfo = [typeof (flowStepGuid) == 'undefined' ? null : flowStepGuid];

			window.modalPopup({
				url: ivScope.ModalUrl('dap', 'flow_step_manage', pathInfo, queryString),
				size: 'tiny'
			});
		},

		/*
		 * close the modal to select a new control identifier for the provided step
		 * 
		 * @isReselectStepCtrl - reselection mode status
		 */
		reselectStepControl: function (isReselectStepCtrl) {

			const currentStepGuid = ivGuide.getCurrentFlowStepGuid();

			let currentLayer = window;

			while (currentLayer) {

				// set the necessary values for the current layer
				currentLayer.ivGuide.setCurrentFlowStepGuid(currentStepGuid);
				currentLayer.ivGuide.setIsReselectStepCtrl(isReselectStepCtrl);

				// check if we are modal, if yes update reference or else get out
				if (currentLayer.modalMode) {
					currentLayer = currentLayer.upperWindow;

				} else {
					// we are on the main page now
					break;
				}
			}
		},

		/**
		 * Returns information about the reselection mode status
		 */
		getIsReselectStepCtrl: function () {
			return appState.isReselectStepCtrl;
		},

		/**
		 * Set information about the reselection mode status
		 *
		 * @flowStepGuid - This is the current step
		 */
		setIsReselectStepCtrl: function (isReselectStepCtrl) {
			appState.isReselectStepCtrl = isReselectStepCtrl;
		},

		/**
		 * Set information about the current step
		 *
		 * @flowStepGuid - This is the current step
		 */
		setCurrentFlowStepGuid: function (flowStepGuid) {
			appState.currentFlowStepGuid = flowStepGuid;
		},

		/**
		 * Returns information about the current step
		 */
		getCurrentFlowStepGuid: function () {
			return appState.currentFlowStepGuid;
		},

		/*
		 * Show popup for the provided step
		 * 
		 * @flowStepGuid - This is the step for which we want to show the popup
		 * @isToggle - If true we will have the visibility of the popup as toggle behavior. So, if it was already visible - we hide it.
		 * @directionToMoveIfMissing - either we move prev or next
		 * @stepCtrlIdentifier - The identifier for the target control. If provided, it will be used; otherwise, the step control identifier from the given 'flowStepGuid' flow step will be used.
		 */
		showPopup: function (flowStepGuid, isToggle, directionToMoveIfMissing, stepCtrlIdentifier) {

			if (flowStepGuid != null && flowStepGuid.length > 0) {

				flowStepService.getFlowStep(flowStepGuid).then(function (flowStep) {

					// Use the new stepCtrlIdentifier if provided since it is for reselect
					const stepCtrlIdentifierToUse = stepCtrlIdentifier ?? flowStep.stepCtrlIdentifier;

					/*
					 * Check if we need to navigate

					 * If a new stepCtrlIdentifier for target control is provided then we will not navigate since it is for reselect.
					 * If ctrl is top navigation menu, we do not need to navigate.
					 */
					if (appState.currentPageDesiredPageUrl !== flowStep.stepPageUrl
						&& (stepCtrlIdentifier ?? '').length == 0
						&& flowStep.stepCtrlIdentifier.indexOf(appConfig.ctrlIdentifierPrefix.mainNavTop) < 0
						&& flowStep.stepCtrlIdentifier.indexOf(appConfig.ctrlIdentifierPrefix.mainNavSub) < 0
						&& !flowStep.stepCtrlIdentifier.startsWith(appConfig.ctrlIdentifierPrefix.header)) {

						if (flowStep.stepParentPageUrl) {

							/*
							 * The step is potentially a modal page since it has a parent page url.
							 * If we're the parent page of the step, we just hide our box and do nothing.
							 * We expect the modal page to continue from there.
							 */
							if (appState.currentPageDesiredPageUrl == flowStep.stepParentPageUrl) {
								hideAllPopup();
								resetGuideBoxState();
							}

						} else if (modalMode && appState.currentParentPageDesiredPageUrl == flowStep.stepPageUrl) {

							upperWindow.ivGuide.resetGuideBoxState();

							if (ivControlUtility.isSelectorControlModal()) {
								// We do not want to automatically close modal if we are in selector 'see all' modal
								return;
							}

							/*
							 * We're a modal and we find that our step is in the parent page.
							 * We continue the guide in the parent page.
							 */

							hideAllPopup();
							resetGuideBoxState();

							upperWindow.ivGuide.showPopup(flowStepGuid, isToggle, directionToMoveIfMissing);

							// Close our modal too
							modalClose();

						} else {

							/*
							 * Or else since we're not on the right page - we will just go there
							 * and there is no guarantees that the control will be there.
							 */
							tryToNavigateToPage(() => {
								navigateToPage(flowStep.stepPageUrl, flowStep.flowStepGuid, flowStep.nextFlowStepGuid)
							});
						}

						return;
					}

					hideAllPopup();

					tryToFindCtrl(stepCtrlIdentifierToUse, () => {
						renderPopup(flowStep.flowGuid, flowStep.flowStepGuid, stepCtrlIdentifierToUse, flowStep.stepLabel, flowStep.stepDesc, flowStep.tooltipPosCss,
							flowStep.stepDistanceAway, flowStep.stepOffset, isToggle, flowStep.percentageCompleted, flowStep.myRank, flowStep.totalStep, flowStep.prevFlowStepGuid, flowStep.nextFlowStepGuid,
							flowStep.stepComplType, flowStep.stepShowNextBtn, flowStep.stepRuleOperCode, flowStep.stepRuleVal, directionToMoveIfMissing)
					});
				}).catch(function (error) {

				});
			}
		},
		/*
		 * We want to reposition and render the popup based on the changes on the 'flow_step_manage' page
		 * We expect the popup to be there since it's part of the 'edit/manage' button.
		 * This will use the value in 'flow step manage' UI (not database) to dynamically show render for position etc.
		 *
		 * @stepCtrlIdentifier - this is the identifier for the control.
		 */
		repositionPopup: function (stepCtrlIdentifier) {

			if (!stepCtrlIdentifier) {
				return;
			}

			const $ctrl = upperWindow.ivGuide.getStepCtrlObj(stepCtrlIdentifier);


			if ($ctrl.length == 1 && $ctrl.popup('get popup').length == 1) {

				const $txtTitle = $('[data-iv-control$="txtTitle"]');
				const $txtDesc = $('[data-iv-control$="txtDesc"]');
				const $selPosition = $('[data-iv-control$="selPosition"]');
				const $txtDistanceAway = $('[data-iv-control$="txtDistanceAway"]');
				const $txtOffset = $('[data-iv-control$="txtOffset"]');
				const $selCompletionType = $('[data-iv-control$="selCompletionType"]');
				const $chkShowNext = $('[data-iv-control$="chkShowNext"]');

				const title = ivClient.get($txtTitle)[Lang];
				const desc = ivClient.get($txtDesc)[Lang];

				// e.g. 'right_center'' => 'right center'' (maybe load the value on init and map against it)
				const position = ivClient.get($selPosition).replace(/_/g, " ");
				const stepDistanceAway = ivClient.get($txtDistanceAway) ? parseFloat(ivClient.get($txtDistanceAway)) : 0;
				const stepOffset = ivClient.get($txtOffset) ? parseFloat(ivClient.get($txtOffset)) : 0;
				const completionType = ivClient.get($selCompletionType);
				const showNext = ivClient.get($chkShowNext, ivCheckBox.properties.checked);

				upperWindow.ivGuide.updatePopupDetails($ctrl, title, desc, completionType, showNext);

				$ctrl.popup('setting', 'position', position);
				$ctrl.popup('setting', 'distanceAway', stepDistanceAway);
				$ctrl.popup('setting', 'offset', stepOffset);

				try {
					$ctrl.popup('reposition');
				} catch (e) {

				}
			}
		},
		/*
		 * Play the guide for the end user.
		 *
		 * @flowGuid - guid of the guide we want to play
		 */
		startGuidePlayer: function (flowGuid) {

			flowSessionService.getGuidePlayerFlowGuid().then((runningFlowGuid) => {

				if (runningFlowGuid) {
					showGuideAlreadyRunningMsg(runningFlowGuid, flowGuid);
				} else {
					showWelcomeMsg(flowGuid);
				}

			}).catch((error) => {

			});
		},
		/*
		 * Exit the guide player
		 *
		 * @flowGuid - Guid of the guide we are exiting
		 * @flowStepGuid - Guid of the guide step we are currently showing.
		 *					We need this to get back to it if user does not want to exit.
		 */
		exitGuidePlayer: function (flowGuid, flowStepGuid) {
			showExitMsg(flowGuid, flowStepGuid);
		},
		/*
		 * End guide player for the end user.
		 */
		endGuidePlayer: function () {

			hideAllPopup();
			resetGuideBoxState();
			resetGuideBorderState();

			flowSessionService.getGuidePlayerFlowGuid().then(function (flowGuid) {

				if (flowGuid && flowGuid.length > 0) {
					showCongratulationMsg(flowGuid);
				}

			}).catch(function (error) {

			});
		},
		/*
		 * Move to the next or previous guide step
		 * @flowStepGuid - this is the guide step where we want to go next
		 * @directionToMoveIfMissing - this is the direction we move if current step is missing. so, next or prev.
		 */
		moveToGuideStep: function (flowStepGuid, directionToMoveIfMissing) {

			resetAutoPostBackToOriginal(appState.$stepCtrl, appState.isStepAutoPostBack);

			if (appState.isStepAutoMoveProcessing) {
				// we are auto-moving to next step
				appState.isStepAutoMoveProcessing = false;
				return;
			}

			// reset - we are at the end there is no more steps so clear keep watching
			if (!flowStepGuid && appState.keepWatchingSetIntervalId) {
				clearInterval(appState.keepWatchingSetIntervalId);
				appState.keepWatchingSetIntervalId = null;
			}

			flowSessionService.setGuidePlayerFlowStepGuid(flowStepGuid).then(function () {

				if (flowStepGuid && flowStepGuid.length > 0) {
					ivGuide.showPopup(flowStepGuid, false, directionToMoveIfMissing);
				} else {
					// We're done
					ivGuide.endGuidePlayer();
				}

			}).catch(function (error) {

			});
		},
		/*
		 * Show the guide browse in modal to 'see all guides'
		 */
		seeAllGuide: function () {

			window.modalPopup({
				url: ivScope.ModalUrl('dap', 'flow_browse', null, null),
				size: 'medium'
			});
		},
		/*
		 * Reset the guide box state
		 */
		resetGuideBoxState: function () {
			resetGuideBoxState();
			resetGuideBorderState();
		},
		/*
		 * Get step control  for the stepCtrlIdentifier.
		 * This is the jQuery object instance.
		 * Depending on the 'stepCtrlIdentifier' we either have control or top navigation menu item.
		 *
		 * @stepCtrlIdentifier - this is the identifier used to find the control in the page.
		 */
		getStepCtrlObj: function (stepCtrlIdentifier) {
			return getStepCtrlObj(stepCtrlIdentifier);
		},
		/*
		 * Update the popup details for the title, content
		 * 
		 * @$ctrl - reference to the control that we're looking for the popup
		 * @title - title of the popup
		 * @content - content of the popup
		 * @completionType - this can be either with next or rule
		 * @showNext - if true we show the next button
		 */
		updatePopupDetails: function ($ctrl, title, content, completionType, showNext) {
