	/*
	 * We want to handle some events so as to ensure that we can keep the menu open
	 * while we are trying to use the plus button.
	 * This is specifically for the 'Guide Studio' where we care about the main nav being open while we try to add.
	 */
	function setupHandlerForMainNavForGuideStudio() {

		let $lastMainNavItem = null;

		// Prevent default behavior for top navigation
		setTimeout(() => {

			$(ivMenu.selector.main).off('mouseleave.menu')
				.off('mouseenter.menu');
		}, 1000);

		$(ivMenu.selector.main).on('mouseenter', ivMenu.selector.dropdown, (event) => {
			$lastMainNavItem = $(event.target);
		});

		/*
		 * We want to close the menu dropdown if we are not going to the plus button.
		 * Let's say we go anywhere else from the menu sub item instead of the plus, we will close menu.
		 * We only care if we have reference to previous menu item so this is only executed in our scenario.
		 */
		document.addEventListener('mouseover', function (event) {

			let $target = $(event.target);

			if ($target.is('.main-nav button')) {
				// open the main navigation dropdown
				$target.trigger('click');

			} else if ($lastMainNavItem) {

				/*
				 * Don't close if we are still in the dropdown menu items for top main navigation
				 */
				if ($target.closest(ivMenu.selector.dropdown).length == 0 && !isGuideActionDivCtrl($target)) {

					let $menu = $lastMainNavItem.children('.menu');

					if (!$menu.length) {
						$menu = $lastMainNavItem.closest('.menu');
					}

					ivMenu.closeMenu($menu);

					// reset
					$lastMainNavItem = null;
				}
			}
		});
	}

	/*
	 * We want to handle some events so as to ensure that we can keep the menu open
	 * while we are in the guide step for the 'main navigation sub menu' item
	 */
	function setupHandlerForMainNavForGuidePlayer() {

		// Prevent default behavior for top navigation
		setTimeout(() => {

			$(ivMenu.selector.main).off('mouseleave.menu')
				.off('mouseenter.menu');
		}, 1000);

		/*
		 * We want to open the main nav item since we prevent default behavior
		 */
		document.addEventListener('mouseover', function (event) {

			let $target = $(event.target);

			if ($target.is('.main-nav button')) {
				// open the main navigation dropdown
				$target.trigger('click');
			}
		});
	}

	/*
	 * We want to open the main nav menu.
	 * This is the top main navigation seen in the application.
	 */
	function openMainNavMenu($ctrl) {
		if ($ctrl == null) {
			return;
		}

		// this is the 'ul/list' that this control is part of - we want to open it
		if ($ctrl.is('a')) {
			const $elemUL = $ctrl.closest('.main-nav').first('ul');
			ivMenu.openMenu($elemUL);
		} else if ($ctrl.is('.main-nav > button')) {
			const $elemUL = $ctrl.next('.main-nav ul');
			ivMenu.openMenu($elemUL);
		}
	}

