	/*
	 * Trap the focus cycle so we stay on modal focusable elements
	 * as we tab or shift tab to go back.
	 *
	 * @cssSelector this is the css selector for the modal
	 */
	function trapFocusCycleOnModal(cssSelector) {

		$(cssSelector).on('keydown.trapFocusCycleOnModal', function (e) {
			if (e.key === 'Tab') {
				e.preventDefault();

				const focusableElements = $(cssSelector + ' :focusable');
				const currentIndex = focusableElements.index(document.activeElement);
				const nextIndex = e.shiftKey ? currentIndex - 1 : currentIndex + 1;
				const nextElement = focusableElements.eq(nextIndex % focusableElements.length);

				nextElement.trigger('focus');
			}
		});
	}

	/*
	 * Release the focus cycle on the modal
	 *
	 * @cssSelector this is the css selector for the modal
	 */
	function releaseFocusCycleOnModal(cssSelector) {
		$(cssSelector).off('keydown.trapFocusCycleOnModal');
	}

	/*
	 * This will setup the first tab keydown to focus on the provided element.
	 * We unbind the event handler after first event.
	 *
	 * @elemCssSelector CSS selector to find the element 
	 */
	function setupOneTimeFirstTabKeydownToFocusElement(elemCssSelector) {

		$(document).on('keydown.setupFirstTabKeyToFocusElement', function (e) {
			if (e.key === 'Tab') {
				e.preventDefault();

				const elem = document.querySelector(elemCssSelector);
				if (elem) {
					elem.focus();
				}

				$(document).off('keydown.setupFirstTabKeyToFocusElement');
			}
		});
	}

