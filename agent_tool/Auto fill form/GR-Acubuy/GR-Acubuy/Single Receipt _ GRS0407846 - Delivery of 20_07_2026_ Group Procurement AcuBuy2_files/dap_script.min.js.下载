	/*
	 * Get the identifier for the control that was last selected by 'plus button'
	 */
	function getCtrlIdentifier() {

		if (appState.$lastSelectedCtrl.attr('data-iv-control')) {

			/* 
			 * Check if it is a grid row. We only care of the data row and not the header
			 * Header row can use directly the 'data-iv-control' as they are unique.
			 * For grid data row - we only care about the 'row index' regarless of the actually object ID.
			 */
			if (appState.$lastSelectedCtrl.closest('td[data-iv-role="cell"]').parent('tr').closest('[data-iv-control-type-name="grid"]').length == 1) {

				/*
				 * Grid scenario
				 */

				const elemParentTr = appState.$lastSelectedCtrl.closest('td[data-iv-role="cell"]').parent('tr');

				if (elemParentTr.length == 1) {
					const rowIndex = elemParentTr.index();
					const gridDataIvControl = elemParentTr.closest('[data-iv-control-type-name="grid"]').attr('data-iv-control');
					const endsWithDataIvControl = appState.$lastSelectedCtrl.attr('data-iv-control').replace(elemParentTr.attr('id'), '');

					return appConfig.ctrlIdentifierPrefix.grid + gridDataIvControl + '|' + rowIndex + '|' + endsWithDataIvControl;
				}

			} else if (!appState.$lastSelectedCtrl.hasClass('iv-dcc-table-item-header') &&
				(appState.$lastSelectedCtrl.is('td.data-collection-item') || appState.$lastSelectedCtrl.parent().hasClass('iv-dcc-table-item-group'))
				&& appState.$lastSelectedCtrl.closest('[data-iv-control-type-name="tableDisplay"]').length == 1) {

				/*
				 * DCC (data control collection) scenario - the new control for grid like structure
				 * Header row can use directly the 'data-iv-control' as they ar unique
				 * (confirmed via td or parent of data-iv-control)
				 */

				const elemParentTr = appState.$lastSelectedCtrl.closest('tr');
				const rowIndex = elemParentTr.index();
				const tableDisplayDataIvControl = elemParentTr.closest('[data-iv-control-type-name="tableDisplay"]').attr('data-iv-control');
				const endsWithDataIvControl = appState.$lastSelectedCtrl.attr('data-iv-control').replace(elemParentTr.attr('data-iv-control'), '');

				return appConfig.ctrlIdentifierPrefix.dccTable + tableDisplayDataIvControl + '|' + rowIndex + '|' + endsWithDataIvControl;

			} else if (!appState.$lastSelectedCtrl.hasClass('iv-dcc-table-item-header')
				&& appState.$lastSelectedCtrl.closest('.data-collection-object.data-collection-object-master-detail').length == 1
				&& appState.$lastSelectedCtrl.closest('[data-iv-control-type-name="tableDisplay"]').length == 1) {

				/*
				 * DCC (data control collection) master detail scenario
				 */

				const elemParentTr = appState.$lastSelectedCtrl.closest('tr.data-collection-object.iv-dcc-table-object');
				const elemParentTd = appState.$lastSelectedCtrl.closest('td.data-collection-item.iv-dcc-table-item');
				const rowIndex = elemParentTr.index();
				const tableDisplayDataIvControl = elemParentTr.closest('[data-iv-control-type-name="tableDisplay"]').attr('data-iv-control');

				let endsWithDataIvControl = appState.$lastSelectedCtrl.attr('data-iv-control').replace(elemParentTd.attr('data-iv-control'), '');

				return appConfig.ctrlIdentifierPrefix.dccTable + tableDisplayDataIvControl + '|' + rowIndex + '|' + endsWithDataIvControl;

			} else if (appState.$lastSelectedCtrl.hasClass('iv-item-clickable iv-context-menu-content')) {

				/*
				 * Button contextual menu item
				 */

				const dataIvControlVal = appState.$lastSelectedCtrl.attr('data-iv-control');

				// This is the control that triggers the open of the contextual menu
				const dataCtrlTriggerVal = appState.$lastSelectedCtrl.closest('ul').attr('data-ctrl-trigger');

				return `${appConfig.ctrlIdentifierPrefix.buttonContextMenuItem}${dataCtrlTriggerVal}|${dataIvControlVal}`;

			} else {

				/*
				 * Any other normal control with data-iv-control
				 */
				return appState.$lastSelectedCtrl.attr('data-iv-control');
			}

		} else if (appState.$lastSelectedCtrl.is('.main-nav button')) {
			return appConfig.ctrlIdentifierPrefix.mainNavTop + parseHrefUrl(appState.$lastSelectedCtrl.next('ul').children('li:first').children('a').attr('href'));
		} else if (appState.$lastSelectedCtrl.is('.main-nav a')) {
			return appConfig.ctrlIdentifierPrefix.mainNavSub + parseHrefUrl(appState.$lastSelectedCtrl.attr('href'));
		}

		return null;
	}

	/*
	 * Returns "/sup/supplier_browse" for something like "/page.aspx/en/sup/supplier_browse"
	 * Also, returns "/sup/supplier_browse" for something like "/buyer/demo/dev292/page.aspx/en/sup/supplier_browse"
	 * for 'href' value of the main navigation menu items
	 */
	function parseHrefUrl(url) {

		// we do not care about the application path
		if (url && ivScope.ApplicationPath != '/') {
			url = url.replace(ivScope.ApplicationPath, '');
		}

		return url.replace(/\/[^\/]+\/[^\/]+/, '');
	}

	/*
	 * Get step control  for the stepCtrlIdentifier.
	 * This is the jQuery object instance.
	 * Depending on the 'stepCtrlIdentifier' we either have control or top navigation menu item.
	 *
	 * @stepCtrlIdentifier - this is the identifier used to find the control in the page.
	 */
	function getStepCtrlObj(stepCtrlIdentifier) {

		let $ctrl = null;

		if (stepCtrlIdentifier.indexOf(appConfig.ctrlIdentifierPrefix.mainNavTop) >= 0
			|| stepCtrlIdentifier.indexOf(appConfig.ctrlIdentifierPrefix.mainNavSub) >= 0) {

			// Main navigation url
			$ctrl = findMainNavCtrlObj(stepCtrlIdentifier);
		} else if (stepCtrlIdentifier.indexOf(appConfig.ctrlIdentifierPrefix.grid) == 0
			|| stepCtrlIdentifier.indexOf(appConfig.ctrlIdentifierPrefix.dccTable) == 0) {

			// data row
			$ctrl = findDataRowCtrl(stepCtrlIdentifier);
		} else if (stepCtrlIdentifier.indexOf(appConfig.ctrlIdentifierPrefix.buttonContextMenuItem) == 0) {

			// Button's contextual menu item
			$ctrl = findButtonContexualMenuItemCtrl(stepCtrlIdentifier);

		} else {

			// data-iv-control
			$ctrl = $('[data-iv-control="' + stepCtrlIdentifier + '"]');
		}

		return $ctrl;
	}

	/*
	 * Will return the jQuery object instance for the main navigation
	 *
	 * @ctrlIdentifer
	 */
	function findMainNavCtrlObj(ctrlIdentifer) {

		let $mainNavCtrl = null;

		/*
		 * returns the page url from the format a|/page.aspx/iva/dummy_manage
		 * so -> /page.aspx/iva/dummy_manage
		 *
		 * @ctrlIdentifer 
		 */
		function getMainNavUrl(ctrlIdentifer) {
			return cleanLegacyNavUrl(ctrlIdentifer.split('|')[1]);
		}

		/*
		 * This will clean the legacy navigation url that was captured
		 * with environment like dev292 etc. e.g. main-nav-top|/dev292/page.aspx/en/usr/login_browse
		 * Returns '/usr/login_browse'
		 */
		function cleanLegacyNavUrl(url) {

			if (url.indexOf('page.aspx') >= 0) {
				return url.replace(/\/[^\/]+[^\/]+\/[^\/]+\/[^\/]+/, '');
			}

			return url;
		}

		if (ctrlIdentifer.indexOf(appConfig.ctrlIdentifierPrefix.mainNavTop) == 0) {

			$('.main-nav button').each(function (idx, e) {
				if ($(this).next('ul').children('li:first').children('a').attr('href').endsWith(getMainNavUrl(ctrlIdentifer))) {
					$mainNavCtrl = $(this);
					return false;
				}
			});

		} else if (ctrlIdentifer.indexOf(appConfig.ctrlIdentifierPrefix.mainNavSub) == 0) {

			$('.main-nav a').each(function (idx, e) {
				if ($(this).attr('href').endsWith(getMainNavUrl(ctrlIdentifer))) {
					$mainNavCtrl = $(this);
					openMainNavMenu($mainNavCtrl);
					return false;
				}
			});
		}

		return $mainNavCtrl;
	}

	/*
	 * Will find the control of the grid or dcc table data row. (we do not do this for grid header)
	 * for e.g. the edit/pencil control of a certain row.
	 *
	 * @ctrlIdentifer - Identifier expected in format:
	 * <ctrl prefix>|<data-iv-control>|<row index>|<control endswith data-iv-control>
	 * 
	 * e.g. 'grid|body_x_proxyImportType_x_grid_grd|3|_img___colManagegridSkill'
	 * e.g. 'dcc-table|body_x_dcc_grid_grid|1|___attrManageGrid_item_btnManage'
	 */
	function findDataRowCtrl(ctrlIdentifer) {

		let $ctrl = null;

		if (ctrlIdentifer.indexOf(appConfig.ctrlIdentifierPrefix.grid) == 0
			|| ctrlIdentifer.indexOf(appConfig.ctrlIdentifierPrefix.dccTable) == 0) {

			const parts = ctrlIdentifer.split('|');
			const dataIvControlVal = parts[1];
			let rowIndex = parseInt(parts[2]) + 1;
			const ctrlDataIvControlEndsWith = parts[3];

			// fail-safe logic if we have less rows that the row index we're looking for. Then, we will pick the last row.
			let totalRows = $('[data-iv-control="' + dataIvControlVal + '"').find('tbody > tr').length;

			if (totalRows < rowIndex)
				rowIndex = totalRows;

			$ctrl = $('[data-iv-control="' + dataIvControlVal + '"').find('tbody > tr:nth-child(' + rowIndex + ')').find('[data-iv-control$="' + ctrlDataIvControlEndsWith + '"').first();
		}

		return $ctrl;
	}

	/*
	 * Finds the control of the button's contextual menu.
	 * Note: The button's contextual menu items are only generated when the button is clicked after first page load.
	 * 
	 * @param {string} stepCtrlIdentifier - The value of the 'data-iv-control' attribute to identify the element.
	 * @returns {$ctrl} - jQuery object instance representing the contextual menu, or null if not found.
	 */
	function findButtonContexualMenuItemCtrl(stepCtrlIdentifier) {

		let $ctrl = null;

		const parts = stepCtrlIdentifier.split('|');
		const dataCtrlTrigger = parts[1];
		const dataIvControl = parts[2];

		// Try to see if the 'ul' is already available. This is only generated after first click.
		let ulElement = document.querySelector(`[data-ctrl-trigger="${dataCtrlTrigger}"]`);

		if (!ulElement) {

			// This is the button that is used to trigger open the context menu
			const btnContextMenuTrigger = document.querySelector(`[data-iv-control="${dataCtrlTrigger}"]`);

			if (btnContextMenuTrigger) {
				btnContextMenuTrigger.click();

				// Now we should have the 'ul'
				ulElement = document.querySelector(`[data-ctrl-trigger="${dataCtrlTrigger}"]`);
			}
		}

		// There are two instances with the same data-iv-control so use the CSS class to find clickable
		const buttonContextualMenuItem = document.querySelector('[data-iv-control="' + dataIvControl + '"].iv-item-clickable.iv-context-menu-content');

		if (buttonContextualMenuItem) {

			if (ulElement) {
				ulElement.style.display = 'initial';
			}

			$ctrl = $(buttonContextualMenuItem);
		}

		// Prevent the button click on the invisible one since there are two instances
		const buttonContextMenuItemInvisible = document.querySelector('[data-iv-control="' + dataIvControl + '"].invisible');

		if (buttonContextMenuItemInvisible) {

			const $buttonContextMenuContentInvisible = $(buttonContextMenuItemInvisible);

			$buttonContextMenuContentInvisible.off('click.dapCustomClick');

			$buttonContextMenuContentInvisible.on('click.dapCustomClick', function (event) {
				$buttonContextMenuContentInvisible.off('click.dapCustomClick');
				event.preventDefault();
				event.stopPropagation();
			});
		}

		return $ctrl;
	}

	/*
	 * Render popup - this will show the popup for the given control.
	 *
	 * @flowGuid - Guid of the flow
	 * @flowStepGuid - Guid of the guide step
	 * @stepCtrlIdentifier - the identifier for the control
	 * @title
	 * @content
	 * @position
	 * @stepDistanceAway
	 * @stepOffset
	 * @isToggle - if true we will have the visibility of the popup as toggle behavior. So, if it was already visible - we hide it.
	 * @percentageCompleted - e.g. 50
	 * @myRank - e.g. 5
	 * @totalStep - e.g. 10
	 * @prevFlowStepGuid - guide step guid of the previous step 
	 * @nextFlowStepGuid - guide step guid of the next step
	 * @stepComplType
	 * @stepShowNextBtn
	 * @stepRuleOperCode
	 * @stepRuleVal
	 * @directionToMoveIfMissing - this is the direction we move if the current step is missing. so, next or prev.
	 */
	function renderPopup(flowGuid, flowStepGuid, stepCtrlIdentifier, title, content, position, stepDistanceAway, stepOffset, isToggle, percentageCompleted, myRank, totalStep, prevFlowStepGuid, nextFlowStepGuid,
		stepComplType, stepShowNextBtn, stepRuleOperCode, stepRuleVal, directionToMoveIfMissing) {

		hideAllPopup();

		const $ctrl = getStepCtrlObj(stepCtrlIdentifier);

		if (isCtrlVisible($ctrl)) {

			// Scroll to since popup cannot be rendered if control is not in the viewport
			scrollToCtrl($ctrl);

			// Setup the same DAP box used in Guide Studio.
			if (isGuideBoxAllowed($ctrl)) {
				setupGuideBoxForCtrl($ctrl);
			} else if (isGuideBorderAllowed($ctrl)) {
				setupGuideBorderForMainNav($ctrl);
			}

			// Check if popup is visible.
			// We want to toggle so if it's already visible just return from here
			if (isToggle && $ctrl.attr('guide-eye-toggle') === "hide") {
				$ctrl.attr('guide-eye-toggle', 'show');
				return;
			} else {
				$ctrl.attr('guide-eye-toggle', 'hide');
			}

			if (ivGuide.isGuidePlayer()) {

				appState.$stepCtrl = $ctrl;

				/*
				 * We want to keep track of this flag - since we will disable autopostback.
				 */
				appState.isStepAutoPostBack = false;
				appState.isStepAutoMoveProcessing = false;

				if (appConfig.autoNextOnChangeControlNames.indexOf(ivControlUtility.getControlTypeName($ctrl)) >= 0
					&& ivClient.get($ctrl, ivClient.properties.data, 'autoPostBack')) {

					appState.isStepAutoPostBack = true;
					ivClient.set($ctrl, ivClient.properties.data, 'autoPostBack', false);
				}

				// Also - setup auto next for applicable controls.
				setupAutoNext($ctrl, nextFlowStepGuid, stepComplType, stepRuleOperCode, stepRuleVal, appState.isStepAutoPostBack);

				// Setup dynamic enable for next button for applicable controls
				setupNextButtonDynamicEnable($ctrl, stepComplType, stepRuleOperCode, stepRuleVal);

				// We want to handle for the main navigation sub menu items
				if (stepCtrlIdentifier.indexOf(appConfig.ctrlIdentifierPrefix.mainNavSub) >= 0) {
					setupHandlerForMainNavForGuidePlayer();
				}
			}

			// logic to remove the 'data-html' so that we can override any data-html that might be there.
			// This logic maybe redundant if we decide to use 'html' instead of 'title/content' since it will
			// by default be overriden by our setup.
			// For now - this helps clean up as we use preformatted 'title' & 'content'
			$ctrl.removeAttr('data-html');

			const showNextBtn = isNextBtnAllowed($ctrl, stepComplType, stepShowNextBtn, stepRuleOperCode, stepRuleVal);

			const popupHtml = getPopupHtml(flowGuid, flowStepGuid, title, content, percentageCompleted, myRank, totalStep, prevFlowStepGuid, nextFlowStepGuid, showNextBtn);

			$ctrl.popup({
				html: popupHtml,
				on: 'manual',
				// This will preserve when we go out of view for instance while scrolling on page. But must remove manually.
				preserve: true,
				className: {
					popup: 'ui popup guide',
				},
				position: position,
				distanceAway: stepDistanceAway == null || stepDistanceAway == '' ? 0 : parseFloat(stepDistanceAway),
				offset: stepOffset == null || stepDistanceAway == '' ? 0 : parseFloat(stepOffset),
				onVisible: function () {

					/*
					 * Focus on the input like element if we have any so that we are automatically
					 * ready to start typing for textbox
					 */
					if (appConfig.autoNextOnChangeControlNames.indexOf(ivControlUtility.getControlTypeName($ctrl)) >= 0 && $ctrl.has('input')) {
						$ctrl.find('input').first().focus();

						// setup first tab key to take us to close button
						setupOneTimeFirstTabKeydownToFocusElement('button.close-guide');
					} else {
						/*
						 * Or else our focus is on the close button of the guide popup
						 */
						const closeBtn = document.querySelector('button.close-guide');
						closeBtn.focus();
					}
				}
			});

			$ctrl.popup('show');

			// Add extra information for accessibility
			$('.ui.popup.guide').attr('role', 'status');

			/*
			 * Show the progress bar in the popup html.
			 * Do not use animation for high contrast mode for accessibility compliance.
			 */
			$('.ui.popup.guide .progress').progress({
				showActivity: (ivScope._params && ivScope._params['bas_accessibility_enabled'] == "0") ? true : false
			});

			// Setup the reason as to why the next button is disabled.
			if (!showNextBtn) {
				setupNextButtonWhyDisabledReason(stepComplType, stepRuleOperCode);
			}

			// Keep watching control position
			keepWatchingCtrlPosition(flowStepGuid, $ctrl);

		} else if (nextFlowStepGuid && nextFlowStepGuid.length > 0) {

			/*
			 * We will try to keep moving to next step as long as we have somewhere to go.
			 */

			const pickNextFlowStepGuid = (directionToMoveIfMissing == appConfig.directionToMove.next) ? nextFlowStepGuid : prevFlowStepGuid;

			ivGuide.moveToGuideStep(pickNextFlowStepGuid, directionToMoveIfMissing);
		} else {

			// We do not have anywhere else to go so we end the guide player.
			ivGuide.endGuidePlayer();
		}
	}

	/*
	 * This will just reposition the popup.
	 * This will not create new instance but just call the reposition for the popup.
	 * This will also take care of the repositioning of the Dap Box. (Dap border is not necessary)
	 */
	function repositionPopup($ctrl) {

		if ($ctrl && $ctrl.length > 0 && $ctrl.popup('exists')) {

			if (isGuideBoxAllowed($ctrl)) {
				setupGuideBoxForCtrl($ctrl);
			}

			$ctrl.popup('reposition');
		}
	}

	/*
	 * Hide all popup in page
	 */
	function hideAllPopup() {

		if (appState.keepWatchingSetIntervalId) {
			clearInterval(appState.keepWatchingSetIntervalId);
			appState.keepWatchingSetIntervalId = null;
		}

		try {

			// Hide other popup that maybe there while playing guide
			$('.ui.popup').popup('hide all');

		} catch (e) {
			// do nothing
		}

		// Need to manually remove since we are using 'preserve' for guide popup
		$('.ui.popup.guide').remove();
	}

	/*
	 * Navigate to the provide page url
	 *
	 * @stepPageUrl - this is the step page url with possible pathinfo, query string too
	 *		e.g. /ctn/document_browse?use_case=main_page_ctr
	 *		e.g. /buy/homepage/adm
	 * @flowStepGuid - this is the current flow step guid we want to navigate for
	 * @nextFlowStepGuid - this is the next flow step guid
	 */
	function navigateToPage(stepPageUrl, flowStepGuid, nextFlowStepGuid) {

		flowSessionService.getLastNavigateAttemptFlowStepGuid(flowStepGuid).then((lastFlowStepGuid) => {

			if (lastFlowStepGuid && lastFlowStepGuid == flowStepGuid) {

				/*
				 * Check to see if we already tried to navigate for this step
				 * We want to prevent infinite navigate scenario
				 * Generally, this is not expected as there needs to be conflict with system redirect and
				 * guide redirect to end up here.
				 * We will try next and eventually should end up in congratulation message.
				 */
				ivGuide.moveToGuideStep(nextFlowStepGuid, appConfig.directionToMove.next);

			} else {

				if (ivGuide.isGuideStudio()) {

					flowSessionService.setGuideStudioFlowStepGuid(flowStepGuid).then((result) => {
						window.location = ivScope.WwwRoot + '/page.aspx/' + ivScope.Lang + stepPageUrl;
					}).catch((error) => {

					});

				} else {

					window.location = ivScope.WwwRoot + '/page.aspx/' + ivScope.Lang + stepPageUrl;
				}
			}

		}).catch((error) => {

		});
	}

	/*
	 * Automatically show popup when we land to the right page after navigation.
	 * We rely on the query string to determine if we should auto show or not.
	 * If no relevant query string found - we will just ignore it.
	 */
	function showPopupOnNavigate() {

		flowSessionService.getGuideStudioFlowStepGuid().then((flowStepGuid) => {

			if (flowStepGuid && flowStepGuid.length > 0) {

				flowStepService.getFlowStep(flowStepGuid).then(function (flowStep) {

					ivGuide.showPopup(flowStep.flowStepGuid, false, appConfig.directionToMove.next);

				}).catch(function (error) {

				});
			}

		}).catch((error) => {

		});
	}

	/*
	 * Get html for the popup
	 *
	 * @flowGuid - Guid of the flow
	 * @flowStepGuid - Guid of the guide step
	 * @title - Displayed for the title
	 * @content - Displayed for the description
	 * @percentageCompleted
	 * @myRank
	 * @totalStep
	 * @prevFlowStepGuid
	 * @nextFlowStepGuid
	 * @showNextBtn
	 */
	function getPopupHtml(flowGuid, flowStepGuid, title, content, percentageCompleted, myRank, totalStep, prevFlowStepGuid, nextFlowStepGuid, showNextBtn) {

		let popupHtml = '<button title="Close Guide" class="close-guide ui basic circular icon button" onclick="ivGuide.exitGuidePlayer(\'' + flowGuid + '\', \'' + flowStepGuid + '\')">';
		popupHtml += '<i aria-hidden="true" class="fa fa-times"></i><span class="sr-only">' + ivScope.GetText(appConfig.textCodes.close) + '</span></button> ';
		popupHtml += '<h1>' + title + '</h1>'

		if (content) {
			popupHtml += '<div>' + content + '</div>';
		}

		popupHtml += '<div class="progress-container">';
		popupHtml += '<div aria-hidden="true" class="ui tiny progress" data-percent="' + percentageCompleted + '">';
		popupHtml += '<div class="bar"></div>';
		popupHtml += '</div><div class="completion-icon">';
		popupHtml += (percentageCompleted == 100) ? '<i aria-hidden="true" class="fa fa-badge-check"></i><span class="sr-only">' + ivScope.GetText(appConfig.textCodes.dapGuidePlayerComplete) + '</span>'
			: '<span aria-hidden="true">' + (myRank + '/' + totalStep) + '</span>'
			+ '<span class="sr-only">' + ivScope.GetText(appConfig.textCodes.dapGuidePlayerProgressStep) + ' ' + myRank + ' ' + ivScope.GetText(appConfig.textCodes.dapGuidePlayerProgressOutOf) + ' ' + totalStep + '</span>';
		popupHtml += '</div></div>';

		popupHtml += '<div class="actions"><div class="step-prev">';

		// Also show previous while we try to add a new step for UI demo
		if (prevFlowStepGuid || !flowStepGuid) {
			popupHtml += '<button class="ui left labeled icon medium floated button" onclick="ivGuide.moveToGuideStep(\'' + prevFlowStepGuid + '\'' + ', \'' + appConfig.directionToMove.prev + '\')"><i aria-hidden="true" class="fa fa-chevron-left icon"></i>' + ivScope.GetText(appConfig.textCodes.prev) + '</button>';
		}

		popupHtml += '</div>';

		popupHtml += '<div class="step-next"><button class="ui right labeled icon medium primary floated button ' + (showNextBtn ? '' : 'disabled') + '" onclick="if (!this.classList.contains(\'disabled\')){ ivGuide.moveToGuideStep(\''
			+ nextFlowStepGuid + '\'' + ', \'' + appConfig.directionToMove.next + '\'); }"><i aria-hidden="true" class="fa fa-chevron-right icon"></i>' + ivScope.GetText(appConfig.textCodes.next) + '</button></div>';

		popupHtml += '</div>';

		popupHtml += '<div class="ui message blue hidden step-next-reason"></div>';

		return popupHtml;
	}

	/*
	 * Update the popup details for the title, content
	 * 
	 * @$ctrl - reference to the control that we're looking for the popup
	 * @title - title of the popup
	 * @content - content of the popup
	 * @completionType - this can be either with next or rule
	 * @showNext - if true we show the next button
	 */
	function updatePopupDetails($ctrl, title, content, completionType, showNext) {

		const $popup = $ctrl.popup('get popup');

		if ($popup) {
			$popup.find('h1').first().html(title);
			$popup.find('div').first().html(content);

			const $nextBtn = $popup.find('.actions .right.button');

			if (completionType == "next" || (showNext && showNext == "true")) {
				$nextBtn.removeClass('disabled');
			} else {
				$nextBtn.addClass('disabled');
			}
		}
	}

	/*
	 * Setup the popup next button enable or disable
	 * 
	 * @$ctrl - reference to the control that we're looking for the popup
	 * @showNext - if true we show the next button. Provide string "true"
	 */
	function updatePopupNextButtonState($ctrl, showNext) {

		const popup = $ctrl.popup('get popup').length > 0 ? $ctrl.popup('get popup')[0] : null;

		if (popup) {

			const nextBtn = popup.querySelector('.actions .right.button');

			if (nextBtn) {
				if (showNext && showNext == "true") {
					nextBtn.classList.remove('disabled');
				} else {
					nextBtn.classList.add('disabled');
				}
			}
		}
	}

	/*
	 * Setup the reason why the next button was disabled.
	 * This is displayed on the mouseenter of the next button.
	 *
	 * @stepComplType - completion type e.g. next, rule
	 * @stepRuleOperCode  - e.g. not_empty
	 */
	function setupNextButtonWhyDisabledReason(stepComplType, stepRuleOperCode) {

		let whyDisabledReason = '';

		if (!stepComplType || stepComplType == appConfig.stepComplType.next) {

			whyDisabledReason = ivScope.GetText(appConfig.textCodes.dapGuidePlayerReasonNext);
		} else if (stepComplType == appConfig.stepComplType.rule) {

			if (stepRuleOperCode == appConfig.stepRuleOper.empty) {
				whyDisabledReason = ivScope.GetText(appConfig.textCodes.dapGuidePlayerReasonRuleEmpty);
			} else if (stepRuleOperCode == appConfig.stepRuleOper.equal) {
				whyDisabledReason = ivScope.GetText(appConfig.textCodes.dapGuidePlayerReasonRuleEqual);
			}
		}

		if (whyDisabledReason) {

			$('.ui.popup.guide .step-next-reason').text(whyDisabledReason);

			$('.ui.popup.guide').on('mouseover.nextReason', (event) => {
				let $target = $(event.target);

				if ($target.closest('.ui.popup.guide .actions .step-next').length == 1
					|| $target.is('.ui.popup.guide .step-next-reason')) {
					$('.ui.popup.guide .step-next-reason').removeClass('hidden');
				} else {
					$('.ui.popup.guide .step-next-reason').addClass('hidden');
				}
			});
		}
	}

	/*
	 * This will reset and remove the why disabled reason displayed for the next button
	 */
	function resetNextButtonWhyDisabledReason() {
		// reset
		$('.ui.popup.guide').off('mouseover.nextReason');
		$('.ui.popup.guide .step-next-reason').text('');
		$('.ui.popup.guide .step-next-reason').addClass('hidden');
	}

	/*
	 * Returns true if we are enabling the next button.
	 *
	 * Also if there is rule and the control already meets the completion rule,
	 * we will enable the next button. Let' say they use previous to go back then we will
	 * have next button enabled if the completion rule is met.
	 *
	 * $ctrl - control jQuery instance
	 * @stepComplType
	 * @showNext
	 * @stepRuleOperCode
	 * @stepRuleVal
	 */
	function isNextBtnAllowed($ctrl, stepComplType, stepShowNextBtn, stepRuleOperCode, stepRuleVal) {

		if (!stepComplType || stepComplType == appConfig.stepComplType.next) {
			return stepShowNextBtn;
		} else if (stepComplType == appConfig.stepComplType.rule) {

			const value = ivControlUtility.getControlValue($ctrl);

			return checkStepCompletionRule(value, stepComplType, stepRuleOperCode, stepRuleVal);
		} else {
			return false;
		}
	}

	/*
	 * Checks if we've met the step completion rule. Returns true if completion rule is met.
	 *
	 * @value - value of the control
	 * @stepComplType
	 * @stepRuleOperCode
	 * @stepRuleVal
	 */
	function checkStepCompletionRule(value, stepComplType, stepRuleOperCode, stepRuleVal) {

		if (!stepComplType || stepComplType == appConfig.stepComplType.next) {
			return true;

		} else if (stepComplType && stepComplType == appConfig.stepComplType.rule) {

			if (stepRuleOperCode == appConfig.stepRuleOper.empty) {

				return value && value.length > 0;
			} else if (stepRuleOperCode == appConfig.stepRuleOper.equal) {

				const allowedValues = stepRuleVal ? stepRuleVal.split('|') : [];

				if (Array.isArray(value)) {

					for (let i = 0; i < value.length; i++) {
						if (allowedValues.indexOf(value[i]) >= 0) {
							return true;
						}
					}

				} else {
					return allowedValues.indexOf(value) >= 0;
				}
			}

		}

		return false;
	}

	/*
	 * Setup increment decrement button for 'guide step manage' distance away & offset
	 * Maybe generalize it for easier reuse for future.
	 */
	function setupFlowStepIncrDecrButton() {

		if (ivScope.IsDesignMode()) {
			return;
		}

		const $txtDistanceAway = $('[id$="txtDistanceAway"]');
		const $txtOffset = $('[id$="txtOffset"]');

		if ($txtDistanceAway.length == 1) {
			$txtDistanceAway.parent('div').addClass('action');

			const $decr = $('<button class="ui icon button"><i aria-hidden="true" class="fa-minus icon"></i><span class="sr-only">' + ivScope.GetText(appConfig.textCodes.minus) + '</span></button>');
			$txtDistanceAway.parent().append($decr);

			$decr.on('click', function () {
				decrement(this);
				return false;
			});

			const $incr = $('<button class="ui icon button"><i aria-hidden="true" class="fa-plus icon"></i><span class="sr-only">' + ivScope.GetText(appConfig.textCodes.plus) + '</span></button>');
			$txtDistanceAway.parent().append($incr);

			$incr.on('click', function () {
				increment(this);
				return false;
			});
		}

		if ($txtOffset.length == 1) {
			$txtOffset.parent('div').addClass('action');

			const $decr = $('<button class="ui icon button"><i aria-hidden="true" class="fa-minus icon"></i><span class="sr-only">' + ivScope.GetText(appConfig.textCodes.minus) + '</span></button>');
			$txtOffset.parent().append($decr);

			$decr.on('click', function () {
				decrement(this);
				return false;
			});

			const $incr = $('<button class="ui icon button"><i aria-hidden="true" class="fa-plus icon"></i><span class="sr-only">' + ivScope.GetText(appConfig.textCodes.plus) + '</span></button>');
			$txtOffset.parent().append($incr);

			$incr.on('click', function () {
				increment(this);
				return false;
			});
		}

		function decrement(sender) {
			const $txt = $(sender).prev();
			let val = ivClient.get($txt) == '' ? 0 : parseInt(ivClient.get($txt));

			val -= 1

			ivClient.set($txt, ivClient.properties.value, val);
		}

		function increment(sender) {
			const $txt = $(sender).prev().prev();
			let val = ivClient.get($txt) == '' ? 0 : parseInt(ivClient.get($txt));

			val += 1

			ivClient.set($txt, ivClient.properties.value, val);
		}
	}

