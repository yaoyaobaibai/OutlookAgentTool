	var ivControlUtility = {
		/*
		* Get control type name e.g. textBoxControl
		* Note that we will not get this information for the top navigation since its a pure html list items.
		*
		* $ctrl - control jQuery object instance
		*/
		getControlTypeName: function ($ctrl) {

			let ivControlTypeName = ivClient.get($ctrl, ivClient.properties.data, 'ivControlTypeName');

			if (!ivControlTypeName) {

				// Button contextual menu item will not have this value so use button
				if ($ctrl.is('button')) {
					ivControlTypeName = appConfig.ivControlTypeName.buttonControl;
				}
			}

			return ivControlTypeName;
		},
		/*
		 * Get the selector code for the given control if applicable e.g. 'iva_skill_step'
		 *
		 * $ctrl - jQuery object instance
		 */
		getSelectorCode: function ($ctrl) {

			const selIvClientData = ivClient.get($ctrl, ivClient.properties.data);

			if (selIvClientData) {
				return selIvClientData['selectorCode'];
			}

			return null;
		},
		/*
		 * Returns the value for the control.
		 * We will handle for textBoxControl
		 *
		 * @$ctrl
		 */
		getControlValue: function ($ctrl) {

			const controlTypeName = ivControlUtility.getControlTypeName($ctrl);

			if (controlTypeName == appConfig.ivControlTypeName.checkBoxControl
				|| controlTypeName == appConfig.ivControlTypeName.selectorControl) {

				return ivClient.get($ctrl, ivClient.properties.value);

			} else if (controlTypeName == appConfig.ivControlTypeName.textBoxControl
				|| controlTypeName == appConfig.ivControlTypeName.searchBoxControl) {

				const value = ivClient.get($ctrl, ivClient.properties.value);

				// Multi-lang for textBoxControl - we need to figure out for the current language
				if (typeof value === 'object') {
					return value[Lang];
				} else {
					return value;
				}

			}
		},
