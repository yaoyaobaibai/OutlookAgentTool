	/*
	 * Setup 'mouseover' handler so that we can mouseover the control.
	 * this takes care of both the box & border (main nav) scenario.
	 */
	function setupGuideStudioMouseOverHandler() {

		document.addEventListener('mouseover', function (e) {

			const $ctrl = $(e.target);

			/*
			 * We obviously don't want to pick the 'plus button'.
			 * We want to get out and keep our last selected control reference.
			 */
			if (isGuideActionDivCtrl($ctrl)) {
				return;
			}

			// reset our last selected control reference
			appState.$lastSelectedCtrl = null;
			resetGuideBoxState();
			resetGuideBorderState();

			const $ctrlForGuideBox = isGuideBoxAllowed($ctrl);

			if (typeof ($ctrlForGuideBox) !== 'undefined' && $ctrlForGuideBox) {
				resetGuideBorderState();
				appState.$lastSelectedCtrl = null;
				setupGuideBoxForCtrl($ctrlForGuideBox);
			} else {

				const $ctrlForGuideBorder = isGuideBorderAllowed($ctrl);

				if (typeof ($ctrlForGuideBorder) !== 'undefined' && $ctrlForGuideBorder) {
					resetGuideBoxState();
					appState.$lastSelectedCtrl = null;

					$('.dap.border').each(function (e) {
						$(this).removeClass('dap border');
					});

					setupGuideBorderForMainNav($ctrlForGuideBorder);
				}
			}

		}, true);
	}

	/*
	 * Returns true if the control is part of the DAP action controls.
	 * This includes the plus button, DAP box etc.
	 * We don't want to react to mouseover on these elements with DAP box.
	 */
	function isGuideActionDivCtrl($ctrl) {
		/*
		 * plus button, its children, DAP box divs
		 */
		return $ctrl.is('.dap.dap-action.buttons')
			|| ($('.dap.dap-action.buttons').length > 0 && $.contains($('.dap.dap-action.buttons')[0], $ctrl[0]))
			|| $ctrl.is('.dap.box.guide-studio');
