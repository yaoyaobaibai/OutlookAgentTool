	/*
	 * We want to try to find the control.
	 * This will take care of the async scenario of the tabs where we need to wait
	 * for the tab to finish loading. As long as we have the dimmer, we will be waiting.
	 *
	 * Without the dimmer, we have fail check on the max attempt and get out of here after that.
	 *
	 * @stepCtrlIdentifier - identifier to find the control
	 * @callback - the callback will be called once we find the control or we are done waiting on fail check scenario
	 */
	function tryToFindCtrl(stepCtrlIdentifier, callback) {

		let counter = 0;
		const maxCounter = 8;	// max 2 seconds
		const waitTime = 250;	// milliseconds
		let success = false;

		keepLooking();

		function keepLooking() {

			const $ctrl = getStepCtrlObj(stepCtrlIdentifier);
			const $loadingDimmer = $('.ui.dimmer.active');

			if (isCtrlVisible($ctrl)) {

				$('body').unblock();

				// We found it
				success = true;
				callback();

			} else {

				// Try recursing until we find it or out of our time
				if ((success !== true && counter <= maxCounter) || $loadingDimmer.length > 0) {

					// we want to show a loading spinner so user is aware while waiting
					// also we don't want to show our spinner if there is already loading dimmer there and we are waiting
					if ($loadingDimmer.length == 0) {
						$('body').block();
					}

					setTimeout(function () {

						counter++;

						keepLooking();

					}, waitTime);
				} else {

					$('body').unblock();

					callback();
				}
			}
		}
	}

	/*
	 * Check to see if control is visible
	 *
	 * $ctrl -
	 */
	function isCtrlVisible($ctrl) {

		// Extra handling for the 'rightPanel' since it can be collapsed
		return $ctrl && $ctrl.length > 0 && $ctrl.is(':visible');
	}

	/*
	 * We want to try to navigate to the page
	 * This will take care of the async scenario of the tabs where we need to wait
	 * for the tab to finish loading. As long as we have the dimmer, we will be waiting.
	 *
	 * Without the dimmer, we have fail check on the max attempt and get out of here after that.
	 *
	 * @callback - the callback will be called once we find the control or we are done waiting on fail check scenario
	 */
	function tryToNavigateToPage(callback) {

		let counter = 0;
		const maxCounter = 8;	// max 2 seconds
		const waitTime = 250;	// milliseconds

		keepLooking();

		function keepLooking() {

			const loadingDimmer = document.querySelector('.ui.dimmer.active');
			const loadingBlockOverlay = document.querySelector('.iv-block-overlay');

			// Try recursing until we find it or out of our time
			if (counter <= maxCounter || loadingDimmer || loadingBlockOverlay) {

				setTimeout(function () {

					if (!loadingDimmer && !loadingBlockOverlay) {
						counter++;
					}

					keepLooking();

				}, waitTime);
			} else {

				callback();
			}
		}
	}

	/*
	 * Reset page vertical and horizontal scroll.
	 * This will set the horizontal and vertical scroll back to zero
	 */
	function resetPageScroll() {
		var scope = document.getElementById('content');
		scope.scrollTo(0, 0);
	}

	/*
	 * Scroll to given control
	 *
	 * @$ctrl
	 */
	function scrollToCtrl($ctrl) {

		// reset page scroll before trying to scroll to - helps with browser size, zoom etc.
		resetPageScroll();

		if ($ctrl && $ctrl.length > 0) {

			const element = $ctrl[0];

			const elementOffsetVertically = element.getBoundingClientRect().top;
			const elementOffsetHorizontally = element.getBoundingClientRect().left;

			const windowHeight = window.innerHeight || document.documentElement.clientHeight;
			const windowWidth = window.innerWidth || document.documentElement.clientWidth;

			const scrollTargetVertically = elementOffsetVertically - (windowHeight / 2);
			const scrollTargetHorizontally = elementOffsetHorizontally - (windowWidth / 2);

			const scope = document.getElementById('content');

			scope.scrollTo({
				top: scrollTargetVertically,
				left: scrollTargetHorizontally
			});
		}
	}

	/*
	 * Replace the value args like {0}, {1} etc. with value provided.
	 *
	 * @text - Hello, {0} {1}!
	 * @values - ['John', 'Doe']
	 * @return - Hello, John Doe!
	 */
	function replaceTextValueArgs(text, values) {
		return text.replace(/{(\d)}/g, (match, index) => values[index]);
	}

	/*
	 * We will keep watching the control provided to reposition popup if it's position changes.
	 * This will call the reposition if the position changes and ensure the DAP box stays in the right place.
	 * For e.g. when client side validation error message shows up the control may shift in position.
	 * 
	 * @flowStepGuid - the guide step guid for the current popup we are watching.
	 * @$ctrl - the control jQuery instance that we are showing the popup for
	 */
	function keepWatchingCtrlPosition(flowStepGuid, $ctrl) {

		const repeatIntervalTime = 250;

		if ($ctrl && $ctrl.length == 1) {

			let prevPosition = null;

			// reset previous
			if (appState.keepWatchingSetIntervalId) {
				clearInterval(appState.keepWatchingSetIntervalId);
				appState.keepWatchingSetIntervalId = null;
			}

			appState.keepWatchingSetIntervalId = setInterval(() => {

				if ($ctrl && $ctrl.length == 1) {

					// reset counter if found

					let currPosition = $ctrl[0].getBoundingClientRect();

					if (!prevPosition || prevPosition.top !== currPosition.top || prevPosition.left !== currPosition.left) {

						if (isCtrlVisible($ctrl)) {

							/*
							 * So something changed in DOM so we need to reposition our popup to align right.
							 */
							repositionPopup($ctrl);

						} else {

							/*
							 * This is added for the partial postback scenario where the part of the page
							 * inside an UpdatePanelControl is cretead again.
							 */
							ivGuide.showPopup(flowStepGuid, false, appConfig.directionToMove.next);
						}
					}

					prevPosition = currPosition;
				}

			}, repeatIntervalTime);
		}
	}

