	/*
	 * Setup automatic next for certain things like buttonControl, textBoxControl.
	 * 
	 * @$ctrl - control that we're showing the popup for
	 * @nextFlowStepGuid - the next step in the chain
	 * @complType
	 * @stepRuleOperCode
	 * @stepRuleVal
	 * @isOriginallyAutoPostBackTrue
	 *	 
	 */
	function setupAutoNext($ctrl, nextFlowStepGuid, stepComplType, stepRuleOperCode, stepRuleVal, isOriginallyAutoPostBackTrue) {

		// We only want to do this in Guide Player
		if (!ivGuide.isGuidePlayer()) {
			return;
		}

		if ($ctrl.is('.main-nav button')) {

			/*
			 * Top navigation button
			 */

			$ctrl.off('mouseover.dapMouseOver');

			$ctrl.on('mouseover.dapMouseOver', function (event) {

				$ctrl.off('mouseover.dapMouseOver');

				autoMoveNextToFlowStep(nextFlowStepGuid, true, function () {
					$ctrl.trigger('click');
				});
			});

		} else if ($ctrl.is('.main-nav a')) {

			/*
			 * Top navigation anchor
			 */

			$ctrl.off('click.dapCustomAnchorClick');

			$ctrl.on('click.dapCustomAnchorClick', function (event) {

				$ctrl.off('click.dapCustomAnchorClick');

				event.preventDefault();

				autoMoveNextToFlowStep(nextFlowStepGuid, false, function () {
					window.location = $ctrl.attr('href');
				});
			});

		} else if (appConfig.autoNextOnClickControlNames.indexOf(ivControlUtility.getControlTypeName($ctrl)) >= 0) {

			/*
			 * Clicks
			 */

			if (ivControlUtility.getControlTypeName($ctrl) == appConfig.ivControlTypeName.imageControl) {

				const $imgLink = $ctrl.find(ivImage.selector.link);

				if ($imgLink && $imgLink.length > 0) {

					/*
					 * On the image control's link that is defined in the ivImage
					 */

					$imgLink.off('click.dapCustomClick');

					$imgLink.on('click.dapCustomClick', function (event) {

						$imgLink.off('click.dapCustomClick');
						event.preventDefault();
						event.stopPropagation();

						autoMoveNextToFlowStep(nextFlowStepGuid, true, function () {
							$imgLink.trigger('click');
						});
					});

				} else {

					/*
					 * Directly set with the image control since there was no link found
					 */
					$ctrl.off('click.dapCustomClick');

					$ctrl.on('click.dapCustomClick', function (event) {

						$ctrl.off('click.dapCustomClick');
						event.preventDefault();
						event.stopPropagation();

						autoMoveNextToFlowStep(nextFlowStepGuid, true, function () {
							$ctrl.trigger('click');
						});
					});
				}

			} else {

				$ctrl.off('click.dapCustomClick');

				// Check to see if any element onclick. We will keep track to remove it.
				const elemOriginalOnclick = $ctrl[0].onclick;

				$ctrl[0].onclick = null;

				$ctrl.on('click.dapCustomClick', function (event) {

					$ctrl.off('click.dapCustomClick');
					event.preventDefault();
					event.stopPropagation();

					// If there're any on click we don't want to use navigation for the anchor. 
					const anyOnClick = ivClient.get($ctrl, ivClient.properties.data, 'onClick');

					if ($ctrl.is('a') && $ctrl.attr('href') && $ctrl.attr('href').length > 0) {

						/*
						 * use href if it's available for anchor
						 */
						autoMoveNextToFlowStep(nextFlowStepGuid, false, function () {

							if (anyOnClick || ivControlUtility.getControlTypeName($ctrl) == appConfig.ivControlTypeName.buttonControl) {
								$ctrl.trigger('click');
							}

							window.location = $ctrl.attr('href');
						});

					} else {

						/*
						 * use click
						 */
						autoMoveNextToFlowStep(nextFlowStepGuid, true, function () {

							if (elemOriginalOnclick) {

								// Call the original handler in the correct context
								elemOriginalOnclick.call($ctrl[0], event);

								// Restore the original 'onclick' behavior
								$ctrl[0].onclick = elemOriginalOnclick;

							} else {
								$ctrl.trigger('click');
							}
						});
					}
				});
			}

		} else if (appConfig.autoNextOnChangeControlNames.indexOf(ivControlUtility.getControlTypeName($ctrl)) >= 0) {

			/*
			 * OnChange
			 */

			$ctrl.off('change.dapCustomChange');

			$ctrl.on('change.dapCustomChange', function (e) {

				const value = ivControlUtility.getControlValue($ctrl);

				if (checkStepCompletionRule(value, stepComplType, stepRuleOperCode, stepRuleVal)) {

					// We only want to remove if the rule as passed
					$ctrl.off('change.dapCustomChange');

					autoMoveNextToFlowStep(nextFlowStepGuid, true, () => {

						if (isOriginallyAutoPostBackTrue === true) {

							isOriginallyAutoPostBackTrue = false;

							// Since we disable the autoPostBack we need to trigger this
							__doPostBack(ivClient.get($ctrl, ivClient.properties.name));
						}

					});
				}

			});

		} else {

			// reset
			appState.isStepAutoMoveProcessing = false;
		}
	}

	/*
	 * This is to automatically move to next guide step.
	 *
	 * @nextFlowStepGuid - the next guide step where we want to move
	 * @showPopup - if true we will call the show popup
	 * @successCallback - function to call after success
	 */
	function autoMoveNextToFlowStep(nextFlowStepGuid, showPopup, successCallback) {

		appState.isStepAutoMoveProcessing = true;

		resetAutoPostBackToOriginal(appState.$stepCtrl, appState.isStepAutoPostBack);

		const setCurrentDapFlowStepPromise = flowSessionService.setGuidePlayerFlowStepGuid(nextFlowStepGuid);
		const nextFlowStepPromise = flowStepService.getFlowStep(nextFlowStepGuid);

		Promise.all([setCurrentDapFlowStepPromise, nextFlowStepPromise]).then((values) => {

			const nextFlowStep = values[1];

			// check if next step is upperWindow
			let useUpperWindow = false;
			if (nextFlowStep && nextFlowStep.stepPageUrl != appState.currentPageDesiredPageUrl && !nextFlowStep.stepParentPageUrl) {
				useUpperWindow = true;
			}

			/*
			 * We need to call the success callback before showing popup since we might rely
			 * on the new page state before showing the popup for that control.
			 */
			if (successCallback) {
				successCallback();
			}

			if (showPopup) {

				if (nextFlowStepGuid) {

					if (useUpperWindow) {
						upperWindow.ivGuide.showPopup(nextFlowStepGuid, false, appConfig.directionToMove.next);
					} else {
						ivGuide.showPopup(nextFlowStepGuid, false, appConfig.directionToMove.next);
					}

				} else {

					// reset - we are at the end there is no more steps so clear keep watching
					if (appState.keepWatchingSetIntervalId) {
						clearInterval(appState.keepWatchingSetIntervalId);
						appState.keepWatchingSetIntervalId = null;
					}

					// We're done
					ivGuide.endGuidePlayer();
				}
			}
		});
	}

	/*
	 * This will reset the AutoPostBack value to the original value of the control
	 * $ctrl - this is the control jQuery object
	 * originalPostBackValue - true or false
	 */
	function resetAutoPostBackToOriginal($ctrl, originalPostBackValue) {

		if ($ctrl) {
			ivClient.set($ctrl, ivClient.properties.data, 'autoPostBack', originalPostBackValue);
		}
	}

	/*
	 * Setup next button dynamic enable for applicable controls
	 *
	 * Let's say the completion rule is met than we want to enable the next button.
	 * We don't want to move the user to next step but just want to enable the next button for visual reference.
	 * E.g. textboxcontrol where any input (at least one character) will enable next (for non empty rules)
	 *
	 * @$ctrl
	 * @stepComplType
	 * @stepRuleOperCode
	 * @stepRuleVal
	 */
	function setupNextButtonDynamicEnable($ctrl, stepComplType, stepRuleOperCode, stepRuleVal) {

		// We only want to do this in Guide Player
		if (!ivGuide.isGuidePlayer()) {
			return;
		}

		if (appConfig.autoNextOnChangeControlNames.indexOf(ivControlUtility.getControlTypeName($ctrl)) >= 0) {

			/*
			 * input event
			 */

			$ctrl.off('input.dapInput');

			/*
			 * Maybe we can think of how to or at what point we can turn off the 'event'
			 * We want to be there currently since let's say if user remove all text we
			 * want to disable back the next button again.
			 * The cost is minimal to listen to the event but better to remove it.
			 */
			$ctrl.on('input.dapInput', function (e) {

				// default
				updatePopupNextButtonState($ctrl, "false");

				const value = ivControlUtility.getControlValue($ctrl);

				if (checkStepCompletionRule(value, stepComplType, stepRuleOperCode, stepRuleVal)) {
					updatePopupNextButtonState($ctrl, "true");
					resetNextButtonWhyDisabledReason();
				} else {
					setupNextButtonWhyDisabledReason(stepComplType, stepRuleOperCode);
				}
			});
