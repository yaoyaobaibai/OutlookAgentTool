				appState.guideStudio.divAction.style.left = (targetOffset.left - 4.5) + 'px';
				appState.guideStudio.divAction.style.top = (targetOffset.bottom - 5) + 'px';

				appState.guideStudio.divActionBtnAdd.classList.add('bottom-left');
