		appState.guideBoxFourSides.divTop.style.top = (targetOffset.top - 4) + 'px';
		appState.guideBoxFourSides.divTop.style.width = (targetWidth + 5) + 'px';

		appState.guideBoxFourSides.divBottom.style.top = (targetOffset.top + targetHeight + 1) + 'px';
		appState.guideBoxFourSides.divBottom.style.left = (targetOffset.left - 3) + 'px';
		appState.guideBoxFourSides.divBottom.style.width = (targetWidth + 5) + 'px';

		appState.guideBoxFourSides.divLeft.style.left = (targetOffset.left - 5) + 'px';
		appState.guideBoxFourSides.divLeft.style.top = (targetOffset.top - 4) + 'px';
		appState.guideBoxFourSides.divLeft.style.height = (targetHeight + 8) + 'px';

		appState.guideBoxFourSides.divRight.style.left = (targetOffset.left + targetWidth + 1) + 'px';
		appState.guideBoxFourSides.divRight.style.top = (targetOffset.top - 4) + 'px';
		appState.guideBoxFourSides.divRight.style.height = (targetHeight + 8) + 'px';

