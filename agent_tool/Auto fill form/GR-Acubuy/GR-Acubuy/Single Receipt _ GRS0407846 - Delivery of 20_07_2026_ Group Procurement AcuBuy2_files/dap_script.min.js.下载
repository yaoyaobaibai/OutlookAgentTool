	/*
	 * We're only allowing DAP box for platform controls with 'data-iv-control' attribute
	 */
	function isGuideBoxAllowed($ctrl) {

		// check if the control is directly 'data-iv-control'
		if ($ctrl.attr('data-iv-control') && !$ctrl.is('td')) {

			// TabPageControl for the Guide Studio (sidebar)
			if ($('[data-iv-control="' + $ctrl.attr('data-iv-control') + '"]').parents('[data-divtabid="tpcFlowOverview"]').length > 0
				|| $ctrl.attr('data-divtabid') == 'tpcFlowOverview') {
				return null;
			}

			return $ctrl;
		} else {

			// check if we are inside one of the data-iv-control children
			// we still want to allow clicking the data-iv-control parent - find closest ancestor
			const closestAncestor = $ctrl.closest('[data-iv-control]');

			if (closestAncestor.length > 0) {
				// We don't want to allow in right panel
				if (closestAncestor.parents('#rightPanel').length > 0 || closestAncestor.attr('id') == 'rightPanel' || closestAncestor.is('td')) {
					return null;
				} else {
					return closestAncestor;
				}
			}
		}

		return null;
	}

	/*
	 * We're only allowing DAP border on the 'main navigation' button & anchor
	 */
	function isGuideBorderAllowed($ctrl) {

		if ($ctrl.is('.main-nav button, .main-nav a')) {
			return $ctrl;
		}

		return null;
	}

	/*
