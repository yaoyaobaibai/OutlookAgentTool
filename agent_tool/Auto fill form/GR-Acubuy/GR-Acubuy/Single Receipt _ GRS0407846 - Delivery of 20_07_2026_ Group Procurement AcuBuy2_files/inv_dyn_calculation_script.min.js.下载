var ivDynamicCalculation = ivDynamicCalculation || {};
$.extend(ivDynamicCalculation, {
	currencyScale: null,
	decimalPrecision: null,
	formatPrecision: function (val, hasCurrencyScale) {
		var currentPrecision = 2;
		if (hasCurrencyScale && ivDynamicCalculation.currencyScale != null)
			currentPrecision = ivDynamicCalculation.currencyScale;
		//BEGIN  D1164486 Invalid System Prompt And forced insertion of decimals for currency with scale = 0
		else if (hasCurrencyScale && typeof ivOitemPriceConditionBrowse != 'undefined' && ivOitemPriceConditionBrowse !== null && ivOitemPriceConditionBrowse.scale !== null)
			currentPrecision = ivOitemPriceConditionBrowse.scale;
		//END  D1164486 Invalid System Prompt And forced insertion of decimals for currency with scale = 0
		else if (ivDynamicCalculation.decimalPrecision)
			currentPrecision = ivDynamicCalculation.decimalPrecision;
		return FormatValue(val, currentPrecision);
	},

	arrondi: function (val, hasCurrencyScale) {
		// Same method in expense_item_manage_script.js, invoice_item_line_browse_script.js and ord_script.js.
		// Will be factorized in v176.

		// Fix needed because of a calculation default due to the internal representation of floating-points number: 
		// in JS: 36.925 * 100 = 3692.4999999999995 and not 3692.5
		return ConvertTo(ivDynamicCalculation.formatPrecision(Math.round(val + "e+10") + "e-10", hasCurrencyScale), 'double');
	},
});