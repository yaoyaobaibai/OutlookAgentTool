			if (typeof ivDataCollectionControl !== 'undefined') {
				ivDataCollectionControl.design.initActionBarControls($ctrlActionBar, $field);
			}

			// Check if the selected field is a proxy, if it is => Add a camera button with options
			// Also, the user needs having the auth_expert_design to have the menu
			if (ivClient.is.proxy($field) && ivScope.isDesignExpert) {
				if (settings) {
					let params = ivDesignMode.GetDesignFieldInfos($('.field-overlay').first());
					settings.snapScreenUrl = params['PageUrl'] +
						(params['PageUrlContainer'] != params['PageUrl'] ? params['PageUrlContainer'] : '');
