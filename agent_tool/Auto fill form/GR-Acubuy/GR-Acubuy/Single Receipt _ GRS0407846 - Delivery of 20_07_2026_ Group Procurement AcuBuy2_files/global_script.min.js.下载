ConvertToDate = function (str) {
	var i = 0;
	var j = 0;
	var l0;
	str = ValidatorTrim(str);
	if (str === "")
		return "";

	var _patternSeparator = new RegExp(ivScope.UserDateFormat.DateSeparatorPattern, 'g');
	// use filter for countries of eastern Europe (as Hungary, Croatia or Serbia)
	// the datetime format ends by a separator
	var a = ivScope.UserDateFormat.ShortDatePattern.split(_patternSeparator).filter(function (s) {
		return s;
	});
	if (!a) { return null; }
	var s = null;
	var _shortDatePattern = ivScope.UserDateFormat.ShortDatePattern;
	var seps = str.match(_patternSeparator);
	if (!seps && !isNaN(str)) {
		//aucun separateur(pfffff)
		if (_shortDatePattern !== null) {
			a = _shortDatePattern.split(_patternSeparator);
		}
		s = [];
		l0 = str.length;
		if (l0 !== 6 && l0 !== 8) {
			return null;
		}
		for (i = 0; i < a.length; ++i) {
			if (a[i] === "dd" || a[i] === "d") {
				s.push(str.substring(j, j + 2));
				j += 2;
			}
			else if (a[i] === "MM" || a[i] === "M") {
				s.push(str.substring(j, j + 2));
