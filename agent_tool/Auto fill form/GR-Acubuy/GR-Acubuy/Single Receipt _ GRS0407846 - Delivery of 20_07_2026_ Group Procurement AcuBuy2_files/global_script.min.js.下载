		/*
		 * Get the absolute path of the field e.g. '.prxInfo.txtName'
		 * We only care about the proxy to the root to find the field
		 */
		getFieldAbsolutePath: function ($field) {

			if (!$field) {
				$field = $('[data-iv-control="' + $('#design-field').data('ivFieldId') + '"]');
			}

			let paths = [];

			paths.push(ivClient.get($field, ivClient.properties.data)['ivFieldCode']);

			let $container = ivClient.get($field, ivClient.properties.containerControl);

			// Try to go up the chain until we find root
			while ($container) {

				if (ivClient.get($container, ivClient.properties.controlTypeName) == 'proxy'
					|| (ivClient.get($container, ivClient.properties.data) && ivClient.get($container, ivClient.properties.data)['path'])) {

					var fieldCode = ivClient.get($container, ivClient.properties.data)['ivFieldCode'];

					// we don't need the root body for absolute path
					if (fieldCode != 'body') {
						paths.push(fieldCode);
					}
				}

				$container = ivClient.get($container, ivClient.properties.containerControl);
			}

			return '.' + paths.reverse().join('.');
		},
