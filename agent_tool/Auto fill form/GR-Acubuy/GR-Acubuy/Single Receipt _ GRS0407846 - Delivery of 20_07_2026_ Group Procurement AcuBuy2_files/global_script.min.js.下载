						}
						else if ($(this).is(':checkbox')) {
							if ($(this).is(':checked')) {
								params['additionalParameters'][$(this).attr('name')] = $(this).val();
							}
						}
						else {
							params['additionalParameters'][$(this).attr('name')] = $(this).val();
						}
					});
				}

				onApprove(params);

				//avoid closing parent modals
				event.stopPropagation();
			}
