	/**
	 * Initialize the 3D scene.
	 * @param {jQuery} $content content area.
	 * @param {string} fileId file identifier.
	 * @param {string} fileExt file extension.
	 */
	function init3D($content, fileId, fileExt) {
		// Load 3D scene and camera
		scene = new THREE.Scene();
		camera = new THREE.PerspectiveCamera(75, $content.width() / $content.height(), 0.1, 10000);

		// New "yellow" ambient light (comes from nowhere / everywhere)
		scene.add(new THREE.AmbientLight(0xaa9966));

		// Add a light that comes from our position
		var directionalLight = new THREE.DirectionalLight(0xaaaaaa);
		directionalLight.position.x = 0;
		directionalLight.position.y = 0;
		directionalLight.position.z = 10;
		directionalLight.position.normalize();
		scene.add(directionalLight);

		// Add the renderer with an alpha in order to have a transparent background
		renderer = new THREE.WebGLRenderer({ alpha: true });
		renderer.setSize($content.width(), $content.height());
		$content.append(renderer.domElement);

		// Load object from data
		CADData[fileExt].loadedCallback(fileId, fileExt);

		// Add controls in order to rotate object 
		controls = new THREE.OrbitControls(camera, renderer.domElement);
		controls.enableDamping = true;
		controls.rotateSpeed = 0.5;
		controls.dampingFactor = 0.1;
		controls.enableZoom = true;
		controls.autoRotate = isRotating;
		controls.autoRotateSpeed = .75;
		controls.update();

		window.addEventListener('resize', function () {
			renderer.setSize($content.width(), $content.height());
			camera.aspect = $content.width() / $content.height();
			camera.updateProjectionMatrix();
		}, false);
	}

	/**
	 * Load a STL object from a corresponding file.
	 * @param {string} fileId file identifier.
	 * @param {string} fileExt file extension.
	 */
	function loadSTLObjectFromFile(fileId, fileExt) {
		var loaderClass = CADData[fileExt].getLoaderClass();
		var loader = new loaderClass();

		loader.load(getImageRelativePath(fileId), function (geometry) {
			var material = new THREE.MeshLambertMaterial({
				overdraw: true,
				color: 0xaa9999,
				shading: THREE.FlatShading
			});
			object3d = new THREE.Mesh(geometry, material);

			// Get bounding box for our object
			geometry.computeBoundingBox();

			// Adjust camera and object positions
			boundingBox = geometry.boundingBox;
			adjustSceneFromBoundingBox(boundingBox);

			// Add object to scene
			scene.add(object3d);
		}, function () { }, function (error) {
			ivFunction.consoleDebug(error.toString(), 'error');
		});
	}

	/**
	 * Load a GLTF object from a corresponding file.
	 * @param {string} fileId file identifier.
	 * @param {string} fileExt file extension.
	 */
	function loadGLTFObjectFromFile(fileId, fileExt) {
		var loaderClass = CADData[fileExt].getLoaderClass();
		var loader = new loaderClass();

		loader.load(getImageRelativePath(fileId), function (gltf) {
			object3d = gltf.scene;

			// Get bounding box for our object
			boundingBox = new THREE.Box3().setFromObject(object3d);

			// Adjust camera and object positions
			adjustSceneFromBoundingBox(boundingBox);

			// Add object to scene
			scene.add(object3d);
		}, function () { }, function (error) {
			ivFunction.consoleDebug(error.toString(), 'error');
			if (error.toString().indexOf('LegacyGLTFLoader') > -1) {
				loadScript(typeof THREE.LegacyGLTFLoader !== 'undefined', baseThreeJSScriptsFilePath + '/LegacyGLTFLoader.js', function ($content, fileId, fileExt) { return loadLegacyGLTFObjectFromFile(fileId); }, null, fileId, 'gltf');
			}
		});
