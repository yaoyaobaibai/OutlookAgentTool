				event.data.onStart();
			item_id = ivPopUp._btn.data(event.data.dataSelector.replace('data-', ''));
			if (event.data.dataQueryString)
			queryStr = '?' + event.data.queryString + '=' + ivPopUp._btn.data(event.data.dataQueryString.replace('data-', ''));
			
			var top = ivPopUp._btn.offset().top + ivPopUp._btn.outerHeight();
			var left = ivPopUp._btn.offset().left;
			var btnWidth = ivPopUp._btn.outerWidth();
			$div = $('<div class="dimmer-popup"></div><div id="ivPopUp" class="iv-alp-popup is-hidden"><i class="close icon fa-times" id="popup-close" title="Close"></i><div class="iv-alp-popup-content"></div></div>');
			if (event.data.inContent)
				$div.addClass('in-content');
			$div.appendTo($("#content"));
			$('.dimmer-popup').height($('#content').prop('scrollHeight'));
			$('.dimmer-popup').css("margin-top", - $('.dimmer-popup').height());
			$('.dimmer-popup').css("opacity", 0.3);
			args = { y: top, x: left, btnWidth: btnWidth, onClose: event.data.onClose, divSelector: event.data.divSelector, mobile: event.data.mobile };
		}
		else {
			ivPopUp._btn = $(event.target).closest(':button');
			item_id = ivPopUp._btn.data(event.data.dataSelector.replace('data-', ''));
			$div = $('<div data-role="modal" id="ivPopUp" class="iv-alp-popup ui modal"></i><div class="iv-alp-popup-content iv-alp-popup-mobile"></div></div>');
			$div.appendTo($("#content"));
			args = { mobile: event.data.mobile };
		}
		if (event.data.url) {
			var pagePopUp = new ivAsyncRequest();
			pagePopUp.addHeader("ResetHtmlControls", false);
			pagePopUp.OnEndResponse = ivPopUp.ajaxCallBack;
			pagePopUp.AsyncRequest({
				type: 'GET',
				Url: ivScope.AjaxUrl(event.data.url.module, event.data.url.page) + (event.data.pathInfos ? "/" + event.data.pathInfos : "") + (item_id ? "/" + item_id : "") + queryStr,
				Args: args,
			});
			ivPopUp.show('<div class="ui active centered inline loader"style="width:300px;"></div>', args, true);
		}
		else if (event.data.divSelector) {
			ivPopUp.show($(event.data.divSelector), args);
		}
		return abort(event);
	},
	ajaxCallBack: function (executor, eventArgs, args) {
		if (!executor.get_responseAvailable() || !IsAuthenticated)
			return;

		var responseData = executor.get_responseData();
		if (responseData) {
			$('#ivPopUp').css("margin-top", '0');
			if (!args.mobile)
				ivPopUp.show(responseData.replace('name="mainForm"', 'name="ivPopUpForm"').replace('id="mainForm"', 'id="ivPopUpForm"'), args, true);
			else
				ivPopUp.show(responseData.replace('name="mainForm"', 'name="ivPopUpForm"').replace('id="mainForm"', 'id="ivPopUpForm"').replace('btn-add-feature', 'btn-add-feature-mobile'), args, true);
		}
	},
	show: function (content, args, isHtml) {
		var $div = $('#ivPopUp');
		if (!args.mobile) {
			$div.removeClass('is-hidden');
			$div.addClass('is-shown');
		}
		// replace name && id before adding html to the DOM to avoid an IE error on "document.forms['mainForm']"
		if (isHtml)
			$div.find('.iv-alp-popup-content').html(content);
		else
			content.appendTo('.iv-alp-popup-content');

		if (!args.mobile) {
			$div.find('#rightPanel').remove();
			$div.find('#proxyActionBar_x').remove();
			$div.find('form').removeAttr('action');
			var top = args.y;
			var left = $('#content').width() < $div.width() + args.x
				? args.x - $div.width() + args.btnWidth
				: args.x;
			$div.offset({ top: top, left: left });
			$div.css("margin-top", $div.css('top'));
			$div.css('top', 0);
			var diffTop = $(document).height() - (args.y + $div.outerHeight());
			if (diffTop < 0)
				$('#content').animate({ "scrollTop": $('#content').scrollTop() - diffTop + 40 }, "fast");
			var argClose = { method: args.onClose, divSelector: args.divSelector };
			$('#popup-close').on("click", argClose, ivPopUp.close);
			$('.dimmer-popup').on("click", argClose, ivPopUp.close);
			$(document).on('click', argClose, ivPopUp.outsideClickListener);
			$(window).resize(ivPopUp.resize);
			var $dropdowns = $div.find(ivDropdownSelector.selector.dropdown);
			ivCheckboxSelector.init($div);
			ivDropdownSelector.init($dropdowns);
		}
		else {
			$div.modal("show");
		}
	},
	resize: function () {
		var top = ivPopUp._btn.offset().top + ivPopUp._btn.outerHeight();
		var x = ivPopUp._btn.offset().left;
		var $div = $('#ivPopUp');
		var left = $('#content').width() < $div.width() + x
			? x - $div.width() + ivPopUp._btn.outerWidth()
			: x;
		$div.offset({ top: top, left: left });
	},
	close: function (event) {
		if (event && event.data) {
			if (event.data.method)
				event.data.method();
			if (event.data.divSelector)
				$(event.data.divSelector).appendTo("#content");
		}
		if ($('.dimmer-popup').length > 0)
			$('.dimmer-popup').remove();
		if ($('#ivPopUp').length > 0)
			$('#ivPopUp').remove();
		$(document).unbind('click', ivPopUp.outsideClickListener);
		$(window).off("resize", ivPopUp.resize);
	},
	getValues: function () {
		var postedValues = $('#ivPopUp #ivPopUpForm').serializeArray();
		var values = [];
		postedValues.forEach(function (elm) {
			if (__ivHtmlControls[$('input[name="' + elm.name + '"]').attr("id")])
				values.push({ id: $('input[name="' + elm.name + '"]').attr("id").replace("body_x_", ""), value: elm.value });
		});

		return values;
	},
	validateForm: function () {
		var isValid = true;
		$('#ivPopUpForm [data-validation]').each(function (elm) {
			if (!ivValidator.validate.field($(this).attr('id')))
				isValid = false;
		});
		return isValid;

	},
	outsideClickListener: function (event) {
		if (!$(event.target).closest('#ivPopUp').length)
			ivPopUp.close(event);
	}
};

