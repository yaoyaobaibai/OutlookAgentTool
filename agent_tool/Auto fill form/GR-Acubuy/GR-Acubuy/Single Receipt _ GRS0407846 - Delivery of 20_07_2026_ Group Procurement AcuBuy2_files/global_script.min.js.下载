	HideColumn: function (hide, number, columnid) {
		var display = hide ? 'none' : '';

		var numberTemp = number;//dealing with column span on first row
		if (this.grid.tHead) {
			var _nodeHeader = this.grid.tHead.rows[0];
			if (number >= _nodeHeader.cells.length) {
				numberTemp = _nodeHeader.cells.length - 1;
			}
		}
		this.changeColumnVisibility(display, _nodeHeader.cells[numberTemp]);
		if (this.grid.tBodies.length) {
			var _nodeBody = this.grid.tBodies[0].rows[0];
			if (_nodeBody.cells.length === 0) {
				_nodeBody = _nodeBody.nextSibling;
			}
			if (_nodeBody && _nodeBody.cells) {
				if (number >= _nodeBody.cells.length) {
					numberTemp = _nodeBody.cells.length - 1;
				}
				this.changeColumnVisibility(display, _nodeBody.cells[numberTemp]);

				while ((_nodeBody = _nodeBody.nextSibling) !== null && _nodeBody.nodeName === 'TR') {
					if (_nodeBody.cells[number]) {
						this.changeColumnVisibility(display, _nodeBody.cells[number]);
					}
				}
			}
		}
		
		var _node = this.grid.rows[0].cells[0];
		while (_node.nodeName === 'TD' && _node.style.display === 'none') {
			_node = _node.nextSibling;
			if (_node === null)
				break;
		}
		
		if (_node && _node.nodeName === 'TD')
			_node.style.paddingLeft = '20px';

		if (this.containerGrid.style.visibility === 'hidden') {
			this.containerGrid.style.visibility = 'visible';
			nextSiblingOf(this.containerGrid, 'DIV').style.visibility = 'visible';
		}

		// Update of a template for row insertion
		if (this.template !== null) {
			const $template = $(this.template);
			if ($template[0].childNodes[0].nodeName !== 'TD')
				number++;
			const templateNode = $template[0].childNodes[number];
			if (display === '') {
				$(templateNode).css("display", "");
				templateNode.classList.add("visible");
				templateNode.classList.remove("hidden");
			} else {
				templateNode.classList.remove("visible");
				templateNode.classList.add("hidden");
			}
			$template[0].childNodes[number] = templateNode;
			this.template = $template[0].outerHTML;
		}
