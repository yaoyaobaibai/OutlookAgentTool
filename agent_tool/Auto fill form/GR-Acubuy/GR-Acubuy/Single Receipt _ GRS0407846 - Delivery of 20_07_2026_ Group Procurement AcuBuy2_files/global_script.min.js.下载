ivLoadTab = function () {
	this.Url = null;
	this.arrayLoadedTab = [];
	this.hdnLoadedTab = null;
	this.tabLoading = null;

	//this.hdnActivatedTab = null;	
	//this.current = null; //main current tab
	//this.tabID = null; //main tabcontrol id

	this.currentTabs = {};
	this.hdnActivatedTabs = {};
	this.mainTabID = null; //main tabcontrol id
	this.pageKey = null; //cache key of the main page
};

ivLoadTab.prototype = new ivUpdatePanel();

ivLoadTab.prototype.initialize = function(tabControlClientID, loadedTabPageID, selectedTabID, pageKey) {
	if (loadedTabPageID != null)
		this.arrayLoadedTab[tabControlClientID] = loadedTabPageID;
	else
		this.arrayLoadedTab[tabControlClientID] = [];

	if (this.hdnLoadedTab == null) {
		this.hdnLoadedTab = this.RenderHiddenField("hdnLoadedTab", this.FormatHiddenLoadedTab(this.arrayLoadedTab));
	}
	else {
		this.hdnLoadedTab.value = __ivTab.FormatHiddenLoadedTab(this.arrayLoadedTab);
	}

	if (selectedTabID != null)
		this.currentTabs[tabControlClientID] = selectedTabID;
	else
		this.currentTabs[tabControlClientID] = [];

	if (this.hdnActivatedTabs[tabControlClientID] == null) {
		this.hdnActivatedTabs[tabControlClientID] = this.RenderHiddenField(tabControlID + "selectedID", selectedTabID);
	}
	else {
		this.hdnActivatedTabs[tabControlClientID].value = selectedTabID;
	}

	if (!this.mainTabID)
		this.mainTabID = tabControlClientID;

	var tabContainer = $('#' + tabControlClientID);
	tabContainer.data('currentSelectedID', selectedTabID);
	tabContainer.data('bodyIsModal', $(document).find('body').hasClass('iv-modal'));

	this.pageKey = pageKey;
};

ivLoadTab.prototype.RenderHiddenField = function(name, value) {
	let hdn = document.getElementById(name);
	if (!hdn) {
		hdn = document.createElement("INPUT");
		hdn.type = "hidden";
		hdn.id = name;
		hdn.name = name;
		hdn.value = value;
		hdn.setAttribute("data-ignorechangesonunload", "true");
		document.forms["mainForm"].insertBefore(hdn, document.forms["mainForm"].firstChild);
	}
	return hdn;
};

ivLoadTab.prototype.FormatHiddenLoadedTab = function (values) {
	var val = "";
	for (__tabControlID in values) {
		if (!values.hasOwnProperty(__tabControlID))
			continue;
		tabControlID = __tabControlID;
		var loadedTabs = values[tabControlID];
		for (var i = 0; i < loadedTabs.length; i++) {
			if (val.length > 0)
				val += ",";
			val += tabControlID + "|" + loadedTabs[i];
		}
	}
	return val;
};

ivLoadTab.prototype.LoadingOn = function (id) {
	var $container = $('#' + id);
	if ($container.length === 0)
		return;

	var $panelLoading = $("<div/>", {
		class: 'tab_loading ui inverted dimmer active'
	});

	var $imgOpac = $("<div/>", {
		class: 'img_ajax_loading ui loader'
	});
	$panelLoading.append($imgOpac);

	var $imgWarning = $("<i/>", {
		class: 'img_ajax_warning fa-exclamation-triangle red big icon hidden'
	});
	$panelLoading.append($imgWarning);

	$container.append($panelLoading);
};

ivLoadTab.prototype.active = function (tab, options) {
	if (typeof tab === 'string') {
		if ($('#' + tab).length > 0) {
			tab = $('#' + tab)[0];
		}
		else {
			tab = $('#content').find('div[tabID="part' + tab + '"]')[0]
		}
	}

	//check hidden fields
	var y = document.querySelectorAll('.dropdown.multiple');
	$(y).each(function () {
		var dropdown = this;
		ivDropdownSelector.toggleOverflowingValuesDisplay(dropdown);
	});

	//loading current tab infos
	var tabControlClientID = $(tab).data('tabcontrolclientid');
	var tabContainerClientID = $(tab).data('tabcontainerclientid');
	var tabDivClientID = $(tab).data('tabdivclientid');
	var autoHideTabs = $('#' + tabContainerClientID).data('autohidetabs') != undefined ? $('#' + tabContainerClientID).data('autohidetabs') : false;
	var currentSelectedID = $('#' + tabControlClientID).data('currentSelectedID');
	var tabCurrent = $('#' + tabContainerClientID).find('[aria-selected="true"]');

	currentSelectedID = $(tab).attr('data-tab-id');
	$('#' + tabControlClientID).data('currentSelectedID', currentSelectedID);

	this.currentTabs[tabControlClientID] = currentSelectedID;

	if ($("#" + tabContainerClientID).data('verticaltab') && $("#" + tabContainerClientID).data('verticaltab') === true) {
		var aboveDisplayTabs = $('#' + tabContainerClientID).data('aboveDisplayTabs');
		var aboveDisplay = !aboveDisplayTabs || aboveDisplayTabs.length == 0 || aboveDisplayTabs.indexOf(currentSelectedID) >= 0 ? 'block' : 'none';
		$('#' + tabContainerClientID).parent().parent().find('div.tab_above').css('display', aboveDisplay);
	}

	if (!$(tab).data('toload')) {
		this.tabLoading = $(tab).prop('id');
		this.loadTab(tab, currentSelectedID, options);
	}
	else {
		this.hdnActivatedTabs[tabControlClientID].value = this.currentTabs[tabControlClientID];
		this.setActiveTabs();
	}

	if (popupMode) {
		adjustTo(document.getElementById('frame'));
	}
	var isMainTab = ivClient.is.true($(tab).closest('nav').data('main'));
	if (isMainTab) {
		$('.iv-content').scrollTop(0);
	}
};

ivLoadTab.prototype.loadTab = function (tab, tabID, options) {
	var tabControlClientID = $(tab).data('tabcontrolclientid');
	var tabControlUniqueID = $(tab).data('tabcontroluniqueid');
	var tabAjaxURL = $(tab).data('ajaxURL');
	var tabDivClientID = $(tab).data('tabdivclientid');
	var tabUniqueID = $(tab).data('tabuniqueid');

	if (Array.contains(this.arrayLoadedTab[tabControlClientID], tabID))
		return;
	this.arrayLoadedTab[tabControlClientID].push(tabID);
	this.LoadingOn(tabDivClientID);

	var upAjax = new ivAsyncRequest();
	var tabAsyncTimeout = ivScope.GetVar("bas_ajax_postback_timeout", "30000");
	if (tabAsyncTimeout && tabAsyncTimeout.length > 0 && !isNaN(Number(tabAsyncTimeout)))
		upAjax.AsyncPostBackTimeout = Number(tabAsyncTimeout);
	upAjax.FormMethod = "GET";
	upAjax.Args = this;
	upAjax.addHeader("IV-AjaxControl", "updatetab");
	upAjax.addHeader("IV-AjaxUpdateTab", tabControlUniqueID);
	var _form = ($(tab).closest('#mainForm').get(0) || theForm);
	if (this.Url === null || this.Url === "") {
		upAjax.Url = _form.action.replace(Mode, "ajax.aspx");
	}
	else {
		upAjax.Url = this.Url;
	}
	upAjax.controlUIDsAsyncList = [];
	if ($.inArray(tabUniqueID, upAjax.controlUIDsAsyncList) == -1) {
		upAjax.controlUIDsAsyncList.push(tabUniqueID);
	}
	options = options || {};
	var contextPageGuid = $(_form).find('#context_page_guid').val();
	if (contextPageGuid)
		options['context_page_guid'] = contextPageGuid;

	if (options != null) {
		$.each(options, function (key, value) {
			upAjax.addQueryString(key, value);
		});
	}

	var webpart = $("#" + tabDivClientID).parents(".is_part:first");
	upAjax.requestWebPartSettings(webpart);
	upAjax.AsyncRequest({ 'OnDone': this.OnDone });
};

ivLoadTab.prototype.OnDone = function (data) {
	//selectedID mis a jour une fois loadé
	var args = this.config.Args;
	var $tab = $('#' + args.tabLoading);
	var tabControlClientID = $tab.data('tabcontrolclientid');
	args.hdnLoadedTab.value = __ivTab.FormatHiddenLoadedTab(args.arrayLoadedTab);
	args.hdnActivatedTabs[tabControlClientID].value = args.currentTabs[tabControlClientID];
	args.setActiveTabs();
	$tab.data('toload', true);

	ivUpdatePanel.prototype.OnDone.apply(this, [data]);

	if (window._ctrlErrorToFocus) {
		var tabField = window._ctrlErrorToFocus.split(',');
		$.each(tabField, function (f) {
			$.each(__ivHtmlControls, function (obj) {
				if (!__ivHtmlControls[obj].controlID || __ivHtmlControls[obj].controlID !== tabField[f])
					return true;
				let fieldToFocus = $(`[data-iv-control="${obj}"]:first`);
				addAnomalyClass(fieldToFocus, window._anomalyType);
				focusField(fieldToFocus);
			});
		});
	}

	if (popupMode) {
		adjustTo(document.getElementById('frame'));
	}

	if (ivScope.IsDesignMode()) {
		ivDesignMode.loadDesignPanel($tab);
		ivDesignMode.toggleAddingFieldState(ivDesignMode.getAddingFieldState());
	}

	var hasValue = $(document.body).find('.dropdown.has-value');
	if (hasValue.length) {
		ivDropdownSelector.toggleOverflowingValuesDisplay(hasValue);
	}	
};

ivLoadTab.prototype.enableDesignMode = function (tabContainerId, tabControlId, url, urlContainer) {
	var
		$tabContainer = $('#' + tabContainerId),
		axis = $tabContainer.hasClass('vertical') ? 'y' : 'x',
		sortable = ivClient.get($tabContainer, ivTabControl.properties.sortable);

	if (sortable) {
		$tabContainer.sortable({
			containment: '#' + tabContainerId,
			axis: axis,
			placeholder: 'placeholder-tab-highlight',
			// disable drag and drop now that all is made by click (check if there is no specific drag to keep)
			disabled: true,
			cursor: 'move',
			items: '.tabcontrol',
			start: function (event, ui) {
				ui.helper.find('span').css('display', 'none');
				ui.placeholder.height(ui.item.height());
				ui.placeholder.width(ui.item.width());
			},
			stop: function(event, ui) {
				console.warn('OBSOLETE : this method should not be called anymore (tab)');
				ui.item.find('span').css('display', '');
				__ivTab.saveOrder();
			}
		});
	}
	else {
		// add a message to explain why the tabcontrol can not be sort
		ivNotificationMessage.AddMsg(ivScope.GetText('tab_control_not_sortable'), null, 'info', ivNotificationMessage.msgContainer.page);
	}

	this.addEventOnImplicitExplicitAreas(tabControlId, tabContainerId);
};

ivLoadTab.prototype.addEventOnImplicitExplicitAreas = function (tabControlId, tabContainerId) {
	//areas click
	$('#' + tabContainerId)
		.off("click.areas-click")
		.on("click.areas-click", '.dm-add-tab.dm-innerline, .dm-add-tab.dm-innerspace', () => { this.beginTabCreation($(event.target).closest('.dm-add-tab'), tabControlId, tabContainerId); return false; });
}

ivLoadTab.prototype.saveOrder = function(tabContainerId, id, url, urlContainer) {
	var orders = new Array();
	var tabsOrders = $("#" + tabContainerId).sortable('toArray');
	for (var i = 0; i < tabsOrders.length; i++) {
		if (tabsOrders[i].length > 0) {
			var $tab = $('#' + tabsOrders[i]);
			orders.push(id + '=' + $tab.data('ivFieldCode') + ':' + i + '-0'); //remove "part" (use attr ?)
		}
	}
	if (!ivCallMethod.saveOrderTabsHandler) {
		ivCallMethodHandler.prototype.saveOrderTabsHandler = function(url, urlContainer, id, tabs) {
			this.invoke(ivScope.AjaxUrl("des", "page_field_manage", null, "methodname=PositionFieldHandler"), { url: url, urlContainer: urlContainer, coordinatesControls: tabs },
				function() {
					ivClient.toggleLoader($('#' + id), false);
				}, null, null);
		};
	}
	ivCallMethod.saveOrderTabsHandler(url, urlContainer, id, orders);
};

ivLoadTab.prototype.setActiveTabs = function() {
	if (this.hdnActivatedTabs == null || this.pageKey == null) return;

	let activeTabs = {};
	let sidebarActiveTabs = {};
	for (let tab of Object.entries(this.hdnActivatedTabs)) {
		if (__ivTab.isSidebarControl(tab[0])) {
			let hasSelectedTab = false;
			document.querySelectorAll(`#${tab[0]} ul li`).forEach((item) => {
				if (item.classList.contains('active')) {
					hasSelectedTab = true;
				}
			});

			if (hasSelectedTab) {
				sidebarActiveTabs = Object.assign(sidebarActiveTabs, { [tab[0]]: tab[1].value });
			}
		} else {
			activeTabs = Object.assign(activeTabs, { [tab[0]]: tab[1].value });
		}
	}
	this.callStateControl('SetSidebarActiveTabs', { objectType: __ivTab.getObjectType(), activeTabs: sidebarActiveTabs }, null);
	this.callStateControl('SetActiveTabs', { pageKey: this.pageKey, activeTabs: activeTabs }, null);
};

ivLoadTab.prototype.isSidebarControl = function (ctrlId) {
	return (document.querySelector(`#${ctrlId}`).getAttribute('data-iv-control-type-name') === 'sidebarControl');
};

ivLoadTab.prototype.getObjectType = function () {
	if ($('#body').attr('data-iv-objecttype')) {
		return $('#body').attr('data-iv-objecttype');
	}
	return null;
}

ivLoadTab.prototype.getTabIndex = function (tabContainerId, tabPartId) {
	for (var i = 0; i < $("#" + tabContainerId).find("li.tab_main_class").length; i++) {
		if ($($("#" + tabContainerId).find("li.tab_main_class")[i]).attr('id') == tabPartId)
			return i;
	}
	return 0;
};

ivLoadTab.prototype.enableAutoHide = function (tabId) {

