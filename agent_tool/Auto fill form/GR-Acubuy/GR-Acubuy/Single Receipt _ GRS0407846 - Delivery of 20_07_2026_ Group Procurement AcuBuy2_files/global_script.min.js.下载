				j++;
		});
		var gripperwidth = layout.width() / 100;
		if (i != 0) {
			var zone = layout.find(".zone_resize").length;
			var dispatch = ((i + (gripperwidth * j)) / zone) + 10;
			$(".zone_resize").each(function () {
				//$(this).width((parseFloat($(this).css("width")) / 100) * (layout.width() - i -55))
				$(this).width($(this).width() - dispatch);
			});
		}
	}
};

//new webpart container
function webPartContainer(id, options) {
	this.id = id;
	this.footPrint = '';
	this.columnWidth = 150;
	this.rowHeight = 150;
	this.containerMaxW = 3000;
	this.containerMaxH = 3000;
	this.map = [];
	if (options) {
		if (options.footPrint != undefined)
			this.footPrint = options.footPrint;
		if (options.columnWidth != undefined)
			this.columnWidth = options.columnWidth;
		if (options.rowHeight != undefined)
			this.rowHeight = options.rowHeight;
		if (options.pageUrl != undefined)
			this.pageUrl = options.pageUrl;
		if (options.pageUrlContainer != undefined)
			this.pageUrlContainer = options.pageUrlContainer;
		if (options.containerId != undefined)
			this.containerId = options.containerId;
		if (options.ajaxRequestUrl != undefined)
			this.ajaxRequestUrl = options.ajaxRequestUrl;
		if (options.allowUserCustom != undefined)
			this.allowUserCustom = options.allowUserCustom;
		if (options.addWebpartBrowseUrl != undefined)
			this.addWebpartBrowseUrl = options.addWebpartBrowseUrl;
	}
	this.columns = Math.round(this.containerMaxW / this.columnWidth);
	this.rows = Math.round(this.containerMaxH / this.rowHeight);
	this.$container = $('#' + id);
	if (this.ajaxRequestUrl) {
		if (this.ajaxRequestUrl.indexOf('?') < 0)
			this.ajaxRequestUrl = this.ajaxRequestUrl + '?1';
	}
	this.itemSelectorClass = '.webpart';
	this.hasLoadedWebPart = false;
	this.init();
	return this;
}

webPartContainer.prototype = {
	gridLayoutRemoveCssClass: function (index, className) {
		return (className.match(/(^|\s)grid-\S+/g) || []).join(' ');
	},
	gridLayoutColumnCssClass: function (pos, size) {
		return "grid-column-" + pos + " grid-column-x" + size;
	},
	gridLayoutRowCssClass: function (pos, size) {
		return "grid-row-" + pos + " grid-row-x" + size;
	},
	moveAxis: function (elem) {
		var $elem = $(elem);
		var position = $elem.position();
		var x = Math.round(position.left / this.columnWidth);
		var y = Math.round(position.top / this.rowHeight);
		//using also data attr because data function doesn't always correctly set the attributes value
		$elem.attr({
			'data-x': x,
			'data-y': y
		}).data({
			'x': x,
			'y': y
		});
	},
	refreshGridPosition: function (elem) {
		var $elem = $(elem);
		var x = Number($elem.attr('data-x')) + 1;
		var y = Number($elem.attr('data-y')) + 1;
		var w = Number($elem.attr('data-colwidth'));
		var h = Number($elem.attr('data-rowheight'));
		$elem.removeClass(this.gridLayoutRemoveCssClass)
			.addClass(this.gridLayoutColumnCssClass(x, w))
			.addClass(this.gridLayoutRowCssClass(y, h))
			//removing top and left calculate by draggable function
			.css('top', '')
			.css('left', '')
			//removing width and height calculate by resizable function
			.css('width', '')
			.css('height', '');
	},
	init: function () {
		var me = this;
		me.$container.addClass('enable').css('width', me.containerMaxW + 'px').css('height', me.containerMaxH + 'px');
		$(document).ready(function () {
			me.generateAddButtons();
			me.setWebpartMap();
			me.$container.droppable({
				tolerance: 'fit'
			});

			me.$container.find(me.itemSelectorClass).draggable({
				containment: 'parent',
				grid: [me.columnWidth, me.rowHeight],
				stack: me.itemSelectorClass,
				revert: false,
				start: function (event, ui) {
					//browser zoom fix
					var x = ui.position.left / me.columnWidth;
					x = Math.ceil(Math.round(x) - x);
					var y = ui.position.top / me.rowHeight;
					y = Math.ceil(Math.round(y) - y);
					if (x > 0 || y > 0) {
						$(this).draggable('option', 'grid', [me.columnWidth - x, me.rowHeight - y]); //zoom factor fix
					}
					else {
						$(this).draggable('option', 'grid', [me.columnWidth, me.rowHeight]);
					}

					me.setWebpartMap();
					$(event.target).attr('original_style', $(event.target).attr('style'));
					me.toggleAddButtons(true);
					$(event.target).parents('.webpart-container:first').addClass("show-gridlines");
				},
				drag: function (event, ui) {
					me.dropHandler(event, ui);
				},
				stop: function (event, ui) {
					me.toggleAddButtons(false);
					if (me.detectOverlap(event.target)) {
						$(event.target).attr('style', $(event.target).attr('original_style'));
						$(event.target).parents('.webpart-container:first').removeClass("show-gridlines");
						$(event.target).removeAttr('original_style');
						return;
					}
					$(event.target).removeAttr('original_style');
					me.moveAxis(event.target);
					me.refreshGridPosition(event.target);

					me.setWebpartMap();
					me.savePosition($(event.target));
					$(event.target).parents('.webpart-container:first').removeClass("show-gridlines");
				}
			});

			me.$container.find(me.itemSelectorClass).resizable({
				grid: [me.columnWidth, me.rowHeight],
				containment: 'parent',
				start: function (event, ui) {
					me.toggleAddButtons(true);
					$(event.target).parents('.webpart-container:first').addClass("show-gridlines");
				},
				resize: function (event, ui) {
					me.resizableHandler(event, ui);
				},
				stop: function (event, ui) {
					me.resizeStopHandler(event, ui);
					me.refreshGridPosition(event.target);

					$(event.target).parents('.webpart-container:first').removeClass("show-gridlines");
					me.toggleAddButtons(false);
				}
			});
		});
	},
	generateAddButtons: function () {
		var me = this;
		var nbCols = me.columns;
		var nbRows = me.rows;
		var addDivs = [];
		for (var i = 0; i < nbCols; i++) {
			for (var j = 0; j < nbRows; j++) {
				var $addDiv = $('<div><div class="webpart_add_button"><i class="fas fa-plus-square icon" aria-hidden="true"></i></div></div>')
					.addClass('webpart_add')
					.addClass(me.gridLayoutColumnCssClass(i + 1, 1))
					.addClass(me.gridLayoutRowCssClass(j + 1, 1))
					.attr('data-x', i)
					.attr('data-y', j);
				addDivs.push($addDiv);
			}
		}
		me.$container.append(addDivs);
		me.$container.find('.webpart_add_button').click(function () {
			var qs = '&x=' + $(this).parent().data('x') + '&y=' + $(this).parent().data('y');
			modalPopup({ url: me.addWebpartBrowseUrl + qs, autoOpen: true });
		});
	},
	toggleAddButtons: function (hide) {
		var me = this;
		me.$container.find('.webpart_add_button').css('display', hide ? 'none' : '');
	},
	setWebpartMap: function () {
		var me = this;
		var map = [];
		for (var i = 0; i < this.columns; i++) {
			var rows = [];
			for (var j = 0; j < this.rows; j++) {
				rows[j] = null;
			}
			map[i] = rows;
		}
		this.$container.find('.webpart').each(function () {
			var id = $(this).attr('id');
			var cols = Math.round($(this).outerWidth() / me.columnWidth);
			var rows = Math.round($(this).outerHeight() / me.rowHeight);
			var x = Math.abs(Math.round($(this).position().left / me.columnWidth));
			var y = Math.abs(Math.round($(this).position().top / me.rowHeight));
			for (var i = 0; i < cols; i++) {
				for (var j = 0; j < rows; j++) {
					if (map[i + x] === undefined)
						map[i + x] = [];
					map[i + x][j + y] = id;
				}
			}
		});
		this.map = map;
		return map;
	},
	detectOverlap: function (currentWebpart, position, size) {
		var me = this;
		var map = this.map;
		var $currentWebpart = $(currentWebpart);
		var currentId = $currentWebpart.attr('id');
		if (!size)
			size = {
				width: $currentWebpart.outerWidth(),
				height: $currentWebpart.outerHeight()
			};

		if (!position)
			position = $(currentWebpart).position();

		var cols = Math.round(size.width / me.columnWidth);
		var rows = Math.round(size.height / me.rowHeight);
		var x = Math.abs(Math.round(position.left / me.columnWidth));
		var y = Math.abs(Math.round(position.top / me.rowHeight));
		for (var i = 0; i < cols; i++) {
			for (var j = 0; j < rows; j++) {
				var id = map[i + x][j + y];
				if (id !== null && id !== currentId) {
					return true;
				}
			}
		}
		return false;
	},
	resizeStopHandler: function (e, ui) {
		var elem = e.target;
		if (this.detectOverlap(elem, null, ui.size)) {
			$(e.target).css(ui.originalSize);
			this.checkSize(e.target, ui.originalSize.width, ui.originalSize.height);
		}
		else {
			this.checkSize(e.target, ui.size.width, ui.size.height);
			this.setWebpartMap();
			this.saveSize($(e.target));
		}

		$(e.target).trigger('webpartResize', { webpart: elem, width: $(elem).width(), height: $(elem).height() });
	},
	resizableHandler: function (e, ui) {
		var elem = e.target;
		if (this.detectOverlap(elem, null, ui.size)) {
			this.$container.find('.webpart').css('border-color', 'red');
		} else {
			this.$container.find('.webpart').css('border-color', '#21ba45');
		}
	},
	dropHandler: function (e, ui) {
		var elem = e.target;
		if (this.detectOverlap(elem)) {
			$(elem).css('border-color', 'red'); //no revert, issue when using browser zoom
			return false;
		}
		else {
			$(elem).css('border-color', '#21ba45');
			return true;
		}
	},
	checkSize: function (webpart, width, height) {
		var colWidth = Math.round(width / this.columnWidth);
		var rowHeight = Math.round(height / this.rowHeight);

		colWidth = Math.min(colWidth, this.columns - 1);
		rowHeight = Math.min(rowHeight, this.rows - 1);

		//using also data attr because data function doesn't always correctly set the attributes value
		$(webpart).attr({
			'data-colwidth': colWidth,
			'data-rowheight': rowHeight
		}).data({
			'colwidth': colWidth,
			'rowheight': rowHeight
		}).css({
			'width': (colWidth * this.columnWidth) + 'px',
			'height': (rowHeight * this.rowHeight) + 'px'
		});
	},
	enableUserCustomReset: function () {
		$('.webpart_reset_user_btn').removeAttr('disabled');
	},
	savePosition: function ($part) {
