				$modal.addClass('fullscreen');
			}

			if ($modal.hasClass('fullscreen')) {
				var $sizeIcon = $modal.find('.fa-window-maximize');
				if ($modal.hasClass('fullscreen-nomargin')) {
					//removes padding & margin to dimmer
