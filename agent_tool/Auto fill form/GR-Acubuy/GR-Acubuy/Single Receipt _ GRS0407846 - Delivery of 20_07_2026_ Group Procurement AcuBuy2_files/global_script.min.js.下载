		}

		jqXHR.get_responseData = function()
		{
			if (jqXHR.status < 200 || jqXHR.status >= 300)
			{
				return {
					'_statusCode' : jqXHR.status,
					'get_message' : function()
					{
						return jqXHR.statusText;
					}
				}
			}
			return jqXHR.responseText;
