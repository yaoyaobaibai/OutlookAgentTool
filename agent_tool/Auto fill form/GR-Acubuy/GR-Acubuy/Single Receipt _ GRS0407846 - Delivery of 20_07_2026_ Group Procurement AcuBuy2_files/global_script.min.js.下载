			if (replyMode) {
				target.htmlRendering.addClass('iv-blog-msg-focus');
				parentMsg = target;
			}

			var $msgEditor = this.newMessageEditor(target, msgType, replyMode);

			this.initMsgSupplierShareLabel($msgEditor);
			this.initCommentMsgZone($msgEditor, target, replyMode);
			this.initCommentTextArea($msgEditor, replyMode);
			this.initCommentInput($msgEditor, target, parentMsg, replyMode, false);

