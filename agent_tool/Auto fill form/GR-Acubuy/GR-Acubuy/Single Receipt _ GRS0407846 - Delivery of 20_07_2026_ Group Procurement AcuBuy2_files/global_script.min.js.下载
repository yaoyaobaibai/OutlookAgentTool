		// Define the event that will be done when we select checkboxes inside the checkbox column
		// It will creates 2 collection in data() : selectedFields & selectedRelationTables
		// This will be useful to get fields that are checked for btn-add-fields
		chkBoxColEvent: function(e) {
			var $tab = $('#' + designAddingControlPanel.id).find('.design-adding-control-database-field');
			var $row = $(this).parents('tr').first();
			var id = $row.attr('id');
			var field = id;
			var $grid = $tab.find('#gridFields');
			var checkedInfo = 'selectedFields';

			if ($row.find('.is-relation-row').length > 0) {
				checkedInfo = 'selectedRelationTables';
				var column = $row.find('[data-iv-column-relation]').attr('data-iv-column-relation');
				field = {
					tableName: id,
					dataTablePath: '.[' + column + ']' + id,
					column: column
				};
			}

			if (typeof $grid.data(checkedInfo) === 'undefined') {
				$grid.data(checkedInfo, [field]);
			}
			else {
				var cols = $grid.data(checkedInfo);

				if (!cols.includes(field)) {
					cols.push(field);
				}
				else {
					$grid.data(checkedInfo, cols.filter(item => item !== field));
				}
			}

			let selectedCount = 0;
			if (typeof $grid.data('selectedFields') !== 'undefined') selectedCount += $grid.data('selectedFields').length;
			if (typeof $grid.data('selectedRelationTables') !== 'undefined') selectedCount += $grid.data('selectedRelationTables').length;

			// Enable/Disable button add fields depending on the checked length of the checkbox column.
			if (selectedCount === 0) {
				$tab.find('.btn-add-fields').prop('disabled', true).addClass('disabled');
			}
			else {
				$tab.find('.btn-add-fields').prop('disabled', false).removeClass('disabled');
			}

			// Enable/Disable fields orientation parameters depending on the checked length of the checkbox column.
			if (selectedCount > 1 && $tab.find('div.action-param').data('hasOrientationParam') === true) {
				if ($tab.find('div.params.orientation').length === 0) {
					const paramName = 'insert_orientation';
					const $divOrientation = $('<div/>', { class: 'params orientation' });
					$divOrientation.append($('<div/>', { class: 'header' }).text(ivScope.GetText('dm_field_orientation')));
					$divOrientation.append($('<div/>', { class: 'content' })
						.appendShiftParams(paramName, [shiftParameters.orientationHorizontal, shiftParameters.orientationVertical]));

					$divOrientation.prependTo($tab.find('div.action-param'));
				}
			}
			else {
				$tab.find('div.params.orientation').remove();
			}
		},
