				return;
			}

			this._conversations.push(convData);
		},
		onConversationsLoaded: function () {
			this.updateChatNotificationMarker();

			// Do not render if chat is not displayed
			if (this.sideBar && this.sideBar.OpenedPanelIndex != 'chat')
				return;

			let chatType = this.findMsgType('chat');
			let $convPanelContent = this.newConversationPanelContent();

			let filteredConvs = this._conversations.filter(convData => convData.Conv.ConvType == this.filterConvType);

			// Hide conversation list if empty
			$convPanelContent.find('.iv-blog-conv-list').toggleClass('hidden', filteredConvs.length == 0);

			// Show / Hide empty state
			$convPanelContent.find('.iv-msg-list-empty-container').toggleClass('hidden', filteredConvs.length > 0);

			// If empty state is visible, set label text and "Start conversation" buttons visibility
			if (filteredConvs.length == 0) {
				let textCode = `blog_panel_msg_list_empty_conversation_${this.filterConvType}`;
				if (this.config.extranetMode)
					textCode += '_extranet';
				$convPanelContent.find('.iv-msg-list-empty-label').text(ivScope.GetText(textCode));
				$convPanelContent.find(`.start-conversation[data-conv-type!="${this.filterConvType}"]`).addClass('hidden');
				$convPanelContent.find(`.start-conversation[data-conv-type="${this.filterConvType}"]`).removeClass('hidden');
			}

			// Hide back button in chat panel when there is less than two elements in the list
			chatType.blockContainerHtmlRendering.find('button.conversation-header-back-button').toggleClass('hidden', filteredConvs.length < 2);

			this.cleanSubscribersContainer();
			this.cleanAttachmentsContainer();

			// Update marker in header bar - To do here only if we don't have an opened conversation, otherwise it will be done during the load of the messages
			if (filteredConvs.length == 0 && !mobileMode)
				ivMsgCenterControl.displayNotificationInHeader();

			if (filteredConvs.length == 1) {
				this.navigate(filteredConvs[0].Conv.SupId);
				this.setChatOpenedBlock('chat');
			}
			else
				this.setChatOpenedBlock('conversation');

			this.renderConversationList();
		},
		loadMessages: function (loadType) {
			let searchValue = this._searchValue;

			if (!this._$panel)
				return;

			const msgType = this.findMsgType('chat');

			// Don't load messages if the current msgType is not chat
			let $chatContainer = this._$panel.find('.iv-blog-type-container[data-id=chat]');
			if ($chatContainer.hasClass('hidden'))
				return;

			if (!msgType)
				return;

			this.cleanSubscribersContainer();
			this.cleanAttachmentsContainer();

			var maxMessageId = null;

			let $firstMsg = msgType.$msgList?.children('li:visible:first');
			if ($firstMsg?.length > 0)
				maxMessageId = Number($firstMsg.attr('messageId'));

			var groupName = this.config.groupName;
			var topValue = (loadType === 'all_unread_msg') ? this.config.unreadMsgNumber : 0;

			this.showLoading(true);

			var blogPanel = this;
			ivBlogAjaxHandler.getMessages(groupName, maxMessageId, searchValue, topValue,
				this.config.showRepliesOnly, this.config.filters.assignedToMe, this.config.filters.assignedToOthers, this.config.filters.assignedTodo, this.config.filters.assignedDone,
				function (args) {
					blogPanel.reloadSubscribers();

					var counters;
					var countMsg = 0;
					var isReply = true;
					var msgParentId = null;
					var oldMsgZoneHeight = 0;
					var newMsgZoneHeight = 0;

					var $msgList = blogPanel.findMsgType('chat')?.$msgList;

					if ($msgList && $msgList.length > 0)
						oldMsgZoneHeight = $msgList.prop('scrollHeight');

					//if the msg zone is hidden, display it everytime the panel is refreshed.
					blogPanel.displayMainMsgEditor(true);

					for (var i in args) {
						// Counter data
						if (i === 'count') {
							counters = args[i];
							continue;
						}

						// Message
						blogPanel.addMessage(args[i]);
						countMsg++;

						if (isReply) {
							if (!args[i].parentId)
								isReply = false;
							else
								msgParentId = args[i].parentId;
						}
					}

					if (counters["chat:total"]) {
						blogPanel._$panel.data("blogTotalMsg", counters["chat:total"]);
					}

					// If conversation doesn't have any message, then display "No messages yet"
					if (!counters["chat:total"] || counters["chat:total"] == 0) {
						var msgTypeChat = blogPanel.findMsgType("chat");
						msgTypeChat.$msgListEmpty.removeClass("hidden");
						msgTypeChat.$msgList.addClass("hidden");
					}

					blogPanel.renderMessages();

					if ($msgList && $msgList.length > 0)
						newMsgZoneHeight = $msgList.prop('scrollHeight');

					if (loadType === 'more_msg')
						$msgList.scrollTop(newMsgZoneHeight - oldMsgZoneHeight);

					if (loadType == 'all_unread_msg' && topValue > 0) {
						// scroll to top to see last unread msg
						$msgList.animate({ scrollTop: 1 }, 500);

						blogPanel.config.unreadMsgNumber = 0;
					}

					//update counters
					if (!isReply && counters) {
						var types = [];
						var totals = [];
						var notDisplayed = [];
						for (var i in counters) {
							var code = i.split(":")[0];
							var count = i.split(":")[1];

							if (!types[code])
								types[code] = code;

							if (count === "total") {
								totals[code] = counters[i];
							}
							else if (count == "not_displayed") {
								notDisplayed[code] = counters[i];
							}
						}
						for (var i in types) {
							blogPanel.updateMessageTypeCounter(
								types[i],
								totals[types[i]],
								notDisplayed[types[i]]
							);
						}
						blogPanel.scrollToBottom(0);
					}

					var convData = blogPanel._currConv;
					if (convData && convData.MyUnreadMsgCount)
						convData.MyUnreadMsgCount = 0;
					blogPanel.updateChatNotificationMarker();

					//update message counter directly
					if (!this._messagesLoaded && !mobileMode)
						ivMsgCenterControl.displayNotificationInHeader();

					blogPanel.showLoading(false);
					blogPanel.reloadConvActionMenu();
				},
				function (args) { blogPanel.showLoadingError(true); },
			);

			this._messagesLoaded = true;
		},
		reloadConvActionMenu: function () {
			let hasChatMessage = this._messages.some(msg => msg.typeCode === 'chat');

			// Show or hide search when there are messages or not
			this.config.$container.find('.' + this.cssClass.conversation.searchMessageItem).toggleClass('hidden', !hasChatMessage);

			// Don't show subscribers button if user is in pingee mode
			this.config.$container.find(`.${this.cssClass.conversation.subscribersItem}`).toggleClass('hidden', this.config.showRepliesOnly && !this.config.hasAccessToObject);

			// Don't show subscribe button if user is in pingee mode
			this.config.$container.find('.' + this.cssClass.conversation.subscribeMeItem).toggleClass('hidden', this.config.showRepliesOnly && !this.config.hasAccessToObject);

