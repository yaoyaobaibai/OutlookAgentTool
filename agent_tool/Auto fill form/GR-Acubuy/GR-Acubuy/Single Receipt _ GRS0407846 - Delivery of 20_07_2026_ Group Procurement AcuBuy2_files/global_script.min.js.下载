		metactrl: function(items, url, phc) {
			var dict = {};
			var __designControlsMetaDataHolder = getDesignControlsMetaDataHolder();
			var meta = __designControlsMetaDataHolder.__designControlsMetaData[url + '/' + phc];
			if (!meta) {
				meta = __designControlsMetaDataHolder.__designControlsMetaData[url];
			}
			if (!meta) {
				return '';
			}
			for (var key in items) {
				var cc = ivDesignMode.getControls(meta, url, __designControlsMetaDataHolder.__designControlsMetaData);
				if (!cc[items[key]]) {
					continue;
				}
				dict[key] = cc[items[key]].meta + "|" + cc[items[key]].type + "|" + cc[items[key]].rule_type + "|" + cc[items[key]].text_code + "|" + cc[items[key]].url + "|" + cc[items[key]]['label_field'];
			}
			return dict;
		},
		getControls: function(meta, url, __designControlsMetaData) {
			var stack = [];
			var items = [];
			var controls = {};
			for (var item in meta.controls) {
				controls[item] = meta.controls[item];
				controls[item].url = url;
			}
			stack.push(url);
			for (var pageUrl in __designControlsMetaData) {
				if (jQuery.inArray(pageUrl, stack) === -1) {
					var meta2 = __designControlsMetaData[pageUrl];
					var controls2 = meta2.controls;
					for (var item2 in controls2) {
						if (!controls[item2]) {
							controls[item2] = controls2[item2];
							controls[item2].url = pageUrl;
						}
					}
					stack.push(pageUrl);
				}
			}
			return controls;
		},
		GetDesignFieldInfos: function($field) {
			var designFieldInfos = {};

			var designProperties = Object.keys(ivDesignMode.properties);
			for (var index = 0; index < designProperties.length; index++) {
				var designProperty = designProperties[index];
				var value = GetDesignFieldInfo($field, designProperty);

				if (typeof value !== 'undefined') {
					designFieldInfos[designProperty] = value;
