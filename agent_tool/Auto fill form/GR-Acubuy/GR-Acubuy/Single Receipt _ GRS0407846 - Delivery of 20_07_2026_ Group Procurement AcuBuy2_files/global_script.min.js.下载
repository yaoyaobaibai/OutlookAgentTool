	create: function () {
		var nodeTemplate = $(this.grid).find('.insert:first');
		var newId = $('#' + nodeTemplate.attr('newObjectIds'));
		var id = Math.floor(Math.random() * 10000);
		if (newId.val() === '') {
			newId.val(id);
		}
		else {
			var values = newId.val().split(',');
			values.unshift(id);
			newId.val(values);
		}

		if (this.template == null)
			return true
		var trId = 'tr_-' + id;
		if (this.dataKeyNames) {
			for (var i = 1; i < this.dataKeyNames.length; i++) {
				trId += this.newRowIDSeparator + '-' + id;
			}
		}
		var newControls = [];
		var copyData = (htmlControl, dataContainer) => {
			var newCtrlId = htmlControl.replace(/new_object/g, trId);
			var data = jQuery.extend(true, {}, dataContainer[htmlControl]);
			// Handle Autocompletion options (change the ID of template)
			if (data.key) {
				data.key = data.key.replace(/new_object/g, trId);
			}
			if (data.postName) {
				data.postName = data.postName.replace(/new_object/g, trId);
			}
			if (data.selectorId) {
				data.selectorId = data.selectorId.replace(/new_object/g, trId);
			}
			if (data.autoSave) {
				data.autoSaveObjectId = trId;
			}
			newControls[newCtrlId] = dataContainer[newCtrlId] = data;			 
			return data;
		}
				
		var filter = x => x.startsWith(nodeTemplate.prop('id'));
		[__ivHtmlControls, __ivCtrl].forEach(dataContainer => 
			Object.keys(dataContainer)
			.filter(filter)
			.forEach(htmlControl => copyData(htmlControl, dataContainer)));
		var template = null;
		template = this.template.replace(/new_object/g, trId);
		var newTemplate = $(template);
		newTemplate.addClass('item_selected');
		newTemplate.attr('new_id', id);
		var insertFirst = ivClient.get(this.ClientID, ivClient.properties.data, 'newLineInsertedFirst');
		if (this.autosave == true) {
			var ix = $(newTemplate).attr('id');
			var newrowtemplate = new GridRowTemplate(this, newTemplate, id, this.dataKeyNames, false);
			this.rowtemplates[ix] = newrowtemplate;
			if (insertFirst) {
				$(this.grid).find('.insert').first().after(newTemplate.show());
			}
			else {
				$(this.grid).find('.insert').last().after(newTemplate.show());
			}
		}
		else {
			if (insertFirst) {
				$(this.grid).find('.insert').first().after(newTemplate.show());
			}
			else {
				$(this.grid).find('.insert').last().after(newTemplate.show());
			}

		}

		//update columns with unknown dataType to enable field validation
		for (var newControl in newControls) {
			var dataType = ivClient.get(newControl, ivClient.properties.data, 'dataType');
			if (!dataType || dataType === 'empty') {
				var cell = ivClient.get(newControl, ivClient.roles.cell);
				if (cell) {
					// set data type for fields which are not selectors
					dataType = cell.attr('data-userdatatype');
					const ctrl = document.getElementById(newControl);
					const field = ctrl?.closest('.field');
					if (field
						&& !field.classList.contains('iv-selector')
						&& dataType && dataType !== 'empty') {
						ivClient.set(newControl, ivClient.properties.data, 'dataType', dataType);
						cell.attr('datatype', dataType);
					}
				}
			}
		}
		newControls = null;

		ivDropdownSelector.init(newTemplate);
		ivCheckBox.init(newTemplate);
		ivTextBox.init(newTemplate);

		if (this.autoSaveRow === null) {
			this.autoSaveRow = this.autosave && this.checkAutoSaveNewRow(newTemplate);
		}
		this.initNewRowActions(newTemplate);

		return trId;
	},
	checkAutoSaveNewRow: function ($newTemplate = $(this.grid).find('tr.insert[new_id]:first')) {
