			searchString = RemoveAccents(searchString.toLowerCase());
			//debut de la recherche
			var $nodeList = $(ivQueryAdvanceTreeview.selector.searchNodeList);
			var matchNode = $.grep($nodeList, function (node, i) { // pose les match-search
				var labels = $(node).find('span.module-label, span.table-label, .node-col-label');
				if (labels.length && RemoveAccents(labels.html().toLowerCase()).indexOf(searchString) > -1) { // module label , table name
					ivQueryAdvanceTreeview.wrapLabel(node, searchString);
					return true;
				}
				if ($('span.node-label-table').lenght && RemoveAccents($(node).find('span.node-label-table').html().toLowerCase()).indexOf(searchString) > -1) // table label
					return true;
				if (node.hasAttribute('module') && $(node).attr('module').indexOf(searchString) > -1) // module tech name => [auc]
					return true;
				if (node.hasAttribute('table') && $(node).attr('table').indexOf(searchString) > -1) // table name [t_sup_supplier]
					return true;
				if (node.hasAttribute('col') && $(node).attr('col').indexOf(searchString) > -1) // table name [t_sup_supplier]
					return true;
				return false;
			});

			$(matchNode).addClass('match-search');

			var matchNodeInside = $.grep($nodeList, function (node, i) { // pose les match-search-inside -> le noeud contient la recherche
				var isModule = node.hasAttribute('module');
				if (isModule) {
					var moduleName = $(node).attr('module');
					var found = false;
					$.each(moduleTable[moduleName], function (ind, table) { // fetch table into module
						if (table.indexOf(searchString) > -1) {
							found = true;
						}
						if (chkLabel) { //table label: Fournisseurs
							if (RemoveAccents(__ivCtrl['CodeMirror'].TableLabel()[table].toLowerCase()).indexOf(searchString) > -1) {
								$(node).children('li[table="' + table + '"]').addClass('match-search');
								found = true;
								if (chkLabel)  //table label: Fournisseurs
									ivQueryAdvanceTreeview.wrapLabel(node, searchString);
							}
						}
						$.each(ivQuery.schema()[table], function (colInd, col) {
							if (col.indexOf(searchString) > -1) //column name: sup_id
							{
								found = true;
								$(node).find('li[table="' + table + '"]').addClass('match-search-inside');
								$(node).find('li[table="' + table + '"]').children('ul').children('li[col="' + col + '"]').addClass('match-search');
								$(node).addClass('match-search-inside');
								if (chkLabel)  //table label: Fournisseurs
									ivQueryAdvanceTreeview.wrapLabel(node, searchString);
							}
						});
					});
				}
				else {
					var tableName = $(node).attr('table');
					$.each(ivQuery.schema()[tableName], function (ind, col) {
						if (col.indexOf(searchString) > -1) //column name: sup_id
						{
							$(node).find('li[table="' + tableName + '"]').addClass('match-search-inside')
							$(node).addClass('match-search-inside');
							$(node).find('li[table="' + tableName + '"] li[col="' + col + '"]').addClass('match-search');
							found = true;
						}
						var label = RemoveAccents(__ivCtrl['CodeMirror'].ColumnLabel()[tableName][col].toLowerCase());
						if (label && chkLabel && label.indexOf(searchString) > -1) {
							found = true;
							colNode = $(node).children('ul').children('li[col="' + col + '"]');
							if (colNode.lenght)
								ivQueryAdvanceTreeview.wrapLabel(colNode, searchString);
						}
					});
					ivQueryAdvanceTreeview.wrapLabel(node, searchString);
				}
				return found;
			});

			$(matchNodeInside).addClass('match-search-inside');
			var $iconInside = $('<i class= "fa-arrow-down icon"></i>');
			var $matchInside = $('.match-search-inside');
			$matchInside.children('.module-label').after($iconInside);

			if (chkLabel)
				$matchInside.children('.node-label-table').after($iconInside);
			else
				$matchInside.children('.table-label').after($iconInside);

			if (chkModules) {
				//hide modules
				$(ivQueryAdvanceTreeview.selector.tablesList).children('li.module-node:not(.match-search)').addClass('hidden');
				$(ivQueryAdvanceTreeview.selector.tablesList).children('li.module-node.match-search').removeClass('hidden');
				$(ivQueryAdvanceTreeview.selector.tablesList).children('li.module-node.match-search-inside').removeClass('hidden');
				$(ivQueryAdvanceTreeview.selector.tablesList).find('li.match-search-inside').removeClass('hidden');
			}
			else {
				$(ivQueryAdvanceTreeview.selector.tablesList).children('li.table-node:not(.match-search)').addClass('hidden');
				$(ivQueryAdvanceTreeview.selector.tablesList).children('li.table-node.match-search').removeClass('hidden');
				$(ivQueryAdvanceTreeview.selector.tablesList).children('li.table-node.match-search-inside').removeClass('hidden');
			}
			ivQuery.fixQueryPosition();
		},
		wrapLabel: function(node, searchString) {
