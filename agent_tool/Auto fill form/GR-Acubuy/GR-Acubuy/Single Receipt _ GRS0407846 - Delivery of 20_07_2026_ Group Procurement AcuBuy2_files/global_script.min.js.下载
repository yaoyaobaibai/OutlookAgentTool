			var td2 = null;
			if (cellIndex == 0) {
				td2 = $('<td colspan=' + cellCount + '></td>');
			}
			else {
				td1 = $('<td colspan=' + cellIndex + '></td>');
				td2 = $('<td colspan=' + (cellCount - cellIndex) + '></td>');
			}

			if (td1 != null) {
