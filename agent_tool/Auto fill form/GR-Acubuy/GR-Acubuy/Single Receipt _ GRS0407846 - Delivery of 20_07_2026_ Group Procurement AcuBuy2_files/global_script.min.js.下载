		// Message editor
		showMessageEditor: function (target, msgType) {
			if (!this._$panel)
				this.renderPanel();

			let replyMode = true;
			let parentMsg = null;

			if (!target) {
				target = msgType;
				replyMode = false;
			}

			// Return message editor if target already has one
			if (target && target.htmlRendering.find('.iv-blog-msg-editor').length > 0) {
