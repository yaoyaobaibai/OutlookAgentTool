			const tagValuesToAdd = values.filter(function (value) { return tagValuesList.indexOf(value) < 0; });
			const templateFilterValue = data.filterTagValue;
			const $control = ivClient.get(controlId, ivClient.properties.role, ivClient.roles.selector);
			const isSelector = data && data.ivControlTypeName && (data.ivControlTypeName === 'selectorControl' || data.ivControlTypeName === 'htmlSelectControl');
			const isDropdown = !Array.contains(['checkBoxes', 'buttonList','toggleButtons', 'sliderButtons', 'rating'], data.selectorType);
			const isCheckBox = data && data.ivControlTypeName && data.ivControlTypeName === 'checkBoxControl';
