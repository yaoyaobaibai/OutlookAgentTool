autoSaveRestoreStatus = function (updatePanelElement, scope) {
	var $div = $('body').find('div[id=' + updatePanelElement.id + ']');
	$.each(__autoSaveRestoreStatus, function (id, status) {
		var $ctrl = $div.find('#' + id);
		if ($ctrl.length > 0)
			autoSaveChangeStatusClass($ctrl[0].id, status, null, scope);
	});
};

