							ivClient.set(this, ivClient.properties.readonly, ivClient.is.true(value));
						}
					});
				}
				else {
					return ivClient.invoke.readonly($control, $root, data, ivClient.is.true(value));
				}
			}
		},
		deleteValue: function ($control, value, $scope, $button) {
			if (!$scope)
				$scope = $(document);

