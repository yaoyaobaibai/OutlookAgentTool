				params['pageUrlContainer'] = $modal.find('.page-url-container-value').text();
				params['fieldCode'] = $modal.find('.field-code-value').text();
				params['clientID'] = $modal.data('ivControl');
				params['tableName'] = $modal.data('ivDataTableName');
