		calculateOverlay: function($target, load) {
			var $targetSiblings = $('[data-iv-control="' + $target.data('ivAssociatedControl') + '"]');
			if ($targetSiblings.length && $targetSiblings.get(0).classList.contains('iv-grid-container')) return;
			var $container = $targetSiblings.closest('.frame.content, [data-iv-role*=field], .dropdown-icons-wrapper, .inline.fields').first();
			var $designField;
			var offsetTop;
			var offsetLeft;

			//!$targetSiblings.is('.phc-table, .frame-container') ==> we need to calculate the overlay on these components
			//to avoid to display the overlay on the whole page. Without this, it will have no size.
			if (!$targetSiblings.length
				|| (!$targetSiblings.is('.phc-table, .frame-container') && $targetSiblings.get(0) === $container.get(0))) {
				return;
			}

			if (!$container.length) {
				$container = $targetSiblings;
			}

			$designField = $targetSiblings.first();

			const targetControlTypeName = $designField.attr('data-iv-control-type-name');

			offsetTop = $designField.offset().top - $container.offset().top;
			offsetLeft = $designField.offset().left - $container.offset().left;

			if (load !== true) {
				// Avoid to apply theses calculation on webparts
				if ($target.parents('.webpart').length === 0) {
					$target.css({
						left: offsetLeft,
						top: offsetTop,
						height: $designField.outerHeight(true) //Force the height with the same target's height.
					});
				}
			}

			if (targetControlTypeName === 'grid') {
				$target.css({
					left: '0',
					top: '0'
				});
			}

			if ($target.siblings('.context-button').length > 2) {
				$target.css('top', '0');
			}

			if (!$target.parents().hasClass('top') && !$target.parents().hasClass('controls')) {
				$target.addClass('non-override');
			}
		},
		loadDesignPanel: function(node, forceRefresh, overlay) {
			let $overlay = overlay ? $(overlay) : $('.overlay[data-iv-associated-control="' + $(node).data('ivControl') + '"]');
			const $node = node ? $(node) : GetDesignField($overlay);
			let load = true;

			$('.selected-button').removeClass('selected-button');
			if ($node.is('.ui.button')) {
				$node.addClass('selected-button');
			}
			if ($node.hasClass('cell-merge')) {
				return true;
			}
			if ($node.is('input') || $node.is('textarea')) {
				return true;
			}

			// remove class to activate the fields
			const $prevOverlay = $('.desactivated-overlay');
			$('.active-field').removeClass('active-field');
			$prevOverlay.removeClass('desactivated-overlay').removeClass(ivPopupTooltip.className.disable);
			$('.field-overlay').removeClass('field-overlay');
			$('.control-action-bar').remove();

			// abort potentially uncompleted previous panel GetDesignField ajax request (click fast between fields) and reset panel ivFieldCode value
			if (_designFieldRequestHandler && _designFieldRequestHandler.ivAsyncRequest.Executor.readyState !== 4) {
				$('#design-field').data('ivFieldCode', '');
				_designFieldRequestHandler.ivAsyncRequest.Executor.abort();
			}

			const $field = GetDesignField($node);
			// add class to activate the fields when the overlay is activated
			$field.parent().addClass('active-field');
			// manage controls without overlay (like tabControl)
			if ($overlay.length === 0) {
				$overlay = $node;
			}
			// hide tooltip
			$overlay.popup('hide');
			$overlay.addClass('desactivated-overlay').addClass(ivPopupTooltip.className.disable);

			// Avoid to add the control bar on the left panel (it's selected by default by clicking on the tab)
			if ($field.parents('.left.panel.collapsed').length > 0) {
				ivPanel.openPanel($field.parents('.left.panel.collapsed').first());
			}

			ivDesignMode.calculateOverlay($overlay, load);

			const parentNodeDataAttr = $node.closest('.designable').attr('data-iv-control-type-name');
			const nodeAttr = $node.attr('data-iv-control-type-name');

			if (parentNodeDataAttr !== 'grid') {
				$node.closest('.designable').addClass('field-overlay');
			} else if (parentNodeDataAttr === 'grid' && nodeAttr !== 'Column') {
				$node.closest('.designable').addClass('field-overlay');
			}

			const fieldId = GetDesignFieldInfo($field, 'ClientID');
			if ((!fieldId || fieldId === $('#design-field').data('ivFieldId')) && !forceRefresh && !$field.is('.tabcontrol')) {
				$('.active-design').removeClass('active-design');
				$overlay.addClass('active-design');
				designPanelToggle(true);
				return;
			}

			const designFieldInfos = ivDesignMode.GetDesignFieldInfos($field);

			if ($field.is('.tabcontrol')) {
				var $phc = $('#' + $field.data('ivControl')).find('div.designable.phc-table');
				if ($phc.length) {
					$.extend(designFieldInfos, { PlaceholderSelector: $phc.first().data('placeholderSelector') });
				}
			}

			designFieldInfos.LockProperty = designFieldInfos.LockProperty ? [designFieldInfos.LockProperty,ivClient.get(fieldId, 'lockedProperties')].join(',') : ivClient.get(fieldId, 'lockedProperties');

			ivCallMethod.InvokeDesignUtil('GetDesignField', designFieldInfos, null, null, null, 'GET');

			// Avoid to generate the control action bar in browse advance filters search buttons
			if ($field.parents('.iv-browse .iv-filter-panel-buttons').length === 0) {
				ivDesignMode.addControlActionBar($field, $overlay.parent());
				ivDesignMode.checkControlDesignActionBar($node);
			}

			$('.active-design').removeClass('active-design');
			$overlay.addClass('active-design');
		},
