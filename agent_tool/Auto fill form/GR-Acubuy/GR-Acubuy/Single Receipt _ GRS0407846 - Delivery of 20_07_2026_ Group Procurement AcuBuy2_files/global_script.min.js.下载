		pasteTexteInEditableDiv: function (event) {
			event.preventDefault();

			var editableDiv = event.target;
			var curPosBegin = 0,
				curPosEnd = 0,
				pastedText,
				sel,
				range;

			if (event.originalEvent.clipboardData)
				pastedText = event.originalEvent.clipboardData.getData("text/plain");
			else if (window.clipboardData)
				pastedText = window.clipboardData.getData("Text"); // IE11 fix

			sel = window.getSelection();

			var curText = $(editableDiv).text();
			var edgeStr = "";
			if (sel.rangeCount) {
				range = sel.getRangeAt(0);
				if (range.commonAncestorContainer.parentNode == editableDiv) {
					curPosBegin = range.startOffset;
					curPosEnd = range.endOffset;
				}
				else if (range.commonAncestorContainer == editableDiv) {
					// Edge fix
					edgeStr = " ";
					$(editableDiv).text(curText + " ");
					curPosBegin = range.startOffset;
					curPosEnd = curText.length;
				}
			}
			var finalText = curText.slice(0, curPosBegin) + pastedText + curText.slice(curPosEnd) + edgeStr;

			$(editableDiv).text(finalText);

			range.setStart(
				editableDiv.childNodes[0],
				curPosBegin + pastedText.length
			);

			if (sel != null) {
				// Edge fix
				sel.removeAllRanges();
				sel.addRange(range);
			}
		},
		renderPanel: function () {
