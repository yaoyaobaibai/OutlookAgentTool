	setCopyCutPasteState: function (type, tileGuid, notificationMessageText, width, height) {
		let me = this;
		this.clearCopyCutPaste();
		let tile = this.getTileById(tileGuid);

		if (type === "copy") tile.addClass('is-copied');
		if (type === "cut") tile.addClass('is-cut');

		ivNotificationMessage.AddMsg(notificationMessageText, null, ivNotificationMessage.criticityLevel.info, ivNotificationMessage.msgContainer.page);

		me.containerPanel.attr('tile-to-paste', tileGuid);


		let domAddTileContextMenu = $('.add-tile-context-menu')
		if (domAddTileContextMenu.length > 0) {
			// if the context menu have already been generated
			// we add the class to display the "Paste Tile" button
			if (!domAddTileContextMenu.hasClass(type + "-paste-active")) {
				domAddTileContextMenu.addClass(type + "-paste-active");
			}
		} else {
			// if the context menu is not generated we directly edit the object
			// in order to have the "Paste Tile" button displayed when we open it
			// for the first time
			let addTileContextMenu = this.contextMenu.opts.className;
			if (type == "copy" && !addTileContextMenu.includes("copy-paste-active")) {
				this.contextMenu.opts.className += " copy-paste-active ";
				this.contextMenu.opts.className = this.contextMenu.opts.className.replace("cut-paste-active", "")
			}
			if (type == "cut" && !addTileContextMenu.includes("cut-paste-active")) {
				this.contextMenu.opts.className += " cut-paste-active ";
				this.contextMenu.opts.className = this.contextMenu.opts.className.replace("copy-paste-active", "")
			}
		}
		$(document).on('keyup.esc-copy-cut', function (event) {
			if (event.key == "Escape" || event.key == "Esc") {
				me.clearCopyCutPaste()
				$(document).off(".esc-copy-cut");
			}
		});
	},

	teleportTile: function ($tile, offset) {
		let tileId = $tile.data('tile-id');
		let me = this;

		let tile = {
			id: tileId,
			top: $tile.data('tile-top'),
			left: $tile.data('tile-left'),
			height: me.roundY($tile.outerHeight(true)),
			width: me.roundX($tile.outerWidth(true))
		}

		let tileList = this.tiles.map(function () {
			let $otherTile = $(this);
			return {
				id: $otherTile.data('tile-id'),
				top: $otherTile.data('tile-top'),
				left: $otherTile.data('tile-left'),
				height: me.roundY($otherTile.outerHeight(true)),
				width: me.roundX($otherTile.outerWidth(true))
			}
		});

		let newSize = me.autoResizeTile(tileList, tile, offset.left, offset.top)

		$tile.css({
			width: newSize.width + "px",
			height: newSize.height + "px"
		})
		this.setPosition($tile, offset);
		
		var tileInfos = me.getTileInfos()

		me.raiseTileSizeChanged(tileId, Math.round(newSize.width / me.columnWidth), Math.round(newSize.height / me.rowHeight), tileInfos);
	},

	autoResizeTile: function (tilesList, tileToResize, newLeft, newTop) {
		let newWidth = tileToResize.width;
		let newHeight = tileToResize.height;

		for (let i = 0; i < tilesList.length; i++) {
			let current = tilesList[i];

			if (current.id !== tileToResize.id) {
				if (
					newLeft < current.left + current.width &&
					newLeft + newWidth > current.left &&
					newTop < current.top + current.height &&
					newTop + newHeight > current.top
				) {
					let diffLeft = current.left - newLeft;
					let diffTop = current.top - newTop;

					if (diffLeft > 0) {
						newWidth = diffLeft;
					} else {
						newWidth = newWidth + diffLeft;
					}

					if (diffTop > 0) {
						newHeight = diffTop;
					} else {
						newHeight = newHeight + diffTop;
					}
				}
			}
		}
		return { width: newWidth, height: newHeight };
	},
});

