		addOrUpdateConversation: function (convData) {
			if (!this._conversations)
				this._conversations = [];

			if (!!convData.MsgPreview && typeof convData.MsgPreview.Date === "string")
				convData.MsgPreview.Date = new Date(convData.MsgPreview.Date);

			let _convData = this._conversations.find(x => x.Conv.ConvId === convData.Conv.ConvId);

			// If conversation already exists, simply update its data
			if (!!_convData) {
				_convData.Conv = convData.Conv;
				_convData.MsgPreview = convData.MsgPreview;
				_convData.MyUnreadMsgCount = convData.MyUnreadMsgCount;
				_convData.MyUndoneMsgCount = convData.MyUndoneMsgCount;
