	}
	if (!scale) {
		scale = ivScope.DecimalPrecision;
	}
	var val = Math.floor(Math.abs(value));

	//#163885 : Avoid rounding issues
	var valuedecilength = Math.abs(value).toString().length - Math.floor(Math.abs(value)).toString().length;
	if (valuedecilength > 0)
		valuedecilength = valuedecilength -1;

	// D838681
	// In some cases, Math.pow(10, scale) * (value % 1).toFixed(valuedecilength) rounds inaccurately
	// So instead of value%1, we just take the value after the decimal separator as a string, then adjust the precision
	// (Nbr(value) is a "real" number so its decimal separator will always be a '.')
	var deci = 0;
	var splitValue = Nbr(value).toString().split('.');
	if (splitValue.length == 2) {
		deci = Math.abs(Math.round(Math.pow(10, scale - valuedecilength) * splitValue[1]));
	}

	if ((scale == 0)) {
		//begin D1050057 Rounding issue when currency scale = 0
		val = Math.round(Math.abs(value));
		//end D1050057
		deci=0;
	}
	else if (deci == Math.pow(10, scale)) {
		val=Math.floor(Math.abs(value)+Math.abs(deci/Math.pow(10, scale)));
		deci=0;
	}
	var val_format = val+"";
	var nb = val_format.length;
	for (var i = 1; i < 5; i++) {
		if (val >= Math.pow(10, (3 * i))) {
			val_format=val_format.substring(0, nb-(3*i))+separator+val_format.substring(nb-(3*i));
		}
	}
	if (scale > 0) {
		var decim = "";
		for (var j = 0; j < (scale - deci.toString().length); j++) {
			decim += "0";
		}
		deci = decim+deci.toString();
		val_format = val_format+decimalSeparator+deci;
	}
	if (parseFloat(value) < 0) {
		val_format = "-"+val_format;
	}
	return val_format;
}

function Nbr(val) {
	if (typeof val === 'string') {
		val = StringNumber(val);
		val = Number(val);
	}
	return val;
}

function StringNumber(val) {
	if (typeof val === 'string') {
		var reGroupSep = new RegExp('\\' + ivScope.UserNumberFormat.NumberGroupSeparator, "g");
		val = val.replace(reGroupSep, '');
		val = val.replace(/ /g, '');//32
		val = val.replace(/ /g, '');//160
		var re = new RegExp("\\&nbsp;", "g");
		val = val.replace(re, '');
		var reDecimalSep = new RegExp('\\' + ivScope.UserNumberFormat.NumberDecimalSeparator, "g");
		val = val.replace(reDecimalSep, '.');
		// negative sign
		val = val.replace(/([\d\.]*)-/, '-$1');
	}
	return val;
}

