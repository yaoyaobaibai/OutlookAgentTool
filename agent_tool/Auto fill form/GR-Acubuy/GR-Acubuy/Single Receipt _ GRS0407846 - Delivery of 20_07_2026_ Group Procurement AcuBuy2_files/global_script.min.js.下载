	duplicateRow: function (event) {
		const newRowsHiddenField = this.table.parents('.frame:first').find('input[data-new_objects]:first');
		const duplicateRowsHiddenField = this.table.parents('.frame:first').find('input[data-duplicate_objects]:first');
		const newId = Math.floor(Math.random() * Math.floor(10000));
		const $originalRow = $(event.target).parents('tr').first();
		const $row = $originalRow.clone();
		let oid = $row.attr('data-id');
		if (!oid) {
			// case of new line
			oid = '-' + $row.attr('new_id');
		} 
		$row.find('.iv-grid-fa-icon.icon-duplicate').closest('td').empty();
		$row.removeAttr('newobjectids');
		$row.attr('data-id', '-' + newId).attr('data-new-row', true);

		const regexReplace = new RegExp('([_:])(' + oid + ')($|[_:]?)', 'g');
		const replaceValue = '$1-' + newId + '$3'; //warning adding a '-' before the newid ...
		$row.attr('id', $row.attr('id').replaceAll(regexReplace, replaceValue));

		const $elts = $row.find('[id], [name], [onchange], [onclick], [data-iv-control], [data-iv-role]');
		const attrs = ['id', 'name', 'onchange', 'onclick'];
		$elts.each(function (index, element) {
			const $node = $(this);

			//replace attributes values
			const eltAttrs = element.attributes;
			for (let eltAttr in eltAttrs) {
				const currentAttr = eltAttrs[eltAttr];
				if (typeof currentAttr.name !== 'undefined' && (currentAttr.name.indexOf('data-') == 0 || attrs.indexOf(currentAttr.name) >= 0)) {
					if (currentAttr.name === 'id') {
						const replaceIdValue = currentAttr.value.replaceAll(regexReplace, replaceValue);

						//copy selector instance
						if (typeof __ivCtrl[currentAttr.value] !== 'undefined' && __ivCtrl[currentAttr.value] instanceof SelectorControl && typeof __ivCtrl[replaceIdValue] === 'undefined') {
							__ivCtrl[replaceIdValue] = __ivCtrl[currentAttr.value].copySelector(regexReplace, replaceValue);
						}

						//copy __ivHtmlControls instance
						if (typeof __ivHtmlControls[currentAttr.value] !== 'undefined' && typeof __ivHtmlControls[replaceIdValue] === 'undefined') {
							const newHTMLControls = Object.assign({}, __ivHtmlControls[currentAttr.value])
							const objKeys = Object.keys(newHTMLControls);
							for (var objKey in objKeys) {
								if (typeof newHTMLControls[objKeys[objKey]] === 'string') {
									newHTMLControls[objKeys[objKey]] = newHTMLControls[objKeys[objKey]].replaceAll(regexReplace, replaceValue);
								}
							}
							__ivHtmlControls[replaceIdValue] = newHTMLControls;
						}
					}
					$node.attr(currentAttr.name, currentAttr.value.replaceAll(regexReplace, replaceValue));
				}
			}

			//replace data() values
			for (let keyData in $node.data()) {
				if (typeof $node.data(keyData) === 'string') {
					$node.data(keyData, $node.data(keyData).replaceAll(regexReplace, replaceValue));
				}
			}
		});
		newRowsHiddenField.attr('value', newRowsHiddenField.val() + (newRowsHiddenField.val().length > 0 ? ',' : '') + newId);
		duplicateRowsHiddenField.val(duplicateRowsHiddenField.val() + (duplicateRowsHiddenField.val().length > 0 ? ',' : '') + oid);
		$originalRow.after($row.show().addClass('item_selected'));

		// reinitialize datepickers
		// events related to the UI datepicker are not duplicated
		$row.find(ivTextBox.selector.date).removeClass('hasDatepicker');
		// it's necessary to remove the button (it will regenerate by ivTextbox.datepicker.init() method)
		$row.find(ivTextBox.selector.dateIcon).remove();
		ivBaseHtmlControl.init($row);

		event.cancelBubble = true;
		event.cancel = true;
		event.returnValue = false;
		event.stopImmediatePropagation();
		event.stopPropagation();
		event.preventDefault();
		return false;
	},
	add: function (customAppend) {
		var eventArgument = "Add|" + (this.ctxVar.length > 0 ? "?" + this.ctxVar : "");
		var grdId = this.ClientID;
		var onAddDoneCallback = ivClient.get(grdId, ivGrid.properties.onAddDone);
