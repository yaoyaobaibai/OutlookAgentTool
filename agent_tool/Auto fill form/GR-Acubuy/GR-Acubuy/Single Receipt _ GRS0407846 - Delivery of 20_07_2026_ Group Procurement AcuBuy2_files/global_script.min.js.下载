			var $labelFound = $(node).children('.node-label[label*="' + searchString + '"]');
			if ($labelFound.length == 1) {
				$labelFound.parents('li.table-node').addClass('match-search');
				var originalLabel = $labelFound.html();
				var val = originalLabel.toLowerCase();
				var str = '';
				searchStringForReplace = val.indexOf(searchString) > -1 ? searchString : originalLabel;
				indexOfSearch = val.indexOf(searchStringForReplace) > -1 ? val.indexOf(searchStringForReplace) : RemoveAccents(val.toLowerCase()).indexOf(RemoveAccents(searchStringForReplace.toLowerCase()));
				str += originalLabel.substring(0, indexOfSearch);
				str += '<span class = "match-search-label">' + originalLabel.substring(indexOfSearch, indexOfSearch + searchStringForReplace.length) + '</span>';
