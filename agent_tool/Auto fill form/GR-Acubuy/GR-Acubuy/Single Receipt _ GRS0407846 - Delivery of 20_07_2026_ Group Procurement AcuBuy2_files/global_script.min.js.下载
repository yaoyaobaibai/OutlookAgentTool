				for (var value in collection) {
					if (!values.includes(value)) {
						values.push(value);
						Selector.add(value, collection[value], null, null, null, null, null);
					}
				}
			}

			ivClient.set(selId, ivClient.properties.value, values);
		},
		addValue: function (value, label, $control, listcolumn, $scope) {
			var Selector = ivDropdownSelector.getSelector($control);
			if (!$scope)
				$scope = $(document);

			var				
				selId = ivClient.get($control, ivClient.properties.data, 'selectorId'),				
				values = ivClient.get(selId, ivClient.properties.value),
				isSingle = ivClient.get(selId, ivClient.properties.data, 'type') === 'single',
