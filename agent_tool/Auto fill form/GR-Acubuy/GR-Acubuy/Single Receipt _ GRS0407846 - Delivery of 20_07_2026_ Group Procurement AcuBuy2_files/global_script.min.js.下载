		UpdateAutosave: function(result) {
			var data = result.content;
			var property = data['propertyName'];
			var fieldSelector = data && data['propertyAttribute'] ? 'data-iv-attribute' : 'data-iv-design-property';

			var $field = $('[' + fieldSelector + '=' + property + ']');
			$field.find('.autosave-wrapper .jumping-ellipsis').addClass('hidden');
			if (result.success) {
				var successIcon = $field.find('.autosave-wrapper .iv-save-ok');
				successIcon.removeClass('hidden');
				setTimeout(function() {
					successIcon.transition('scale', 500, function() {
						$field.find('.dropdown.icon').fadeIn(500);
					});
				}, 2000);
			}
			else {
				var errorIcon = $field.find('.autosave-wrapper .iv-save-ko');
				errorIcon.removeClass('hidden');
				setTimeout(function() {
					errorIcon.transition('scale', 500, function() {
						$field.find('.dropdown.icon').fadeIn(500);
					});
				}, 2000);
			}
		},
		DeleteSuccess: function (result, settings) {
			ivClient.set('#designPanel', ivClient.properties.loading, false);
			if (!result && !result.success) {
				return;
			}

			// additional position parameters (move other fields)
			if (settings && settings.additionalParameters) {
				if (settings.additionalParameters.delete_direction === shiftParameters.shiftUp.value) {
					ivPlaceHolderDesign.shiftFields($('#' + result.id).closest('[data-iv-target="' + settings.fieldCode + '"]'), { 'shiftUp': true, 'updateFields': true });
				}
			}

			const hiddenFieldsDisplayed = $('.dm-hidden-controls-button').prop('checked');
			if (result.content == 'hide') {
				let $field = ivClient.get(result.id, ivClient.properties.role, ivClient.roles.field);
				$field
					.toggleClass(designSettingsPanel.displayHiddenControls.dmClassEnabled, hiddenFieldsDisplayed)
					.toggleClass(designSettingsPanel.displayHiddenControls.dmClassDisabled, !hiddenFieldsDisplayed);
				//case for dcc headers
				$field.closest('th#' + result.id)
					.toggleClass(designSettingsPanel.displayHiddenControls.dmClassEnabled, hiddenFieldsDisplayed)
					.toggleClass(designSettingsPanel.displayHiddenControls.dmClassDisabled, !hiddenFieldsDisplayed)
					.toggleClass('hidden', !hiddenFieldsDisplayed);
				if (!hiddenFieldsDisplayed) {
					ivDesignMode.setClientVisibility(result.id, false);
				}
			}
			else if ($('#' + result.id + ', [data-iv-control="' + result.id + '"]').length > 0) {
				ivDesignMode.setClientVisibility(result.id, false);
				$('#' + result.id).closest('td, th').remove(); // ensure we remove the container and not just the control inside
			}

			// remove control action bar after the removing the field.
			$('.control-action-bar').remove();

			var $panel = $('.design-panel');
			$panel.addClass('collapsed');
			$panel.find(ivPanel.selector.buttonContainer).addClass(ivClient.cssClass.hidden);
			$panel.find(ivPanel.selector.panelContent).empty();
		},
