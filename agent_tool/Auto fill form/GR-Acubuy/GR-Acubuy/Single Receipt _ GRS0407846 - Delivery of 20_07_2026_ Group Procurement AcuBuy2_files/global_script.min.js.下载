		addNewComment: function ($msgEditor, parentMsg, _onSuccess) {

			var $textarea = $msgEditor.find(`.${this.cssClass.msgEditor.textarea}`);

			// Message type
			var msgType = this.findMsgType('chat');

			// GroupName
			var groupName = parentMsg ? parentMsg.groupName : this.config.groupName;

			// Content
			var content = $textarea.val();

			// Check message validity
			var errorMessages = [];
			// Make sure message content is not empty
			if (!content || content.trim().length === 0) {
				// add red style to textarea
				var err = ivValidator.get.prompt("empty", null, $textarea, {});
				ivValidator.add.prompt($textarea, [err]);
				errorMessages.push({
					id: ivClient.get($textarea, ivClient.properties.id),
					node: err,
				});
			}
			else {
				ivNotificationMessage.clear();
				ivValidator.remove.prompt($textarea);
			}
			if (errorMessages.length > 0) {
				ivValidator.add.error(errorMessages);
				return false;
			}

			// Attachments
			var attachments = $msgEditor.find(`#hdnIvBlogAddFileUploadedIds_${$msgEditor.attr('id')}`).val();

			// Pings
			var newPingeesList = [];
			$textarea.ping('getPings', function (pings) {
				$.each(pings, function (index, item) {
					newPingeesList.push(new ivJsBlogSubscriber(item.id, item.value));
				});
			});

			// Assignment - Assigned to
			var assignmentContactId = null;
			var $assignmentContainer = $msgEditor.find(`.${this.cssClass.msgEditor.assignContainer}`);
			if ($assignmentContainer.length) {
				var $chkAssignment = $assignmentContainer.find(`.${this.cssClass.msgEditor.chkAssign}`);
				if ($chkAssignment && $chkAssignment.prop('checked')) {
					var $selAssignment = $assignmentContainer.find(`.${this.cssClass.msgEditor.selAssignContact}`);
					assignmentContactId = $selAssignment ? $selAssignment.val() : null;
				}
			}

			// Assignment - Mark as done
			var assignmentStatusCode = null;
			if (parentMsg && parentMsg.assignmentStatusCode && parentMsg.assignmentStatusCode !== 'val') {
				var $chkMarkDone = $msgEditor.find(`.${this.cssClass.msgEditor.chkMarkDone}`);
				if ($chkMarkDone && $chkMarkDone.prop('checked')) {
					assignmentStatusCode = 'val';
				}
			}

			// If message is "Done" and being reassigned, reset its status to "ini"
			else if (assignmentContactId && parentMsg && parentMsg.assignmentStatusCode === 'val')
				assignmentStatusCode = 'ini';

			this.config.allowSendingMsg = false;
			this.setAllowSendingMsg(false, $msgEditor);

			var blogPanel = this;
			ivBlogAjaxHandler.sendMessage(
				groupName,
				ivFormat.formatStartTag(content),
				attachments,
				assignmentContactId,
				assignmentStatusCode,
				parentMsg?.messageId ?? null,
				newPingeesList,
				// On message sent
				function (args) {
					_onSuccess();

					blogPanel.clearUploadedFiles($msgEditor);

					if (args.messageParentId)
						$textarea.closest('.iv-blog-msg-editor').remove();

					blogPanel.config.scrollToBottom = true;
				},
				// On message rejected
				function (args) {
					ivBlogUtil.showToastMessage(ivScope.GetText('error_msg_not_send'), 'icon fa-exclamation-circle', 'red', $textarea);
				}
			);

			if (!this.config.isJsSubscribed)
				this.toggleSubscribeStatus(true);

			return true;
		},
		newGetSelectedContacts: function (contactSelectorId) {
			var selectedContacts = ivClient.get(contactSelectorId, ivClient.properties.value);

			if (selectedContacts.length <= 0) return null;

