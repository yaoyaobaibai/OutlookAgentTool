		changeRowColSpan: function(btn) {
			var $td = $(btn).parents('td[data-iv-target]:first');
			var style = '';
			var step;
			if ($(btn).hasClass(cssClass.btnIncreaseColSpan) || $(btn).hasClass(cssClass.btnDecreaseColSpan)) {
				style = 'colspan';
			}
			else {
				style = 'rowspan';
			}
			step = parseInt($td.attr(style), 10);
			var old = step;
			if (Number.isNaN(step)) {
				step = 2;
				old = 1;
			}
			else if ($(btn).hasClass(cssClass.btnIncreaseColSpan) || $(btn).hasClass(cssClass.btnIncreaseRowSpan)) {
				step += 1;
			}
			else {
				step -= 1;
				if (step <= 1) {
					//$(this).addClass('hidden');
					step = 1;
				}
			}

			$td.attr(style, step);
			var $placeholder = $(btn).parents('[data-iv-role*=placeholder]:first');
			var dragTo = GetFieldCoord($placeholder, true);
			var urlContainer = $placeholder.attr('container');
			var url = $placeholder.attr('url');

			$('#_specificFieldUrlContainer').val(urlContainer);
			var id = $td.attr('data-iv-target');

			ivDesignMode.updateStyle($td, style, step, [dragTo]);

			var actionBarIv = $(btn).parents('.control-action-bar:first').siblings('[data-iv-actionbar-associated-control]:first').attr('data-iv-actionbar-associated-control');
			var $fieldNode = $('[data-iv-control="' + actionBarIv + '"]');

			ivDesignMode.checkControlDesignActionBar($fieldNode, true);

			// TODO : designUndoStack is not defined. There is a reference in placeholder-design_script file
			designUndoStack.push({
				property: 'style', id: id, url: url, urlContainer: urlContainer, cell: $td, style: style, value: old
			});
			ivMessage.clearMsg();
			ivMessage.AddInfoMsg('<span class="dm-undo"><b>'
				+ ivScope.getTextByOS("design_undo", false) + '</b> '
				+ (designUndoStack[designUndoStack.length - 1].property == 'style' ? ivScope.GetText('design_undo_style', false) : ivScope.GetText('design_undo_move', false))
				+ '</span>');
