				//Replace msg by the new textarea
				const $modifiedDate = msg.htmlRendering.find('.iv-blog-msg-date.date-modified').clone();
				const $beforeEdition = msg.htmlRendering.find(messageContentSelector).clone();

				// Remove all content except files
				msg.htmlRendering.find(messageContentSelector).contents().filter(function () {
					return !$(this).hasClass(me.cssClass.comment.messageFiles);
				}).remove();

				msg.htmlRendering.find('.iv-blog-msg-date.date-modified').remove();

				msg.htmlRendering.find('.' + me.cssClass.comment.messageContentContainer).addClass('edit-mode');

				me.initMsgSupplierShareLabel($msgEditor);
				me.initCommentMsgZone($msgEditor, msg, false);
				me.initCommentTextArea($msgEditor, false);

				$msgEditor
					.find(`.${me.cssClass.msgEditor.textarea}`)
					.text(msg.content)
					.prop('selectionStart', $msgEditor.text().length)
					.prop('selectionEnd', $msgEditor.text().length)
					.focus()
					.off('paste')
					.on('paste', { blogPanel: me }, function (e) { e.data.blogPanel.pasteTexteInEditableDiv(e); });

				me.initCommentInput($msgEditor, msg, me._renderedMessages[msg.parentId], false, true);

				// Close button
				let $btnClose = ivBlogUtil.createButton(ivScope.GetText('g_close'), 'fa-times', `${me.cssClass.msgEditor.btnClose} iv-button borderless`)
					.on('click', function () {
						let $editContainer = $msgEditor.closest('.' + me.cssClass.comment.messageContent);
						if ($editContainer.length === 0)
							return;

						if (!confirm(ivScope.GetText('confirm_cancel_edit')))
							return;

						$editContainer
							.after($beforeEdition)
							.after($modifiedDate)
							.remove();

						$beforeEdition.closest('.edit-mode').removeClass('edit-mode');

						me.displayMainMsgEditor(true);
						me.signalRClientBroadcastEventUnPause();
					});

				$msgEditor.find('.iv-blog-msg-text-input').append($btnClose);

				// Override editor's submit to update message instead of sending a new one
				let submitEditMessage = function () {
					me.updateComment(msg);
					msg.htmlRendering.find('.edit-mode').removeClass('edit-mode');
					me.displayMainMsgEditor(true);
				}

				$msgEditor
					.find(`.${me.cssClass.msgEditor.textarea}`)
					.focus()
					.off('keydown')
					.on('keydown', { callBack: submitEditMessage }, me.catchEnterKey);

				$msgEditor
					.find(`.${me.cssClass.msgEditor.btnSendMessage}`)
					.off('click')
					.on('click', function () {
						submitEditMessage()
						return false;
					})
					.removeClass('hidden');

				msg.htmlRendering
					.find('.iv-blog-msg-files .iv-delete-file')
					.off('click')
