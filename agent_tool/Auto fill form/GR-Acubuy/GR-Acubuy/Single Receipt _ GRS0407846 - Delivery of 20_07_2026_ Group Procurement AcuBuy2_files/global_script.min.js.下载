		static addDynamicHover(containerNode, targetNode) {
			$(targetNode).addClass('hidden');

			$(containerNode).mouseover(function () {
				$(targetNode).removeClass('hidden');
			});
			$(containerNode).mouseout(function () {
				if (!$(targetNode).hasClass('active'))
					$(targetNode).addClass('hidden');
