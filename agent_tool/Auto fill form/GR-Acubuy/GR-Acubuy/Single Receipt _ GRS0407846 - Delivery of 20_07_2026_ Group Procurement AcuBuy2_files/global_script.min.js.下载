				$('#' + designAddingControlPanel.id + ' button.close').one('click.' + eventNamespace, { hideOnly: true, isCloseButton: true }, designAddingControlPanel.toggleControlPanel);
			}
		},
		setPanelPosition: function(trigger, direction) {
			var $body = $('#body');
			var $panel = $('#' + designAddingControlPanel.id);
			var $trigger = $(trigger).closest(selector.designActionButton);

			// prevent if the panel is already visible
			if ($panel.is(':visible')) {
				$trigger.removeClass('active');
				return;
			}
			$trigger.addClass('active');

			var bodyWidth = parseInt($body.width(), 10);
			var bodyHeight = parseInt($body.height(), 10);
			var panelWidth = parseInt($panel.width(), 10);
			var panelHeight = parseInt($panel.height(), 10);
			var directionOrder = panelDirectionOrder.slice();
			var defaultDirection = panelDirectionOrder[0];
			var currentDirection = $trigger.data('ivPanelDirection');
			if (!currentDirection && !directionOrder.includes(currentDirection)) {
				if (direction && directionOrder.includes(direction)) {
					currentDirection = direction;
				}
				else {
					currentDirection = defaultDirection;
				}
			}
			// if a direction has been defined, change the order
			while (currentDirection !== directionOrder[0]) {
				directionOrder.push(directionOrder.shift());
			}

			var offset = $trigger.offset();
			var width = parseInt($trigger.width(), 10);
			var height = parseInt($trigger.height(), 10);
			// calculate the center of the trigger
			var refPoint = {
				top: parseInt(offset.top, 10) + (height / 2),
				left: parseInt(offset.left, 10) + (width / 2)
			};
			var fixedTop;

			// prevent CSS classes (i.e. Semantic UI .ui.popup rules)
			var defaultPosition = {
				top: 'auto',
				left: 'auto',
				right: 'auto',
				bottom: 'auto'
			};
			var newPosition = Object.assign({}, defaultPosition);

			var oobCheck = false;
			do {
				// "center" & "random" positions are not managed by the loop
				currentDirection = directionOrder.shift();
				// bottom left (position: 3)
				if (currentDirection === panelDirections.bottomLeft) {
					newPosition.top = refPoint.top;
					newPosition.right = bodyWidth - refPoint.left;
					// check out of bounds
					// top border: newPosition.top < 0 (useless)
					// left border: refPoint.left - panelWidth < 0
					// right border: newPosition.right > bodyWidth (useless)
					// bottom border: newPosition.top + panelHeight > bodyHeight
					oobCheck = !(refPoint.left - panelWidth < 0 || newPosition.top + panelHeight > bodyHeight);
				}
				// bottom right (position: 1)
				else if (currentDirection === panelDirections.bottomRight) {
					newPosition.top = refPoint.top;
					newPosition.left = refPoint.left;
					// check out of bounds
					// top border: newPosition.top < 0 (useless)
					// left border: newPosition.left < 0 (useless)
					// right border: newPosition.left + panelWidth > bodyWidth
					// bottom border: newPosition.top + panelHeight > bodyHeight
					oobCheck = !(newPosition.left + panelWidth > bodyWidth || newPosition.top + panelHeight > bodyHeight);
				}
				// left (position: 6)
				else if (currentDirection === panelDirections.left) {
					newPosition.right = bodyWidth - refPoint.left;
					// check out of bounds
					// left border: refPoint.left - panelWidth < 0
					if (refPoint.left - panelWidth >= 0) {
						fixedTop = false;
						// calculate the "right" top position
						// check top border
						newPosition.top = refPoint.top - (panelHeight / 2);
						if (newPosition.top < 0) {
							newPosition.top = 0;
							fixedTop = true;
						}
						if (newPosition.top + panelHeight > bodyHeight) {
							if (!fixedTop) {
								newPosition.top = bodyHeight - panelHeight;
								oobCheck = true;
							}
						}
						else {
							oobCheck = true;
						}
					}
				}
				// right (position: 5)
				else if (currentDirection === panelDirections.right) {
					newPosition.left = refPoint.left;
					// check out of bounds
					// right border: newPosition.left + panelWidth > bodyWidth
					if (newPosition.left + panelWidth <= bodyWidth) {
						fixedTop = false;
						// calculate the "right" top position
						// check top border
						newPosition.top = refPoint.top - (panelHeight / 2);
						if (newPosition.top < 0) {
							newPosition.top = 0;
							fixedTop = true;
						}
						if (newPosition.top + panelHeight > bodyHeight) {
							if (!fixedTop) {
								newPosition.top = bodyHeight - panelHeight;
								oobCheck = true;
							}
						}
						else {
							oobCheck = true;
						}
					}
				}
				// top left (position: 4)
				else if (currentDirection === panelDirections.topLeft) {
					newPosition.bottom = bodyHeight - refPoint.top;
					newPosition.right = bodyWidth - refPoint.left;
					// check out of bounds
					// top border: refPoint.top - panelHeight < 0
					// left border: refPoint.left - panelWidth < 0
					// right border: newPosition.right > bodyWidth (useless)
					// bottom border: newPosition.bottom > bodyHeight (useless)
					oobCheck = !(refPoint.top - panelHeight < 0 || refPoint.left - panelWidth < 0);
				}
				// top right (position: 2)
				else if (currentDirection === panelDirections.topRight) {
					newPosition.bottom = bodyHeight - refPoint.top;
					newPosition.left = refPoint.left;
					// check out of bounds
					// top border: refPoint.top - panelHeight < 0
					// left border: newPosition.left < 0 (useless)
					// right border: newPosition.left + panelWidth > bodyWidth
					// bottom border: newPosition.bottom > bodyHeight (useless)
					oobCheck = !(refPoint.top - panelHeight < 0 || newPosition.left + panelWidth > bodyWidth);
				}
				// reset position
				if (!oobCheck) {
					newPosition = Object.assign({}, defaultPosition);
				}
			}
			while (!oobCheck && directionOrder.length);
			$panel.css(newPosition);
		},
