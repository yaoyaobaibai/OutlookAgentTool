			$messageBlock.find('.' + this.cssClass.comment.btnOtherActionDeleteMessage).on('click', { blogPanel: this, message: msg }, this.messageEventHandlers.btnOtherActionDeleteClick);
			$messageBlock.find('.' + this.cssClass.comment.btnOtherActionMarkDoneMessage).on('click', { blogPanel: this, message: msg }, this.messageEventHandlers.btnOtherActionMarkDoneClick);
			$messageBlock.find('.' + this.cssClass.comment.btnOtherActionReplyMessage).on('click', { blogPanel: this, message: msg }, this.messageEventHandlers.btnReplyClick);
			$messageBlock.find('.' + this.cssClass.comment.btnCommentReply)
				.off('mousedown')
