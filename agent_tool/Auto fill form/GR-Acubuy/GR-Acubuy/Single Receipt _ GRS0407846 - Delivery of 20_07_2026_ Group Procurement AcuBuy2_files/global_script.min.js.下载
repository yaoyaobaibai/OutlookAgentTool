	var isRotating = true;

	/**
	 * Get the application base relative path.
	 */
	function getApplicationBasePath() {
		return ivScope.ApplicationPath === '/'
			? ''
			: ivScope.ApplicationPath;
	}

	/**
	 * Get an image relative path from its id.
	 * @param {string} id file id.
	 * @returns {string} relative image path.
	 * @deprecated use ivScope.BareUrl() instead
	 */
	function getImageRelativePath(id) {
		return ivScope.BareUrl('fil', 'download', [id]);
	}

	/**
	 * Get script file path for 3D libs.
	 * @param {string} name file name.
	 * @returns {string} full file path.
	 */
	function getScriptFilePath(name) {
		var baseThreeJSScriptsFilePath = '/dist/third-party/three/';
		return baseThreeJSScriptsFilePath + name + (ivScope.Debug ? '.js' : '.min.js');
	}

	/**
	 * Get the extension of a file name.
	 * @param {string} fileName file name.
	 * @returns {string} file extension.
	 */
	function getFileExtension(fileName) {
		var fileNameTab = fileName.split('.');
		return fileNameTab.length > 0 ? fileNameTab[fileNameTab.length - 1].toLowerCase() : '';
	}

	/**
	 * Get the file category.
	 * @param {string} fileName file name.
	 * @returns {TYPES} file category.
	 */
	function getFileType(fileExtension) {
		if (VIEWABLE_MISC_EXTENSIONS.indexOf(fileExtension) > -1)
			return TYPES.TEXT;

		if (VIEWABLE_IMAGE_EXTENSIONS.indexOf(fileExtension) > -1)
			return TYPES.IMAGE;

		if (VIEWABLE_CAD_EXTENSIONS.indexOf(fileExtension) > -1)
			return TYPES.CAD;

		if (VIEWABLE_DOC_EXTENSIONS.indexOf(fileExtension) > -1)
			return TYPES.DOCUMENT;

		return TYPES.UNKNOWN;
	}

	/**
	 * Initialize overlay HTML content.
	 * @param {string} fileName file name to be displayed.
	 * @param {string} fileId file id to be displayed.
	 * @param {string} fileExtension extension of the file to be displayed.
	 * @returns {string} HTML content.
	 */
	function getOverlayContent(fileName, fileId, fileExtension) {
		var contentTab = [];


		// Get file extension and type
		var fileType = getFileType(fileExtension);


		// Viewer header
		// -------------
		contentTab.push('<div class="viewer-header">');
		contentTab.push('  <h3>');
		// Back icon
		contentTab.push('    <button id="closeViewer" class="ui icon borderless button image-control" title="' + ivScope.GetText('close_viewer') + '">');
		contentTab.push('      <i class="fa fa-arrow-left icon"></i><span class="sr-only">' + ivScope.GetText('close_viewer') + '</span>');
		contentTab.push('    </button>');

		// Filename
		contentTab.push('    <span class="title">' + ivFunction.htmlEncode(fileName) + '</span>' || '<span class="title title-without-name">' + ivScope.GetText('file_unknown_title') + '</span>');
		contentTab.push('  </h3>');
		contentTab.push('</div>');

		// Viewer content
		// --------------
		contentTab.push('<div class="viewer-content ' + TYPES.UNKNOWN + '-viewer" data-type="' + fileType + '" data-ext="' + fileExtension + '" data-id="' + fileId + '">');
		contentTab.push('  <div class="viewer-placeholder">' + ivScope.GetText('loading') + '</div>');
		contentTab.push('</div>');

		// Navigation arrows
		// -----------------
		contentTab.push(htmlIconButton('chevron-left', ivScope.GetText('navigate_prev_file'), 'image-control navigate-file navigate-prev invisible', 'right center'));
		contentTab.push(htmlIconButton('chevron-right', ivScope.GetText('navigate_next_file'), 'image-control navigate-file navigate-next invisible', 'left center'));

		return contentTab.join('');
	}

	/**
	 * Update data and content for navigation between files.
	 * @param {jQuery} $overlay overlay jQuery element.
	 * @param {string} fileId current file id.
	 */
	function updateNavigation($overlay, fileId) {
		var $link = getLinkToFileFromId(fileId);

		// If file not found, remove potential arrows
		if ($link.length === 0) {
			$overlay.find('button.navigate-file').addClass('invisible');
			return;
		}

		// If previous file, add a left arrow
		updateNavigationArrow('prev', $link);

		// If next file, add a right arrow
		updateNavigationArrow('next', $link);
	}

	/**
	 * Update navigation arrow to point to the correct next or previous file.
	 * @param {'prev'|'next'} direction direction to navigate.
	 * @param {jQuery} $linkFile hyperlink that corresponds to the current file.
	 */
	function updateNavigationArrow(direction, $linkFile) {
		var $file = $linkFile.closest('.viewable-file');
		var $fileOther = direction === 'next' ? $file.nextAll('.viewable-file') : $file.prevAll('.viewable-file');
		var $navButton = $overlay.find('button.navigate-' + direction);

		if ($fileOther.length === 0 || $linkFile.length !== 1) {
			$navButton.addClass('invisible');
			return;
		}

		var $btnCloseOther = $fileOther.first().find('button[file_guid]');
		var title = ivScope.GetText('navigate_file', $btnCloseOther.attr('file_name'));
		$navButton
			.removeClass('invisible')
			.data('id', $btnCloseOther.attr('file_guid'))
			.data('name', $btnCloseOther.attr('file_name'))
			.data('ext', $btnCloseOther.attr('file_ext'))
			.attr('data-html', title)
			.find('span')
			.text(title);
	}

	/**
