			btnOtherActionDeleteClick: function (e) {
				let me = e.data.blogPanel;
				let msg = e.data.message;

				if (confirm(`${ivScope.GetText('delete_message')} "${msg.content}" ?`)) {
					me.deleteComment(msg);
					me.displayMainMsgEditor(true);
				}
			},
			btnOtherActionMarkDoneClick: function (e) {
				let me = e.data.blogPanel;
				let msg = e.data.message;

				let mainMsg = msg.parentId ? me._renderedMessages[msg.parentId] : msg;
				let newStatusCode = null;
				if (mainMsg.assignmentStatusCode === 'ini')
					newStatusCode = 'val';
				if (mainMsg.assignmentStatusCode === 'val')
					newStatusCode = 'ini';

				me.setMessageAssignmentStatus(mainMsg, newStatusCode, msg);
			},
			btnReplyClick: function (e) {
				let me = e.data.blogPanel;
				let msg = e.data.message;
				let $msgEditor = msg.htmlRendering.find('.iv-blog-msg-sub .iv-blog-msg-editor').first();

				// If reply block already exists, close it
				if ($msgEditor && $msgEditor.length > 0) {
					$(this).attr('aria-expanded', false);
					$msgEditor.closest('.iv-blog-msg').remove();
					me.showAddReplyBlock(msg);
					me.displayMainMsgEditor(true);
					me._currentlyEditing = null;
					return;
				}

				if (me._currentlyEditing != null) {
					let cancel = !me.tryCloseMessageEditor(me._currentlyEditing);
					if (cancel)
						return;
					}

				me._currentlyEditing = msg;
					

				$(this).attr('aria-expanded', true);

				$msgEditor = me.showMessageEditor(msg);
			

				setTimeout(function () {
					$msgEditor.find(`.${me.cssClass.msgEditor.textarea}`).focus();
				}, 200);

				me.hideAddReplyBlock(msg);
				//Hide main message zone when we reply on a comment.
				me.displayMainMsgEditor(false);
				me.signalRClientBroadcastEventPause();
