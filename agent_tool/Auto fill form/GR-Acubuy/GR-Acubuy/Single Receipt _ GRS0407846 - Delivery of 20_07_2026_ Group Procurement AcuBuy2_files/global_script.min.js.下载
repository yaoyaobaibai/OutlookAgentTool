				let hasUnreadMsg = this._conversations.some(convData => convData.Conv.ConvType == 'internal' && convData.MyUnreadMsgCount > 0);
				let hasUndoneMsg = this._conversations.some(convData => convData.Conv.ConvType == 'internal' && convData.MyUndoneMsgCount > 0);
				let markerClass = (hasUnreadMsg ? 'has-unread-msg' : '') + ' ' + (hasUndoneMsg ? 'has-undone-objects' : '');
