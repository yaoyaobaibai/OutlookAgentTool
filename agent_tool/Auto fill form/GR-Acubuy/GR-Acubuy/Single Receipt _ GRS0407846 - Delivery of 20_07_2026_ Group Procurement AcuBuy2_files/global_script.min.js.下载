				}
			}
		},
		topdown: function () {
			var ddl = this.SelectorControl;
			if (!ddl)
				return;
			ddl.value = this.value;
			if ((BrowseIE && !ddl.value) || (!BrowseIE && (!ddl.options[ddl.selectedIndex] || ddl.options[ddl.selectedIndex].value != this.value))) {
				var l = ddl.options.length;
