						});

						$modal.off("resizestop" + modalNamespace).on("resizestop" + modalNamespace, function (event, ui) {							
							$(this).removeClass('ui-resize-helper');
							//setting wrapper size
							let totalHeight = this.clientHeight;
							let titleHeight = this.querySelector('#modalTitle')?.clientHeight ?? 0;
							let footerHeight = this.querySelector('#footerContainer')?.clientHeight ?? 0;
							let contentHeight = totalHeight - titleHeight - footerHeight;
							this.querySelector('.wrapper').style.height = contentHeight + 'px';

							//checking modal position (no outside the screen)
							if (this.offsetLeft < 0 && this.style?.left !== null) {
								let maxLeft = Number(this.style.left.replace('px', '')) - this.offsetLeft;
								this.style.left = maxLeft + 'px';
							}

							if (this.offsetTop < 0 && this.style?.top !== null) {
								let maxTop = Number(this.style.top.replace('px', '')) - this.offsetTop;
								this.style.top = maxTop + 'px';
							}
						});
					}
					var w = $(this).find("#headerContainer").outerWidth(true) + $(this).find('.close.icon').outerWidth(true);
					var head = $(this).find('.header:first'),
						$iframe = $('iframe#' + $(this).attr('data-modal-id')),
						$body = $iframe.parents('body'),
						$form = $body.find('#mainForm');

					$form.attr('aria-hidden', 'true');
					$iframe.attr('title', head.text());
					if (head.length > 0) {
						if (w > 0) {
							head.css('padding-right', w + 'px'); //padding for long text title
						}
						if (head[0].scrollWidth > head[0].clientWidth) { //Adds tooltip if title is overflowing
							head.attr("data-html", head.text())
								.attr("data-iv-role", "control tooltip")
