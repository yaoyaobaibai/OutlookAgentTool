			if (ivScope.infos.Mode === "mobile.aspx") {
				centered = false;
				closable = true;
			}

			$modal.modal({
				centered: centered,
				closable: closable,
				context: $(this.contentDocument).find('#mainForm')[0],
				onHide: function ($element) {
					// will only work on modern browser
					if (typeof event !== 'undefined') {
						var keyCode = event.keyCode,
							dropdown = event.target.closest('.ui.dropdown');
						if (dropdown !== null) { // needs to be handled here since ivDropdownSelector.dropdownKeyDown is triggered after this event 
							var isOpen = $(dropdown).dropdown('is visible');
							if (isOpen && keyCode === KEYS.ESCAPE) {
								ivDropdownSelector.hideSuggestion(dropdown);
								abort(event);
								return false;
							}
						}
					}
					return true;
				},
				onHidden: function (e) {
					//invoke onHiddenMethod with the modal as parameter
					if (onHidden) {
						onHiddenMethod.apply(e);
					}

					const $iframe = $('iframe#' + $(this).attr('data-modal-id'), upperDocument);
					const $body = $iframe.parents('body');
					const $form = $body.find('#mainForm');

					$form.attr('aria-hidden', 'false');
					$iframe.get(0).contentWindow.upperWindow.modalOnHiddenCallBack(e, $iframe.parent(), $(this).attr('data-modal-id'));
				},
				duration: duration,
				onShow: function (e) {
					//hack for screenHeight semantic's method. When doing .modal('show'), it will calculate the main body height if the modal is too long
					//We don't want to assign a particular height because the modal is already scrolling.
					if (!$(this).hasClass('mini')) {
						$('iframe#' + $(this).attr('data-modal-id')).closest('body').css('height', '');
					}
				},
				onVisible: function (e) {
					const $modal = $(this);
					const modalNamespace = '.ivModal';

					if (!$(this).hasClass('fullscreen-nomargin')) {
						//resizable setup and initialization
						const maxResizeWidth = $modal.parent().width() * 0.95; //according to CSS rule equal to 95%  max for a modal's width
						const maxResizeHeight = $modal.parent().height() * 0.95; //according to CSS rule equal to 95%  max for a modal's width
						const minWidth = 400, minHeight = 400;
						settings = {
							minHeight: minHeight,
							minWidth: minWidth,
							maxWidth: maxResizeWidth,
							maxHeight: maxResizeHeight
						};						
						$modal.draggable({ containment: "body", handle: "> .header", cancel: '.modal-title-text' });
						$modal.resizable(settings);

						$modal.off("resizestart" + modalNamespace).on("resizestart" + modalNamespace, function (event, ui) {
							$(this).css({
								'width': ui.size.width + 'px',
								'height': ui.size.height + 'px',
								'top': ui.position.top + 'px',
								'left': ui.position.left + 'px'
