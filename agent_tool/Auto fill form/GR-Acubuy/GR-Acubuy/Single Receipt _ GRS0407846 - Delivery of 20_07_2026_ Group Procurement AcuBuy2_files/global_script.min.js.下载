					break;

				var label = null;

				if (hist.action_code === 'assign')
					label = ivScope.GetText('blog_panel_assigned_to', hist.contact_name);
				else if (hist.action_code === 'reassign')
					label = ivScope.GetText('blog_panel_reassigned_to', hist.contact_name);

				var $item = $('<div/>', { class: 'iv-blog-msg-assignment-history-item' }).text(label);
				$msgAssigmentHistory.append($item);
			}

			$msgContentWrapper.append($msgAssigmentHistory);
		},
		renderMessageSubList: function (msg) {

