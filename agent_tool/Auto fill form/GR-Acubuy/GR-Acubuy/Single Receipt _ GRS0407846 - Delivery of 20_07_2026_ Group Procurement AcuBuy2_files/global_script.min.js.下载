			var originalSearchString = searchString;
			$('.match-search-label').contents().unwrap();

			$(ivQueryAdvanceTreeview.selector.tablesList).find('.match-search').removeClass('match-search');
			$(ivQueryAdvanceTreeview.selector.tablesList).find('.match-search-inside').removeClass('match-search-inside');
			$context.find('.fa-arrow-down').remove();

			var found = false;
			if (!searchString || searchString == '' || searchString.length < 3) {
				$(ivQueryAdvanceTreeview.selector.tablesList).children('li.module-node').removeClass('hidden');
				$('ul.table-tree li.table-node').removeClass('hidden');
