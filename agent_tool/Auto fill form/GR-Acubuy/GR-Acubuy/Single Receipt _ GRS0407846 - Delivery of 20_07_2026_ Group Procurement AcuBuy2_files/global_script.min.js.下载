	 * Gets the empty cell of a row.
	 * The method returns the cell if it's the next element in the DOM. It ignores non-visible cells
	 * @param {Element} target a DOM element that represents the active table cell
	 */
	function findEmptyCell(target) {
		var td = target;
		var emptyCell = td.nextElementSibling;
		while (emptyCell && !emptyCell.classList.contains('empty-cell')) {
			// if the next td is not visible, go the next one
			if (emptyCell.classList.contains('hidden')) {
				emptyCell = emptyCell.nextElementSibling;
			}
			else {
				emptyCell = null;
			}
		}
		return emptyCell;
	}

	function hasOrientationParam(area) {
		if (!area || area.closest('.iv-datacollection-control') !== null || area.closest('.iv-grid-view') !== null)
			return false;
		const cell = area.closest('td');
		return cell !== null && cell.closest('.iv-filter-panel-content') === null;
	}

	function hasShiftOption($area, $origin) {
		const $cell = $area.closest('th, td');
		return $area.hasClass('dm-innerline')
			&& ($area.hasClass('dm-top') || $area.hasClass('dm-bottom'))
			&& $cell.is('td')
			&& $cell.closest('.iv-filter-panel-content').length === 0
			&& hasMultipleFieldsBelow($cell, $origin);
	}

	function hasMultipleFieldsBelow($cell, $excludedCell) {
		if (!$cell) return false;
		const $row = $cell.parent();
		// do not count excluded cell (the cell we are trying to move for example)
		let ivTarget = '';
		if ($excludedCell)
			ivTarget = $excludedCell.attr('data-iv-target');
		return $row.nextAll('tr').not('.hidden').children('td').filter(function() {
			return !$(this).hasClass('hidden')
				&& $(this).attr('data-iv-target') && $(this).attr('data-iv-target') !== ivTarget;
		}).length > 1;
	}

	/**
	 * Remove useless bottom innerline areas which have explicit area just below.
	 * Needed as on server side we can't be sure of which line/cell will be below the other one and visible.
	 */
	function removePlaceholdersDuplicateAreas($target) {
		if (typeof $target === 'undefined')
			$target = $('body');

		$target.find('.' + cssClass.designActions.explicit).each(function() {
			const $cell = $(this).parent('td').first();
			if ($cell.length === 0 || $cell.hasClass('hidden') || $cell.closest('tr').hasClass('hidden'))
				return;

			const colFieldInfo = ivPlaceHolderDesign.getFieldsInColumn($cell, { 'checkTop': true, 'onlyFirstRow': true, 'onlyFittingFields': true });
			if (colFieldInfo && colFieldInfo.$fields.length > 0) {
				colFieldInfo.$fields[0].nextAll('td').andSelf().children('.' + cssClass.designActions.bottom).remove();
			}
		});
	}

	/**
	 * Refreshs implicit and explicit areas of a placeholder
	 * @param {any} target JQuery object or a DOM element that represents a placeholder
	 */
	function refreshPlaceholderAreas(target) {
		var phc = target;
		if (phc instanceof jQuery) {
			phc = $(phc).get(0);
		}

		var allowHorizontal = ivClient.get(phc, ivClient.properties.data, 'ivAllowHorizontalImplicitAreas');
		var allowVertical = ivClient.get(phc, ivClient.properties.data, 'ivAllowVerticalImplicitAreas');
		var areas = phc.querySelectorAll(':scope > tbody > tr[data-iv-coord-y] > td > ' + selector.designActionButton);
		areas.forEach(function removeArea(area) {
			area.remove();
		});

		var rows = phc.querySelectorAll(':scope > tbody > tr[data-iv-coord-y]');
		var maxCells = 0;
		var cells;
		var y;
		var x;
		var nbCells;

		// get max cells by row
		for (y = 0; y < rows.length; y++) {
			cells = rows[y].querySelectorAll(':scope > td:not(.hidden):not(.empty-cell)');
			nbCells = 0;
			for (x = 0; x < cells.length; x++) {
				if (cells[x].colSpan) {
					nbCells += cells[x].colSpan;
				}
				else {
					nbCells += 1;
				}
			}
			maxCells = Math.max(maxCells, nbCells);
		}

		if (!maxCells) {
			maxCells = 1;
		}

		for (y = 0; y < rows.length; y++) {
			cells = rows[y].querySelectorAll(':scope > td:not(.hidden):not(.empty-cell)');
			nbCells = 0;
			var emptyCell = rows[y].querySelector(':scope > td.empty-cell');
			if (cells.length) {
				for (x = 0; x < cells.length; x++) {
					if (cells[x].colSpan) {
						nbCells += cells[x].colSpan;
					}
					else {
						nbCells += 1;
					}
					// implicit areas for all cells
					if (y === 0 && allowHorizontal) {
						addImplicitArea(cells[x], cssClass.designActions.top);
					}
					if (allowVertical) {
						addImplicitArea(cells[x], cssClass.designActions.left);
					}
					if (allowHorizontal) {
						addImplicitArea(cells[x], cssClass.designActions.bottom);
					}
					var nextTd = findEmptyCell(cells[x]);
					if (allowVertical && ((nbCells < maxCells && !nextTd) || (nbCells === maxCells && nextTd))) {
						addImplicitArea(cells[x], cssClass.designActions.right);
					}
				}
			}
			// explicit areas
			if (nbCells < maxCells || nbCells === 0) {
				addExplicitArea(emptyCell);
			}
		}
		removePlaceholdersDuplicateAreas($(phc));
	}

	/**
 * Refreshs implicit and explicit areas of a grid
 * @param {any} target JQuery object or a DOM element that represents a grid
 */
	function refreshGridAreas(target) {
		let phc = target;
		if (phc instanceof jQuery) {
			phc = $(phc).get(0);
		}

		const areas = phc.querySelectorAll(selector.designActionButton);
		areas.forEach(function removeArea(area) {
			area.remove();
		});

		const headerCells = phc.querySelectorAll(':scope th');
		let previousCellHasRightArea = false;
		headerCells.forEach(function addImplicitAreas(cell) {
			// implicit areas
			const notMovable = cell.querySelector('[data-iv-allow-drag="False"]') !== null;

			if (notMovable) {
				previousCellHasRightArea = false;
			}
			else {
				if (!previousCellHasRightArea) {
					addImplicitArea(cell, cssClass.designActions.left);
				}

				addImplicitArea(cell, cssClass.designActions.right);
				previousCellHasRightArea = true;

				const items = cell.querySelectorAll('.iv-dcc-table-item-header-wrapper');
				items.forEach(function addBottomArea(item, i) {
					if (i === 0) {
						addImplicitArea(item, cssClass.designActions.top);
					}
					addImplicitArea(item, cssClass.designActions.bottom);
				});
			}
		});
		}

	/**
	 * Refreshs implicit and explicit areas
	 * @param {any} target JQuery object or a DOM element
	 */
	function refreshDesignAreas(target) {
		var phc = target;
		if (phc instanceof jQuery) {
			phc = $(phc).get(0);
		}
		var placeholderContainerId = phc.getAttribute('data-phc-dcc-id') ?? phc.getAttribute('placeholderforgridid');
		if (placeholderContainerId) {
			refreshGridAreas(phc);
		}
		else {
			refreshPlaceholderAreas(phc);
		}
	}

	/**
	 * Change the behavior of implicit / explicit areas
	 * @param {any} scope a JQuery object or a DOM element that represents a placeholder
	 * @param {object} action a key of designActions object
	 */
	function changeDesignAction(scope, action) {
		var s = scope;
		if (s instanceof jQuery) {
			s = $(s).get(0);
		}

		var buttons = s.querySelectorAll(selector.designActionButton + ', ' + selector.designAddTabButton);
		buttons.forEach(function changeAction(button) {
			// icon part
			var icon = button.querySelector('.icon-foreground');

			Object.keys(designActions).forEach(function removeClass(key) {
				const da = designActions[key];
				button.classList.remove(da.cssClass);
				icon.classList.remove(da.icon);
			});
			button.classList.add(action.cssClass);
			icon.classList.add(action.icon);
		});
	}

	function toggleAreasBase(show, $explicitAreas, $targetExplicitAreas, $implicitAreas, $targetImplicitAreas) {
		if (!show) {
			$targetExplicitAreas.addClass('notransition');
			$targetImplicitAreas.addClass('notransition');
		}

		const $hiddenExplicit = $explicitAreas.not($targetExplicitAreas);
		const $hiddenImplicit = $implicitAreas.not($targetImplicitAreas);

		// adding mode
		$explicitAreas.toggleClass(ivDesignMode.getAddingFieldCssClass(), !show);
		$hiddenExplicit.toggleClass('hidden', show);
		$targetExplicitAreas.find('i').toggleClass('hidden', show);
		toggleTargetArea($targetExplicitAreas, show);

		$implicitAreas.toggleClass(ivDesignMode.getAddingFieldCssClass(), !show);
		$hiddenImplicit.toggleClass('hidden', show);
		$targetImplicitAreas.children('.fa-stack').toggleClass('hidden', show);
		toggleTargetArea($targetImplicitAreas, show);

		if (!show) {
			// flush css to handle the "notransition"
			if ($targetImplicitAreas.length)
				$targetImplicitAreas[0].offsetHeight;

			$targetExplicitAreas.removeClass('notransition');
			$targetImplicitAreas.removeClass('notransition');
		}
	}

	function toggleTargetArea($elem, show) {
		$elem.toggleClass(designActions.cutPaste.cssClasses.target, show);

		if (show)
			$elem.append($('<i/>', { class: 'icon ' + designActions.cutPaste.icons.target }));
		else
