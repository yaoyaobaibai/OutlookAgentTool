	*   @access	 public
	*/
	this.MouseOver = function() {
		ivCurMenu = ivMenuCollection.getMenu(this.id);

		ivCurMenu.hideMenu(this.id, 0);
		ivCurMenu.showMenu(this.id);
	}
}


