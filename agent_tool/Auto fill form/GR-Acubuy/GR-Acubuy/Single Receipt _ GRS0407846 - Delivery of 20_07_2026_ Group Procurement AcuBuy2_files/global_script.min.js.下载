	 */
	function finalizeDocumentDisplay() {
		// Apply the correct viewer design
		$overlay.find('.viewer-content')
			.removeClass(TYPES.UNKNOWN + '-viewer')
			.addClass(TYPES.DOCUMENT + "-viewer");

		// Remove loading message
		$overlay.find('.viewer-placeholder').remove();

		// Display the content
		$overlay.find('.viewer-content > iframe').removeClass('out-of-view');
	}

	/**
	 * Load a simple text file.
	 * Display the text content directly in a div.
	 * @param {string} text text content.
	 */
	function loadText(text) {
		var $content = $overlay.find('.viewer-content');
		var paragraphs = text.split(/\n\r/g);

		// Clear loading text
		$content.text('');

		// Append each paragraph
		for (var i = 0; i < paragraphs.length; i++) {
			var $element = document.createElement('p');
			$element.innerText = paragraphs[i];
			$content.append($element);
		}

		// Set viewer type
		$content.removeClass(TYPES.UNKNOWN + '-viewer').addClass(TYPES.TEXT + "-viewer");
	}

	/**
	 * Load a file depending of its category.
	 * @param {jQuery} $overlay overlay area where to attach the content.
	 * @param {string} fileId file identifier.
	 * @param {string} fileExtension file extension (which will determine the category).
	 */
	function loadFile($overlay, fileId, fileExtension) {
		var $content = $overlay.find('.viewer-content'),
			fileType = getFileType(fileExtension);

		var imageSrc;
		if (fileId.startsWith('http'))
			imageSrc = fileId;
		else
			imageSrc = getImageRelativePath(fileId);

		// Add arrows to navigate between files
		updateNavigation($overlay, fileId);

		switch (fileType) {
			case TYPES.TEXT:
				$.ajax(getImageRelativePath(fileId)).done(loadText);
				break;

			case TYPES.IMAGE:
				$content
					.removeClass(TYPES.UNKNOWN + '-viewer')
					.addClass(fileType + "-viewer")
					.html('<img class="fil_file_name ui image" src="' + imageSrc + '" alt="Image preview">');
				break;

			case TYPES.CAD:
				load3DObject($content, fileId, fileExtension);
				break;

			case TYPES.DOCUMENT:
				displayDocument(fileId, fileExtension);
				break;

			default:
				$content.html(ivScope.GetText('invalid_content_type'));
				break;
		}
	}

	/**
