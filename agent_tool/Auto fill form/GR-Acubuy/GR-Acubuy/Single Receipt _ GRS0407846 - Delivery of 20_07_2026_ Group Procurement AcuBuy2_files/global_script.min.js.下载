function FocusHandler(node) {
	const $lastfocus = $('#__LASTFOCUS');
	let lastFocusVal = $lastfocus.val();	
	let $currentAutoFocus;

	node
		.find("input,select,textarea,button,[tabindex=0]")
		.off('focus.focusHandler')
		.on('focus.focusHandler', function (e) {
			const id = $(this).prop('id') || ivClient.get(this, ivClient.properties.id);
			if (id) {
				$lastfocus.val(id);
			}
		});

	if (!lastFocusVal || document.getElementById(lastFocusVal) === null) {
		if (window.sessionStorage) {
			const storage = sessionStorage.getItem('triggeredBy');
			if (storage && typeof storage === 'string' && (!upperDocument || document === upperDocument)) {
				lastFocusVal = storage;
				sessionStorage.removeItem('triggeredBy');
			}
		}
	}

	if (lastFocusVal && lastFocusVal.length > 0) {
		const lastFocus = document.getElementById(lastFocusVal);
		const currentFocus = document.activeElement;
		$currentAutoFocus = ivClient.get(lastFocus, ivClient.properties.focus);

		// exclude tooltips for autofocus on postback (or the tooltip will be shown automatically on load)
		if (typeof $currentAutoFocus !== 'undefined') {
			$currentAutoFocus = $currentAutoFocus.filter(function () { return !$(this).is(ivPopupTooltip.selector.tooltip); });
		}

		// don't trigger activeElement
		if ($currentAutoFocus && $currentAutoFocus.length && lastFocus !== currentFocus) {
			// If lastfocus is a focussable control (ie is in $currentAutoFocus), we focus it,
			// else we focus the first control in the $currentAutoFocus list (for a multi-language
			// label with a tooltip, $currentAutoFocus contains the tooltip / the input field /
			// the button to open the language list)
			$currentAutoFocus = ($currentAutoFocus[0].id === currentAutoFocusId) ? $(lastFocus) : $currentAutoFocus.first();

			// Don't trigger also on datepickers as they reopen the picker which we don't want after a postback
			// (that is, we just pick a date)
			const isInDatePicker = $currentAutoFocus.closest('.ui.date').length > 0 || $currentAutoFocus.closest('.ui-datepicker').length > 0;
			if (!isInDatePicker) {
				setTimeout(function () {
					$currentAutoFocus.trigger('focus', { triggerBy: 'FocusHandler' });
				}, 0);
			}
		}
	}
}

