			// enable dropdowns and add the new action bar into the container
			$parentOverlay.append($ctrlActionBar);

			// Check if the action bar is too large for the container, if it is, rebuild the action bar into a minify one
			if ($ctrlActionBar.width() > $parentOverlay.width()) {
				const $newActionBar = ivDesignMode.minifyControlActionBar($ctrlActionBar);
				$ctrlActionBar.remove();
				$parentOverlay.append($newActionBar);
				$ctrlActionBar = $newActionBar;
