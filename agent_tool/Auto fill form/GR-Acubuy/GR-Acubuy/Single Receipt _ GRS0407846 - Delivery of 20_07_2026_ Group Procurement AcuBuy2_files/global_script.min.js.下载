		// Subscribers panel
		clearSubscribersSelector: function (selectorId) {

			ivValidator.clear(selectorId);
			ivClient.set(selectorId, ivClient.properties.value, null);

			const selector = __ivCtrl[selectorId];
			if (selector && selector.AutocompletionSelector) {
				selector.AutocompletionSelector.clearCache();
			}

			const contactData = ivClient.get(selectorId, ivClient.properties.data);
			if (!contactData)
				return;

			const params = (new URLSearchParams(contactData.ctxVarText));
			params.delete('contactFilterType');
			params.delete('type');
			params.delete('conversationGroupName');
			const newCtxVarText = params.toString();

			if (!newCtxVarText)
				return;

			ivClient.set(selectorId, ivClient.properties.data, 'ctxVarText', newCtxVarText);

			if (selector && selector.AutocompletionSelector) {
				selector.AutocompletionSelector.options.ctxVarText = newCtxVarText;
			}
		},
		initSubscribersSelector: function (contactFilterType, contactType) {
			const selectorId = this.options.subscribersContactsSelectorId;
			const conversationGroupName = this.config.groupName;
			const contactControlData = ivClient.get(selectorId, ivClient.properties.data);

			const msgType = this.findMsgType('chat');

			if (!contactControlData || !msgType)
				return;

			const params = (new URLSearchParams(contactControlData.ctxVarText));
			params.set('contactFilterType', contactFilterType);
			params.set('type', contactType);
			params.set('conversationGroupName', conversationGroupName);
			const newCtxVarText = params.toString();

			if (!newCtxVarText)
				return;

			ivClient.set(selectorId, ivClient.properties.data, 'ctxVarText', newCtxVarText);

			const selector = __ivCtrl[selectorId];
			if (selector?.AutocompletionSelector) {
				selector.AutocompletionSelector.options.ctxVarText = newCtxVarText;
			}

			// Disable confirm button if the is no selected value in the subscriber selector
			$('#' + selector.SelectorID).on('change', function () {
				var selected_value = ivClient.get($(this), ivClient.properties.value);
				msgType.participantsFooterSaveContainer.find('button.ui.button').toggleClass('disabled', !selected_value || selected_value.length === 0);
			});
		},
		subscribersEventHandlers: {
			toggleContactSelectorVisibility: function (event) {
				let blogPanel = event.data.blogPanel;
				const contactFilterType = event.data.contactFilterType;
				const msgType = blogPanel.findMsgType('chat');

				if (!msgType)
					return;

				if (!msgType.subscribersSelectorContainer.hasClass('hidden'))
					return;

				if (contactFilterType !== 'conversationAddInternals'
					&& contactFilterType !== 'conversationAddExternals')
					return;

				msgType.addInternalsButtonContainer.addClass('hidden');
				msgType.addExternalsButtonContainer.addClass('hidden');
				msgType.participantsFooterSaveContainer.removeClass('hidden');
				msgType.participantsFooterSaveContainer.find('button.ui.button').addClass('disabled');
				msgType.participantsFooterCancelContainer.removeClass('hidden');

				let type = contactFilterType === 'conversationAddInternals' ? 'internal' : 'supplier';

				blogPanel.clearSubscribersSelector(blogPanel.options.subscribersContactsSelectorId);

				blogPanel.initSubscribersSelector(contactFilterType, type);

				msgType.subscribersSelectorContainer.removeClass('hidden');
			},
			saveSubscribers: function (event) {
				let blogPanel = event.data.blogPanel;

				const msgType = blogPanel.findMsgType('chat');
				if (!msgType)
					return;

				if (msgType.subscribersSelectorContainer.hasClass('hidden'))
					return;

				const contactData = ivClient.get(blogPanel.options.subscribersContactsSelectorId, ivClient.properties.data);
				if (!contactData)
					return;

				const params = (new URLSearchParams(contactData.ctxVarText));
				const supId = ivBlogUtil.getGroupNameParts(blogPanel.config.groupName).supplierId;

				if (params.get("type") === "internal") {

					let values = ivClient.get(blogPanel.options.subscribersContactsSelectorId, ivClient.properties.value);
					if (values && values.length > 0) {
						blogPanel.addSubscribers(event.data.blogPanel, 'internal');
						// send internals
					}

					msgType.subscribersSelectorContainer.addClass('hidden');

					msgType.addInternalsButtonContainer.removeClass('hidden');
					if (supId && supId > 0)
						msgType.addExternalsButtonContainer.removeClass('hidden');

					msgType.participantsFooterSaveContainer.addClass('hidden');
					msgType.participantsFooterCancelContainer.addClass('hidden');

					return;
				}

				if (params.get("type") === "supplier") {
					let values = ivClient.get(blogPanel.options.subscribersContactsSelectorId, ivClient.properties.value);
					if (values && values.length > 0)
						blogPanel.addSubscribers(blogPanel, 'supplier');

					msgType.addInternalsButtonContainer.removeClass('hidden');
					if (supId && supId > 0)
						msgType.addExternalsButtonContainer.removeClass('hidden');

					msgType.participantsFooterSaveContainer.addClass('hidden');
					msgType.participantsFooterCancelContainer.addClass('hidden');
					return;
				}
			},
			cancelSaveSubscriber: function (event) {
				let blogPanel = event.data.blogPanel;

				const msgType = blogPanel.findMsgType('chat');
				const supId = ivBlogUtil.getGroupNameParts(blogPanel.config.groupName).supplierId;
				if (!msgType)
					return;

				msgType.addInternalsButtonContainer.removeClass('hidden');
				if (supId && supId > 0)
					msgType.addExternalsButtonContainer.removeClass('hidden');

				msgType.subscribersSelectorContainer.addClass('hidden');
				msgType.participantsFooterSaveContainer.addClass('hidden');
				msgType.participantsFooterCancelContainer.addClass('hidden');
			},
		},

