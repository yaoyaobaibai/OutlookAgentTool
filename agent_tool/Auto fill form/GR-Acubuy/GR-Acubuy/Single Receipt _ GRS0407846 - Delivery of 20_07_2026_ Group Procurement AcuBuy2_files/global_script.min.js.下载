webPartEditorConfig = function (container, prefixname) {
	var custom = [];
	var data = "";
	container.find("[type!=radio][data-editorname]").each(function () {
		var name = $(this).attr("data-editorname");
		if (!name)
			return true;
		if (prefixname)
			name = prefixname + "[" + name + "]";
		if ($(this).is(':checkbox'))
			// dealing with checkboxes in the old homepage system
			data += '&' + name + '=' + this.checked;
		else if ($(this).find("input[type='checkbox']")[0])
			// dealing with checkboxes in the new homepage system
			data += '&' + name + '=' + ivClient.is.checked(this);
		else if (ivClient.get($(this).attr("id"), ivClient.properties.value)) {
			var value = ivClient.get($(this).attr("id"), ivClient.properties.value);
			if ($.isArray(value)) {
				$.each(
					value,
					function () {
						data += "&" + name + "[]=" + this;
					});
			}
			else if (value.indexOf(',') < 0) {
				data += "&" + name + "=" + value;
			}
			else {
				$.each(
					value.split(','),
					function () {
						data += "&" + name + "[]=" + this;
					});
			}
		}
		else {
			var regex = new RegExp("&", "g");
			data += "&" + name + "=" + $(this).val().replace(regex, '%26');
		}
	});

	container.find("[type=radio][data-editorname]:checked").each(function () {
		var name = $(this).attr("data-editorname");
		if (prefixname)
			name = prefixname + "[" + name + "]";
		data += "&" + name + "=" + $(this).val();
	});
	return data;
};

