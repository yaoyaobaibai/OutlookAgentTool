		var fieldId = $container.data('ivFieldId');
		var fieldCode = $container.data('ivFieldCode');
		var pageUrl = $container.data('ivPageUrl');
		var pageUrlContainer = $container.data('ivPageUrlContainer');

		if (!fieldId) {
			return;
		}

		if (!ivValidator.validate.field(ivClient.get($target, ivClient.properties.id))) {
			return;
		}

		ivDesignMode.toggleAutoSaveIcon($field);

		if (typeof attributeProperty !== 'undefined' && attributeProperty !== null) {
			var settings = {
				attribute: attributeProperty,
				pfieldCode: fieldCode,
				pageUrl: pageUrl,
				pageUrlContainer: pageUrlContainer,
				colSpan: $('.frmAttributes .colspan').find('input').val(),
				rowSpan: $('.frmAttributes .rowspan').find('input').val(),
				vAlign: $('.frmAttributes .valign').find('input[type=hidden]').val(),
				hAlign: $('.frmAttributes .halign').find('input[type=hidden]').val(),
				cssClass: $('.frmAttributes .cssclass').find('input').val(),
				style: $('.frmAttributes .style').find('input').val(),
				chkNoWrap: $('.frmAttributes .nowrap').find('input[type=hidden]').val()
			};
			ivCallMethod.InvokeDesignUtil('SaveCellAttribute', settings);
