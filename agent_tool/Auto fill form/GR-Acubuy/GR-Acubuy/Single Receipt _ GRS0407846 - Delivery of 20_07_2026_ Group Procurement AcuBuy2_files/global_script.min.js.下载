		renderConversationList: function () {
			if (!this.config.showChat)
				return;

			$convListContainer = this.newConversationPanelContent().find('ul.iv-blog-conv-list');

			for (var convData of this._conversations) {
				// Do not render item for conversation that is not properly started (aka where no message has been sent)
				if (convData.Conv.LastMessageId === null || convData.Conv.LastMessageId === undefined)
					continue;

				if (convData.isRendered && !convData.mustUpdateRender)
					continue;

				if (convData.isRendered && convData.mustUpdateRender) {
					this.updateConversationItemData(convData);
					convData.mustUpdateRender = false;

					// Conversation type filtering
					convData.htmlRendering.toggleClass('hidden', convData.htmlRendering.attr('data-conv-type') != this.filterConvType);

					continue;
				}

				var $convItem = this.newConversationItem(convData);
				convData.htmlRendering = $convItem;
				convData.isRendered = true;

				// Conversation type filtering
				convData.htmlRendering.toggleClass('hidden', convData.htmlRendering.attr('data-conv-type') != this.filterConvType);

				$convListContainer.append($convItem);
			}
		},
		updateConversationItemData: function (convData) {
			var conv = convData.Conv;
			var lastMsgPreview = convData.MsgPreview;

			var $convLabel = convData.htmlRendering.find('.iv-blog-conversation-label');
			var $unreadCounter = convData.htmlRendering.find('.conv-counter.my-unread-msg-counter > .counter');
			var $author = convData.htmlRendering.find('.iv-blog-conversation-last-msg-author');
			var $date = convData.htmlRendering.find('.iv-blog-conversation-last-msg-date');
			var $msgText = convData.htmlRendering.find('.iv-blog-conversation-last-msg-content');

			// Conversation Label
			$convLabel.text(this.getConversationLabel(conv.SupId));
			// Unread messages count
			$unreadCounter.text(
				convData.MyUnreadMsgCount > 0
					? (convData.MyUnreadMsgCount > 9 ? '9+' : convData.MyUnreadMsgCount)
					: ''
			);
			// Last message author's name
			$author.text(lastMsgPreview?.Author);
			// Last message date
			$date
				.data('date', lastMsgPreview?.Date)
				.text(this.parseDate($date.data('date')));
			// Last message text
			$msgText.text(lastMsgPreview?.BlogText);
		},
		newConversationItem: function (convData) {
			var conv = convData.Conv;

			var $conversationBlock = $('<li/>', { class: 'iv-blog-conversation-list-item' })
				.attr('data-convid', conv.ConvId)
				.attr('data-conv-type', conv.ConvType)
				.attr('tabIndex', 0);

			const $conversationItemHeader = this.newConversationItemHeader(convData.MyUnreadMsgCount, convData.MyUndoneMsgCount, convData.OthersUndoneMsgCount, conv.SupId);
			const $conversationItemType = this.newConversationItemType(convData);
			const $conversationItemContent = this.newConversationItemContent(convData);

			$conversationBlock
				.append($conversationItemHeader)
				.append($conversationItemType)
				.append($conversationItemContent);

			var openChat = () => {
				if (conv.ConvType == 'supplier')
					this.navigate(conv.SupId);
				else
					this.navigate();

				var chatMsgType = this.findMsgType('chat');
				chatMsgType.blockContainerHtmlRendering.attr("openedblock", "chat");
				chatMsgType.openedBlock = "chat";
			};

			// Open conversation on click
			$conversationBlock
				.off('click.openChat')
				.on('click.openChat', {}, openChat)
				// Open conversation on "Enter" key pressed
				.keypress((event) => {
					switch (event.code) {
						case ('Enter'):
						case ('Space'):
							openChat();
					}
				})

			return $conversationBlock;
		},
		newConversationItemType: function (convData) {
			if (!convData.Conv.SupId)
				return;

			return $(`
				<div class='conv-type'>
					<span class='conv-type-supplier-name'>
