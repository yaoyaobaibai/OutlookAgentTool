function ConvertTo(op, dataType, scale) {
	var num, cleanInput, m, exp;
	if (dataType === "integer" || dataType === "uInteger") {
		exp = new RegExp(dataType === "integer" ? ivScope.UserNumberFormat.NumberRegExpInteger : ivScope.UserNumberFormat.NumberRegExpUInteger);
		if (op.match(exp) === null)
			return false;
		cleanInput = Nbr(op);
		num = parseInt(cleanInput, 10);
		return isNaN(num) ? null : num;
	}
	else if (dataType === "bigInteger" || dataType === "uBigInteger") {
		var num, exp;
		exp = new RegExp(dataType === "bigInteger" ? ivScope.regExp.long : ivScope.regExp.ulong);
		if (op.match(exp) === null)
			return false;
		if (typeof op === 'string') {
			op = StringNumber(op);
		}
		num = BigInt(op);
		return num;
	}
	else if (dataType === "double" || dataType === "uDouble" || dataType === "money") {
		if (!isDouble(op, scale, dataType) || op === '')
			return false;
		cleanInput = Nbr(op);
		num = parseFloat(cleanInput);
		return isNaN(num) ? null : num;
	}
	else if (dataType === "date" || dataType === "dateTime") {
		return ConvertToDate(op);
	}
	else {
		return op.toString();
	}
}

function TryConvertTo(op, dataType, scale) {
	var data = { dataType: dataType, scale: scale };
	if (typeof dataType !== 'undefined' && ivValidator.rules.is[dataType] && ivValidator.rules.is[dataType](op, null, data)) {
		return ConvertTo(op, dataType, scale);
	}
	else if (typeof dataType !== 'undefined' && (dataType === "double" || dataType === "uDouble" || dataType === "money")
		&& ivValidator.rules.is[dataType](op)) { //check double/money value without checking the scale.
		return ConvertTo(op, dataType, scale);
	}
	else if (typeof op === 'string') {
		return op.toUpperCase();
	}
	else
		return ivClient.cleanVal(op);
}

function ValidatorCompare(operand1, operand2, operator, dataType, scale) {
	var
		op1 = operand1,
		op2 = operand2;
	// 0 is a valid value
	if (op1 === null || typeof (op1) === 'undefined') {
		return false;
	}
	if (op2 === null || typeof (op2) === 'undefined') {
		return true;
	}
	// convert
	op1 = TryConvertTo(op1, dataType, scale);
	op2 = TryConvertTo(op2, dataType, scale);

	switch (operator) {
		case "notEqual":
		case "!=":
			return op1 !== op2;
		case "greaterThan":
		case ">":
			if (op1 === "" || op2 === "")
				return true;
			else
				return op1 > op2;
		case "greaterThanEqual":
		case ">=":
			if (op1 === "" || op2 === "")
				return true;
			else
				return op1 >= op2;
		case "lessThan":
		case "<":
			if (op1 === "" || op2 === "")
				return true;
			else
				return op1 < op2;
		case "lessThanEqual":
		case "<=":
			if (op1 === "" || op2 === "")
				return true;
			else
				return op1 <= op2;
		case "sameSignAndAbsLessThanEqual":
			if (op1 === "" || op2 === "")
				return true;
			else
				return ((op2 < 0 && op1 <= 0) || (op2 > 0 && op1 >= 0) || (op2 === 0 && op1 === 0)) && Math.abs(op1) <= Math.abs(op2);
		default:
			return op1 === op2;
	}
}

function ValidatorTrim(s) {
	if (typeof s !== "string")
		s = s !== null && s !== undefined ? s.toString() : '';
	var m = s.match(/^\s*(\S+(\s+\S+)*)\s*$/);
	return m === null ? "" : m[1];
}

