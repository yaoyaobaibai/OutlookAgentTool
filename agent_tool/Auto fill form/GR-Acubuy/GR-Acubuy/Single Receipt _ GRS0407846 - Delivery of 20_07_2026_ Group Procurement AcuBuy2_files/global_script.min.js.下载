		updateChatHeaderData: function (grpNameParts, subscribersCount, externalSubscribersCount) {
			const chatMsgType = this.findMsgType('chat');
			if (!chatMsgType)
				return;

			const $conversation = chatMsgType.headerHtmlRendering.find('.iv-blog-conversation');

			// Conversation label
			let $convLabel = $conversation.find('.conv-label');
			let convLabel = this.getConversationLabel(grpNameParts.supplierId);
			$convLabel.text(convLabel);
			ivBlogUtil.addTooltip($convLabel, convLabel);

			// Conversation counters
			$conversation.find('.conv-counters').empty();

			if (this._currentSubscriber)
				$conversation.find('.conv-counters')
					.append(this.newConvMyUnreadMsg(this._currentSubscriber.subscriberCounters?.myUnreadMsgCount))
					.append(this.newConvMyUndoneMsg(this._currentSubscriber.subscriberCounters?.myUndoneMsgCount))
					.append(this.newConvOthersUndoneMsg(this._currentSubscriber.subscriberCounters?.othersUndoneMsgCount));

			// Message center - Update counters on grid row
			if (this.config.messageCenterMode) {

				const $msgCenterConvItem = $('tr.iv-msg-center-selected-row[data-object-type="blog_conversation"]');

				$msgCenterConvItem.find('.conv-label').toggleClass('bold', this._currentSubscriber?.subscriberCounters?.myUnreadMsgCount > 0);

				const $countersContainer = $msgCenterConvItem.find('.conv-counters').empty();

				if (this._currentSubscriber) {
					$countersContainer
						.append(this.newConvMyUnreadMsg(this._currentSubscriber.subscriberCounters?.myUnreadMsgCount))
						.append(this.newConvMyUndoneMsg(this._currentSubscriber.subscriberCounters?.myUndoneMsgCount));

					if (this.config.hasAccessToObject && this._currentSubscriber.subscriberType !== 'recipient')
						$countersContainer.append(this.newConvOthersUndoneMsg(this._currentSubscriber.subscriberCounters?.othersUndoneMsgCount));
				}
			}

			const $convSupMarker = $conversation.find('.conv-type-supplier-name');
			const $convSubscribers = $conversation.find('.conv-type-subscribers');

			// Show or hide truck icon
			$convSupMarker.toggleClass('hidden', grpNameParts?.supplierId == 0);

			if (this.config.showRepliesOnly && !this.config.hasAccessToObject) {
				$convSubscribers.addClass('hidden');
				return;
			}

			// Supplier conversation
			if (Number.isInteger(grpNameParts?.supplierId) && grpNameParts?.supplierId > 0) {

				$convSubscribers.data('show_internal_external', 1);

				if (Number.isInteger(subscribersCount) && Number.isInteger(externalSubscribersCount)) {

					let internalSubscribersCount = subscribersCount - externalSubscribersCount;

					let subscribersCountText = ivScope.GetText(
						'blog_panel_participants_count_internal_external',
						internalSubscribersCount > 99 ? '99+' : internalSubscribersCount,
						externalSubscribersCount > 99 ? '99+' : externalSubscribersCount
					);

					$convSubscribers.text(subscribersCountText);
				}
			}
			// Internal conversation
			else {
				$convSupMarker.addClass('hidden');
				$convSubscribers.data('show_internal_external', 0);

				if (Number.isInteger(subscribersCount))
					$convSubscribers.text(ivScope.GetText('blog_panel_participants_count', subscribersCount > 99 ? "99+" : subscribersCount));
			}

			if (!this._currentSubscriber)
				return;

			var $conversationActionContainer = chatMsgType.headerHtmlRendering.find('.iv-blog-conversation-action');
			var $archiveConversationItem = $conversationActionContainer.find('.' + this.cssClass.conversation.archiveConversationItem);
			ivBlogUtil.addTooltip($archiveConversationItem, ivScope.GetText(this._currentSubscriber.isParticipating ? 'blog_panel_conversations_archive_button' : 'blog_panel_conversations_unarchive_button'));
			$archiveConversationItem.toggleClass('hidden', !this.config.messageCenterMode || this._currentSubscriber.subscriberCounters?.myUndoneMsgCount > 0);

			var $archiveIcon = $conversationActionContainer.find('.archive-conversation-icon');
			$archiveIcon.toggleClass('fa-inbox-out', !this._currentSubscriber.isParticipating);
			$archiveIcon.toggleClass('fa-archive', this._currentSubscriber.isParticipating);			
		},
