			// dropdown settings
			var defaultSettings = {
				keepOnScreen: false,
				selectOnKeydown: false,
				showOnFocus: false,
				allowCategorySelection: false,
				action: 'hide'
			};

			var settings = $.extend(defaultSettings);

			$ctrlActionBar.find('.ui.dropdown').dropdown(settings);
			ivDesignMode.addButtonsEvents($ctrlActionBar);
		},
		minifyControlActionBar: function($ctrlAbBase) {
			// build menu depending on container buttons
			var $buttons = $ctrlAbBase.find('.buttons .button');
			var $menu = $('<div />', { class: 'ui menu vertical hidden' });
			$.each($buttons, function(ind, button) {
				var classes = '';
				$.each(button.classList, function(ind, c) {
					if (c.indexOf('btn-') === 0) {
						classes += ' ' + c;
					}
				});
				if ($(button).find('.item').length === 0) {
					$menu.append($('<div />', { class: 'item ' + classes, text: $(button).attr('title') }));
				}
				else {
					var $items = $(button).find('.menu .item');
					var $subMenu = $('<div />', { class: 'ui dropdown item' + classes })
						.append($('<i />', { class: 'dropdown icon' }))
						.append($('<span />', { class: 'text', text: $(button).attr('title') }))
						.append($('<div />', { class: 'menu submenu right' }).append($items));

					$menu.append($subMenu);
				}
			});

			var $ctrlActionBar = $('<div />', { class: 'control-action-bar' })
				.append($('<div />', { class: 'buttons' })
					.append($('<div />', { class: 'ui top left dropdown icon button' })
						.append($('<i/>', { class: 'fal fa-bars' }))
						.append($menu))
				);

			return $ctrlActionBar;
		},
		beginControlCut: function(options) {
			if ($('.overlay.active-design').closest(designActions.cutPaste.selectors.parentCell).length === 0)
				return;
			if ($('.control-action-bar .buttons .' + designActions.cutPaste.cssClasses.btn).length === 0)
				return;
			if (designActions.cutPaste.isActive())
				return;

			options = $.extend(options, {});

			ivDesignMode.showControlActionBarCancel();
			designActions.cutPaste.setActive(true);

			// hide all other overlays while cutting (just the border is shown on hover)
			$('body').addClass('light-overlay');

			// disable floating button
			designCentralButton.toggleDisabled(true);

			// show target areas
			ivDesignMode.toggleCutPasteTargetAreas(true, options);

			if (designActions.cutPaste.isActive()) {
				ivGuidancePopup.show(ivScope.GetText('cut_option_started'), 8000);
			}
		},
		controlPaste: function($target) {
			var $fromCell = $('.overlay.active-design').closest(designActions.cutPaste.selectors.parentCell);

			if (ivClient.get($fromCell, ivClient.properties.controlTypeName) == 'tabPageControl')
				ivDesignMode.controlPasteTab($fromCell, $target);
			else if ($fromCell.hasClass(ivDataCollectionControl.cssClass.tableItemHeaderWrapper)) {
				ivDesignMode.controlPasteDataCollectionField($fromCell, $target);
			}
			else {
				ivDesignMode.controlPasteField($fromCell, $target);
			}
		},
		controlPasteTab: function($fromTab, $target) {
			var $targetButton = $target;
			var $targetElem;

			if ($targetButton.hasClass(cssClass.designActions.explicit))
				$targetElem = $targetButton;
			else
				$targetElem = $targetButton.closest('li');

			// moveTab and its area after the target
			$fromTab.nextAll('li .dm-innerline').each(function() {
				$(this).attr('iv-area-tab-index', parseInt($(this).attr('iv-area-tab-index'), 10) - 1);
			});
			$fromTab.prevAll('li').first().insertBefore($targetElem);
			$fromTab.insertBefore($targetElem);
			$fromTab.nextAll('li .dm-innerline').each(function() {
				$(this).attr('iv-area-tab-index', parseInt($(this).attr('iv-area-tab-index'), 10) + 1);
			});
			ivDesignMode.endControlCut({ 'refresh': true });
			ivGuidancePopup.show(ivScope.GetText('control_moved_successfully'));
		},
		controlPasteField: function($fromCell, $target, options) {
			const $fromField = $fromCell.is('th') ? $fromCell : ivClient.get($('.overlay.active-design').data('ivActionbarAssociatedControl'), ivClient.properties.field);
			const $fromRow = $fromCell.closest('tr');
			const $targetButton = $target.closest(selector.designActionButton);
			const $targetCell = $targetButton.closest(designActions.cutPaste.selectors.parentCell);
			const $targetTable = $targetCell.closest('table');

			// show direction dialog if necessary (horizontal innerspace with element below, no grid, no tab, no advanced filter)
			if (typeof options === 'undefined' && hasShiftOption($targetButton, $fromCell)) {
				showPasteOptionsDialog($fromCell, $target);
				return;
			}
			// new row by default if the dialog is not displayed
			if (typeof options === 'undefined')
				options = { 'shiftDown': false };

			let targetX = -1;
			let targetY = -1;
			options.newLine = false;

			if ($targetButton.hasClass('dm-innerspace')) {
				if ($targetButton.closest('td, th').prev().length)
					targetX = $targetButton.closest('td, th').prev()[0].cellIndex + 1;
				else
					targetX = 0;

				targetY = $targetButton.closest('tr')[0].rowIndex;
			}
			else {
				targetX = $targetCell[0].cellIndex;
				targetY = $targetCell.closest('tr')[0].rowIndex;
				if ($targetButton.hasClass('dm-top')) {
					if (options.shiftDown !== true) options.newLine = true;
				}
				else if ($targetButton.hasClass('dm-bottom')) {
					if (options.shiftDown === true) {
						// if move controls to bottom then we have to get the real cell and not just use the index (because some are hidden)
						const belowColInfo = ivPlaceHolderDesign.getFieldsInColumn($targetCell, { 'onlyFirstRow': true });
						if (belowColInfo && belowColInfo.$fields.length > 0) {
							const $belowCell = belowColInfo.$fields[0];
							targetX = $belowCell[0].cellIndex;
							targetY = $belowCell.parent()[0].rowIndex;
						}
					}
					else {
						options.newLine = true;
						targetY += 1;
					}
				}
				else if ($targetButton.hasClass('dm-right')) {
					targetX += 1;
				}
			}

			const xFrom = $fromCell[0].cellIndex
			const yFrom = $fromRow[0].rowIndex;

			const moveData =
			{
				'$fromField': $fromField,
				'$targetCell': $targetCell,
				'$targetTable': $targetTable,
				'xFrom': xFrom,
				'yFrom': yFrom,
				'xTo': targetX,
				'yTo': targetY,
				'options': options
			};

			ivPlaceHolderDesign.moveField(moveData);
			ivGuidancePopup.show(ivScope.GetText('control_moved_successfully'));
		},
		cancelControlCut: function(options) {
			ivDesignMode.endControlCut(options);
			ivGuidancePopup.show(ivScope.GetText('cut_option_cancelled'));
		},
		endControlCut: function(options) {
			if (options && options.$fromTable) {
				refreshDesignAreas(options.$fromTable);
				if (options.$targetTable && options.$fromTable.prop('id') !== options.$targetTable.prop('id')) {
					refreshDesignAreas(options.$targetTable);
				}
				hidePasteOptionsDialog();
			}
			if (!designActions.cutPaste.isActive())
				return;

			if (options && options.refresh)
				ivDesignMode.loadDesignPanel(null, true, $('.overlay.active-design'));

			designActions.cutPaste.setActive(false);
			$('body').removeClass('light-overlay');
			designCentralButton.toggleDisabled(false);
			ivDesignMode.hideControlActionBarCancel();
			// hide target areas
			ivDesignMode.toggleCutPasteTargetAreas(false);
		},
		controlPasteDataCollectionField: function ($fromCell, $target, options) {
			const field = $fromCell instanceof jQuery ? $fromCell.get(0) : $fromCell;
			const target = $target instanceof jQuery ? $target.get(0) : $target;
			const fieldCell = field.closest('th');
			const targetButton = target.closest(selector.designActionButton);
			const targetField = targetButton.closest(designActions.cutPaste.selectors.parentCell);
			const targetCell = targetField.closest('th');
			const data = ivClient.get(field, ivClient.properties.data);

			if (targetButton.classList.contains('dm-top') || targetButton.classList.contains('dm-bottom')) {
				if (targetButton.classList.contains('dm-top')) {
					// insert before targetCell
					targetField.before(field);
				}
				else {
					// insert after targetCell
					targetField.after(field);
				}
				// refresh group parameters
				refreshGroupParameters(fieldCell);
				refreshGroupParameters(targetCell);
				// same cell
				saveGroupedWith(targetCell);
				if (fieldCell === targetCell) {
					// clean value
					// we need to create an empty rule to override the property (if it's defined by code for example)
					savePropertyHandler(fieldCell.dataset.groupedin, $(field), data, 'GroupedWith', null);
				}
				else {
					saveGroupedWith(fieldCell);
				}
			}
			else if (targetButton.classList.contains('dm-right') || targetButton.classList.contains('dm-left')) {
				// create th
				const newCell = ivDataCollectionControl.createItemHeader();
				if (targetButton.classList.contains('dm-left')) {
					targetCell.before(newCell);
				}
				else {
					targetCell.after(newCell);
				}
				newCell.appendChild(field);
				refreshGroupParameters(fieldCell);
				refreshGroupParameters(newCell);

				// clean value
				// null value is not manage by ApplyRuleValues
				// we need to create an empty rule to override the property (if it's defined by code for example)
				savePropertyHandler(newCell.dataset.groupedin, $(field), data, 'GroupedWith', null);
				// save new group in previous field
				saveGroupedWith(fieldCell);
			}

			if (!targetButton.classList.contains('dm-bottom')) {
				// reorder columns (no need if attribute moved below another one => same column as the "master" attribute)
				// TODO : refactor with other move field actions (missing the undo part here) (request 814127)
				// refactor also with DCC get/save columns order
				const row = targetCell.closest('tr');
				const colObject = {};
				let colOrder = '';
				let index = 0;
				row.querySelectorAll('th').forEach(function(th) {
					const col = th.dataset?.ivGroupedin;
					if (col && typeof colObject[col] === 'undefined') {
						colOrder += `${col}:${index};`;
						colObject[col] = index;
						index++;
					}
				});
				const methodName = "SaveOrderColumnHandler";
				const dcc = ivClient.get($fromCell, ivClient.properties.containerControl);
				const dccData = ivClient.get(dcc, ivClient.properties.data);
				const params = {
					id: dccData.controlID,
					colsOrder: colOrder,
					globalSetting: true,
				}

				ivDataCollectionControl.saveControlSettings(methodName, params, null, dccData.ivControl);
			}

			ivDesignMode.endControlCut({ $fromTable: field.closest('.table'), 'refresh': true });
			ivGuidancePopup.show(ivScope.GetText('control_moved_successfully'));
		},
		toggleCutPasteTargetAreas: function(show, options) {
			if (typeof show === 'undefined')
				show = false;

			// toggle(!show) as we are showing the cut/paste targets, so we hide other elems
			$('.dm-tab-wrench-innerspace').toggle(!show);

			var $cell = $('.overlay.active-design').closest(designActions.cutPaste.selectors.parentCell);
			var tooltip = show ? 'move_control_into_container' : 'add_control_into_container';

			if (ivClient.get($cell, ivClient.properties.controlTypeName) == 'tabPageControl')
				ivDesignMode.toggleCutPasteTargetAreasTab($cell, show, tooltip);
			else
				ivDesignMode.toggleCutPasteTargetAreasField($cell, show, tooltip, options);
		},
		toggleCutPasteTargetAreasTab: function($tab, show, tooltip) {
			var $explicitAreas = $('.' + cssClass.designActions.explicit);
			var $implicitAreas = $('.' + cssClass.designActions.implicit);
			var $targetExplicitAreas = $tab.closest('ul').find('.dm-innerspace');
			var $targetImplicitAreas = $tab.closest('ul').find('.dm-innerline');

			toggleAreasBase(show, $explicitAreas, $targetExplicitAreas, $implicitAreas, $targetImplicitAreas);

			if (show) {
				// hide current tab previous and next area
				toggleTargetArea($tab.prevAll('li').first().find('.dm-innerline'), false);
				toggleTargetArea($tab.nextAll('li').first().find('.dm-innerline'), false);
			}

			// change tooltips
			$targetExplicitAreas.each(function() {
				setAreaTooltip($(this), tooltip);
			});
			$targetImplicitAreas.each(function() {
				setAreaTooltip($(this), tooltip);
			});
		},
		toggleCutPasteTargetAreasField: function($cell, show, tooltip, options) {
			var $field = $cell.is('th') ? $cell : ivClient.get($('.overlay.active-design').data('ivActionbarAssociatedControl'), ivClient.properties.field);

			var placeholderSelector = $field.attr('data-placeholder-selector') || $field.children('[data-placeholder-selector]').attr('data-placeholder-selector');
			if (typeof placeholderSelector === 'undefined')
				placeholderSelector = '';

			var $explicitAreas = $('.' + cssClass.designActions.explicit);
			var $implicitAreas = $('.' + cssClass.designActions.implicit);
			var $targetExplicitAreas = $('table' + placeholderSelector + ' .' + cssClass.designActions.explicit);
			var $targetImplicitAreas = $('table' + placeholderSelector + ' .' + cssClass.designActions.implicit);

			if (placeholderSelector === '') {
				$field.idProxy = $field.parent().closest('.iv-proxy').prop('id');
				const placeholderContainerId = $field.closest('table').attr('data-phc-dcc-id') ?? $field.closest('table').attr('placeholderForGridId');
				$field.idPhcForGrid = placeholderContainerId;
			}

			var nestedTablesAreasFilter = function () {
				const placeholderContainerId = $(this).closest('table').attr('data-phc-dcc-id') ?? $(this).closest('table').attr('placeholderForGridId');
				return $field.find($(this)).length === 0 // don't show children of cut element
					&&
					(
						// if selector not available, do not show the inside of different proxies or grids, else show only in similar selector.
						// Do not show areas in tab system.
						(placeholderSelector === '' && $(this).closest('.iv-proxy').prop('id') === $field.idProxy && placeholderContainerId === $field.idPhcForGrid)
						|| ($(this).closest('table').is(placeholderSelector) && !$(this).hasClass('dm-add-tab'))
					);
			}

			$targetExplicitAreas = $targetExplicitAreas.filter(nestedTablesAreasFilter);
			$targetImplicitAreas = $targetImplicitAreas.filter(nestedTablesAreasFilter);

			// move parent container if no target area
			if (show && $targetExplicitAreas.length === 0 && $targetImplicitAreas.length === 0) {
				ivDesignMode.endControlCut();
				// ask if we have to cut parent container (ask only once if need to go up more levels)
				if ((options && options.cutParentContainer) || confirm(ivScope.GetText('cut_parent_container_confirm'))) {
					const $container = ivClient.get($field, ivClient.properties.containerControl);
					if ($container.length && $container[0] !== $field[0]) {
						options = $.extend(options, { cutParentContainer: true });
						ivDesignMode.loadDesignPanel($container);
						ivDesignMode.beginControlCut(options);
					}
				}
				return;
			}

			toggleAreasBase(show, $explicitAreas, $targetExplicitAreas, $implicitAreas, $targetImplicitAreas);

			if (show) {
				// show only some areas for current control
				if (ivClient.get($field, ivClient.properties.controlTypeName) == 'Column') {
					toggleTargetArea($field.find('.dm-innerline'), false);
					// use :visible as some columns are display:none
					toggleTargetArea($field.prevAll(':visible').first().find('.dm-innerline.dm-right'), false);
					toggleTargetArea($field.nextAll(':visible').first().find('.dm-innerline.dm-left'), false);
				}
				else {
					var $container = $field.closest('[data-iv-target="' + ivClient.get($field, ivClient.properties.data, 'ivFieldCode') + '"]');
					toggleTargetArea($field.siblings('.dm-left, .dm-right'), false);
					toggleTargetArea($container.prevAll().not('.hidden').first().find('.dm-innerline.dm-right'), false);
					toggleTargetArea($container.nextAll().not('.hidden').first().find('.dm-innerline.dm-left'), false);

					// can paste top or bottom only if there are more than 1 control on the row
					if ($container.siblings('[data-iv-target]').length == 0) {
						toggleTargetArea($field.siblings('.dm-top, .dm-bottom'), false);
						toggleTargetArea($container.closest('tr').prevAll('tr:not(hidden):has([data-iv-target]:not(.hidden))').first()
							.children(':not(.hidden)').first().children('.dm-bottom'), false);
					}

					// if next sibling is explicit area then don't show it
					if ($container.next().hasClass('empty-cell')) {
						toggleTargetArea($container.next().find('.dm-innerspace'), false);
					}
				}
			}

			// change tooltips
			$targetExplicitAreas.each(function() {
				setAreaTooltip($(this), tooltip);
			});
			$targetImplicitAreas.each(function() {
				setAreaTooltip($(this), tooltip);
			});
		},
