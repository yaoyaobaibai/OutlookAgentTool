				if (!ignoreChangeEvent) {
					if (this.OnBeforeChange && typeof (this.OnBeforeChange) == 'function')
						this.OnBeforeChange();
					this.OnChange();
				}
				return;
			}
			if (this.TypeSelector == "Selectable") {
				this.addValue(this.value);
