var ivLogger = (function (ivScope) {

	if (!('__IV_ENABLED_LOGS' in ivScope)) {
		if (('DebugScript' in ivScope)) {
			ivScope.__IV_ENABLED_LOGS = ivScope.DebugScript;
		}
		else
			ivScope.__IV_ENABLED_LOGS = true;
	}

	var inGroup = false;

	const methodToColorMap = {
		debug: '#949494', // Gray
		log: '#006407', // Green
		warn: '#FBBD08', // Yellow
		error: '#DB2828', // Red
		groupCollapsed: '#2185d0', // Blue
		groupEnd: null, // No colored prefix on groupEnd
	};

	const print = function (method, args) {
		if (!ivScope.__IV_ENABLED_LOGS) {
			return;
		}

		const styles = [
			'background: ' + methodToColorMap[method],
			'font-weight: bold',
			'border-radius: 0.5em',
			'color: white',			
			'padding: 1px 0.5em',
		];

		// In a group the prefix is not displayed.
		//%c  Applies CSS style rules to the output string as specified by the second parameter
		const logPrefix = inGroup ? [] : ['%cIvalua [' + method.toUpperCase() + ']', styles.join(';')];

		console[method].apply(null,logPrefix.concat(args||[]));

		if (method === 'groupCollapsed') {
			inGroup = true;
		}
		if (method === 'groupEnd') {
			inGroup = false;
		}
	};

	const api = {};
	const loggerMethods = Object.keys(methodToColorMap);

	loggerMethods.forEach(function (key) {
		const method = key;

		api[method] = function () {
			print(method, Array.apply(null, arguments));
		};
	});

	return api;
})(ivScope);

