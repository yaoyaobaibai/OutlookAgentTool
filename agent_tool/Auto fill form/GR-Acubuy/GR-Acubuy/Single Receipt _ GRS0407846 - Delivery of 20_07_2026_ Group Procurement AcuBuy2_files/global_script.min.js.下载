	function showPasteOptionsDialog($fromCell, $target) {
		const paramName = 'paste_direction';
		const $targetCell = $target.closest(designActions.cutPaste.selectors.parentCell);
		const $optionsDialog = $('<div>')
			.attr('id', 'paste_options')
