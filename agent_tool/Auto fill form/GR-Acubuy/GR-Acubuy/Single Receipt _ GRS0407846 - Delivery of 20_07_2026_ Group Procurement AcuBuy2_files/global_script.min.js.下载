		startConversationClick: function (e) {
			var blogPanel = e.data.blogPanel;
			var convType = e.data.convType;

			ivBlogAjaxHandler.startConversation(
				blogPanel.config.objectType,
				blogPanel.config.objectId,
				convType,
				function (args) {
					let convData = {
						Conv: args,
						MsgPreview: null,
						MyUnreadMsgCount: 0,
						MyUndoneMsgCount: 0,
						mustUpdateRender: true
					};

					blogPanel._conversations.push(convData);

					if (convData.Conv.ConvType == 'supplier')
						blogPanel.navigate(convData.Conv.SupId);
					else
						blogPanel.navigate();

					blogPanel.setChatOpenedBlock('chat');

					blogPanel.focusNewMsgTextarea();
				},
				function (args) {
					blogPanel.showLoadingError(true);
				}
			);
		},
		reload: function (msgTypeCode) {
			this.clearMessages(msgTypeCode);
			this.loadMessages(null);
			this.scrollToBottom(500);
			this.signalRClientBroadcastEventReset();
		},
		setChatOpenedBlock: function (openedBlock) {
			let chatType = this.findMsgType('chat');

			if (chatType.openedBlock == openedBlock)
				return;

			chatType.blockContainerHtmlRendering.attr('openedBlock', openedBlock)
			chatType.openedBlock = openedBlock;
		},
		navigateConvType: function (convType) {
			this.filterConvType = convType;
			this.loadConversations();
		},
		navigate: function (supId) {
			const arrGroup = this.config.groupName.split(":");
			const supPart = supId ?? '0';
			const newGroupName = `${arrGroup[0]}:${arrGroup[1]}:${supPart}`;

			const conv = this._conversations.find(convData => convData.Conv.SupId == (supId ?? 0));

			// Navigate to new blog instance
			this.config.groupName = newGroupName;
			this.instanceName = arrGroup.length === 3
				? this.initializedInstanceName
				: `${this.initializedInstanceName}${supPart}`;
			this._currConv = conv;

			this.initMsgSupplierShareLabel();

			const blogPanel = this;
			const target = blogPanel.findMsgType('chat');
			const msgEditor = target?.htmlRendering
				?.find('.iv-blog-msg-editor')?.first();

			this.setPingButtonParams(msgEditor);

			if (this.config.allowComment && this.config.groupName) {
				ivSignalRInstanceGlobal.ResetSignalR(this);
				return;
			}

			//MSB : this line seems to be never reached !!
			this.reload('chat');
		},
		updateMessageTypeCounter: function (typeCode, total, notDisplayed) {
			var msgType = this.findMsgType(typeCode);

			if (!msgType || !msgType.isRendered)
				return;

			if (total === undefined) total = 0;
			if (notDisplayed === undefined) notDisplayed = 0;
			msgType.messageCount = total;

			if (!msgType.allUnreadContainer)
				return;

			msgType.allUnreadContainer.toggleClass(
				'hidden',
				!(this.config.unreadMsgNumber > 0 && total - notDisplayed < this.config.unreadMsgNumber)
			);

			if (notDisplayed > 0) {
				if (msgType.allUnreadContainer.hasClass("hidden"))
					msgType.moreContainer.removeClass("hidden");
			}
			else {
				msgType.allUnreadContainer.addClass("hidden");
				msgType.moreContainer.addClass("hidden");
			}
		},
		renderMessages: function (insertBefore) {
			var me = this;

			if (!this._$panel)
				return;

			// ordering messages: first parent messages (the one to add and the messages already rendered) and then replies
			var tempMessages = this._messages;
			var tempReplies = [];
			this._messages = [];
			for (var tmpMsg of tempMessages) {
				if (!tmpMsg)
					continue;
				if (tmpMsg.parentId) {
					tempReplies.push(tmpMsg);
					continue;
				}
				this._messages.push(tmpMsg);
			}
			tempReplies.sort(function (a, b) {
				let idA = parseInt(a.messageId);
				let idB = parseInt(b.messageId);
				if (idA < idB) return -1;
				if (idA > idB) return 1;
				return 0;
			});
			for (var j in tempReplies) {
				if (typeof tempReplies[j] === "undefined") continue;
				this._messages.push(
					tempReplies[tempReplies.length - (parseInt(j) + 1)]
				);
			}
			for (var msg of this._messages) {
				if (typeof msg === "undefined") continue;
				if (typeof msg === "function") continue; // IE issue

				var messageType = this.findMsgType(msg.typeCode);
				if (msg.isRendered)
					continue;

				const isLogMessage = msg.statusCode === 'log';
				const isChatMessage = msg.typeCode === 'chat';
				const isCurrentUser = msg.author && msg.author.loginName === ivScope.User.LoginName;
				const isSupplierContact = msg.author && msg.author.isSupplierContact === true;

				messageType.htmlRendering.removeClass("hidden");
				var target = messageType.$msgList;
				var subMessage = false;
				var parentMsg = null;

				// If message is a reply
				if (msg.parentId && this._renderedMessages[msg.parentId]) {

					subMessage = true;
					parentMsg = this._renderedMessages[msg.parentId];
					target = parentMsg.htmlRendering;

					// Disable edit & delete actions if the message has replies
					let $targetMsgContentContainer = target.find('>.' + this.cssClass.comment.messageContentContainer);
					$targetMsgContentContainer.find('.' + this.cssClass.comment.btnOtherActionEditMessage).addClass('disabled');
					$targetMsgContentContainer.find('.' + this.cssClass.comment.btnOtherActionDeleteMessage).addClass('disabled');

					let $msgSubList = this.renderMessageSubList(parentMsg);
					$msgSubList.removeClass('hidden');

					target = $msgSubList;
				}

				msg.htmlRendering = $('<li/>', {
					'messageid': msg.messageId,
					class: 'iv-blog-msg'
				});

				msg.htmlRendering.addClass('hidden');

				if (isChatMessage)
					msg.htmlRendering
						.toggleClass('msg-supplier', isSupplierContact)
						.toggleClass('msg-me', isCurrentUser)
						.toggleClass('msg-external', this.config.extranetMode ? !isSupplierContact : isSupplierContact);

				if (insertBefore) {
					//After
					target.append(msg.htmlRendering);
				}
				else {
					var $firstElement = target.find('li:first');
					if ($firstElement.length > 0) {
						$firstElement.before(msg.htmlRendering);
					}
					else {
						target.append(msg.htmlRendering);
					}
				}

				if (!isLogMessage) {

					var $messageHeader = $('<div/>', { class: 'iv-blog-msg-header' });
					msg.htmlRendering.append($messageHeader);

					// Message author
					if (msg.author) {
						var $author = $(`
							<div class="iv-blog-msg-author">
								${ivFunction.htmlAttributeEncode(isCurrentUser ? ivScope.GetText('blog_chat_me') : ivFormat.formatContactName(msg.author.firstName, msg.author.lastName))}
							</div>`
						);
						$messageHeader.append($author);
						if (msg.author.email)
							ivBlogUtil.addTooltip($author, msg.author.email);
						if (isSupplierContact)
							$author.append($(`<span class="sup-icon-container"><i class="fa fa-truck fa-inverse icon" aria-hidden="true"></i></span>`));
					}

					// Message date
					if (msg.date) {
						var $messageDate = $('<div/>', { class: 'iv-blog-msg-date' })
							.attr('data-position', 'left center')
							.data('date', msg.date);

						ivBlogUtil.addTooltip(
							$messageDate,
							`${this.getLocalDate(msg.date).format(ivScope.CurrentCulture.DateTimeFormat.DatePattern)} ${this.getLocalDate(msg.date).format(ivScope.CurrentCulture.DateTimeFormat.LongTimePattern)}`
						);

						this.updateDateTimeBindedElement($messageDate);

						$messageHeader.append($messageDate);
					}

					var $messageContentContainer = $(`
						<div class="${this.cssClass.comment.messageContentContainer}">
							<div class="${this.cssClass.comment.messageContentWrapper}">
								<div class="${this.cssClass.comment.messageContent}">
									
								</div>	
							</div>
						</div>`);
					var $messageContent = $messageContentContainer.find(`.${this.cssClass.comment.messageContent}`);

					msg.htmlRendering.append($messageContentContainer);

					$messageContent.setTextMultiline(msg.content);

					this.highlightMessage(msg);

					// Message edition date
					if (msg.dateModified) {
						const dateModified = new Date(msg.dateModified);

						let $messageDate = $('<div/>', { class: 'iv-blog-msg-date date-modified' })
							.attr('data-position', 'left center')
							.data('date', dateModified)
							.data('label-format', `${ivScope.GetText('blog_content_edited')} {0}`);

						ivBlogUtil.addTooltip(
							$messageDate,
							`${this.getLocalDate(dateModified).format(ivScope.CurrentCulture.DateTimeFormat.DatePattern)} ${this.getLocalDate(dateModified).format(ivScope.CurrentCulture.DateTimeFormat.LongTimePattern)}`);

						this.updateDateTimeBindedElement($messageDate);

						$messageContentContainer.find(`.${this.cssClass.comment.messageContentWrapper}`).prepend($messageDate);
					}						

					if (msg.files)
						$messageContent.append(me.renderMessageFiles(msg));

					if (msg.assignmentStatusCode)
						me.renderMessageAssignment(msg);
					$(msg).on('assignment_change', function () { me.renderMessageAssignment(this); });

					me.renderMessageAssignmentHistory(msg);

					if (isCurrentUser && isChatMessage) {
						if (msg.readOnly && !mobileMode) {
							// Message readonly tooltip
							let $msgReadOnlyTooltipContainer = ivBlogUtil.createMsgReadonlyTooltip(me.cssClass.comment.readonlyMsgTooltipIcon);
							$messageContentContainer.prepend($msgReadOnlyTooltipContainer);
							ivBlogUtil.addDynamicHover($messageContentContainer, $msgReadOnlyTooltipContainer);
						} else if (!msg.readOnly) {
							// Other action buttons
							let $btnOtherActionsContainer = $(`
								<div class="ui top dropdown icon button iv-button borderless ${me.cssClass.comment.btnOtherAction}" title="${ivScope.GetText('more_options')}">
									<i class="fa fa-ellipsis-v"></i>
									<div class="menu transition hidden" tabindex="-1" style="opacity: 1;">
										<div class=" item ${me.cssClass.comment.btnOtherActionEditMessage}">${ivScope.GetText("edit_message")}</div>
										<div class=" item ${me.cssClass.comment.btnOtherActionDeleteMessage}">${ivScope.GetText('delete_message')}</div>
									</div>
								</div>`);
							let $btnList = $btnOtherActionsContainer.find('.menu');

							// Mark as done button
							var mainMsg = subMessage ? parentMsg : msg;
							if (mainMsg.assignmentStatusCode) {
								var $btnMarkDone = $(`<div class="item ${me.cssClass.comment.btnOtherActionMarkDoneMessage}"></div>`);
								var updateMarkDoneBtn = function (mainMsg) {
									var label = ivScope.GetText(mainMsg.assignmentStatusCode === 'val' ? 'blog_panel_mark_todo' : 'blog_panel_mark_done');
									$btnMarkDone.html(label);
									$btnMarkDone.removeClass('active');
								}
								$(mainMsg).on('assignment_change', function () { updateMarkDoneBtn(this); });
								updateMarkDoneBtn(mainMsg);

								$btnList.append($btnMarkDone);
							}

							// Reply button
							if (!subMessage) {
								var $btnReply = $(`<div class="item ${me.cssClass.comment.btnOtherActionReplyMessage}">${ivScope.GetText('blog_panel_reply')}</div>`);
								$btnList.append($btnReply);
							}

							$messageContentContainer.prepend($btnOtherActionsContainer);

							if (!mobileMode)
								ivBlogUtil.addDynamicHover($messageContentContainer, $btnOtherActionsContainer);
						}
					}

					if (!subMessage)
						messageType.messageCount++;

					if (!subMessage && isChatMessage && !isCurrentUser) {
						let $replyButtonOrReadonlyTooltip = msg.readOnly
							? ivBlogUtil.createMsgReadonlyTooltip(me.cssClass.comment.readonlyMsgTooltipIcon)
							: ivBlogUtil.createButton(
								ivScope.GetText("blog_panel_reply"),
								"fa-reply",
								`${this.cssClass.comment.btnCommentReply} iv-button borderless`);

						$messageContentWrapper = $messageContentContainer.find('.' + this.cssClass.comment.messageContentWrapper);
						$messageContentWrapper.after($replyButtonOrReadonlyTooltip);

						if (!mobileMode)
							ivBlogUtil.addDynamicHover($messageContentContainer, $replyButtonOrReadonlyTooltip);
					}
				}
				else {
					msg.htmlRendering.addClass("log");

					var $messageContentContainer = $(`<div class="${this.cssClass.comment.messageContentContainer}" />`);
					msg.htmlRendering.append($messageContentContainer);

					if (msg.allowHtmlContent === true) {
						var $htmlContent;
						try {
							$htmlContent = $(msg.content);
						} catch (e) {
							$htmlContent = $("<span/>").append(msg.content);
						}
						if (!$htmlContent.length) {
							$htmlContent = $("<span/>").append(msg.content);
						}
						$messageContentContainer.append($htmlContent);
						if (
							$htmlContent.length > 0 &&
							$htmlContent.is('table') &&
							!$htmlContent.hasClass("sc-container")
						)
							$htmlContent.first().css("display", "list-item");
					}
					else
						$messageContentContainer.text(msg.content);
				}

				this.addMessageEvents(msg.htmlRendering, msg);

				msg.htmlRendering.removeClass("hidden");
				msg.isRendered = true;
				this._renderedMessages[msg.messageId] = msg;
				msgAdded = true;
				msg.htmlRendering.data("blogMessage", msg);

				this.showAddReplyBlock(msg);
			}

			if (me._messagesLoaded)
				me.scrollToBottom(500);
		},
		addMessageEvents: function ($messageBlock, msg) {
