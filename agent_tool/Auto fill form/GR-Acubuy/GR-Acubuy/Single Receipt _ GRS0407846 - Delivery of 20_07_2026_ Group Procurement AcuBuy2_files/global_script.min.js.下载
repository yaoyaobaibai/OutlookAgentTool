			$designableFields.each(function() {
				var $target = $(this);
				var $container;
				var containerID;
				var containerName;
				var containerDesignable;
				var containerClientID;
				var containerDiff;
				var node;
				var category;
				var title;
				var description;
				var id;
				var value;
				var visible;
				var selected = false;
				var diff;

				// controls are not designable (it's the parent \o/ ) ...
				// hook for opened cells
				if (ivClient.is.cell($target) && $target.hasClass('open')) {
					$target = $target.find('[data-iv-control]').first();
				}
				else if ($target.data('ivAssociatedControl')) {
					// start with id to manage multi lang fields
					$target = $('[id^="' + $target.data('ivAssociatedControl') + '"]').first();
				}

				// remove controls in hidden tab
				if ($target.closest('.ui.tab:not(.active').length > 0) {
					return true;
				}

				$container = $target.parents(selector.container).first();
				containerID = $.trim($container.data('ivFieldCode'), '');
				containerDesignable = $container.hasClass(cssClass.designable);
				containerClientID = ivClient.get($container, ivClient.properties.id);
				containerDiff = ivClient.get($container, ivClient.properties.data, 'ivDiff');

				// category : key for semantic
				containerName = ivClient.get($container, ivClient.properties.associatedText);
				category = containerName;
				if (!category) {
					category = containerID;
				}

				// page case
				if (ivClient.is.page($target)) {
					title = ivScope.GetText('page');
					// description
					description = ivClient.get($target, ivClient.properties.data, 'ivContainerurl') || ivClient.get($target, ivClient.properties.data, 'ivPageurl');
				}
				else {
					// title : control's label (or id)
					title = ivClient.get($target, ivClient.properties.associatedText);
					// description
					description = ivClient.get($target, ivClient.properties.data, 'ivFieldCode');
				}
				if (!title) {
					title = description;
					description = ivClient.get($target, ivClient.properties.controlTypeName);
				}
				if (title) {
					title = title.trim();
				}
				// id : ivFieldCode
				id = ivClient.get($target, ivClient.properties.data, 'ivFieldCode');
				// value : clientID of the control
				value = ivClient.get($target, ivClient.properties.id);

				if (fieldID === value) {
					selected = true;
					ivClient.set($(selector.designSearch), ivClient.properties.associatedText, ivClient.is.page($target) ? description : title);
				}

				// visibility
				visible = ivClient.is.visible($target);
				if (visible && $target.length) {
					const field = ivClient.get($target, ivClient.properties.field);
					if (field) {
						visible = !(field.get(0).classList.contains(designSettingsPanel.displayHiddenControls.dmClassDisabled) || field.get(0).classList.contains(designSettingsPanel.displayHiddenControls.dmClassEnabled));
					}

				}
				diff = ivClient.get($target, ivClient.properties.data, 'ivDiff');

				node = {
					// required for semantic
					category: category,

					// container data
					containerID: containerID,
					containerName: containerName,
					containerDesignable: containerDesignable,
					containerClientID: containerClientID,
					containerDiff: containerDiff,

					// node
					title: title,
					description: description,
					// adds data
					id: id,
					value: value,
					visible: visible,
					selected: selected,
					diff: diff
				};
				if ($.grep(designableFields, function(n) { return n.containerID === node.containerID && n.id === node.id; }).length === 0) {
					designableFields.push(node);
				}
			});
