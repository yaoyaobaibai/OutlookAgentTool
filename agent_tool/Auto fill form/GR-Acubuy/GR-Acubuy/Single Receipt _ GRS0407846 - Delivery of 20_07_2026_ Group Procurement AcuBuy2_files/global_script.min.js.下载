		#openedIndex = null;

		#navigationMethods = {};

		constructor($toggledContainer) {

			this.$navigationContainer = $toggledContainer;

			this.#render();

			// When "keep open" is false, close panel when elsewhere is clicked
			$('body').on('click', { navBar: this }, function (e) {
				let navBar = e.data.navBar;
