			$(document)
				.on('focus' + eventNamespace, ivDropdownSelector.selector.dropdown, ivDropdownSelector.dropdownFocusHandler)
				.on('focusout' + eventNamespace, ivDropdownSelector.selector.dropdown, ivDropdownSelector.dropdownFocusOutHandler)
				.on('focusout' + eventNamespace, ivDropdownSelector.selector.menuContainer, ivDropdownSelector.containerFocusOutHandler)
				.on('focusout' + eventNamespace, ivDropdownSelector.selector.inputSearch, ivDropdownSelector.inputSearchFocusOutHandler);

			$(ivDropdownSelector.selector.simpleDropdown).each(function () {
