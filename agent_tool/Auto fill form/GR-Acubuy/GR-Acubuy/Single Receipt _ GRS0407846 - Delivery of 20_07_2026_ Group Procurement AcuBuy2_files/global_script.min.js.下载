/**
 * Get the data from the .net main form (theForm) as an array 
 * with each element under the form `${key}=${value}`.
 * */
function formGetData() {
	var excludedFieldNames = ['__VIEWSTATE', '__LASTFOCUS', '__EVENTTARGET', '__EVENTARGUMENT', '__VIEWSTATEGENERATOR'];
	var formBody = [],
		form = theForm,
		count = form.elements.length;

	for (var i = 0; i < count; i++) {
		var element = form.elements[i];
		var name = element.name;
		var value;

		if (typeof name !== 'string'
			|| name.length === 0
			|| element.getAttribute("data-ignorechangesonunload") === "true"
			|| excludedFieldNames.indexOf(name) > -1)
			continue;

		var tagName = element.tagName;
		if (tagName === 'INPUT') {
			// Generic input fields and checkboxes
			value = element.type == "checkbox"
				? element.checked
				: encodeURIComponent(element.value);
			formBody.push(name + '=' + value);
		} else if (tagName === 'SELECT') {
			// Select options (dropdowns)
			var optionCount = element.options.length;

			// Get all selected options
			var values = [];
			for (var j = 0; j < optionCount; j++) {
				var option = element.options[j];
				if (option.selected)
					values.push(option.value);
			}

			// Push them in a list to associate it with the element name
			if (values.length > 0)
				formBody.push(name + '=' + encodeURIComponent(values.join(',')));
		} else if (tagName === 'TEXTAREA') {
			// Textareas (from CKEditor or not)
			if (element.getAttribute("editor") == "true" && typeof CKEDITOR !== 'undefined' && ivHtmlEditor.getEditorInstance(element.id)) {
				//TODO: about changesload, it is too early in onload event => values are thus different
				var oEditor = ivHtmlEditor.getEditorInstance(element.id);
				value = oEditor.getData();
			} else {
				value = element.value;
			}
			formBody.push(name + '=' + encodeURIComponent(value));
		}
	}

	return formBody.sort();
}

/**
 * Check changes before unloading the page if requested (see param bas_page_check_changes_onunload).
 * __formDataInitial is initially set to null (see scope_script), then at save it is bound 
 * to data in the main .net form serialized as a string.
 * */
function CheckChangesOnUnload() {
	if (!__checkChangesOnUnload)
		return true;

	var formBody = formGetData();

	// As data arrays are sorted, we can compare the 2 resulting strings
	return (__formDataInitial || []).join(',') == formBody.join(',');
}

/**
 * Save data from the .net main form.
 * Is called by the ActionBar OnLoad event from C# side.
 * */
function SaveFormData() {
	if (!__checkChangesOnUnload)
		return true;

	// slice is there to create a shallow copy of the array...
	__formDataInitial = formGetData().slice();
}

