		createNewTdField: function(opener, previousTd, options) {
			if (typeof options === 'undefined')
				options = {};

			let tdOpener = opener.closest('td');
			const th = opener.closest('th');
			let grid = null;
			if (th != null)
				grid = th.closest('.iv-grid-view');
			let header = false;
			let newTr;
			if (grid) {
				tdOpener = opener.closest('th');
				header = true;
			}
			if (previousTd) {
				tdOpener = previousTd;
			}
			let newCell = true;
			let newWrapper = document.createElement(header ? 'th' : 'td');
			newWrapper.classList.add('design-field-added');

			// insert the field right or left the TD that contains the opener
			if (opener.classList.contains('dm-right') || opener.classList.contains('dm-left')) {
				if (options.isFirst) {
					if (opener.classList.contains('dm-right')) {
						tdOpener.parentNode.insertBefore(newWrapper, tdOpener.nextSibling);
					}
					else {
						tdOpener.parentNode.insertBefore(newWrapper, tdOpener);
					}
				}
				else {
					if (options.isVertical) {
						designAddingControlPanel.insertTdBelow(newWrapper, tdOpener);
					}
					else {
						tdOpener.parentNode.insertBefore(newWrapper, tdOpener.nextSibling);
					}
				}
			}
			// insert the field above or below the TD that contains the opener
			else if (!header && (opener.classList.contains('dm-top') || opener.classList.contains('dm-bottom'))) {
				// if move to bottom options then move all below controls down and insert new field to the left of next one
				if (options.shiftDown) {
					let $targetCell = $(tdOpener);
					let nextCell = tdOpener.nextSibling;
					if (options.isVertical || options.isFirst) {
						if (options.isFirst) {
							if (opener.classList.contains('dm-bottom')) {
								options.onlyFirstRow = true;
								const rowToMoveInfo = ivPlaceHolderDesign.getFieldsInColumn($targetCell, options);
								if (rowToMoveInfo && rowToMoveInfo.$fields.length > 0) {
									$targetCell = rowToMoveInfo.$fields[0];
									nextCell = rowToMoveInfo.$fields[rowToMoveInfo.$fields.length - 1][0].nextSibling;
								}
							}

							const parentRow = $targetCell[0].parentNode;
							options.onlyFirstRow = false;
							ivPlaceHolderDesign.shiftFields($targetCell, options);
							parentRow.insertBefore(newWrapper, nextCell);
						}
						else {
							designAddingControlPanel.insertTdBelow(newWrapper, tdOpener);
						}
					}
					else
						tdOpener.parentNode.insertBefore(newWrapper, tdOpener.nextSibling);
				}
				else {
					if (options.isVertical || options.isFirst) {
						newTr = designAddingControlPanel.createNewTr();
						// insert above
						if (opener.classList.contains('dm-top')) {
							// insert row
							tdOpener.parentNode.parentNode.insertBefore(newTr, tdOpener.parentNode);
						}
						// check if it's not the last row
						else if (tdOpener.parentNode.nextSibling) {
							tdOpener.parentNode.parentNode.insertBefore(newTr, tdOpener.parentNode.nextSibling);
						}
						else {
							tdOpener.parentNode.parentNode.appendChild(newTr);
						}
						// insert field
						newTr.insertBefore(newWrapper, newTr.firstChild);
					}
					else
						tdOpener.parentNode.insertBefore(newWrapper, tdOpener.nextSibling);
				}
			}
			else if (header && (opener.classList.contains('dm-bottom') || opener.classList.contains('dm-top'))) {
				const openerWrapper = ivDataCollectionControl.getItemHeaderWrapper(opener);
				// create a group field
				newCell = false;
				// create a dcc wrapper
				newWrapper = ivDataCollectionControl.createItemHeaderWrapper();
				newWrapper.classList.add('design-field-added');
				newWrapper.dataset.targetId = 'design-field-added';
				// retrieve the field id
				newWrapper.dataset.groupedin = tdOpener.dataset.ivGroupedin;
				if (opener.classList.contains('dm-top')) {
					newWrapper.dataset.groupedin = 'design-field-added';
					openerWrapper.before(newWrapper);
				}
				else {
					openerWrapper.after(newWrapper);
				}
				// grouped
				const wrappers = ivDataCollectionControl.getChildrenItemHeaderWrapper(tdOpener);
				const groupedWiths = [];
				wrappers.forEach(function getTargetId(wrapper) {
					groupedWiths.push(wrapper.dataset.targetId);
				});
				newWrapper.dataset.groupedwith = groupedWiths.join(',');
			}
			// explicit area
			else if (opener.classList.contains('dm-innerspace')) {
				if (options.isFirst)
					tdOpener.parentNode.insertBefore(newWrapper, tdOpener);
				else {
					if (options.isVertical) {
						designAddingControlPanel.insertTdBelow(newWrapper, tdOpener);
					}
					else {
						tdOpener.parentNode.insertBefore(newWrapper, tdOpener.nextSibling);
					}
				}
			}

			// add cell in other rows
			if (header) {
				const emptyGrid = tdOpener.classList.contains('iv-grid-empty');
				// remove empty grid cell
				// we need to keep this button during the add process
				if (emptyGrid) {
					tdOpener.classList.add('hidden');
				}

				if (newCell && newWrapper && newWrapper.parentElement) {
					const colIndex = newWrapper.cellIndex;
					const nbColumns = newWrapper.parentElement.cells.length;
					// prevent nested placeholders
					// empty grid case
					let body = grid.querySelector(':scope > tbody');
					if (!body) {
						body = document.createElement('tbody');
						grid.appendChild(body);
						body.appendChild(document.createElement('tr'));
					}
					const rows = body.querySelectorAll(':scope > tr');
					for (let row of rows) {
						// ignores newobjects row & rows with not the same number of columns (+1 is for the new cell)
						if (!row.cells.length || (row.cells.length + 1) !== nbColumns) {
							break;
						}
						const cell = row.insertCell(colIndex);
						cell.setAttribute('data-iv-role', 'cell');
						cell.classList.add('new-cell');

						if (emptyGrid) {
							row.cells[row.cells.length - 1].classList.add('hidden');
						}
					}
				}
			}
			return newWrapper;
		},

		insertTdBelow: function(newTd, tdOpener) {
			// insert below previous td or in new row if none
			const rowToMoveInfo = ivPlaceHolderDesign.getFieldsInColumn($(tdOpener), { 'onlyFirstRow': true });
			if (rowToMoveInfo && rowToMoveInfo.$fields.length > 0) {
				rowToMoveInfo.$fields[0][0].parentNode.insertBefore(newTd, rowToMoveInfo.$fields[0][0]);
			}
			else {
				let firstVisibleRow = $(tdOpener.parentNode).nextAll('tr').not('.hidden').has('td:not(.hidden)').first();
				if (firstVisibleRow.length > 0) {
					const emptyCell = findEmptyCell(firstVisibleRow[0].firstChild);
					firstVisibleRow[0].insertBefore(newTd, emptyCell);
				}
				else {
					const newTr = designAddingControlPanel.createNewTr();
					tdOpener.parentNode.parentNode.insertBefore(newTr, tdOpener.parentNode.nextSibling);
					newTr.insertBefore(newTd, newTr.firstChild);
				}
			}
		},

		createNewTr: function() {
			var newTr = document.createElement('tr');
			newTr.setAttribute('data-iv-coord-y', '');
			// add empty cell
			var newEmptyCell = document.createElement('td');
			newEmptyCell.classList.add('empty-cell');
			newTr.appendChild(newEmptyCell);
			return newTr;
		},
		setColumnOrder: function (list, targetId, insertColumn, insertAfterIndex, insert) {
			targetId = Object.keys(list).find(function (key) { return list[key] === insertAfterIndex; });
			let colIndex = 0;
			const tmpList = {};
			for (let colId in list) {
				if (insert === false) {
					if (insertColumn === colId) {
						continue;
					}
					if (list[colId] === insertAfterIndex) {
						tmpList[insertColumn] = colIndex;
						colIndex++;
					}
					tmpList[colId] = colIndex;
					colIndex++;
				}
				else {
					//insert
					tmpList[colId] = list[colId] + (insertAfterIndex && list[colId] > insertAfterIndex ? 1 : 0);

					if (targetId === colId) {
						tmpList[insertColumn] = insertAfterIndex + 1;
					}
				}
			}
			return tmpList;
		},
		getColumnOrder: function (list) {
			let colsOrder = '';
			for (let colId in list) {
				colsOrder +=
					(colsOrder.length > 0 ? ';' : '') +
					colId + ':' + list[colId];
			}
			return colsOrder;
		},
		addFieldHandler: function (event, datafields) {
