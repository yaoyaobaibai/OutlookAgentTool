	stopReorderAttributes: function ($item)
	{
		var attrInfos = $item.data('type').split(':');
		var AttributeReorder = this.AttributeOrder;
		this.startReorderAttributes($item);
		if (AttributeReorder != this.AttributeOrder && attrInfos.length > 3)
