var ivAnalysisTilePopup = (function ($, ivScope) {
	'use strict';

	var AnalysisTilePopup = function (elemId, options) {
		this.elem = document.querySelector('#' + elemId);
		this.config = options;
	};
	AnalysisTilePopup.prototype = {

		init: function () {
			if (this.elem) {
				this.tile = this.elem.closest('[data-tile-id="' + this.config.tileId + '"]');
				if (!this.tile) {
					//Webpart
					var webpart = this.elem.closest('[data-iswebpart]');
					if (webpart) {
						this.tile = webpart.querySelector('.is_part');
					}
				}
				this.initCollapse();
				this.initDrag();
				this.initEllipsisButton();
				this.initCollapsibleSections();
				this.initTextAreaResize();
			}
			return this;
		},

		initTextAreaResize: function () {
			const textAreas = this.elem.getElementsByTagName("textarea");
			for (let i = 0; i < textAreas.length; i++) {
				textAreas[i].setAttribute("style", "height:" + (textAreas[i].scrollHeight) + "px;overflow-y:hidden;");
				textAreas[i].removeEventListener("input", setHeightInput, false);
				textAreas[i].addEventListener("input", setHeightInput, false);

				function setHeightInput() {
					this.style.height = 0;
					this.style.height = (this.scrollHeight) + "px";
				}
			}
		},

		initCollapse: function () {
			if (this.elem) {
				var analysisTilePopup = this;
				$(document).off('click.collapse_tile_options', '#' + this.elem.id + ' .' + this.config.btnClass);
				$(document).on('click.collapse_tile_options', '#' + this.elem.id + ' .' + this.config.btnClass, function (event) { analysisTilePopup.toggleCollapse(event) });
			}
		},

		initCollapsibleSections: function () {
			if (this.tile) {
				var that = this;
				var sectionCollapseButtons = this.tile.querySelectorAll('.analysis-tile-options-collapse-btn');
				for (let i = 0; i < sectionCollapseButtons.length; i++) {
					sectionCollapseButtons[i].addEventListener("click", function () {
						that.resetHeightOnSectionOpen();
						setTimeout(() => that.setOpenSections());
					}, false);
				}
				that.setOpenSections();
			}
		},

		// textareas have no height when initialized in collapsed section in quick editor
		// might be fighting with initTextAreaResize() above
		resetHeightOnSectionOpen: function () {
			const textAreas = this.elem.getElementsByTagName("textarea");
			for (let i = 0; i < textAreas.length; i++) {
				textAreas[i].style.height = "31px";
			}
		},

		initDrag: function () {
			if (this.elem) {
				var containment = this.elem.querySelector('.' + this.config.draggablePhc);
				var analysisTilePopup = this;
				if (containment) {
					var phc = containment.querySelector('.pivot-table-light-projection-container');
					if (phc) {
						$('#' + containment.id + ' .pivot-table-light-projection-container > tbody').sortable({
							cursor: 'grabbing',
							containment: '#' + containment.id,
							handle: '.fa-grip-lines',
							placeholder: 'drag-zone-analysis-tile',
							zIndex: 9999,
							start: function (event) {
								analysisTilePopup.toggleCollapse(event.originalEvent, true);
							},
							stop: function () {
								analysisTilePopup.updateOrder();
							},
							connectWith: '#' + containment.id + ' .pivot-table-light-projection-container > tbody'
						});
					}
				}
			}
		},

		initEllipsisButton: function () {
			if (this.tile) {
				var ellipsisButton = this.tile.querySelector('.' + this.config.ellipsisButtonClass);
				if (ellipsisButton) {
					var analysisTilePopup = this;
					ellipsisButton.onclick = function (event) { analysisTilePopup.toggleButtonSettings(); event.stopPropagation(); }
				}
			}
		},

		onChangeSortIndic: function (selSortId, selDirectionId, indicOrder) {
			var selSort = document.getElementById(selSortId),
				sortBy = ivClient.get(selSort, 'value'),
				selDirection = document.getElementById(selDirectionId);
			ivClient.set(selDirection, 'visible', sortBy && sortBy != indicOrder);
		},

		onChangeFilterIndic: function (selIndicId, selOperatorId, txtFilterId) {
			var selIndic = document.getElementById(selIndicId),
				indic = ivClient.get(selIndic, 'value'),
				selOperator = document.getElementById(selOperatorId),
				txtFilter = document.getElementById(txtFilterId);
			ivClient.set(selOperator, 'visible', indic && indic != '');
			ivClient.set(txtFilter, 'visible', indic && indic != '');
		},

		show: function () {
			var analysisTilePopup = this;
			__ivCtrl[this.config.currentGuid].hideAllPopupSettings();
			$(document).on('click.hide_all', 'body', function (event) {
				var target = event.target;
				while ((target = target.parentNode) && target !== analysisTilePopup.elem && (!target.classList || !target.classList.contains('iv-context-menu')));
				if (!target) {
					__ivCtrl[analysisTilePopup.config.currentGuid].hideAllPopupSettings();
				}
			});
			$(document).on('keyup.hide_all_esc', 'body', function (event) {
				if (event.key === "Esc" || event.key === "Escape") {
					__ivCtrl[analysisTilePopup.config.currentGuid].hideAllPopupSettings();
				}
			});
			__ivCtrl[this.config.currentGuid].hideContextMenus();
			if (this.tile) {
				this.tile.dataset.isFocus = 1;
				var tileOptionsPhc = this.tile.querySelector('.analysis-tile-popup');
				var btnContextMenu = this.tile.querySelector('.ui.button.tile-context-menu');
				if (tileOptionsPhc) {
					tileOptionsPhc.classList.add('visible');
					if (btnContextMenu) {
						btnContextMenu.classList.add('focused');
					}
					if (this.tile.classList.contains('is_part')) {
						let width = this.tile.offsetWidth;
						let height = this.tile.offsetHeight;
						if (width > 0 && height > 0) {
							this.tile.style.width = width + 'px';
							this.tile.style.height = height + 'px';
						}
						var webpartContainer = this.tile.closest('.frame-webpart-content > .frame.content');
						if (webpartContainer) {
							webpartContainer.style.overflow = 'visible';
						}
					}
					//Scroll to focus the phc if needed (only on main page)
					var container = document.querySelector('#content');
					if (container) {
						var pos = tileOptionsPhc.getBoundingClientRect();
						if (pos) {
							var scroll = ((pos.x + pos.width) - window.innerWidth) + 15;
							if (scroll > 0) {
								container.scrollLeft += scroll;
							}
						}
					}
					//Reset the scroll inside the menu
					var scrollableArea = this.elem.querySelector('.content');
					if (scrollableArea) {
						scrollableArea.scrollTop = 0;
					}
				}
				this.initTextAreaResize();
			} 
		},

		save: function () {
			this.refresh(true, 'save');
		},

		block: function () {
			if (this.elem) {
				var upc = this.elem.querySelector('.analysis-tile-light-manage-update-panel');
				if (upc) {
					$(upc).block();
				}
			}
		},

		unblock: function () {
			if (this.elem) {
				var upc = this.elem.querySelector('.analysis-tile-light-manage-update-panel');
				if (upc) {
					$(upc).unblock();
				}
			}
		},

		refresh: function (refreshTile, eventArg) {
			if (this.elem) {
				var upc = this.elem.querySelector('.analysis-tile-light-manage-update-panel');
				if (upc) {
					__ivContextMenu = {};
					var currentGuid = this.config.currentGuid;
					var tileId = this.config.tileId;
					var anlTile = this.tile.querySelector('.analysis-tile');
					if (refreshTile) {
						//Display loader
						if (anlTile) {
							$(anlTile).analysisTile('displayLoader');
						}
					}
					var hdnCurrentGuids = document.getElementsByName('hdnCurrentGuid');
					for (var i = 0; i < hdnCurrentGuids.length; i++) {
						hdnCurrentGuids[i].value = currentGuid;
					}
					__doPostBack(upc.id, eventArg).then(function () {
						if (refreshTile) {
							__ivCtrl[currentGuid].refresh(null, tileId);
							__ivCtrl[currentGuid].refreshContextMenus(tileId);
						}
					});
				}
			}
		},

		toggleButtonSettings: function () {
			if (this.tile) {
				var tileOptionPhc = this.tile.querySelector('.analysis-tile-popup');
				if (tileOptionPhc && tileOptionPhc.classList.contains('visible')) {
					__ivCtrl[this.config.currentGuid].hideAllPopupSettings();
				} else {
					this.show();
				}
			}
		},

		toggleCollapse: function (event, hide) {
			var optionPhc = event.target.closest('.' + this.config.phcClass);
			if (optionPhc) {
				var icon = optionPhc.querySelector('.' + this.config.btnClass + ' i.icon'),
					optionPhcContent = optionPhc.querySelector('.' + this.config.contentClass);
				if (optionPhcContent && icon) {
					if (hide && optionPhcContent.classList.contains('hidden')) {
						return;
					}
					icon.classList.toggle('fa-chevron-right');
					icon.classList.toggle('fa-chevron-down');
					optionPhcContent.classList.toggle('hidden');
					optionPhc.classList.toggle('open');
				}
			}
		},

		deleteLevel: function (dim, level) {
			const key = dim + ';' + level;
			let rowProjList = this.getPivotProjList(true),
				colProjList = this.getPivotProjList(false);
			const rowIndex = rowProjList.indexOf(key),
				colIndex = colProjList.indexOf(key);
			if (rowIndex != -1) {
				rowProjList.splice(rowIndex, 1);
				this.setPivotProjList(true, rowProjList);
			}
			else if (colIndex != -1) {
				colProjList.splice(colIndex, 1);
				this.setPivotProjList(false, colProjList);
			}
			this.refresh(false);
		},

		addLevel: function (dim, level, isRow, addLevelKeywordEvent) {
			let projList = this.getPivotProjList(isRow);
			projList.push(dim + ';' + level);
			this.setPivotProjList(isRow, projList);
			__ivCtrl[this.config.currentGuid].hideContextMenus();

			this.refresh(false, addLevelKeywordEvent + '|' + dim + '_' + level);
		},

		swapAxes: function () {
			let rowProjList = this.getPivotProjList(true),
				colProjList = this.getPivotProjList(false);
			this.setPivotProjList(true, colProjList);
			this.setPivotProjList(false, rowProjList);
			this.refresh(false);
		},

		updateOrder: function () {
			this.setPivotProjList(true, this.getPivotProjList(true));
			this.setPivotProjList(false, this.getPivotProjList(false));
		},

		getPivotProjList: function (isRow) {
			var containment = this.elem.querySelector('.' + this.config.draggablePhc),
				selector = isRow ? '.is-row' : '.is-col',
				fullSelector = '.pivot-table-light-projection-container' + selector,
				table = containment.querySelector(fullSelector),
				listProj = [];
			if (table) {
				var nodes = table.querySelectorAll('[data-dimension][data-level]');
				if (nodes) {
					for (var i = 0; i < nodes.length; i++) {
						listProj.push(nodes[i].dataset.dimension + ";" + nodes[i].dataset.level);
					}
				}
			}
			return listProj;
		},

		setPivotProjList: function (isRow, value) {
			if (isRow) {
				this.elem.querySelector('#' + this.hdnProjRowId).value = value.join('|');
			}
			else {
				this.elem.querySelector('#' + this.hdnProjColId).value = value.join('|');
			}
