autoSaveChangeStatusClass = function (id, status, event, scope) {
	scope = scope || document;
	var $field = ivClient.get(id, ivClient.properties.role, ivClient.roles.field);
	var savingDots = $field.find('.jumping-ellipsis');
	var savedIcon = $field.find('.iv-save-ok');
	var failedIcon = $field.find('.iv-save-ko');
	var autosaveWrapper = $field.find('.autosave-wrapper');

	//for dropdown only, hide the carret down icon
	var caret;
	var data = ivClient.get(id, ivClient.properties.data);
	if (data && ((data.ivControlTypeName === 'selectorControl' && data.selectorType === 'dropdown') || (data.ivControlTypeName === 'checkBoxControl' && data.renderType === 'dropDown'))) {
		caret = $('#' + id).parent().find(".dropdown.icon");
	}

	var $checkbox;
	// TODO : To review
	if ((data.ivControlTypeName === 'checkBoxControl' && (data.renderType !== 'dropDown'))) {
		$checkbox = $('#' + id).parents('[data-iv-control]:first').find('label');
	}

	function saving() {
		ivValidator.clear(id);

		autosaveWrapper.addClass('autosaving');

		if (caret)
			caret.hide();
		if ($checkbox)
			$checkbox.addClass('cb-saving');
		savedIcon.hide();
		savingDots.removeClass('hidden').fadeIn();
	}

	function saved() {
		if (caret)
			caret.delay(3000).fadeIn(100);
		if ($checkbox) {
			setTimeout(function () { autosaveWrapper.removeClass('autosaving'); }, 200);
			savedIcon.removeClass('hidden').fadeIn().delay(100).fadeOut();
			setTimeout(function () { $checkbox.removeClass('cb-saving'); }, 200);
		}
		else {
			setTimeout(function () { autosaveWrapper.removeClass('autosaving'); }, 2500);
			savedIcon.removeClass('hidden').fadeIn().delay(2000).fadeOut();
		}
		savingDots.addClass('hidden');

	}
	function failed() { // save fail 
		$field.addClass('error');
		savingDots.addClass('hidden');
		autosaveWrapper.removeClass('autosaving');

		if (!$checkbox)
			failedIcon.removeClass('hidden').fadeIn().delay(4000).fadeOut();

		if (caret)
			caret.delay(5000).fadeIn(100);

		if ($checkbox)
			$checkbox.removeClass('cb-saving'); //re-show the checkbox
	}

	switch (status) {
		case 'load':
			saving();
			break;
		case 'ok':
			saved();
			__autoSaveRestoreStatus[id] = status;
			break;
		case 'ko':
			failed();
			break;
	}
};

autoSaveFinalizeStatusClass = function (id) {
	var $ctrl = $('#' + id);
	$ctrl.removeClass('fa-check-circle').removeClass('fa-times-circle');
	delete __autoSaveRestoreStatus[id];
};

