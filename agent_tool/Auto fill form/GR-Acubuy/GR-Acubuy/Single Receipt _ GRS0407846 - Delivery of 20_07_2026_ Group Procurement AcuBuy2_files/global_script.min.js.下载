	function adjustSceneFromBoundingBox(box) {
		// Move object to center its bounding box
		var middle = box.getCenter(new THREE.Vector3());
		object3d.position.x = -1.0 * middle.x;
		object3d.position.y = -1.0 * middle.y;
		object3d.position.z = -1.0 * middle.z;

		object3d.rotation.x = 0;
		object3d.rotation.y = 0;
		object3d.rotation.z = 0;

		var dimX = box.max.x - box.min.x;
		var dimY = box.max.y - box.min.y;
		var dimZ = box.max.z - box.min.z;

		// Adjust camera position to see the whole object
		camera.position.x = 0;
		camera.position.y = 0;
		camera.position.z = 2.5 * Math.max(dimX / 2, dimY / 2, dimZ / 2);

		camera.rotation.x = 0;
		camera.rotation.y = 0;
		camera.rotation.z = 0;

		// Adjust camera focalization in order to see min details as whole object
		camera.near = Math.min(dimX, dimY, dimZ) / 50;
		camera.far = Math.max(dimX, dimY, dimZ) * 20;
	}

	function animate3D() {
		requestAnimationFrame(animate3D);
		controls.update();
		renderer.render(scene, camera);
	}

	/**
	 * Manage keyboard events
	 * @param {KeyboardEvent} evt keyboard event.
	 */
	function manageKeyEvents(evt) {
		// ESC -> close viewer
		if (evt.keyCode === 27) {
			closeViewer();
			return false;
		}

		// R -> reset object
		if (evt.keyCode === 82) {
			reset3DState();
			return false;
		}

		// S -> toggle auto-rotation
		if (evt.keyCode === 83) {
			isRotating = !controls.autoRotate;
			controls.autoRotate = isRotating;
			return false;
		}
	}

