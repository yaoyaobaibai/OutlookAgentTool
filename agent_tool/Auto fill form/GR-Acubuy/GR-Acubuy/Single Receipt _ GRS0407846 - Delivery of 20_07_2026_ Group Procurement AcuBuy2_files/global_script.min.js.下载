		// Build final path thanks to data "selectedFields" and data "selectedRelationTables"
		getFieldsPath: function() {
			var fields = $('#gridFields').data('selectedFields');
			var relationTables = $('#gridFields').data('selectedRelationTables');
			var path = '';
			var table;
			var dataFields = [];
			var $tab = $('#' + designAddingControlPanel.id).find('.design-adding-control-database-field');
			var i;

			$tab.find('.table-infos').children('.field').each(function(ind, node) {
