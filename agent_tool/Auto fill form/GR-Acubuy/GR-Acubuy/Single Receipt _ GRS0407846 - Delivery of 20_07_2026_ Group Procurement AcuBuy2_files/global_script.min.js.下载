function dataBindDataCollectionControl(args) {
	var node = $('[data-iv-control="' + args.rowcontrol + '"]');
	var writableFields = [];
	node.find(ivValidator.selector.fields).each(function () {
		var			
			dataFieldName = ivClient.get(this, ivClient.properties.data, 'dataFieldName'),
			isPk = false,
			currentPk = '',
			field = args.dataKeyNames.find(function (df) {
				if (typeof dataFieldName === 'undefined') {
					if (args.pks.includes(df)) {
						isPk = true;
						currentPk = df;
					}
					return false;
				}

				var find = false;
				const dataFieldNames = dataFieldName.split(';');
				dataFieldNames.forEach(function (item) {
					if (df === item) {
						find = true;
						return;
					}
				});
				return find;
			});

		if (!$(this).closest('.data-collection-item').hasClass('action-column')) {
			if (isPk) {
				if (currentPk)
					bindManageUrlValues(node, currentPk, args.pkValue);
				let $dci = $(this).closest('.data-collection-item');
				$dci.empty();
				$dci.text(args.pkValue);
			}
			else {
				if (!ivClient.is.readonly(this)) {					
					if (field)
						bindManageUrlValues(node, field, args.pkValue);
					ivClient.set(this, ivClient.properties.readonly, true);
					writableFields.push(this);
				}
			}
		}
	});

	$.each(writableFields, function () {
		const id = ivClient.get(this, ivClient.properties.id),
			data = __ivHtmlControls[id],
			colIndex = $(this).closest('.data-collection-item').index();
		let dataAttributes = ivClient.get($(this).closest('.iv-datacollection-control'), ivClient.properties.data, 'dataAttributes');

		if (!dataAttributes)
			dataAttributes = ivClient.get($(this).closest('.iv-datacollection-control'), ivClient.properties.data, '_tableDisplay').dataAttributes;

		if (!dataAttributes[colIndex].readOnly && !args.pks.includes(data.dataFieldName)) {
			ivClient.set(id, ivClient.properties.readonly, false);
		}
	});

	//data binding with data coming from database
	////a.href
	node.find('a').each(function () {
		$(this).attr('href', $(this).attr('href').replace(/\{([\w]+)\}/g, args.pkValue));

		if ($(this).children('.icon').length) {
			var ctrlId = $(this).attr('id');
			if (__ivHtmlControls[ctrlId]
				&& __ivHtmlControls[ctrlId].imageLink) {
				__ivHtmlControls[ctrlId].imageLink = __ivHtmlControls[ctrlId].imageLink.replace(/\{([\w]+)\}/g, args.pkValue);
			}
			$(this).children('.icon').removeClass('hidden');
		}
	});
	////td.innerText
	node.find('td').each(function () {
		//case for td without control (pk for example)
		if ((/\{([\w]+)\}/g).test($(this).html())) {
			$(this).html($(this).html().replace(/\{([\w]+)\}/g, args.pkValue));
		}
	});

	node.attr('data-id', args.pkValue);
	node.find('.delete-dcc-object-button').attr('data-object-id', args.pkValue);
	node.find('.delete-dcc-object-modal').attr('data-object-id', args.pkValue);
	node.find('.action-column.checkbox .iv-checkbox').attr('data-value', args.pkValue);
	node.find('.action-column.insert-new-line .button').remove();
	node.find('.manage-url-dcc-button, .delete-dcc-object-button').removeClass('hidden');
	node.find('.action-column.checkbox .dcc-checkbox').removeClass('hidden');
	node.removeClass('active');

	//Hide saveAll button if it's all good.
	let linesToSave = node.closest('tbody')?.find('.data-collection-object:not([data-id])');
	if (linesToSave?.length === 0) {
		node.closest('.iv-dcc-table').removeClass('is-inserting');
		const btnSaveNewRows = node.closest('.iv-datacollection-frame').find('.new-rows-save');
		if (btnSaveNewRows.length > 0) {
			btnSaveNewRows.addClass('hidden');
		}
	}

	const nodeElt = node.get(0);
	if (nodeElt != null) {
		if (nodeElt.hasAttribute('data-new-id')) {
			ivDataCollectionControl.removeInsertedRow(nodeElt, false);
		}
		if (nodeElt.hasAttribute('data-duplicate-id')) {
			ivDataCollectionControl.removeDuplicatedRow(nodeElt, false);
		}
	}

	return false;
}

function bindManageUrlValues(node, dataFieldName, value) {
	//Choper le nom de la colonne a la place du data-id
	const btnId = ivClient.get(node.find('.manage-url-dcc-button'), ivClient.properties.id);
	let modalUrl = ivClient.get(btnId, ivClient.properties.data, 'modalUrl')?.url;
	if (btnId) {
		if (!modalUrl) {
			modalUrl = $('#' + btnId).attr('href');
			$('#' + btnId).attr('href', modalUrl.replace('{' + dataFieldName + '}', value));
		}
		else {
			modalUrl = modalUrl.replace('{' + dataFieldName + '}', value);
			__ivHtmlControls[btnId].modalUrl.url = modalUrl;
		}
	}
	
}

function dataBind(insertedRow, args) {
	var	node = $('#' + args.rowcontrol);
	if (node.length === 0 || node[0].closest(ivDataCollectionControl.selectors.control) != null) {
		let pks, pkValue;
		insertedRow['pks'].split(';').forEach(function (pk) {
			if (!pks) {
				pks = pk;
				pkValue = insertedRow[pk];
			}
			else {
				pks += ';' + pk;
				pkValue = ';' + insertedRow[pk];
			}
		});
		args.pks = pks;
		args.pkValue = pkValue;
		dataBindDataCollectionControl(args);
	}
	else {
		var
			$grid = node.closest('.iv-grid-view'),
			tmpId = node.attr('new_id'),
			rowId = [],
			//to review, set the properties on the object container or parentContainer? (form:container, grid:parentContainer (here to avoid to declare multiple variable with the same value)
			dataKeyNames = args.dataKeyNames,
			writableFields = [],
			reInitIvCheckBox = false,
			hasAutoSaveFields = false;

		var newRowIDSeparator = '_x_';
		var ivGrid = null;
		if ($grid.length && __ivCtrl[$grid.attr('id')]) {
			ivGrid = __ivCtrl[$grid.attr('id')];
			newRowIDSeparator = ivGrid.newRowIDSeparator;
			ivGrid.updateRowsCountPager();
		}

		node.find(ivValidator.selector.fields).each(function () {
			var
				dataFieldName = ivClient.get(this, ivClient.properties.data, 'dataFieldName'),
				field = dataKeyNames.find(function (df) {
					if (typeof dataFieldName === 'undefined')
						return false;

					var find = false;
					const dataFieldNames = dataFieldName.split(';');
					dataFieldNames.forEach(function (item) {
						if (df === item) {
							find = true;
							return;
						}
					});
					return find;
				});

			if (field && !ivClient.is.readonly(this)) {
				ivClient.set(this, ivClient.properties.readonly, true);
				writableFields.push(this);
			}
		});

		//old code
		$.each(dataKeyNames, function (i, v) {
			rowId.push(insertedRow[v] != undefined ? insertedRow[v] : '');
		});
		//old code
		var validRowId = [];
		$.each(rowId, function () {
			var tmp = this.toString().split("/").filter(function (v) { return v !== '' }).join(newRowIDSeparator);
			validRowId.push(tmp);
		});

		//replace the temporary id (_1) by the id of the line after recording
		node.find('[id]').each(function () {
			if ($(this).attr('name')) {
				$(this).attr('name', $(this).attr('name').replace('tr_-' + tmpId, 'tr_' + validRowId.join(newRowIDSeparator)));
			}

			var $field = ivClient.get(this, ivClient.properties.field);
			if ($field) {
				var ivCtrl = $field.data('ivControl'),
					newIvctrl = ivCtrl.replace('tr_-' + tmpId, 'tr_' + validRowId.join(newRowIDSeparator)).trim(),
					$validation = $field.find('[data-validation="' + ivCtrl + '"]'),
					$search = $field.find('.search'),
					ariaControl = newIvctrl + '_MenuItem';

				if (__ivCtrl[ivCtrl] && __ivCtrl[ivCtrl].SelectorID)
					__ivCtrl[ivCtrl].key = __ivCtrl[ivCtrl].SelectorID = newIvctrl;

				var selector = ivClient.get($field, ivClient.properties.role, ivClient.roles.selector);
				if (selector)
					selector.data('selector', newIvctrl).attr('data-selector', newIvctrl);

				$field.find('input[type=hidden]').attr('id', newIvctrl);
				$field.data('ivControl', newIvctrl).attr('data-iv-control', newIvctrl);
				ivClient.set($field, ivClient.properties.data, 'key', newIvctrl);
				$validation.data('validation', newIvctrl).attr('data-validation', newIvctrl);
				$search.data('controls', ariaControl).attr('data-controls', ariaControl).attr('aria-controls', ariaControl).attr('id', newIvctrl + '_search');
				__ivHtmlControls[newIvctrl] = __ivHtmlControls[ivCtrl];
				if (__ivHtmlControls[newIvctrl] && __ivHtmlControls[newIvctrl].autoSaveObjectId) {
					hasAutoSaveFields = true;
					__ivHtmlControls[newIvctrl].autoSaveObjectId = validRowId.join('|');
				}

				const readOnly = ivClient.is.readonly(this) ?? false;
				if (ivClient.get(newIvctrl, 'control')) {
					ivClient.set(newIvctrl, ivClient.properties.readonly, readOnly);
				}
				//onclick replace
				if (__ivHtmlControls[newIvctrl] && __ivHtmlControls[newIvctrl].onClick) {
					const id = ivClient.get(this, ivClient.properties.id);
					__ivHtmlControls[newIvctrl].onClick = __ivHtmlControls[newIvctrl].onClick.replace(/\b\w*(new_object)\w*\b/g, id);
					reInitIvCheckBox = __ivHtmlControls[newIvctrl].renderType === 'checkBox';
				}

				//modal url replace
				if (__ivHtmlControls[newIvctrl]
					&& __ivHtmlControls[newIvctrl].modalUrl
					&& __ivHtmlControls[newIvctrl].modalUrl.url) {
					var modalUrl = __ivHtmlControls[newIvctrl].modalUrl.url;
					if (modalUrl.indexOf('{') > 0) {
						modalUrl = modalUrl.replace(/\{([\w]+)\}/g, function (match, p1, p2, p3) {
							return insertedRow[p1] ? insertedRow[p1] : '';
						});
						__ivHtmlControls[newIvctrl].modalUrl.url = modalUrl;
					}
				}

				ivClient.clearRootCache();
			}
		});

		//data binding with data coming from database
		////a.href
		node.find('a').each(function () {
			$(this).attr('href', $(this).attr('href').replace(/\{([\w]+)\}/g, function (match, p1) {
				return insertedRow[p1];
			}));

			if ($(this).children('.icon').length) {
				var ctrlId = $(this).attr('id');
				if (__ivHtmlControls[ctrlId]
					&& __ivHtmlControls[ctrlId].imageLink) {
					__ivHtmlControls[ctrlId].imageLink = __ivHtmlControls[ctrlId].imageLink.replace(/\{([\w]+)\}/g,
						function (match, p1, p2, p3) {
							return insertedRow[p1];
						});
				}
				$(this).children('.icon').removeClass('hidden');
			}
		});
		////td.innerText
		node.find('td').each(function () {
			//case for td without control (pk for example)
			if ($(this).html().length == 0
				&& typeof $(this).attr('datafieldname') !== 'undefined'
				&& typeof insertedRow[$(this).attr('datafieldname')] !== 'undefined') {
				$(this).html(insertedRow[$(this).attr('datafieldname')]);
			}
			else if ((/\{([\w]+)\}/g).test($(this).html())) {
				$(this).html($(this).html().replace(/\{([\w]+)\}/g, function (match, p1) {
					return insertedRow[p1] ? insertedRow[p1] : '';
				}));
			}
		});

		$.each(writableFields, function () {
			var
				id = ivClient.get(this, ivClient.properties.id),
				c = ivClient.get(this, ivClient.properties.data);
			if (c) {
				var controlType = ivClient.get(this, ivClient.properties.data, 'controlType');
				if (typeof controlType !== 'undefined' && c.controlType === controlType) {
					ivClient.set(id, ivClient.properties.readonly, false);
				}
			}
		});

		if (reInitIvCheckBox)
			ivCheckBox.init(node);

		node.data('id', rowId.join("|"));
		node.removeClass('insert item_selected');
		//old code
		node.removeAttr('newobjectids').removeAttr('new_id').attr('data-id', rowId.join("|"));

		var
			$nodeTemplate = $grid.find('.insert:first'),
			$newIds = $('#' + $nodeTemplate.attr('newObjectIds'));

		var values = $newIds.val().split(',');
		values = $.grep(values, function (value) { return value !== tmpId; });
		$newIds.val(values);

		node.find('div.new-row-actions .new-row-buttons').remove();
		showNewRowReorderButton(node);
		ivGrid.toggleSaveNewRowsButton();

		return hasAutoSaveFields;
	}
}

