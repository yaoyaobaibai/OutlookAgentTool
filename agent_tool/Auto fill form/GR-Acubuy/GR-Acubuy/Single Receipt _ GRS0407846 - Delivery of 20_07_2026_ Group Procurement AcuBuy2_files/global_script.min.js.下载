};

ivLoadTab.prototype.beginTabCreation = function ($sender, tabId, tabContainerId) {
	if ($sender.hasClass('dm-cut-paste-target')) {
		const $container = $('.add-new-tab-modal[data-iv-tab-container-id="' + tabContainerId + '"] .content');
		const $tabInfos = {
			tabId: tabId,
			tabContainerId: tabContainerId,
			tabName: ivClient.get($container.find('.new-tab-name'), ivClient.properties.value),
			tabIcon: ivClient.get($container.find('.new-tab-icon'), ivClient.properties.value)
		};
		this.createNewTab($sender, $tabInfos);
	} else {
		const that = this;
		const options = {
			onApprove: function () {
				const $container = $('.add-new-tab-modal[data-iv-tab-container-id="' + tabContainerId + '"] .content');
				const $fields = $container.find('[data-validation]');
				if (ivValidator.validate.fields($fields, false, false, true)) {
					const $tabInfos = {
						tabId: tabId,
						tabContainerId: tabContainerId,
						tabName: ivClient.get($container.find('.new-tab-name'), ivClient.properties.value),
						tabIcon: ivClient.get($container.find('.new-tab-icon'), ivClient.properties.value)
					};
					that.createNewTab($sender, $tabInfos);
				} else {
					return false;
				}
			}
		};
		ivModalControl.initModal('.add-new-tab-modal[data-iv-tab-container-id="' + tabContainerId + '"]', options, true);
	}
}

ivLoadTab.prototype.createNewTab = function (sender, tabInfos) {
	const tabId = tabInfos.tabId;
	const tabContainerId = tabInfos.tabContainerId;
	const tabIcon = tabInfos.tabIcon;
	const tabName = tabInfos.tabName;
	const $button = $(sender);
	const tableName = ivClient.get($button, ivClient.properties.tableName);
	let newTabPosition = $button.attr('iv-area-tab-index');
	if (newTabPosition !== undefined) {
		newTabPosition = parseInt(newTabPosition);
	}
	else {
		const tabs = $("#" + tabContainerId).find('li.tabcontrol:not(.hidden)');
		newTabPosition = tabs.length ?? 0;
	}
	const pageUrl = ivClient.get($button, ivClient.properties.pageUrl);
	const containerUrl = ivClient.get($button, ivClient.properties.containerUrl);

	if ($button.hasClass('dm-cut-paste-target')) {
		ivClient.toggleLoader($('#' + tabId), true);
		ivDesignMode.controlPaste($button);
		__ivTab.saveOrder(tabContainerId, tabId, pageUrl, containerUrl);
		return;
	}

	const orders = __ivTab.getOrdersWithNewTab(tabId, newTabPosition, tabContainerId);
	
	if (modalMode) {
		modalLoading();
	}
	else {
		ivMessage.displayLoadMsg();
	}

	ivDesignMode.toggleDimmerDesignAjax(true);

	if (!ivCallMethod.createNewTabHandler) {
		ivCallMethodHandler.prototype.createNewTabHandler = function (pageUrl, pageUrlContainer, tabId, tabs, tabName, tabIcon, tableName) {
			const newTabUrl = ivScope.AjaxUrl("ctl", "util_ctrl", null, "methodname=AddNewTab");
			const invokeParameters = {
				pageUrl: pageUrl,
				pageUrlContainer: pageUrlContainer,
				tabId: tabId,
				coordinatesControls: tabs,
				tabName: tabName,
				icon: tabIcon,
				tableName: tableName
			};
			const cbNewTab = function (response) {
				// Indicate that after refresh (done by `window.location.href = url` just below)
				// we want to load the design panel for this new tab.
				// See designAddingControlPanel.init function from designmode_script.js.
				sessionStorage.setItem('tab-change-url', response.id);

				// Update overall url by including the active tab
				var url = __ivTab.updateUrlWithNewTab(location.href, response.id, tabId);
				window.location.href = url;
			};
			this.invoke(newTabUrl, invokeParameters, cbNewTab, null, null);
		};
	}
	ivCallMethod.createNewTabHandler(pageUrl, containerUrl, tabId, orders, tabName, tabIcon, tableName);
};

ivLoadTab.prototype.getOrdersWithNewTab = function (tabId, newTabPosition, tabContainerId) {

	if (!newTabPosition && newTabPosition !== 0) {
		return null;
	}
	
	const tabsOrders = $("#" + tabContainerId).find('li.tabcontrol:not(.hidden)').map((index, val) => val.id);

	let hasNewTabIncluded = false;
	let orders = [];

	for (var i = 0; i < tabsOrders.length; i++) {
		if (tabsOrders[i].length > 0) {
			var $tab = $('#' + tabsOrders[i]);

			if (i === newTabPosition) {
				orders.push(tabId + '=_:' + i + '-0');
				orders.push(tabId + '=' + $tab.data('ivFieldCode') + ':' + (i + 1) + '-0');
				hasNewTabIncluded = true;
			} else {
				var indexToAssign = 0;
				if (hasNewTabIncluded) {
					indexToAssign = i + 1;
				} else {
					indexToAssign = i;
				}
				orders.push(tabId + '=' + $tab.data('ivFieldCode') + ':' + indexToAssign + '-0');
			}
		}
	}
	return orders;
};

ivLoadTab.prototype.addExistingTab = function (pageUrl, pageUrlContainer, pfieldCode, pfieldPlaceholderCode) {
	if (modalMode)
		modalLoading();
	else
		ivMessage.displayLoadMsg();

	if (!ivCallMethod.addExistingTabHandler) {
		ivCallMethodHandler.prototype.addExistingTabHandler = function (pageUrl, pageUrlContainer, pfieldCode, pfieldPlaceholderCode) {
			this.invoke(ivScope.AjaxUrl("ctl", "util_ctrl", null, "methodname=AddExistingTab"), { pageUrl: pageUrl, pageUrlContainer: pageUrlContainer, pfieldCode: pfieldCode, pfieldPlaceHolderCode: pfieldPlaceholderCode },
				function () { document.location.href = document.location.href; }, null, null);
		};
	}
	ivCallMethod.addExistingTabHandler(pageUrl, pageUrlContainer, pfieldCode, pfieldPlaceholderCode);
};

ivLoadTab.prototype.completeUrl = function (url) {
	$.each(this.hdnActivatedTabs, function (tab, hdn) {
		var tabID = hdn.name.substring(hdn.name.indexOf(0), hdn.name.length - 'selectedID'.length),
			$tab = $('#' + tabID),
			$leftPanel = $tab.parents('.left.panel'),
			addDesignControl = url.indexOf('design_control') === -1,
			$tabPage = $tab.find('[data-tab-id="' + hdn.value + '"]');

		if (addDesignControl && $leftPanel.length) {
			url += (url.indexOf('?') === -1 ? '?' : '&') + 'design_control=' + $tabPage.attr('id');
		}
	});
	if (this.pageKey != null) {
		var re = new RegExp("__tabs=[^&]*", "gi");
		if (re.test(url)) {
			url = url.replace(re, '__tabs=' + this.pageKey);
		}
		else {
			url = (url.indexOf('?') !== -1
				? url = url + '&'
				: url = url + '?') + '__tabs=' + this.pageKey;
		}
	}
	return url.replace('#', '');
};

ivLoadTab.prototype.updateUrlWithNewTab = function (url, newTabId, prevTabId) {
	if (!this.hdnActivatedTabs || this.hdnActivatedTabs.length === 0) {
		return url;
	}

	$.each(this.hdnActivatedTabs, function (tab, hdn) {
		var tabID = hdn.name.substring(hdn.name.indexOf(0), hdn.name.length - 'selectedID'.length);
		var $tab = $('#' + tabID);

		if (!$tab || $tab.length === 0) {
			return true;
		}

		var $leftPanel = $tab.parents('.left.panel'),
			$tabPage = $tab.find('[data-tab-id="' + hdn.value + '"]');

		if (!$tabPage || $tabPage.length === 0) {
			return true;
		}

		var redc = new RegExp('design_control' + "=[^&]*", "gi");
		var re = new RegExp(hdn.name + "=[^&]*", "gi");

		if (tabID.substr(-(prevTabId.length)) === prevTabId) {
			if ($leftPanel.length) {
				var parentCtrlPrefix = $tabPage.attr('id').substring(0, $tabPage.attr('id').length - hdn.value.length);
				if (redc.test(url)) {
					url = unescape(url).replace(redc, 'design_control=' + parentCtrlPrefix + newTabId);
				} else {
					url += (url.indexOf('?') === -1 ? '?' : '&') + 'design_control=' + parentCtrlPrefix + newTabId;
				}
			} 

			if (re.test(url)) {
				url = unescape(url).replace(re, hdn.name + '=' + newTabId);
			} else {
				url = url.replace('#', '');
				url = (url.indexOf('?') !== -1
					? url = url + '&'
					: url = url + '?') + hdn.name + '=' + newTabId;
			}
		} else {
			if ($leftPanel.length) {
				var currentLeftPanelTabId = $('.left.panel').find('li.tabcontrol.active').attr("id");
				if (currentLeftPanelTabId) {
					if (redc.test(url)) {
						url = unescape(url).replace(redc, 'design_control=' + currentLeftPanelTabId);
					} else {
						url += (url.indexOf('?') === -1 ? '?' : '&') + 'design_control=' + currentLeftPanelTabId;
					}
				}

				var currentLeftPanelDataTabId = $('.left.panel').find('li.tabcontrol.active').attr("data-tab-id");
				if (currentLeftPanelDataTabId) {
					if (re.test(url)) {
						url = unescape(url).replace(re, hdn.name + '=' + currentLeftPanelDataTabId);
					} else {
						url = url.replace('#', '');
						url = (url.indexOf('?') !== -1
							? url = url + '&'
							: url = url + '?') + hdn.name + '=' + currentLeftPanelDataTabId;
					}
				}
			}
		}
	});
	return url;
};

