function TileContainer(
	containerPanelClientId,
	columnWidth,
	rowHeight,
	nbOfColumns,
	nbOfRows,
	defaultNbOfColumns,
	defaultNbOfRows,
	ajaxUrl,
	interactiveModeActivated,
	disableAction,
	contextMenu) {

	this.containerPanelClientId = containerPanelClientId;
	this.contextMenu = contextMenu;
	this.columnWidth = columnWidth;
	this.rowHeight = rowHeight;
	this.defaultNbOfColumns = defaultNbOfColumns;
	this.defaultNbOfRows = defaultNbOfRows;
	this.nbOfColumns = nbOfColumns;
	this.nbOfRows = nbOfRows;
	this.ajaxUrl = ajaxUrl;

	this.containerSelector = "#" + containerPanelClientId;
	this.tilesSelector = this.containerSelector + " .tile";

	this.containerPanel = $(this.containerSelector);
	this.tiles = $(this.tilesSelector);

	this.disableAction = disableAction || !interactiveModeActivated;

	if (interactiveModeActivated) {

		// subscribe to container events and forward to server as ajax
		this.containerPanel.on(this.tileCopyPasteEvent, $.proxy(this.forwardTileCopyPaste, this))
		
		this.containerPanel.on(this.tileDeletedEvent, $.proxy(this.forwardTileDeleted, this));
		// Delete tile when the delete event is thrown
		this.containerPanel.on(this.tileDeletedEvent, $.proxy(this.deleteTile, this));

		this.setContainerState("idle");


		if (!disableAction) {
			this.containerPanel.on(this.tilePositionChangedEvent, $.proxy(this.forwardTilePositionChanged, this));
			this.containerPanel.on(this.tileSizeChangedEvent, $.proxy(this.forwardTileSizeChanged, this));

			// Setup drag&drop and resize
			this.tiles
				.draggable(this.getDraggableOptions())
				.resizable(this.getResizableOptions());

			// Set Min/Max size for each tile
			this.tiles.each(function () {
				var tile = $(this);
				tile.resizable("option",
					{
						minWidth: tile.data("min-width"),
						minHeight: tile.data("min-height"),
						maxWidth: tile.data("max-width"),
						maxHeight: tile.data("max-height")
					});
			});
		}

		// Generate the add buttons
		this.generateAddButtons();

		//Generate Context Menu
		if (this.contextMenu) {
			this.generateContextMenu();
		}

		this.setTileOptions();
	}
}

$.extend(TileContainer.prototype, {

	disable: function () {
		if (!this.disableAction) {
			this.tiles.draggable('disable');
		}
	},

	enable: function () {
		if (!this.disableAction) {
			this.tiles.draggable('enable');
		}
	},

	generateAddButtons: function () {
		var addDivs = [];
		for (var i = 0; i < this.nbOfColumns; i++) {
			for (var j = 0; j < this.nbOfRows; j++) {
				addDivs.push(this.generateAddButton(i, j));
			}
		}
		this.containerPanel.append(addDivs);
	},

	generateAddButton: function (i, j) {
		var $addDiv = $('<div></div>')
			.addClass('new-tile-zone')
			.css('top', j * this.rowHeight + 'px')
			.css('left', i * this.columnWidth + 'px')
			.css('width', this.columnWidth + 'px')
			.css('height', this.rowHeight + 'px')
			.data('x', i)
			.data('y', j);
		if (this.containerPanel && this.containerPanel.attr('id')) {
			$addDiv
				.attr('data-iv-control', this.containerPanel.attr('id') + '_btnAdd_' + i + '_' + j);
		}
		var me = this;
		if (this.contextMenu) {
			$addDiv
				.attr('data-context-id', this.contextMenu.controlid)
				.attr('data-context-menu', ivContextMenu.trigger.click)

			$addDiv.each(function () {
				let x = $(this).data("x")
				let y = $(this).data("y")

				$(this).on("click", (function () {
					me.containerPanel
						.attr('tile-to-paste-x', x)
						.attr('tile-to-paste-y', y);
				}));
			})
		}
		else {
			$addDiv
				.click((function (x, y) { return function () { me.raiseTileCreationRequested(x, y); }; })(i, j));
		}
		return $addDiv;
	},

	removeAddButton: function (x, y) {
		this.containerPanel.find('.new-tile-zone').each(function () { if ($(this).data('x') == x && $(this).data('y') == y) { this.remove(); } });
	},

	addRow: function () {
		var addDivs = [];
		for (var i = 0; i < this.nbOfColumns; i++) {
			addDivs.push(this.generateAddButton(i, this.nbOfRows));
		}
		this.nbOfRows += 1;
		this.containerPanel.css('height', this.nbOfRows * this.rowHeight);
		this.containerPanel.append(addDivs);
	},

	addCol: function () {
		var addDivs = [];
		for (var i = 0; i < this.nbOfRows; i++) {
			addDivs.push(this.generateAddButton(this.nbOfColumns, i));
		}
		this.nbOfColumns += 1;
		this.containerPanel.css('width', this.nbOfColumns * this.columnWidth);
		this.containerPanel.append(addDivs);
	},

	removeRow: function () {
		var me = this;
		this.nbOfRows -= 1;
		this.containerPanel.find('.new-tile-zone').each(function () { if ($(this).data('y') == me.nbOfRows) { this.remove(); } });
		this.containerPanel.css('height', this.nbOfRows * this.rowHeight);
	},

	removeCol: function () {
		var me = this;
		this.nbOfColumns -= 1;
		this.containerPanel.find('.new-tile-zone').each(function () { if ($(this).data('x') == me.nbOfColumns) { this.remove(); } });
		this.containerPanel.css('width', this.nbOfColumns * this.columnWidth);
	},

	generateContextMenu: function () {
		var me = this;
		this.contextMenu.opts.beforeShow = function () {
			if (__ivCtrl[me.contextMenu.opts.currentGuid].hideAllPopupSettings())
				return false;
			me.x = this.target.data('x');
			me.y = this.target.data('y');
			this.target.addClass('is-focus');
		};
		this.contextMenu.opts.className = $.contextMenu.className + " add-tile-context-menu ";
		this.contextMenu.opts.hideSpeed = 0; //Mandatory to make hidecallback work
		this.contextMenu.opts.hideCallback = function () {
			me.x = null;
			me.y = null;
			this.target.removeClass('is-focus');
		};
		__ivHtmlControls[this.contextMenu.controlid] = { 'contextMenu': this.contextMenu };
		//Reinit context menu
		ivContextMenu.init();
	},

	openModal: function (url) {
