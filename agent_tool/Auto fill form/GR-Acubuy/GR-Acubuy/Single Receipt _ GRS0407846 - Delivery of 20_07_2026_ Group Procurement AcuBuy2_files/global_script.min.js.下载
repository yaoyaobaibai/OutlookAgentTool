	var toggleDesignableControl = function(target, eventName) {
		var $target = $(target);
		var $dropZone;
		var $parent = $target.parent();

		$('.design-panel .active-field').data('activeField', $target.data('ivAssociatedControl'));

		// display the label of the hovered designable field
		setTimeout(function() {
			var $ribbon = $('.design-panel .ui.ribbon');
			var $label = $ribbon.find('.active-field');
			var $icon = $ribbon.find('.icon');
			var activeField = $target.data('ivAssociatedControl');
			var $activeOverlay = $('.overlay.active-design-field');
			var actualActiveField = $activeOverlay.data('ivAssociatedControl');
			var intend = typeof activeField !== 'undefined' && activeField === actualActiveField;

			if (intend) {
				var $field = ivClient.get($activeOverlay.data('ivAssociatedControl'), ivClient.properties.field);
				if (typeof $field !== 'undefined') {
					$label.text($field.data('ivFieldCode'));
					if (ivValidator.isTrue($field.data('ivIsCustomField'))) {
						$icon.removeClass('hidden');
					}
					else {
						$icon.addClass('hidden');
					}
				}
			}
			// if we don't hover any designable field, we display the selected field
			setTimeout(function() {
				if (!$('.overlay.active-design-field').length) {
					var $linkedField = ivClient.get($('.linked-fields'), ivClient.properties.value);
					if ($linkedField) {
						var $field = $('[data-iv-control="' + $linkedField + '"]');
						$label.text(ivClient.get($field, ivClient.properties.field).data('ivFieldCode'));
						if (ivValidator.isTrue($field.data('ivIsCustomField'))) {
							$icon.removeClass('hidden');
							return;
						}
					}
					else {
						$label.text('Design Mode');
					}
					$icon.addClass('hidden');
				}
			}, 1000);
		}, 500, $target);
		if (!$target.is('.overlay')) {
			return;
		}
		if ($target.length > 0) {
			$dropZone = $target.find('.sortable_no_move');
			if (eventName === 'mouseover' || eventName === 'mouseenter') {
				$('.active-design-field').removeClass('active-design-field');
				$target.addClass('active-design-field');

				$dropZone.addClass('zone-droppable');

				var overlayFieldLabel = $('.active-design-field:not(.active-design) > .overlay-field-code');
				// If we hover the active field we don't want to display the tooltip field's ID.
				if (overlayFieldLabel.length === 0) {
					return;
				}

				// classic html template, do not need to calculate
				//  ==>placeholder td
				//		==> overlay
				//		==> designable field
				if ($parent.children().not('.design-action-bar, .ui.dimmer').length === 2 && $($parent.children()[1]).is('[data-iv-role*=field]')) {
					return;
				}
				if ($parent.is('.extender')
					|| $parent.is('.phc-card') && $target.data('ivControlType').indexOf('Frame') > -1
					|| $parent.is('.tabcontrol')
					|| $target.is('.overlay-prx')
					|| $parent.is('.placeholder-cell')) {
					return;
				}

				// calculate designable field beside overlay
				var cellParentTd = $parent.attr('data-iv-role');
				var isHeaderCol = $target.parent().is('th[scope=col]');

				if (!$parent.hasClass('designable') && cellParentTd !== 'cell' && !isHeaderCol || ($parent.hasClass('designable') && $target.parent().children().length > 2)) {
					ivDesignMode.calculateOverlay($target);
				}
			}
		}
	};

