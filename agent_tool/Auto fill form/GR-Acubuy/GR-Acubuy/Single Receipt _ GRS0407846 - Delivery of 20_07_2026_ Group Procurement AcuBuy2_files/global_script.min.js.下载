			readonly: function ($control, $field, data, value) {
				const $ellipsisButton = $field.find('.ellipsis-selector'),
					$grid = $field.find('.grid.container'),
					$fields = $grid.find(ivClient.selector.fields);

				if (!$ellipsisButton)
