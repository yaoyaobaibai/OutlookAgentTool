		parseDate: function (messageDate) {
			if (!messageDate)
				return '';

			var userDate = new Date(
				ivBlogUtil.getUserUTCDate().valueOf() + (this.config.serverDateOffset ?? 0)
			);
			return ivBlogUtil.parseDate(messageDate, userDate);
		},
		getLocalDate: function (messageDate) {
			if (messageDate instanceof Date && this.config.timeZoneOffset) {
				return new Date(
					messageDate.valueOf() + this.config.timeZoneOffset + (this.config.serverDateOffset ?? 0)
				);
			}
			return messageDate;
		},
		getServerDate: function () {
			var jsTimestamp = ivBlogUtil.getUserUTCDate().valueOf();
			var jsInstance = this.instanceName;
			ivBlogAjaxHandler.getServerDate(
				jsTimestamp,
				jsInstance,
				function (args) {
					if (!args)
						return;

					var stop = ivBlogUtil.getUserUTCDate().valueOf();

					args = JSON.parse(args);
					var start = Number(args.jsTimestamp);
					var ajaxCall = stop - start;
					var serverDate = new Date(args.server);
					var serverDiff = serverDate.valueOf() + ajaxCall - stop;

					if (serverDiff === 0)
						return;

					serverDiff -= ajaxCall;
					if (Math.abs(serverDiff) > 10 * 1000)
						upperWindow.__ivCtrl[args.jsInstance].config.serverDateOffset = serverDiff;
				},
				null
			);
		},
