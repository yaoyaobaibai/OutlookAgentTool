					if (this.ShowHeader)
						_row.row.cells[i].className = "PTd";
				}
				_row.row.className = 'item_selected';
				_row.row.setAttribute("key", this.value);
				_row.row.setAttribute("data-id", this.value);
				_row.row.setAttribute("role", "listitem");

				var elemDataQaId = this.dataQaId ? (this.dataQaId + '_' + this.value.replace(";", "_")) : null;

				var gridAllowDeleteColumn = ivClient.get('#' + this.GridClientID, ivClient.properties.data)
					? ivClient.get('#' + this.GridClientID, ivClient.properties.data).autoGenerateDeleteButton
