		renderMessageAssignmentHistory: function (msg) {
			var $msgContentWrapper = msg.htmlRendering.find(`.${this.cssClass.comment.messageContentWrapper}`).first();

			$msgContentWrapper.find('.iv-blog-msg-assignment-history').remove();

			if (msg.assignmentHistory.length == 0)
				return;

			var $msgAssigmentHistory = $(`<div class="iv-blog-msg-assignment-history"></div>`);

