		newMsgTypeHeaderContainer: function (msgType) {
			var me = this;

			if (!msgType)
				return;

			// Header specific to chat
			if (msgType.code == 'chat')
				return this.newChatHeaderContainer();

			// Other message types
			var title = this.config.messageCenterMode ? me.config.blogPanelTitle : ivScope.GetText(msgType.code);
			var $convHeaderContainer = $(`
