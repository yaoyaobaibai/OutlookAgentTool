	updateCheckAllState: function (id) {
		var gridView = this, i = 0;
		$.each(gridView.cb, function (name, obj) {
			if (id && name != id)
				return true;
			gridView.updateSelectingCounter(name);
			if (typeof gridView.table === 'undefined')
				return;

			var checkAll = true;
			var cellIndex = gridView.findCheckAllCellIndex(name);
			var hasCheckBoxes = false;
			var headerRow = gridView.Header ? gridView.Header : gridView.grid.rows[0];
			var checkAllCheckBox = $(headerRow.cells[cellIndex]).find(':checkbox').first();
			var $checkAllCheckBoxField = checkAllCheckBox.closest('.field');
			var checked = $checkAllCheckBoxField.data('checked');
			var template = $checkAllCheckBoxField.closest('th[template]').attr('template');

			$.each(gridView.grid.rows, function (i, row) {
				var key = row.getAttribute("data-id");
				if (!key)
					return true;
				var gridRow = row;
				var cb = $(gridRow.cells[cellIndex]).find(':checkbox');
				if (cb && cb.length > 0) {
					hasCheckBoxes = true;
					if (!cb.is(':disabled')) {
						if (!ivClient.is.checked(cb)) {
							checkAll = false;
							return false;
						}
					}
				}
			});

			if (!checked && template) {
				checked |= (gridView.cb[template] && gridView.cb[template].length > 0);
			}

			if (checkAll && hasCheckBoxes) {
				$checkAllCheckBoxField.removeClass('partial-selection');
				checkAllCheckBox.prop('checked', true);
			}
			else {
				if (checked) {
					ivCheckBox.invoke.value(checkAllCheckBox.closest('.ui.checkbox'), null, null, false);
