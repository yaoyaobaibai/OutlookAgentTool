getLocalizedValue = function(key) {
	var value = ivClient.get(key, ivClient.properties.value);

	// Key found and simple string
	if (typeof value === 'string')
		return value;

	// Localized text
	if (typeof value === 'object') {
		//case of Selector.selectedValues
		if (!(Lang in value))
			return value; 

		var valLg = value[Lang];

		// If it corresponds to a valid non-empty text, we return it
		if (typeof valLg === 'string' && valLg !== '')
			return valLg;

		// Check if the value has been translated in some other language
		for (var lg in value) {
			valLg = value[lg];

			// If found -> return it
			if (typeof valLg === 'string' && valLg !== '')
				return valLg;
		}
	}

	// All other cases leads to an empty string
	return '';
}

RemoveAccents = function (s) {
	var r = s.toLowerCase();
	//r = r.replace(new RegExp("\\s", 'g'), "");
	r = r.replace(new RegExp("[àáâãäå]", 'g'), "a");
	r = r.replace(new RegExp("æ", 'g'), "ae");
	r = r.replace(new RegExp("ç", 'g'), "c");
	r = r.replace(new RegExp("[èéêë]", 'g'), "e");
	r = r.replace(new RegExp("[ìíîï]", 'g'), "i");
	r = r.replace(new RegExp("ñ", 'g'), "n");
	r = r.replace(new RegExp("[òóôõö]", 'g'), "o");
	r = r.replace(new RegExp("œ", 'g'), "oe");
	r = r.replace(new RegExp("[ùúûü]", 'g'), "u");
	r = r.replace(new RegExp("[ýÿ]", 'g'), "y");
	//r = r.replace(new RegExp("\\W", 'g'), "");
	return r;
}

