function callModalCloseEvent(modalId) {
	var eventValue = getModalCloseEvent();
	setModalCloseEvent();
	setHasModal();
	setModalScrollTop();

	if (eventValue) {
		var eventType = eventValue.split('|')[0];
		var eventArgs = null;
		if (eventValue.split('|').length > 1)
			eventArgs = eventValue.split('|')[1];
		switch (eventType) {
			case "submit":
				window.submit();
				break;
			case "refresh":
				refreshDocument();
				break;
			case "postback":
				__doPostBack(eventArgs, '');
				break;
		}
	}
	else if (window.sessionStorage)
		sessionStorage.removeItem('triggeredBy');
}


