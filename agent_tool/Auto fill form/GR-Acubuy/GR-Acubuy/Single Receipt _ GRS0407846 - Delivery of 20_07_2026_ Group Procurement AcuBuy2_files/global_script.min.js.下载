ivCallMethodHandler.prototype.GetQueryHandle = function (parameters, succeededCallback, failedCallback, userContext, type, timeout, options) {
	let qs = "&txtQuery=" + encodeURIComponent(userContext[1]);

	if (userContext[0].TypeSelector != "ellipsis" && userContext[0].options.querystring != null) {
		qs += "&" + parseQueryString(userContext[0].options.querystring);
	}
	if (userContext[0].options.ctxVarText != null) {
		qs += "&" + parseQueryString(userContext[0].options.ctxVarText);
	}

	// Merge with post parameters (in particular, when getting label from a modal with a filter area)
	const selectorIFrame = getIFrameForSelector(qs);
	if (selectorIFrame) {
		qs += "&prefixAjax=body%3Ax";
		const filters = selectorIFrame.contentDocument.querySelectorAll('.iv-filter [name]');
		const isTreeview = selectorIFrame.contentDocument.querySelector('.iv-treeview');
		filters.forEach(elt => {
			if (elt.closest('.iv-keyword') && isTreeview) {
				return;
			}
			parameters[elt.name] = elt.value;
		});
	}

	const url = parameters.queryByValueUrl
		?? (userContext[0].TypeSelector != "ellipsis" ? userContext[0].options.url : userContext[0].popupUrl);

	return this.invoke(url + "?methodname=GetQueryHandle" + qs, parameters, succeededCallback, failedCallback, userContext,
		type, timeout, options);
};

function getIFrameForSelector(qs) {
	const qsParams = new URLSearchParams(qs);
	if (qsParams.has('tableName') && qsParams.has('selectorCode')) {
		const tableName = qsParams.get('tableName');
		const selectorCode = qsParams.get('selectorCode');
		const iframes = topWindow().document.getElementsByTagName('iframe');
		for (const iframe of iframes) {
			if (iframe.src.indexOf('tableName=' + tableName) > -1 && iframe.src.indexOf('selectorCode=' + selectorCode) > -1)
				return iframe;
		}
	}
}

