					.append($('<i/>', { class: 'icon fa-ellipsis-vertical' }))
					.append($('<div />', { class: 'menu hidden' })
						.append($('<div />', { class: 'item ' + cssClass.btnDeleteField, text: ivScope.GetText('delete_field') }))
						.append($('<div />', { class: 'item ' + cssClass.btnResetFieldValue, text: ivScope.GetText('reset_field_values') }))
