function parseQueryString(str) {
	let str0 = str;
	if (str !== null) {
		const regex = new RegExp("#(?:[^&]*)", "gi");
		let results = null;
		while ((results = regex.exec(str)) !== null) {
			let value = getLocalizedValue(results[0]);
			
			// encodeURIComponent cannot escape alphabetic, decimal digits, - _ . ! ~ * ' ( )
			// the code below helps to escape !'() in the string
			value = encodeURIComponent(value).replace(/[!'()]/g, escape);
			str0 = str0.replace(results[0], value);
		}
	}
	return str0;
}

