		deleteButtonClick: function(event) {
			const $container = $('#design-field');
			const params = ivDesignMode.GetParams($container);
			let warningMsg = null;

			// if DCC, delete the DCC and not the only the selected display - TODO : add other displays type when activated (or other way to detect dcc)
			if (params.IvControlType === 'ivalua.platform.ctl.DataCollection.TableDisplay') {
				const dccFieldCode = ivClient.get(params.ClientID, 'data', 'ivParentFieldCode');
				if (dccFieldCode) {
					params.FieldCode = dccFieldCode;
				}
			}
			//add a warning in the case of the 1st colum of a grouped column is deleted
			if (params.IvControlType === 'ivalua.platform.DataCollectionAttribute') {
				let col = ivClient.get(params.ClientID, 'control');
				if (col instanceof jQuery && col.length > 0) {
					col = col[0];
				}
				if (col.closest('th[data-iv-groupedin="' + params.FieldCode + '"][data-iv-groupedwith]') !== null) {
					warningMsg = ivScope.GetText('design_mode_warning_detete_grouped_column');
				}
			}

			// additional positioning params : allow to move controls below to top if there are controls below and if there are also controls on siblings
			let addDeleteParam = false;
			const $cell = $('#' + params.ClientID).closest('td');
			if ($cell.length > 0) {
				const colInfo = ivPlaceHolderDesign.getFieldsInColumn($cell);
				if (colInfo && colInfo.$fields.length > 0) {
					addDeleteParam = colInfo.$cell.prevAll('td').not('.hidden').not('.empty-cell').length > 0;
					if (!addDeleteParam) {
						const nextColInfo = ivPlaceHolderDesign.getFieldsInColumn(colInfo.$cell.nextAll('td').not('.hidden').first(), { 'includeSelf': true });
						addDeleteParam = nextColInfo && nextColInfo.$fields.length > 0;
					}
				}
			}

			if (addDeleteParam) {
				const paramName = 'delete_direction';
				const $deleteParam = $('<div/>')
					.appendShiftParams(paramName, [shiftParameters.shiftLeft, shiftParameters.shiftUp]);

				params['additionalParams'] = $deleteParam;
			}

			params['TitleTextCode'] = 'delete_field';
			params['Warning'] = warningMsg;

			confirmModal.handlers.open(params, confirmModal.actions.delete);
			event.stopPropagation();
			return false;
		},
