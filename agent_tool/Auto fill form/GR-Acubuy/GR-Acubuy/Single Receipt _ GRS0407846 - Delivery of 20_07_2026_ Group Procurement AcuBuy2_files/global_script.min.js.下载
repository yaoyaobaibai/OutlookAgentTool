						$content.append($('<div />', { class: 'ui checkbox select-all-checkbox', tabindex: 0 })
							.append($('<input />', { type: 'checkbox', id: id }))
							.append($('<label />')))
							.append($('<label />', { for: id }).text('Select All ' + e.ids.length + ' ' + e.label));


						var $popup = $('<div />', { class: 'ui popup' }).append($content);
						$checkbox.after($popup);
						$checkbox.popup({
							popup: $popup,
							target: $checkbox,
							on: 'manual',
							preserve: true,
							position: 'right center'
						}).popup('show');

						$(document).off('click.selectAll').
							on('click.selectAll', 'body', function (event) {
