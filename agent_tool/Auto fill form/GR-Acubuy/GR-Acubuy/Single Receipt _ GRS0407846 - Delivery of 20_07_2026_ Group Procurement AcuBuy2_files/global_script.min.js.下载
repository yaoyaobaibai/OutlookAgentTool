					category, result,
					$category, $result, $iconResult, $textResult,
					nbTotal = 0,
					searchText = $container.search('get value');

				if (nbCategories > 0) {
					for (catIndex = 0; catIndex < nbCategories; catIndex++) {
						// get the first item regardless of name of the first key
						for (var cKey in response[catIndex]) {
							category = response[catIndex][cKey];
							if (category) {
								// category
								if (category.browse_access) {
									$category = $('<a />');
									$category.addClass('result');

									var objUrlBrowse = category.url_browse;
									if (objUrlBrowse.indexOf('?') >= 0)
										objUrlBrowse += "&";
									else
										objUrlBrowse += "?";
									objUrlBrowse += "txtQuery=" + encodeURIComponent(searchText);

									$category.attr('href', objUrlBrowse);
								}
								else {
									$category = $('<span />');
								}
								$category.addClass('cat');
								$category.text(category.label);
								html += '<li id="' + namespace + '_' + cKey + '" role="option" class="item">' + $category.prop('outerHTML') + '</li>';

								nbResults = category.results.length;
								nbTotal += nbResults;
								for (resultIndex = 0; resultIndex < nbResults; resultIndex++) {
									// result
									result = category.results[resultIndex];
									if (result) {

										$iconResult = $('<i />');
										$iconResult.addClass(category.css_class);

										$textResult = $('<span />', {
											class: 'name'
										});
										$textResult.text(result.label);

										$result = $('<a />');
										$result.addClass('result');
										$result.attr('href', formatUrl(category.url_manage, result));
										$result.append($iconResult);
										$result.append($textResult);

										html += '<li id="' + namespace + '_' + cKey + '_' + result.ID + '" role="option" class="item">' + $result.prop('outerHTML') + '</li>';
									}
								}
							}
						}
						ivAccessibility.promptLiveMessage(nbTotal + ' ' + ivScope.GetText('accessibility_universal_search_results'));
					}
					return html;
				}
				return false;
			}
		},
		settings = {
			minCharacters: 2,
			type: 'category',
			fields: {
				// hook to manage the response
				results: '0'
			},
			apiSettings: {
				url: ivScope.AjaxUrl('bas', 'util_ctrl', null),
				data: {
					methodname: 'UniversalSearch',
					mobileMode: $('html').hasClass('iv-mobile')
				},

				beforeXHR: function (xhr) {
					xhr.setRequestHeader('Content-Type', 'application/json; charset=utf-8');
				},

				beforeSend: function (settings) {
					settings.data.searchText = settings.urlData.query;
					return settings;
				}
			},
			templates: {
				category: templates.results
			},
			onResultsOpen: function () {
				var
					$container = $(selector.searchContainer),
					$prompt = $container.find(selector.prompt);
				$prompt.attr('aria-expanded', 'true');
			},
			onResultsClose: function () {
				var
					$container = $(selector.searchContainer),
					$prompt = $container.find(selector.prompt);
				$prompt.attr('aria-expanded', 'false').removeAttr('aria-activedescendant');
			}
		},
		handlers = {
			// Keyboard support for ARIA 1.1 Combobox
			// https://www.w3.org/TR/wai-aria-practices-1.1/#combobox
			// some behaviors are directly managed by Semantic UI Search module
			// it's an additional support
			handleAccessibilityKeyboard: function (event) {
				var
					$container = $(selector.searchContainer),
					$prompt = $container.find(selector.prompt),
					$results = $container.find($.fn.search.settings.selector.results),
					$result = $container.find($.fn.search.settings.selector.result),
					$category = $container.find($.fn.search.settings.selector.category),
					$activeResult = $result.filter('.' + $.fn.search.settings.className.active),
					currentIndex = $result.index($activeResult),
					resultSize = $result.length,
					hasActiveResult = $activeResult.length > 0,
					keyCode = event.which || event.keyCode,
					newIndex;

				if ($container.search('is visible')) {
					// Up Arrow support
					// If the listbox is displayed, moves focus to the last suggested value.
					if (keyCode === KEYS.UP_ARROW && (!hasActiveResult || currentIndex === 0)) {
						event.preventDefault();
						newIndex = resultSize - 1;
						$category.removeClass($.fn.search.settings.className.active);
						$result
							.removeClass($.fn.search.settings.className.active)
							.eq(newIndex)
							.addClass($.fn.search.settings.className.active)
							.closest($category)
							.addClass($.fn.search.settings.className.active);
					}
					// Down Arrow support
					// If focus is on the last option, moves focus to the first option.
					else if (currentIndex + 1 === resultSize && keyCode === KEYS.DOWN_ARROW) {
						event.preventDefault();
						newIndex = 0;
						$category.removeClass($.fn.search.settings.className.active);
						$result
							.removeClass($.fn.search.settings.className.active)
							.eq(newIndex)
							.addClass($.fn.search.settings.className.active)
							.closest($category)
							.addClass($.fn.search.settings.className.active);
					// Enter support
					} else if (!hasActiveResult) {
						if (keyCode === KEYS.ENTER) {
							event.preventDefault();
							event.stopPropagation();
						}
					}
					// refresh active result
					$activeResult = $result.filter('.' + $.fn.search.settings.className.active);
					// scroll to the selected result 
					if ($activeResult && $activeResult.length > 0)
						$results.scrollTop(
							$activeResult.offset().top - $results.offset().top + $results.scrollTop()
						);
					// & add aria attributes
					$results.find('.item').attr('aria-selected', null);
					$activeResult.closest('.item').attr('aria-selected', 'true');
					$prompt.attr('aria-activedescendant', $activeResult.closest('.item').prop('id'));
				}
				// Enter support
				else {
					if (keyCode === KEYS.ENTER) {
						event.preventDefault();
						event.stopPropagation();
					}
				}
				// Escape support
				// Clears the textbox.
				if (keyCode === KEYS.ESCAPE) {
					$prompt.val('');
				}
			}
		};

	function formatUrl(url, obj) {
		var formattedUrl = url.format(obj.ID);

		for (var k in obj) {
			if (obj.hasOwnProperty(k)) {
				var r = obj[k];
				if (r && r.toString().startsWith('/'))
					r = r.toString().substring(1, r.toString().length);
				formattedUrl = formattedUrl.replace('{' + k + '}', r);
			}
		}
		return formattedUrl;
	}

	return {
		init: function () {
			var
				$container = $(selector.searchContainer),
				$prompt = $container.find(selector.prompt);
			$container.search(settings);
			// accessibility events
			$container
				.off('keydown' + eventNamespace)
				.on('keydown' + eventNamespace, handlers.handleAccessibilityKeyboard);
		}
	};

}(jQuery));

