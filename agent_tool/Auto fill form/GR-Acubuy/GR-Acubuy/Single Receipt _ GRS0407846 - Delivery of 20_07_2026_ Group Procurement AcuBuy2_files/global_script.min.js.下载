function setModalCloseEvent(eventType, eventArgs) {
	if (document) {
		var eventValue = (eventType ? eventType : '');
		if (eventArgs)
			eventValue += '|' + eventArgs;
		var $hdnClose = $(document).find("body").find("#_hdnModalCloseEvent");
		
		if ($hdnClose && $hdnClose.length > 0) {
			$hdnClose.val(escape(eventValue));
