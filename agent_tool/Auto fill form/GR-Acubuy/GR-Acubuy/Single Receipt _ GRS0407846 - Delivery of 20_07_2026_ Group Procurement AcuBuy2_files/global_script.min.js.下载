function refreshGridSettings(data, grid) {
	// reset fixed header & columns
	// fixed header
	ivGrid.changeFixedHeader(grid.ClientID, data.fixedHeaderState === true);

	// fixed columns (we should not call `changeFixedColumns` if the number has not changed
	// or else, this method will reset the frozen columns)
	var field = ivClient.get(grid.ClientID, ivClient.properties.field);
	var currentValue = ivClient.get(field, ivClient.properties.data, 'fixedColumnNumber');
