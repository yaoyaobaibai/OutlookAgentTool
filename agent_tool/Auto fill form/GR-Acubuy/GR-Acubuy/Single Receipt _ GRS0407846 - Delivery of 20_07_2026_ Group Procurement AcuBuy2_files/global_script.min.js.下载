			if ($('.overlay-file-viewer').length > 0) return;

			if (!fileExtension) {
				fileExtension = getFileExtension(fileName);
			}

			if (mobileMode) {
				if (VIEWABLE_DOC_EXTENSIONS.indexOf(fileExtension) > -1) {
					window.open(getLinkToFileFromId(fileId).attr('href'), '_blank');
					return;
				}
			}

			// If extension is unknown, we execute the default action (download file)
			if (VIEWABLE_IMAGE_EXTENSIONS.indexOf(fileExtension) === -1 &&
				VIEWABLE_CAD_EXTENSIONS.indexOf(fileExtension) === -1 &&
				VIEWABLE_MISC_EXTENSIONS.indexOf(fileExtension) === -1 &&
				VIEWABLE_DOC_EXTENSIONS.indexOf(fileExtension) === -1) {
				window.open(getLinkToFileFromId(fileId).attr('href'), '_blank');
				return;
			}

			// Create an overlay to display the file content
			var overlay = document.createElement('div');
			overlay.className = 'overlay-file-viewer';
			overlay.innerHTML = getOverlayContent(fileName, fileId, fileExtension);
			document.body.appendChild(overlay);

			$overlay = $(overlay);

			// Add a close event on the corresponding icon of the overlay (unregistering previous one if this is not the first file we open)
			$overlay.on('click.' + EVT_NS, '#closeViewer', closeViewer);

			// Add a keydown listener
			$(document).on('keydown.' + EVT_NS, manageKeyEvents);

			// Add navigation between files
			$overlay.on('click.' + EVT_NS, '.navigate-file', changeToOtherFile);

