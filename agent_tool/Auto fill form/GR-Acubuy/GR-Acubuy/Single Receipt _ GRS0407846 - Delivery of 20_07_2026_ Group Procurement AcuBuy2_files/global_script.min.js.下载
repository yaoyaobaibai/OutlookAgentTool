				}
			}

			$(this).show();
			//access to the url of the iframe, not the main window
			if (this.contentWindow.location.href.indexOf('listColumn') == -1) {
				$(this).removeAttr('data-list-column');
			}
			$('<input>').attr('type', 'hidden').attr('name', 'listColumn').val($(this).attr('data-list-column')).appendTo($($(this).contents()).find('form'));
			$modal.off('keydown.modal').on('keydown.modal', ivModal.keydownHandler);

			//create ghost window during src changes
			$(this.contentWindow).on('beforeunload', function (e) {

				var $modal = $(e.target).find('div.ui.modal.active');
				var iframeId = $modal.data('modal-id');
				var $iframe = $('iframe#' + iframeId);
				if ($iframe && $iframe.length > 0) {
					var $ghost = $modal.parent().clone().addClass('ghost');
					$ghost.find("#headerContainer").find('.modal-list-tool-link').remove();
					$('<div class="ui large text loader"></div>').appendTo($ghost.find('div.ui.modal'));
					$ghost.find('div.ui.modal').css('height', $modal.height() + 'px');
					$ghost.find('.wrapper').remove();
					$ghost.find('footer').remove();
					$iframe.parent().append($ghost);
					$iframe.hide();
