function setHasModal(modalId) {
	var hasModal = modalId && modalId.length > 0;
	var hasModalStr = (hasModal ? "true" : "false");
	var modalIdStr = (modalId ? modalId : hasModal ? $(document).find("body").find("#_hdnModalId").val() : '');
	if (document) {
		var $hdnHasModal = $(document).find("body").find("#_hdnHasModal");
		if ($hdnHasModal && $hdnHasModal.length > 0) {
			$hdnHasModal.val(hasModalStr);
		}
		var $hdnModalId = $(document).find("body").find("#_hdnModalId");
		if ($hdnModalId && $hdnModalId.length > 0) {
			$hdnModalId.val(modalIdStr);
		}
	}
}

function getModalCloseEvent() {
	var eventType = null;
	if (document) {
		var $hdnClose = $(document).find("body").find("#_hdnModalCloseEvent");
		var $modal = $('#' + $('#_hdnModalId').val());

		// Search the modal in case of multi modals
		if ($modal.length === 0)
			$modal = $(mainWindow().document).find("body").find('#' + $('#_hdnModalId').val());

		var clientIdToRefresh = $modal.attr('clientIdToRefresh');		

		var objectId = $($modal.contents()).find('#listColumn_objectID').val();
		if (!objectId)
			objectId = $modal.attr('objectId');
		
		if (clientIdToRefresh && objectId)
		{
			//add new value before posting the update panel
			var hdnField = document.querySelector('#' + clientIdToRefresh)?.closest('.field')?.querySelector('.control-wrapper>input[type=hidden][data-validation]');
			if (typeof hdnField !== 'undefined' && hdnField !== null) {
				var val = hdnField.value?.trim();
				if (typeof val !== 'undefined' && !val.split(',').includes(objectId)) {
					hdnField.value = val + (val !== '' ? ',' : '') + objectId;
				}
			}
			return 'postback|' + clientIdToRefresh;
		}
		if ($hdnClose && $hdnClose.length > 0)
			eventType = unescape($hdnClose.val());
	}
	return eventType;
}

function hasModal() {
	let hasModal = false;

	if (document) {
		var $hdnClose = $(document).find("body").find("#_hdnHasModal");
		if ($hdnClose && $hdnClose.length > 0) {
