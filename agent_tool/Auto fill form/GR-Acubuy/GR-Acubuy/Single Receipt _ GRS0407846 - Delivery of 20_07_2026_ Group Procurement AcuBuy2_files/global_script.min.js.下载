	/**
	 * Load asynchronously a new JS script.
	 * @param {boolean} condition condition to add or not the script.
	 * @param {string} path file path to the script.
	 * @param {function} cb callback that should be rised after adding the script.
	 * @param {jQuery} $content content area where to attach callback data.
	 * @param {string} fileId file identifier.
	 * @param {string} fileExt file extension.
	 */
	function loadScript(condition, path, cb, $content, fileId, fileExt) {
		if (condition) {
			cb($content, fileId, fileExt);
			return;
		}

		var script = document.createElement('script');
		script.type = "text/javascript";
		script.src = getApplicationBasePath() + path;
		script.async = true;
		script.addEventListener('load', function () { cb($content, fileId, fileExt); });
		document.body.appendChild(script);
	}

