			const menu = dropdown.querySelector('.iv-menu-container');
			const content = $(dropdown).scrollParent().get(0);

			if (menu && content) {
				//check if menu bottom is outside content
				const contentTop = $(content).offset()?.top ?? 0;
				const contentHeight = $(content).height() ?? 0;
				const menuTop = $(menu).offset()?.top ?? 0;
				const menuHeight = $(menu).height() ?? 0;
				const shouldScroll = ((contentTop + contentHeight) - (menuTop + menuHeight)) < 0;

				if (shouldScroll) {
					// Semantic UI adds a transition (200ms) in the dropdown control
					// we need to add a small delay before move the scrollbar
					setTimeout(function innerSetScroll() {
						//menu can't fit into content, scroll to dropdown position
						if (menuHeight > contentHeight) {
							dropdown.scrollIntoView(true);

							//special case for advanced filters, prevent the dropdown from scrolling under the search buttons
							let contentAdjust = 0;
							const $advFiltersPanel = $(content).closest('.iv-filter-panel');
							if ($advFiltersPanel.length > 0) {
