function modalPopup(opts) {
	$(upperDocument).find('#mainForm').attr('aria-hidden', 'true');
	if (!jQuery) { alert('jQuery not installed!'); return; }
	if (!opts['url']) return;
	var url = opts['url'];
	url = parseQueryString(url);

	//todo : add an option to set size

	if (!$.fn.dialog) { alert('jQuery UI not installed!'); return; }
	var modalId = currentModalId;
	if (modalId)
		url = url + (url.indexOf('?') >= 0 ? '&' : '?') + 'fuid=' + modalId;

	var post = false;
	var postValues = null;
	if (opts['method'] && opts['method'] === 'post') {
		post = true;
		if (opts['postValues'])
			postValues = opts['postValues'];
	}

	//Set the triggering element
	var triggeredByFunc = null;
	var triggeredByObj = null;

	try {
		triggeredByFunc = arguments.callee.caller;
		while (triggeredByFunc != null) {
			if (triggeredByFunc.arguments && triggeredByFunc.arguments.length > 0) {
				for (var i = 0, l = triggeredByFunc.arguments.length; i < l; i++) {
					if (triggeredByFunc.arguments[i]) {
						if (triggeredByFunc.arguments[i].target) {
							triggeredByObj = triggeredByFunc.arguments[i].target;
							break;
						}
						else {
							triggeredByObj = triggeredByFunc.arguments[i];
						}
					}
				}
			}

			if (triggeredByObj)
				break;

			triggeredByFunc = triggeredByFunc.caller;
		}
	}
	catch (ex) {
		// Cannot use "arguments.callee.caller" while using "strict mode".
		// Catch the exception to have the modal working without the triggeredByObj
	}
	//modal must create on parent window
	var $modal = parent.createModal(url, post, postValues, opts);
	if (url.indexOf('listColumn') > -1) {
		const params = new URLSearchParams(url);
		const cols = params.get('listColumn');
		if (cols) {
			$modal.attr('data-list-column', cols.replaceAll('%2c', ',').replaceAll('%3b', ';'));
		}
	}

	if (triggeredByObj) {
		$modal.data('triggeredByObj', triggeredByObj);
		if (window.sessionStorage)
			sessionStorage.setItem('triggeredBy', triggeredByObj.id);
	}

	if (opts.clientIdToRefresh) {
		$modal.attr('clientIdToRefresh', opts.clientIdToRefresh);
	} else {
		//clientIdToRefresh is in the querystring
		if (opts.url.indexOf('?') > -1) {
			var qs = opts.url.split('?')[1];
			$(qs.split('&')).each(function (e) {
				if (qs.split('&')[e].split('=')[0] == 'clientIdToRefresh') {
					$modal.attr('clientIdToRefresh', qs.split('&')[e].split('=')[1]);
				}
					else if (qs.split('&')[e].split('=')[0] == 'objectId') {
						$modal.attr('objectId', qs.split('&')[e].split('=')[1]);
					}
			});
		}
	}
		if (opts.objectId) {
			$modal.attr('objectId', opts.objectId);
		}
	if (opts.onCloseScript) {
		$modal.attr('onCloseScript', opts.onCloseScript);
	}

	initModalHiddens();
	setHasModal($modal.attr('id'));

	if (post === true) {
		try {
			if (navigator && navigator.userAgent.indexOf('Trident/') > 0) //if ie
			{
				$modal.load(function () {
					var $form = $(this.contentWindow.document).find('#modalPostForm');
					if ($form.length > 0) {
						$form.submit();
					}
				});
			}
			else {
				var $form = $($modal[0].contentWindow.document).find('#modalPostForm');
				if ($form.length > 0) {
					$form.submit();
				}
			}
		}
		catch (ex) { }
	}

	return $modal;
}

function modalClose() {
	var DOMToRemove = null;
	var $modal = $(document).find('div.ui.modal[data-modal-id=' + currentModalId + ']');
	if ($modal.length > 0) {
