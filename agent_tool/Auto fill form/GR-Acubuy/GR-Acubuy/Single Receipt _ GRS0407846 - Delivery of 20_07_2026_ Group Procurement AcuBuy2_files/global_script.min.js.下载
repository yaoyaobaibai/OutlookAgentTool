			});

			$modal.modal('show');
	
			$(this).data('isLoaded', true);

			// Trigger a custom event to indicate that the modal is shown.
			// This is useful in particular for the Swiper plugin (see swiper_script.js).
			// Also to correctly trigger an event in the iframe context (and not the current
			// one which is the parent of the iframe), we need to go through the contentWindow.
			$iframe[0].contentWindow.$('body').data('isLoaded', true);
			$iframe[0].contentWindow.$('body').trigger('modalShown.ivModal');
		});

	if (!post)
		$iframe.attr("src", url);

	if (post === true) {
		try {
			var $document = $($iframe[0].contentWindow.document);
			if ($document.find('body').length == 0) {
				$document[0].write('<html><body></body></html>');
			}
			$document.find('body').append('<form id="modalPostForm" name="mainForm" action="' + url + '" method="post"></form>');
			var $form = $document.find('#modalPostForm');
