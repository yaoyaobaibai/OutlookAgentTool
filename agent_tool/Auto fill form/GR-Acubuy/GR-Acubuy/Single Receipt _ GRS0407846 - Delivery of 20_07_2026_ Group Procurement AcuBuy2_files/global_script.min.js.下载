var ivDialog = (function ($) {
	'use strict';

	const namespace = 'ivDialog';
	const eventNamespace = '.' + namespace;
	const defaultSettings = {
		movePopup: false,
		position: 'bottom left',
		lastResort: 'bottom right',
		onShow: onShowHandler,
		onHide: onHideHandler
	};
	const dialogDisplayMode = {
		tooltip: 'Tooltip',
		modal: 'Modal'
	};

	function onShowHandler() {
		const $trigger = $('#' + $(this).data('ivDialogTrigger'));

		//Avoid open popup when target is disable
		if ($trigger.prop('disable') || $trigger.hasClass('disable')) {
			return false;
		}

		$(this).addClass('dialog-popup');
		// accessibility
		$trigger.attr('aria-expanded', 'true');
	}

	function onHideHandler() {
		const $trigger = $('#' + $(this).data('ivDialogTrigger'));
		// accessibility
		$trigger.attr('aria-expanded', 'false');
	}

	function initializeEvents() {
		var $dialogs = $(document).find(ivDialog.selector.field);
		$.each($dialogs, function (index, dialog) {
			const $dialog = $(dialog);
			const $ctrl = $('#' + $dialog.data('ivDialogTrigger'));
			let settings;
			const displayMode = $dialog.data('ivDialogDisplayMode');

			if ($ctrl.length > 0) {
				// move dialog control after the trigger control
				$dialog.insertAfter($ctrl);

				let $target = '';
				if (ivScope.IsDesignMode())
					$target = $($ctrl).parents('.sortable_control').length > 0 ? $($ctrl).parents('.sortable_control').first() : $($ctrl).parents('.designicon.ui.buttons');
				else
					$target = $($ctrl).parent()[0].tagName === "TD" ? $($ctrl).parent() : $ctrl;

				$target.addClass('dialog-relative-parent');

				let trigger = ivClient.get(dialog, ivClient.properties.data, 'dialogTrigger');
				let dialogOpenerNamespace = '.dialogOpener';

				if (trigger) {
					trigger = trigger.toLowerCase();
					if (displayMode === dialogDisplayMode.tooltip) {
						$($ctrl).off(trigger + dialogOpenerNamespace).on(trigger + dialogOpenerNamespace, function () {
							$(this).popup('destroy');
							settings = $.extend({
								popup: dialog,
								on: trigger,
								target: $target
							}, defaultSettings);
							$(this).popup(settings).popup('show');
						});
					}
					else if (displayMode === dialogDisplayMode.modal) {
						$dialog.modal('attach events', $ctrl, 'show');
					}
				}
			}
		});
	}

	return {
		selector: {
			field: '[data-iv-control-type-name=dialogControl]'
		},
		init: function () {
			initializeEvents();
		}
	};
}(jQuery));


