			},
		},
		highlightMessage: function (msg) {
			let $msgContent = msg.htmlRendering.find("." + this.cssClass.comment.messageContent).first();
			let url = ivScope.AjaxUrl("usr", "contact_sheet").replace("ajax.aspx", "modal.aspx") + "/{GUID}?modal=true";
			let msgContentText = $msgContent.html();
			let searchValue = this._searchValue;

			// Render contacts urls
			if (msg.msgRecipients) {
				$.each(msg.msgRecipients, function (i, item) {
					let contactName = ivFormat.formatContactName(item.contact_firstname, item.contact_lastname, ivScope.UserNameFormat);
					let contactNameReverse = ivFormat.formatContactName(item.contact_firstname, item.contact_lastname, !ivScope.UserNameFormat);
					let reg = new RegExp(searchValue, 'gi');

					let highlightBgContact = searchValue !== null
						&& searchValue !== undefined
						&& searchValue.trim().length !== 0
						&& (reg.test(contactName) || reg.test(contactNameReverse));

					msgContentText = msgContentText.replace(
						new RegExp(`(@((${contactName})|(${contactNameReverse})))`, 'gi'),
						`<button type="button" class="ui borderless button ${(highlightBgContact ? "search-highlight" : "")}" tabindex="0" onclick="modalPopup({\'autoOpen\':\'true\',\'url\':\'${url.replace("{GUID}", item.contact_guid)}\'});;return abort(event);">
							@${contactName}
						</button>`
					);
				});

				$msgContent.empty().append(msgContentText);
			}

			// Highlight search value
			if (searchValue === null
				|| searchValue === undefined
				|| searchValue.trim().length === 0
			)
				return;

			// highlight only texts outside html tags
			msgContentText = msgContentText.replace(
				new RegExp(`${searchValue}(?![^<]*>|[^<>]*<\/)`, 'gi'),
				function (match) {
					return `<span class="search-highlight">${match}</span>`;
				}
			);

			$msgContent.empty().append(msgContentText);
		},
		renderMessageFiles: function (msg) {
			if (msg.htmlRendering)
				msg.htmlRendering.find('.iv-blog-msg-files').remove();

			if (!msg.files || msg.files.length === 0)
				return;

			var $files = $('<div/>', { class: 'iv-blog-msg-files' });

			for (let file of msg.files) {

				let $msgFile = $('<div/>', {
					class: 'ui buttons iv-file-button',
					fileGuid: file.fileGuid,
				});

				let $fileLink = $('<a/>', {
					href: file.downloadUrl,
					class: 'ui button icon iv-download-file',
					'aria-label': file.fileLabel,
					onclick: 'patchDownload();'
				})

				ivBlogUtil.addTooltip($fileLink, file.fileLabel);

				let $fileIcon = file.thumbnailUrl
					? $('<img/>', { src: file.thumbnailUrl, alt: file.fileName })
					: ivImage.createIcon(file.fileIcon ?? 'icon_base icon_file');

				let $fileName = $('<span/>').text(file.fileName);

				$fileLink
					.append($fileIcon)
					.append($fileName);

				//  Render delete button if user is author of the message
				if (msg.author.loginName == ivScope.User.LoginName) {

					let $btnDeleteFile = ivBlogUtil.createButton(`${ivScope.GetText('g_delete')} : ${file.fileName}`, 'fa-times-circle', 'iv-delete-file')
						.data('position', null);

					$msgFile.append($btnDeleteFile);
				}

				$msgFile.append($fileLink);

				$files.append($msgFile);
			}

			return $files;
		},
