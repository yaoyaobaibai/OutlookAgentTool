		/** Generates a page field code as : arg0_(argN)_yyyyMMddhhmmssfff */
		generateFieldCode: function() {
			var args = Array.from(arguments);
			var date = new Date();

			var yyyy = date.getFullYear();
			// base 0
			var mm = date.getMonth() + 1;
			mm = (mm > 9 ? '' : '0') + mm;
			var dd = date.getDate();
			dd = (dd > 9 ? '' : '0') + dd;
			var hh = date.getHours();
			hh = (hh > 9 ? '' : '0') + hh;
			var m = date.getMinutes();
			m = (m > 9 ? '' : '0') + m;
			var ss = date.getSeconds();
			ss = (ss > 9 ? '' : '0') + ss;
			var fff = date.getMilliseconds();
			if (fff <= 9) {
				fff = '00' + fff;
			}
			else if (fff <= 99) {
				fff = '0' + fff;
			}

			var suffix = [yyyy, mm, dd, hh, m, ss, fff].join('');
			args.push(suffix);
			var fieldCode = args.join('_').toLowerCase();
			fieldCode = fieldCode.split(';').join('_');
			// check if the pfieldCode is available
			var target = document.querySelector('[data-iv-target=' + fieldCode + ']');
			if (!target && generatedFieldCodes.indexOf(fieldCode) < 0) {
				generatedFieldCodes.push(fieldCode);
				return fieldCode;
			}
			return this.generateFieldCode(...arguments);
		},
