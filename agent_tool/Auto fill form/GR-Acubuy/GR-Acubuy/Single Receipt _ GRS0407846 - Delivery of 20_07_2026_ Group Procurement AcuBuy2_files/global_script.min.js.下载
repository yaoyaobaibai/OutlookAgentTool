			// get common params (url, container, design context, object type ...)
			// ivDesignMode.GetDesignFieldInfos need a Jquery object as parameter
			const params = ivDesignMode.GetDesignFieldInfos($(opener));
			let pFieldCode;

			// other common parameters
			// TODO : need to be reviewed, some parameters seem obsolete
			$.extend(params, {
				// from ivDesignMode.GetDesignFieldInfos, seems obsolete
				// DataTableName: '',
				// PlaceholderSelector: '',
				// DataTablePath: '',
				// obsolete ???
				// placeholderSelector: '',
				// for server-side
				url: params.PageUrl,
				urlContainer: params.PageUrlContainer,
				objectType: params.ObjectType,
				placeholder: placeholderContainerId ?? placeholder.id,
				customField: '1',
				// obsolete ???
				// browseMode: placeholderContainerId ? true : target.dataset.ivBrowseMode,
				designSortableId: placeholder.dataset.ivDesignSortableId,
				inPhc: placeholder.dataset.ivRole.indexOf('placeholder') > -1,
				inBrowseFilter: typeof placeholder.closest('.iv-filter') !== 'undefined' || typeof placeholder.closest('.iv-filter-panel-content') !== 'undefined',
				hasObjectId: placeholder.closest('[data-id]:not([data-id=""])') !== null
			});

			// layout params
			const directionParam = $('.design-adding-control-options').find('input[name="insert_direction"]:checked').val();
			const orientationParam = $('#' + designAddingControlPanel.id).find('div.action-param .orientation input[name="insert_orientation"]:checked').val();
			const shiftDownParam = directionParam === shiftParameters.shiftDown.value;
			const isVerticalParam = orientationParam === shiftParameters.orientationVertical.value;

			let moveOptions = {};
			moveOptions.shiftDown = shiftDownParam;
			moveOptions.isVertical = isVerticalParam;

			if (moveOptions.shiftDown) {
				moveOptions.currentCoords = GetFieldCoord($(placeholder), true);
			}

			// force vertical orientation if in advanced filter
			if (opener.closest('.iv-filter-panel-content')) {
				moveOptions.isVertical = true;
			}

			if (datafields && datafields.length > 1) {
				// if multiple fields inserted, start by moving all controls impacted
				if (moveOptions.shiftDown) {
					moveOptions.colspan = moveOptions.isVertical ? 1 : datafields.length;
					moveOptions.rowspan = moveOptions.isVertical ? datafields.length : 1;
				}
			}

			moveOptions.isFirst = true;
			let newTd = designAddingControlPanel.createNewTdField(opener, null, moveOptions);
			moveOptions.isFirst = false;

			// add dimmer
			ivClient.toggleLoader(newTd, true);

			// hide opener and panel
			opener.classList.remove('active');
			designAddingControlPanel.toggleControlPanel({ data: { hideOnly: true }, target: newTd });

			// existing fields
			let targetId;
			let colsOrder;

			if (placeholderContainerId) {
				if (opener.closest('[data-target-id]') != null) {
					targetId = opener.closest('[data-target-id]').getAttribute('data-target-id');
				}
				else if (opener.closest('[targetid]')) {
					targetId = opener.closest('[targetid]').getAttribute('targetid');
				}
				else if (opener.closest('th[data-iv-groupedwith]')?.querySelector('[data-target-id]')) {
					// grouped columns
					targetId = opener.closest('th[data-iv-groupedwith]').querySelector('[data-target-id]').getAttribute('data-target-id');
				}
				else if (opener.previousSibling.closest('[data-target-id]')) {
					// case of datacollection 
					targetId = opener.previousSibling.closest('[data-target-id]').getAttribute('data-target-id');
				}
			}

			if (datafields) {
				for (var i = 0; i < datafields.length; i++) {
					pFieldCode = datafields[i].fieldCode;
					// hook if the field in a DataCollection View
					if (placeholder.dataset.ivDesignPrefix) {
						pFieldCode = placeholder.dataset.ivDesignPrefix + pFieldCode;
					}
					datafields[i].fieldCode = pFieldCode;
					newTd.setAttribute('data-iv-target', pFieldCode);
					// grouped
					if (newTd.dataset.groupedwith) {
						datafields[i].groupedwith = newTd.dataset.groupedwith;
					}
					if (newTd.dataset.groupedin) {
						datafields[i].groupedin = newTd.dataset.groupedin;
					}

					$.extend(datafields[i], params);

					// if field is added in a listview card then it must be rendered as a read only RawDataField
					if (newTd.closest('.phc-card') !== null && datafields[i].fieldType !== 'placeholder' && typeof datafields[i].fieldName !== 'undefined') {
						$.extend(datafields[i], {
							fieldType: 'rawdatafield'
						});
					}

					if (placeholderContainerId) {
						if (targetId) {
							let $element = __ivCtrl[placeholder.id] ?? ivClient.get(ivClient.get(placeholder.id, ivClient.properties.data, 'ivControl'), ivClient.properties.data);
							colsOrder = designAddingControlPanel.setAndGetColumnsOrder($element, targetId, datafields, i, typeof __ivCtrl[placeholder.id] === 'undefined');
						}

						$.extend(datafields[i], {
							fieldType: 'column',
							columnsOrder: colsOrder
						});
					}

					if (i + 1 < datafields.length) {
						newTd = designAddingControlPanel.createNewTdField(opener, newTd, moveOptions);
						// add dimmer
						ivClient.toggleLoader(newTd, true);
					}
				}

				// handle all coords in once on the last added field
				if (!placeholderContainerId) {
					ivPlaceHolderDesign.removeUselessRows(newTd.parentNode.parentNode);
					datafields[datafields.length - 1].fieldPositionTo = GetFieldCoord($(placeholder), true);
				}
				ivCallMethod.InvokeDesignUtil('AddFieldHandler', { addParams: datafields });
			}
			// new field
			else {
				pFieldCode = ivDesignMode.generateFieldCode(target.dataset.ivFieldPrefix, params.ObjectType);
				// hook if the field in a DataCollection View
				if (placeholder.dataset.ivDesignPrefix) {
					pFieldCode = placeholder.dataset.ivDesignPrefix + pFieldCode;
				}
				newTd.setAttribute('data-iv-target', pFieldCode);

				// new field parameters
				$.extend(params, {
					fieldCode: pFieldCode,
					ctypeCode: target.dataset.ivDataType,
					createColumn: typeof target.dataset.ivDataType !== 'undefined',
					fieldType: target.dataset.ivControlType,
					groupedwith: newTd.dataset.groupedwith,
					groupedin: newTd.dataset.groupedin
				});

				if (placeholderContainerId) {
					let $element = __ivCtrl[placeholder.id] ?? ivClient.get(ivClient.get(placeholder.id, ivClient.properties.data, 'ivControl'), ivClient.properties.data);
					colsOrder = designAddingControlPanel.setAndGetColumnsOrder($element, targetId, datafields, i, typeof __ivCtrl[placeholder.id] === 'undefined', pFieldCode);

					$.extend(params, {
						columnsOrder: colsOrder,
						fieldType: params.fieldType || 'column'
					});
				}
				else {
					$.extend(params, {
						// GetFieldCoord need a Jquery object as parameter, and the new td must have data-iv-target attribute
						fieldPositionTo: GetFieldCoord($(placeholder))
					});
				}

				// create new data field
				if (params.createColumn) {
					params.currentCoords = moveOptions.currentCoords;
					ivDesignMode.OpenCreateColumnPopUp(params);
				}
				// create new control
				else {
					ivCallMethod.InvokeDesignUtil('AddFieldHandler', { addParams: [params] });
				}
			}
		},
		setAndGetColumnsOrder: function ($element, targetId, datafields, index, isDcc, pfieldCode) {
			let insertAfterIndex;
			if (isDcc) {
				const control = $element._tableDisplay || $element;
				// find index of the reference column
				insertAfterIndex = control.colsIndexAll[targetId];
				// recalculate order
				let newOrder = control.colsIndexAll;
				if (datafields) {
					for (let ind = 0; ind < datafields.length; ind++) {
						newOrder = designAddingControlPanel.setColumnOrder(newOrder, targetId, datafields[ind].fieldCode, insertAfterIndex, true);
					}
				}
				else {
					newOrder = designAddingControlPanel.setColumnOrder(newOrder, null, pfieldCode, insertAfterIndex, true);
				}
				return designAddingControlPanel.getColumnOrder(newOrder);
			}
			else {
				insertAfterIndex = $element.colsIndex0[targetId];
				$element.colsIndex0 = designAddingControlPanel.setColumnOrder($element.colsIndex0, (datafields ? targetId : null), (datafields ? datafields[index].fieldCode : pfieldCode), insertAfterIndex, true);
				return designAddingControlPanel.getColumnOrder($element.colsIndex0);
			}
		},
		addSelectedFields: function(event) {
			const datafields = designAddingControlPanel.getFieldsPath();
			designAddingControlPanel.addFieldHandler(event, datafields);
		}
	};

