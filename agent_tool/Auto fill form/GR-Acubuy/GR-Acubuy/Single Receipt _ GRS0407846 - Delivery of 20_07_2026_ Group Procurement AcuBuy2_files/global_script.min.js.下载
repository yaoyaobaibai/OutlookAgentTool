		},
		Init: function () {
			$(document)
				.off('click.ellipsis')
				.on('click.ellipsis', ivEllipsisSelector.selector.ellipsis, ivEllipsisSelector.EllipsisClickHandler);
		},
		AutoPostBack: function (ellipsis, scope) {
			if (!scope)
				scope = upperWindow;
			var data = ivClient.get(ellipsis, ivClient.properties.data);
			if (data.autoPostBack) {
				if (!scope.hasModal())
					__doPostBack(data.postName, '');
				else
					scope.setModalCloseEvent('postback', data.postName);
			}
		},
		EllipsisClickHandler: function (e) {
			var $el = $(e.target);
			if (!$el.data('selector'))
				$el = $el.parent();
			var form = __ivHtmlControls[$el.data('selector')];
			ivEllipsisSelector.onClickEllipsis(e, form);
		},
		onClickEllipsis: function (evt, data) {
			var modalsize = __ivHtmlControls[evt.currentTarget.id] ? __ivHtmlControls[evt.currentTarget.id].modalTargetSize : null;
			modalsize = modalsize ? modalsize.toLowerCase() : null;
			var popUpUrl = data.control.popUpUrl;
			if (!data.selectorCode)
				data.selectorCode = data.GridClientID;
			var jointureChar = popUpUrl.indexOf('?') > 0 ? "&" : "?";
			var url = popUpUrl;
			var q =
				"type=" + data.type +
				"&__isselector=true" +
				(data.closeAfterSelection
					? "	&CloseAfterSelection=" + data.closeAfterSelection
					: "") +
				(data.shortBegin !== 0
					? "&shortbegin=" + data.shortBegin
					: "") +
				(data.shortEnd !== 0
					? "&shortend=" + data.shortEnd
					: "") +
				"&object=" + data.key +
				(data.autoSelect
					? "&autoselect=true"
					: "") +
				(data.defaultFetchOperation ? "" : data.params ? "&fetchParameters=" + encodeURIComponent(JSON.stringify(data.params)) : '') +
				(data.fetchParameters && data.fetchParameters["sqlLikeBehavior"] ? "&sqlLikeBehavior=" + data.fetchParameters["sqlLikeBehavior"] : "") +
				(data.defaultFetchOperation ? "" : data.dataValueField ? "&dataValueField=" + data.dataValueField : "") +
				(data.defaultFetchOperation ? "" : data.dataTextField ? "&dataTextField=" + data.dataTextField : "") +
				(data.listColumn && data.listColumn.length > 0 ?
					"&listColumn=" + JSON.parse(data.listColumn).join(",") : "") +
				(data.queryString ? "&" + data.queryString : "") +
				(data.ctxVarText ? "&" + data.ctxVarText : "");

			var querystring = {};
			var qsSplit = q.split('&');
			for (var i = 0; i < qsSplit.length; i++) {
				if (!qsSplit[i])
					continue;
				var kv = qsSplit[i].split('=');
				if (kv.length > 0 && !querystring.hasOwnProperty(kv[0])) {
					if (kv.length > 1)
						querystring[kv[0]] = kv[1];
					else
						querystring[kv[0]] = '';
				}
			}
			url += jointureChar + decodeURIComponent($.param(querystring));

			if (data.keepState) {
				data.context[ivScope.SelectorValueName + "[" + data.selectorCode + "]"] = data.selectedValues;
				data.context["__IVISPOST"] = true;
				openPopup(url, data.context);
			}
			else {
				var modal = modalPopup({ 'url': url, 'title': '', size: modalsize });
			}
			evt.preventDefault();
			evt.stopPropagation();
			return false;
		},
		getGrid: function($field){
			return $field.find('.iv-grid-view.dropdown-grid');
		}
	};
}(jQuery));

