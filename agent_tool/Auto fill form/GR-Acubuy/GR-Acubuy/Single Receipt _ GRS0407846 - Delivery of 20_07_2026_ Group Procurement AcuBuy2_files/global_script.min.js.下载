		uploadedFilesCallback: function (uploader) {

			let blogPanel = uploader._blogPanel;

			let $uploadedFiles = blogPanel.config.$container.find(`#${uploader.attachTo} .upload_fileblock[status=success]`);

			// Render uploaded files list
			$uploadedFiles.each(function () {

				let file = $(this).data('upload_file');

				let fileGuid = window['eval'](`(${file.xmlHttpRequest.response})`).guid[0];

				var $msgEditor = $(this).closest('.iv-blog-msg-editor');

				var $fileList = $msgEditor.find('ul.iv-blog-uploaded-files');
				if ($fileList.length == 0) {
					$fileList = $('<ul/>', { class: 'iv-blog-uploaded-files' });
					$msgEditor.append($fileList);
				}

				var $fileItem = $('<li/>', {
					class: 'item iv-blog-uploaded-file',
				});

				var $btnDelete = ivBlogUtil.createButton(ivScope.GetText('delete'), 'fa-trash-alt', 'borderless')
					.on('click', { $msgEditor: $msgEditor, fileGuid: fileGuid }, function (e) {

						let $hdnFileGuids = e.data.$msgEditor.find('#' + uploader.hdnUploadedFileId);
						let $hdnFileNames = e.data.$msgEditor.find('#' + uploader.hdnUploadedFileName);

						let fileGuids = $hdnFileGuids.val().split(';');
						let fileNames = $hdnFileNames.val().split(';');

						let index = fileGuids.lastIndexOf(e.data.fileGuid);
						if (index < 0)
							return;

						fileGuids.splice(index, 1);
						fileNames.splice(index, 1);

						$hdnFileGuids.val(fileGuids.join(';'));
						$hdnFileNames.val(fileNames.join(';'));

						$fileItem.remove();
					});

				$fileItem
					.append($btnDelete)
					.append($(this).find('img.file_ico').clone())
					.append(file.name);

				$fileList.append($fileItem);
			});
		},
