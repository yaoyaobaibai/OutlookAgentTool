		newStartConversationButton: function (convType) {
			return $('<button/>', {
					class: `ui button iv-button primary start-conversation start-conversation-${convType}`,
					type: 'button',
					text: ivScope.GetText('blog_panel_start_conversation_button'),
					'data-conv-type': convType
				})
				.on('click', { blogPanel: this, convType: convType }, this.startConversationClick);
