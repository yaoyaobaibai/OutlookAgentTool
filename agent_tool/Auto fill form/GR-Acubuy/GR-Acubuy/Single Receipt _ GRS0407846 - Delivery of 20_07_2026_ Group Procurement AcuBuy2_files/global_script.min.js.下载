		$(this).click();
		$('#favorite-wrapper').css('display', 'block');
		return false;
	}
	return true;
};
Favorites.remove = function (id, node) {
	if (!ivCallMethod.removeFavorite) {
		ivCallMethodHandler.prototype.removeFavorite = function (id, current, node) {
			this.invoke(ivScope.AjaxUrl("usr", "favorites", null, "methodname=Remove"), { id: id, url0: Favorites._url },
				() => {
					node.closest('li.fitem').remove();
				}, null, ['remove', current]);
			if (current)
				$('#add-favorite-popup').css("display", "block");
		};
	}
	ivCallMethod.removeFavorite(id,
		location.href.substr((location.protocol + "//" + location.hostname + (location.port.length > 0 && location.port != 80 ? (":" + location.port) : "")).length) == $(node).parents('.fitem:first').attr('url'),
		node);
