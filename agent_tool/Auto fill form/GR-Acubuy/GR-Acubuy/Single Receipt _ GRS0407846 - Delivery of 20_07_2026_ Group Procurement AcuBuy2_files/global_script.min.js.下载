$.fn.textAreaExpander = function () {
	// resize a textarea
	function ResizeTextarea(e) {
		var h;
		// event or initialize element?
		e = e.target || e;
		// find content length and box width
		var vlen = e.value.length, ewidth = e.offsetWidth;
		if (vlen !== e.valLength || ewidth !== e.boxWidth) {
			if (vlen < e.valLength || ewidth !== e.boxWidth) {
				e.style.height = "0px";
			}
			if (e.expandMax > 0) {
				h = Math.max(e.expandMin, Math.min(e.scrollHeight, e.expandMax));
				e.style.overflow = (e.scrollHeight > h ? "auto" : "hidden");
				e.style.height = h + "px";
			}
			else {
				h = Math.max(e.expandMin, e.scrollHeight);
				e.style.overflow = "hidden";
				e.style.height = h + "px";
			}

			e.valLength = vlen;
			e.boxWidth = ewidth;
		}
		return true;
	};

	// initialize
	this.each(function () {
		// is a textarea?
		if (this.nodeName.toLowerCase() !== "textarea") return;

		var rows = $(this).prop('rows');
		var maxRows = $(this).data('ivMaxrows');
		// set height restrictions
		this.expandMin = rows ? rows * 15 : 0;
		this.expandMax = maxRows ? maxRows * 15 : -1;

		// initial resize
		ResizeTextarea(this);

		// zero vertical padding and add events
		if (!this.Initialized) {
			this.Initialized = true;
			$(this).bind("keyup", ResizeTextarea).bind("focus", ResizeTextarea);
		}
	});
	return this;
};


