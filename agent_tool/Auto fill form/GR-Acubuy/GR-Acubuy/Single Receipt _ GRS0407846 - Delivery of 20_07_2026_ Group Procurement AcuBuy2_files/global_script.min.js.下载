	moveColumn: function (columnId, $item, effect, movetype, originalColIndex, newColIndex, columns, globalSetting, step) {
		var $menuItems = $item ? $item.parent('ul.menu').find('>li') : null;

		// fixed columns
		var fixedColumns = ivClient.get(this.table, ivClient.properties.data, 'fixedColumnNumber');

		if (ivClient.is.null(newColIndex) && ivClient.is.null(originalColIndex)) {
			originalColIndex = this.colsIndex[columnId];

			newColIndex = 0;
			for (i = 0; i < $menuItems.length; i++) {
				var type = $($menuItems[i]).data('type');
				var id = $($menuItems[i]).data('id');
				if (type && type === 'column') {
					if (id && id === columnId)
						break;
					newColIndex++;
				}
			}
		}

		if (originalColIndex !== newColIndex) {
			if (typeof step !== 'number')
				step = 1;

			var $trHeaderList = this.table.find(">thead>tr");
			if ($trHeaderList.length > 0) {
				var $th = $trHeaderList.find(">th:nth-child(" + (originalColIndex + 1) + ")");
				if (effect) {
					$th.addClass("active");
				}

				if (movetype == "keyboard") {
					$trHeaderList.find(">th:nth-child(" + (newColIndex + step) + ")").after($th);
				}
				else if (originalColIndex < newColIndex) {
					$trHeaderList.find(">th:nth-child(" + (newColIndex + step) + ")").after($th);
				}
				else {
					$trHeaderList.find(">th:nth-child(" + (newColIndex + step) + ")").before($th);
				}
			}

			var $trBodyList = this.table.find(">tbody>tr");
			//step send by placeholder_script when moving a column (hack!!! :)
			for (i = 0; i < $trBodyList.length; i++) {
				var $td = $($trBodyList[i]).find(">td:nth-child(" + (originalColIndex + 1) + ")");
				if (effect) {
					$td.addClass("active");
				}

				if (movetype == "keyboard") {
					$($trBodyList[i]).find(">td:nth-child(" + (newColIndex + step) + ")").after($td);
				}
				else if (originalColIndex < newColIndex) {
					$($trBodyList[i]).find(">td:nth-child(" + (newColIndex + step) + ")").after($td);
				}
				else {
					$($trBodyList[i]).find(">td:nth-child(" + (newColIndex + step) + ")").before($td);
				}
			}

			//map index on menu items order
			var itemOrder = 0;
			if ($menuItems) {
				for (i = 0; i < $menuItems.length; i++) {
					var type = $($menuItems[i]).data('type');
					var id = $($menuItems[i]).data('id');
					var $trigger = $($menuItems[i]).find('[data-iv-fixed-column-trigger]');
					if (type && type == 'column' && this.colsIndex[id] != undefined) {
						this.colsIndex[id] = itemOrder;
						$trigger.attr('data-value', (itemOrder + 1));
						itemOrder++;
					}
				}
			}

			if (globalSetting !== true)
				globalSetting = false;

			this.saveOrderColumn(columns, globalSetting);

			if (this.moveColumnCallback != null && typeof this.moveColumnCallback == "function") {
				this.moveColumnCallback.call(this);
			}

			if (effect) {
				setTimeout("$('#" + this.ClientID + ">tbody>tr>').removeClass('active');", 600);
			}

			if (fixedColumns > 0) {
				// force a refresh
				ivClient.set(this.table, ivClient.properties.data, 'fixedColumnNumber', 0);
				ivGrid.setFixedColumns(this.table, fixedColumns);
			}
		}
	},
	refreshSamePage: function () {
		var nbPages = Math.ceil(this.RowCount / this.pageSize);
		var currentIndex = parseInt(this.$PageIndex().val());
		if ((nbPages - 1) < currentIndex)
			currentIndex = nbPages - 1;
		if (currentIndex <= 1)
			currentIndex = 0;

		this.GoToPageOfGrid(currentIndex, currentIndex);
