		conversationHeaderEventHandlers: {
			conversationActionDropdownShow: function (e) {
				const $mainMenu = $(this).children('.menu').first();
				let opacity = $mainMenu.css('opacity');
				$mainMenu.css('opacity', '0').removeClass('hidden');
				$mainMenu.css('opacity', typeof opacity !== 'undefined' ? opacity : '');
				$mainMenu.children('.item').removeClass('active').removeClass('selected');
			},
			subscribeMeClick: function (e) {
				e.data.blogPanel.toggleSubscribeStatus(false);
			},
			toggleArchiveStatusClick: function (e) {
				e.data.blogPanel.toggleArchiveStatus(e.data.blogPanel._currentSubscriber.isParticipating);
			},
			attachmentsClick: function (e) {
				let me = e.data.blogPanel;
				let chatMsgType = me.findMsgType('chat');

				const attachmentsContainer = chatMsgType.blockContainerHtmlRendering.find('div.attachments-container');
				if (attachmentsContainer.length === 0 || attachmentsContainer.hasClass('hidden')) {
					// Add Attachments container
					me.renderAttachmentsContainer(chatMsgType);
					// Load and render Attachment grid
					me.reloadAttachments();
					me.signalRClientBroadcastEventPause();
				}
				else {
					me.cleanAttachmentsContainer();
					me.signalRClientBroadcastEventUnPause();
				}
			},
			searchMessageClick: function (e) {
				e.stopPropagation();
			},
			filtersTitleClick: function (e) {
				const anyFilter = e.data.blogPanel.config.filters.anyFilter();
				if (!anyFilter) {
					e.stopPropagation();
					return;
				}

				e.data.blogPanel.config.filters.resetFilters();

				$(e.currentTarget)
					.parent()
					.find('.item-checking')
					.toggleClass('hidden', true);

				$(e.currentTarget)
					.closest(`.${e.data.blogPanel.cssClass.conversation.actionContainer}`)
					.find(`.${e.data.blogPanel.cssClass.conversation.filters.convHeaderFilterResetBtn}`)
					.toggleClass('hidden', true);

				const $searchInput = $(e.currentTarget)
					.parent()
					.find(`.${e.data.blogPanel.cssClass.conversation.searchMessageInput}`);

				e.data.blogPanel.searchChatComment($searchInput.val());
			},
			conversationFilterClick: function (e) {
				e.stopPropagation();

				$(e.currentTarget).find('.item-checking').toggleClass('hidden', e.data.blogPanel.config.filters[e.data.filterName]);

				e.data.blogPanel.config.filters[e.data.filterName] = !e.data.blogPanel.config.filters[e.data.filterName];

				const $noFilter = !e.data.blogPanel.config.filters.anyFilter();
				$(e.currentTarget)
					.siblings('.' + e.data.blogPanel.cssClass.conversation.filters.filtersTitle)
					.find('.item-checking')
					.toggleClass('hidden', $noFilter);

				$(e.currentTarget)
					.closest(`.${e.data.blogPanel.cssClass.conversation.actionContainer}`)
					.find(`.${e.data.blogPanel.cssClass.conversation.filters.convHeaderFilterResetBtn}`)
					.toggleClass('hidden', $noFilter);

				const $searchInput = $(e.currentTarget)
					.siblings(`.${e.data.blogPanel.cssClass.conversation.searchMessageItem}`)
					.find(`.${e.data.blogPanel.cssClass.conversation.searchMessageInput}`);

				e.data.blogPanel.searchChatComment($searchInput.val());
			},
			subscribersClick: function (e) {
				let me = e.data.blogPanel;
				let chatMsgType = me.findMsgType('chat');

				if ((me.config.showRepliesOnly && !me.config.hasAccessToObject) || me._subscribers?.length < 1)
					return;

				const participantsContainer = chatMsgType.blockContainerHtmlRendering.find("div.subscribers-container");
				if (participantsContainer.length === 0 || participantsContainer.hasClass("hidden")) {
					// Add Participants container
					me.renderSubscribersContainer(chatMsgType);
					// Render Participants DataTables
					me.renderSubscribersDtTable(me);
					me.signalRClientBroadcastEventPause();
				}
				else {
					me.cleanSubscribersContainer();
					me.signalRClientBroadcastEventUnPause();
				}
			},
			searchMessage: function (blogPanel, $input) {
				blogPanel.searchChatComment($input.val());

				let $convActionContainer = $input.closest('.iv-blog-conversation-action');
				let $convActionButton = $convActionContainer.find('.ui.button.btn-action');
				$convActionButton.trigger("click");
			},
			searchMessageInputKeydown: function (e) {
				let kc = e.which ? e.which : e.keyCode;

				if (kc !== KEYS.ENTER)
					return;

				e.data.blogPanel.conversationHeaderEventHandlers.searchMessage(e.data.blogPanel, $(this));

				return abort(e);
			},
			btnSearchMessageClick: function (e) {
				let $searchInput = $(this).siblings('input.iv-blog-search-message-input');
				e.data.blogPanel.conversationHeaderEventHandlers.searchMessage(e.data.blogPanel, $searchInput);
			},
		},
		findMsgType: function (msgTypeCode) {
			return this.config.messageTypes.find(x => x.code == msgTypeCode);
		},
		openConversationListPanel: function () {
			var chatMsgType = this.findMsgType('chat');

			if (!chatMsgType || !chatMsgType.isRendered)
				return;

			this.setChatOpenedBlock('conversation');

			// Stop signalR hub if we already have a connection opened
			if (this.config.allowComment && this.config.groupName) {
				ivSignalRInstanceGlobal.connectionStop();
			}

			this.loadConversations();

			// Hide and reset subscribers and attachments containers
			this.cleanSubscribersContainer();
			this.cleanAttachmentsContainer();
		},
		newConvBackButton: function () {

			var $convBackButton = $(`
				<button type="button" class="conversation-header-back-button ui button iv-button borderless icon-fa-angle-left icon">
					<i class="fa-angle-left icon regular" data-iv-role="icon"></i>
