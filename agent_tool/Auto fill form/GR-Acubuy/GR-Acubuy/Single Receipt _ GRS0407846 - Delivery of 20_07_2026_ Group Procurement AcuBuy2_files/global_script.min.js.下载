					.append($('<div />', { class: 'item ' + cssClass.btnTakePictureConf, text: ivScope.GetText('take_picture_conf') }))
					.append($('<div />', { class: 'item ' + cssClass.btnRestoreConfiguration, text: ivScope.GetText('restore_configuration') }))
					.append($('<div />', { class: 'item dropdown ' + cssClass.btnSnpEnvList }))
					.append($('<div />', { class: 'item ' + cssClass.btnResetSnapshot, text: ivScope.GetText('page_field_reset_settings') }))
					.append($('<div />', { class: 'item ' + cssClass.btnApplyStdLayout, text: ivScope.GetText('page_field_merge_standard_settings') }))
					.append($('<div />', { class: 'item ' + cssClass.btnDeleteSnapshot, text: ivScope.GetText('page_field_delete_settings') }));

				var $btnCamera = $('<div />', { class: 'ui top left dropdown icon button ' + cssClass.btnCamera, title: ivScope.GetText('access_snp_features') })
					.append($('<i/>', { class: 'icon fa-camera-alt' }))
