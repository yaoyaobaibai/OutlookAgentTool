					onAddDoneCallback.call(this, id, response);
				}
			},
			onFailed: function () {
				if (typeof onAddFailCallback === 'function') {
					onAddFailCallback.call(this);
				}
			},
			keepInstanceControl: true,
			enabledOverlay: false,
			enableLockActionBar: false,
			autoContentUpdate: false
		});
	}
};

