			ivBlogAjaxHandler.getSubscribers(
				this.config.groupName,
				function (dicSubscribersSerialized) {
					blogPanel._subscribers = [];

					try {
						let dicSubscribers = JSON.parse(dicSubscribersSerialized);

						blogPanel._subscribers = dicSubscribers['subscribers'];
						blogPanel._currentSubscriber = dicSubscribers['currentSubscriber'];
