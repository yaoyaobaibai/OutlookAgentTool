		hideAddReplyBlock: function (msg) {
			msg.htmlRendering.find('.iv-blog-msg.msg-me.add-reply').remove();
		},
		showAddReplyBlock: function (msg) {
			if (!msg) return;

			// For each main message of a thread where a user has been mentioned (in the main message or any of existing replies)
			if (msg.typeCode != 'chat'
				|| !!msg.parentId
				|| !msg.threadRecipientsIds
				|| msg.threadRecipientsIds.length === 0
				|| msg.threadRecipientsIds.every(contactId => contactId != ivScope.User.ContactId))
				return;

			const txtAddReply = ivScope.GetText("blog_panel_add_reply_btn");
			let $addReplyButton = ivBlogUtil.createButtonIconText(
				txtAddReply,
				'fa-reply',
				'iv-blog-add-reply iv-button borderless',
				null,
				false,
				txtAddReply);

			let $messageContentContainer = msg.htmlRendering.find(`.${this.cssClass.comment.messageContentContainer}:first`);

			if ($messageContentContainer.length === 0)
				return;

			let $msgSub = msg.htmlRendering.find('.iv-blog-msg-sub');
			if ($msgSub.length === 0) {
				$msgSub = $('<ul/>', { class: 'iv-blog-msg-sub' });
				$messageContentContainer.after($msgSub);
			}

			let $msgBubble = $(`
				<li class="iv-blog-msg msg-me add-reply">
					<div class="${this.cssClass.comment.messageContentContainer}">
					</div>
				</li>
			`);
			$msgBubble.find(`.${this.cssClass.comment.messageContentContainer}`).append($addReplyButton);

			$msgSub.append($msgBubble);

			$addReplyButton
				.off('click')
				.on('click', { blogPanel: this, message: msg }, this.messageEventHandlers.btnReplyClick);
		},
		newMessageEditor: function (target, msgType, replyMode, editMode = false) {
			let me = this;

			let id = (replyMode || editMode)
				? `ivBlogMsgEditor_${target.typeCode}_${target.messageId}`
				: `ivBlogMsgEditor_${msgType.code}`;

			let placeHolderText = replyMode
				? ivScope.GetText('blog_panel_add_reply')
				: ivScope.GetText('blog_panel_add_comment');

			let newMsgClass = '';
			// If main message editor
			if (!replyMode && !editMode) {
				newMsgClass += 'iv-blog-new-msg';

				// Try to hide the new message text area if the blog panel is in "show only replies" mode
				if (me.config.showRepliesOnly)
					newMsgClass += ' new-msg-hidden';
			}

			let $msgEditor = $(`
				<div id="${id}" class="iv-blog-msg-editor ${newMsgClass}">
					<div class="iv-blog-msg-supplier-share-label">
						<i aria-hidden="true" class="fa-truck icon supplier-share-icon"></i>
						<span class="supplier-share-label"></span>
					</div>
					<div class="iv-blog-msg-text-input">
						<textarea id="${id}_comment" class="comment ${me.cssClass.msgEditor.textarea}" rows="1" placeholder="${placeHolderText}" tabindex="0" aria-label="${placeHolderText}"></textarea>
					</div>
					<div class="${me.cssClass.msgEditor.actionContainer}">
					</div>
					<div class="iv-blog-msg-editor-help">
						<span class="iv-blog-msg-editor-help-item" data-help-code="ping">${ivScope.GetText('blog_panel_msg_editor_info_ping')}</span>
						<span class="iv-blog-msg-editor-help-item" data-help-code="assign">${ivScope.GetText('blog_panel_msg_editor_info_assign')}</span>
					</div>
				</div>
			`);

			return $msgEditor;
		},
		initCommentMsgZone: function ($msgEditor, target, replyMode) {

			// Main message editor
			if (!replyMode && target.htmlRendering.find('ul.iv-msg-list').length > 0) {
				target.htmlRendering.append($msgEditor);
				return;
			}

			var $messageContentContainer = target.htmlRendering
				.find("." + this.cssClass.comment.messageContentContainer + ":first");

			if ($messageContentContainer.length === 0)
				return;

			// Reply mode
			if (replyMode) {

				let $msgSub = this.renderMessageSubList(target);

				let $msgBubble = $(`
					<li class="iv-blog-msg msg-me">
						<div class="${this.cssClass.comment.messageContentContainer} reply-mode">
							<div class="${this.cssClass.comment.messageContentWrapper}">
							</div>
						</div>
					</li>
				`);
				$msgBubble.find(`.${this.cssClass.comment.messageContentWrapper}`).append($msgEditor);

				$msgSub.append($msgBubble);
			}
			// Edit mode
			else {
				if ($messageContentContainer.hasClass('edit-mode'))
					$messageContentContainer.find('.' + this.cssClass.comment.messageContent).prepend($msgEditor);
				else
					$messageContentContainer.append($msgEditor);
			}
		},
		initCommentTextArea: function ($msgEditor, replyMode) {

			let $textarea = $msgEditor.find(`.${this.cssClass.msgEditor.textarea}`);

			$textarea.on('input', function () {
				if (this.scrollHeight === 0)
					return;

				this.style.height = (this.scrollHeight) + 'px';
			});

			if (replyMode) {
				$textarea
					.focus()
					.off("paste")
					.on("paste", { blogPanel: this }, function (e) {
						e.data.blogPanel.pasteTexteInEditableDiv(e);
					});
				return;
			}
		},

		tryCloseMessageEditor: function (msg) {
			let $replyContainer = msg.htmlRendering.find('ul');
			if ($replyContainer.length === 0)
				return false;

			let cancel = false;

			let $textarea = msg.htmlRendering.find(`.${this.cssClass.msgEditor.textarea}`);
			let $filesContainer = msg.htmlRendering.find(`.${this.cssClass.msgEditor.filesContainer}`);

			// If user has entered text or uploaded files, ask for confirmation before closing editor
			if ($textarea.val().length > 0 || $filesContainer.children('.iv-blog-uploaded-file').length > 0)
				cancel = !confirm(ivScope.GetText('confirm_cancel_reply'));

			if (cancel)
				return false;

			$replyContainer.remove();
			this.showAddReplyBlock(msg);
			this.displayMainMsgEditor(true);
			this.signalRClientBroadcastEventUnPause();
			return true;
		},
		initCommentInput: function ($msgEditor, target, parentMsg, replyMode, editMode) {

			let me = this;

			let $inputContainer = $msgEditor.find('.iv-blog-msg-text-input');
			let $textarea = $msgEditor.find(`.${me.cssClass.msgEditor.textarea}`);
			let $actionContainer = $msgEditor.find(`.${me.cssClass.msgEditor.actionContainer}`);

			let $btnSendMsg = ivBlogUtil.createButton(ivScope.GetText('blog_panel_send_message'), 'fa-paper-plane', `${me.cssClass.msgEditor.btnSendMessage} iv-button borderless`);

			if (me.config.allowSendingMsg === false) {
				$btnSendMsg.prop('disabled', true);
				$inputContainer.prop('disabled', true);
			}

			// Disable message sending button when text area is empty
			$textarea.on('input', function () {
				let msgIsEmpty = $(this).val().length === 0;

				let tooltipText = ivScope.GetText(msgIsEmpty ? 'blog_panel_cant_send_empty_message' : 'blog_panel_send_message');

				$btnSendMsg
					.toggleClass('disable', msgIsEmpty)
					.toggleClass('iv-tooltip-disable', mobileMode)
					.attr('data-html', tooltipText);
			});

			// Display help message when pinging a user
			$textarea.on('input', function () {
				let $helpContainer = $msgEditor.find('.iv-blog-msg-editor-help');

				let showPingHelp = $(this).val().includes('@');

				$helpContainer
					.find('[data-help-code="ping"]')
					.toggleClass('visible', showPingHelp);
			});

			$textarea.trigger('input');

			if (editMode === false) {

				let submitMessage = function () {
					if (me.config.allowSendingMsg === false || $msgEditor.find(`.${me.cssClass.msgEditor.btnSendMessage}`).hasClass('disable'))
						return;

					me.addNewComment(
						$msgEditor,
						parentMsg,
						function () {
							$textarea.val('').trigger('input');

							$msgEditor.find(`.${me.cssClass.msgEditor.filesContainer}`).remove();

							me.displayMainMsgEditor(true);
							me.signalRClientBroadcastEventUnPause();
						}
					);
				}

				$btnSendMsg.on('click', submitMessage);
				$inputContainer.on('keydown', { callBack: submitMessage }, me.catchEnterKey);
			}

			if (me.config.allowFile && me.config.uploadUrl)
				me.renderFileUploader($msgEditor);

			me.renderPingButton($msgEditor);

			var mainMsg = target && target.parentId ? parentMsg : target;

			// "Assign to" / "Reassign to" panel
			var allowAssignment = !editMode;
			if (allowAssignment) {
				var assignmentText = mainMsg && mainMsg.assignmentContactId
					? ivScope.GetText("blog_panel_reassign_to")
					: ivScope.GetText("blog_panel_assign_to");

				let $assignContainer = $(`
					<div class="${me.cssClass.msgEditor.assignContainer}">
						<div class="ui checkbox">
							<input type="checkbox" class="${me.cssClass.msgEditor.chkAssign}">
							<label>${assignmentText}</label>
						</div>
						<select class="${me.cssClass.msgEditor.selAssignContact}"></select>
					</div>
				`).addClass('hidden');

				let $chkAssign = $assignContainer.find(`.${me.cssClass.msgEditor.chkAssign}`);
				let $selAssignContact = $assignContainer.find(`.${me.cssClass.msgEditor.selAssignContact}`);

				// Check "Assign to" when the contact selector value is changed
				$selAssignContact.on('change', function () {
					$chkAssign.prop('checked', true).trigger('change');
				});

				$chkAssign.on('change', function () {
					let checked = $chkAssign.prop('checked');

					let $helpContainer = $msgEditor.find('.iv-blog-msg-editor-help');

					$helpContainer.find('[data-help-code="assign"]').toggleClass('visible', checked);
					$helpContainer.find('[data-help-code="ping"]').toggleClass('hidden', checked);
				});

				// Bind the assignment panel to the textarea's ping collection
				$textarea.ping('onPingCollectionChanged_Add', function (pings) {
					var selectedValue = $selAssignContact.val();
					// Clear the list of values in the assignment contact selector
					$selAssignContact.empty();

					// Hide assignment panel if ping collection is empty
					$assignContainer.toggleClass('hidden', pings.length === 0);

					// Disable contact selector if only one value
					$selAssignContact.prop('disabled', pings.length === 1);

					// Uncheck assign if ping collection is empty
					if (pings.length === 0)
						$chkAssign.prop('checked', false).trigger('change');

					// Rebuild the list of options in contact selector
					$.each(pings, function (index, item) {
						var $option = $('<option/>')
							.attr('value', item.id)
							.html(item.value);
						$selAssignContact.append($option);

						// If the selected value is still in list, set it back as selector's value
						if ($option.attr('value') === selectedValue)
							$selAssignContact.val(selectedValue);
					});
				});

				$actionContainer.prepend($assignContainer);
			}

			// "Mark as Done" Checkbox
			var allowMarkAsDone = mainMsg && mainMsg.assignmentStatusCode && mainMsg.assignmentStatusCode !== 'val';
			if (allowMarkAsDone)
				me.renderMarkDoneControl($msgEditor);

			// Make "Reassign" and "Mark as done" mutually exclusive
			if (allowAssignment && allowMarkAsDone) {
				let $assignContainer = $msgEditor.find(`.${me.cssClass.msgEditor.assignContainer}`);
				let $chkAssign = $assignContainer.find(`.${me.cssClass.msgEditor.chkAssign}`);
				let $selAssign = $assignContainer.find(`.${me.cssClass.msgEditor.selAssignContact}`);

				let $markDoneContainer = $msgEditor.find(`.iv-blog-mark-done`);
				let $chkMarkDone = $msgEditor.find(`.${me.cssClass.msgEditor.chkMarkDone}`);

				$chkAssign.on('change', function () {
					$markDoneContainer.toggleClass('hidden', $(this).prop('checked'));
				});
				$chkMarkDone.on('change', function () {
					$assignContainer.toggleClass('hidden', $(this).prop('checked') || $selAssign.find('option').length === 0);
				});
			}

			// "Close" button
			if (replyMode) {
				var $closeReplyBtn = ivBlogUtil.createButton(ivScope.GetText('g_close'), 'fa-times', `${this.cssClass.msgEditor.btnClose} iv-button borderless`)
					.on('click', () => {
						let done = me.tryCloseMessageEditor(mainMsg);
						if (done)
							me._currentlyEditing = null;

					});

				$inputContainer.append($closeReplyBtn);
			}

			$inputContainer.toggleClass('new-comment', !replyMode && !editMode);

			$actionContainer.append($btnSendMsg);
		},
