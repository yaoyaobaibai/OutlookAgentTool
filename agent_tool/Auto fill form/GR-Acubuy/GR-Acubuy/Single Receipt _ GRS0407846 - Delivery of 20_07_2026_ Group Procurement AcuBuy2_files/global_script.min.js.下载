/**
 * @description Defines methods and properties to interact with modal controls
 */
var ivModal = (function ($) {
	{
		'use strict';
		var
			namespace = 'ivModal',
			eventNamespace = '.' + namespace;

		return {
			/**
			 * @description Provides keyboard support to modals
			 */
			keydownHandler: function (event) {
				var keycode = event.which ? event.which : event.keyCode;
				if (keycode !== KEYS.TAB && keycode !== KEYS.ESCAPE) {
					return;
				}
				var $modal = $(this);
				var $focusableEls = ivAccessibility.get.focussable($modal);
				var firstFocusable = $focusableEls.first().get(0);
				var lastFocusable = $focusableEls.last().get(0);
				if (keycode === KEYS.TAB) {
					if (event.shiftKey) {
						// Shift + Tab, backward
						if (event.target === firstFocusable) {
							event.preventDefault();
							$(lastFocusable).focus();
						}
					}
					else {
						if (event.target === lastFocusable) {
							event.preventDefault();
							$(firstFocusable).focus();
						}
					}
				}
				else if (keycode === KEYS.ESCAPE) {
					// don't close modal if already another modal (semantic) in it with closing element => close this one instead
					if ($(this).find('div.ui.modal.visible.active:not([data-modal-id]) .iv-cancel').length > 0) {
						$(this).find('div.ui.modal.visible.active:not([data-modal-id]) .iv-cancel').first().click();
					}
					// dont' close modal if there is a visible tooltip
					else if ($(this).find(ivPopupTooltip.selector.trigger).length > 0 || $(this).find(ivTextBox.selector.trigger).length > 0) {
						return;
					}
					else {
						// don't close modal if already another modal (semantic) in it with closing element => close this one instead
						if ($(this).find('div.ui.modal.visible.active:not([data-modal-id]) .iv-cancel').length > 0) {
							$(this).find('div.ui.modal.visible.active:not([data-modal-id]) .iv-cancel').first().click();
						}
						else {
							var act = event.target;

							//selectors ellipsis
							var arr = $(this).find('[data-selectorid][type="text"]');
							if (act && jQuery.inArray(act, arr) >= 0) {
								if ($(act).attr('state') && $(act).attr('state') == 'close')
									$(act).attr('state', '');
								else
									$modal.modal('hide');
								return;
							}

							//selectors dropdown
							arr = $(this).find('select');
							if (act && jQuery.inArray(act, arr) >= 0) {
								if ($(act).attr('state') == 'open')
									$(act).attr('state', 'close');
								else
									$modal.modal('hide');
								return;
							}

							//date picker
							arr = $(this).find('input[class*="iv-txtbox-date"]');
							if (act && jQuery.inArray(act, arr) >= 0) {
								if ($('#ui-datepicker-div').length > 0 && $('#ui-datepicker-div').is(":visible"))
									return;
								else {
									$modal.modal('hide');
									return;
								}
							}

							$modal.modal('hide');
							event.stopPropagation();
						}
					}
				}				
			}
		}
	}
}(jQuery));

