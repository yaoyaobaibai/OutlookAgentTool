		toggleSubscribeStatus: function (sendingMsg) {
			if (sendingMsg && this.config.isJsUnsubscribed)
				return;

			if (!sendingMsg) {
				this.config.isJsSubscribed = !this.config.isJsSubscribed;
				this.config.isJsUnsubscribed = !this.config.isJsSubscribed;
			}
			else if (!this.config.isJsUnsubscribed)
				blogPanel.config.isJsSubscribed = true;

			if (this.config.messageCenterMode
				&& this.config.isJsUnsubscribed
				&& !confirm(ivScope.GetText('blog_chat_log_unsubscribe_me_confirmation'))) {
				return;
			}

			var blogPanel = this;
			ivBlogAjaxHandler.toggleSubscribeStatus(
				this.config.groupName,
				this.config.isJsSubscribed,
				this.instanceName,
				function (args) {
					if (!blogPanel.config.messageCenterMode)
						blogPanel.reload('chat');
					else if (blogPanel.config.isJsUnsubscribed)
						blogPanel.removeCurrentBlog();

					// Reload participants counter
					blogPanel.reloadSubscribers();
				}
			);
		},
		toggleJsSubscriptionStatus: function (blogPanel, subscribed) {
			// Update subscription status for current user
			blogPanel.config.isJsSubscribed = subscribed;
			blogPanel.config.isJsUnsubscribed = !blogPanel.config.isJsSubscribed;

			// Update subscribe button's text
			blogPanel.config.$container.find(`.item.${blogPanel.cssClass.conversation.subscribeMeItem}`).html(
				blogPanel.config.isJsSubscribed
					? ivScope.GetText("blog_panel_unsubscribe")
					: ivScope.GetText("blog_panel_subscribe")
			);
		},
		scrollToBottom: function (animDuration) {
			if (!this.config.scrollToBottom || !this.config.showChat)
				return;

			var chatType = this.findMsgType('chat');

			if (!chatType || !chatType.$msgList)
				return;

			var height = chatType.$msgList.prop('scrollHeight') || 10000;
			if (animDuration > 0) {
				chatType.$msgList.clearQueue(); // remove all animations not executed yet (scroll can be really long when loading the page)
