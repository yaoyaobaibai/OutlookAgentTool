			$('.control-action-bar .buttons').children().hide();
			$('.control-action-bar .buttons')
				.append($('<button />', { type: 'button', class: 'ui icon button ' + cssClass.btnCancelAction, title: ivScope.GetText('cancel_action') })
					.append($('<i/>', { class: 'fal fa-undo' })));
			$('.control-action-bar .buttons .' + cssClass.btnCancelAction).on('click', ivDesignMode.cancelControlCut);
