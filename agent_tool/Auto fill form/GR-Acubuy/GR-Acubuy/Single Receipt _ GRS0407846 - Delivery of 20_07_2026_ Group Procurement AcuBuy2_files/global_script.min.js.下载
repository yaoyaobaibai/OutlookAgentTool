function autoSaveData(grid, container) {

	let dataTableName = null, dataFieldName = null;
	let containerurl = null;
	let rowFields = {};
	let fields = container.find(ivValidator.selector.fields);
	$.each(fields, function () {
		let id = ivFormControl.getID(this);
		let c = __ivHtmlControls[id];
		if (c.dataFieldName && c.dataTableName) {
			dataTableName = c.dataTableName;
			dataFieldName = c.dataFieldName;
			if (c.translatable) {
				dataFieldName += $(this).data('lang');
			}
			containerurl = c.autoSaveUrl;

			if (!rowFields[dataFieldName]) {
				rowFields[dataFieldName] = getDataFieldValue(this);
			} else {
				id = this.id; //updating the id to get the id corresponding to the specific time part element
				if (id && id.includes('datetime')) {
					let timePartInfo = getDataFieldValue(this);
					if (timePartInfo) {
						rowFields[dataFieldName] = `${rowFields[dataFieldName]} ${timePartInfo}`;
					}
				}
			}
		}
	});
	if (!dataFieldName && !dataTableName) {
		return;
	}

	let args = {};
	args.rowcontrol = container.attr('id') || container.attr('data-iv-control');
	args.dataKeyNames = container.data('key') || grid.dataKeyNames || ivClient.get(grid, ivClient.properties.data, 'dataKeyNames');
	args.overLay = disableContainer(container);
	if (!ivCallMethod.saveDataRowHandler) {
		ivCallMethodHandler.prototype.saveDataRowHandler = function (options, args) {
			//HTTP URL scheme:[//[user[:password]@]host[:port]][/path][?query][#fragment]
			let fragments = window.location.href.split('#');
			let authorityPart = fragments[0];
			let offset = authorityPart.indexOf("?");
			if (offset === -1) {
				authorityPart += "?";
			}
			else if (offset !== authorityPart.length - 1) {
				authorityPart += "&";
			}
			authorityPart += "methodname=AutoSaveDataRowHandler";
			fragments[0] = authorityPart;
			let absoluteUrl = fragments.join('#');
			this.invoke(absoluteUrl,
				options,
				onSaveSuccess,
				onSaveFailure,
				args);
		};
	}

	const browseUrl = grid instanceof GridView ? ('/' + grid.ModuleName + '/' + grid.PageName) : ivClient.get(grid, ivClient.properties.data, 'datacollectionAutosaveurl');
	var ctxDcc;
	if (!grid.ctxvar) {
		ctxDcc = ivClient.get(grid, ivClient.properties.data, 'cryptedCtxVar');
		if (!ctxDcc)
			ctxDcc = ivClient.get(grid, ivClient.properties.data, '_tableDisplay').cryptedCtxVar;
	}

	//to review the options {datatablename,datakeynames...} (do more generic for grid/form_manage/listview...)
	ivCallMethod.saveDataRowHandler({
		dataTableName: dataTableName,
		dataKeyName: container.data('key') || grid.dataKeyNames || ivClient.get(grid, ivClient.properties.data, 'dataKeyNames'),
		dataValue: rowFields,
		containerUrl: containerurl,
		browseUrl: browseUrl,
		ctxVar: grid.ctxvar || ctxDcc
	}, args);
}

function getDataFieldValue(ctrl) {
	var dataFieldValue = null;
	if ($(ctrl).length > 0) {
		if ($(ctrl)[0].isSelector) {
			if (ctrl.SelectedValues.length > 0)
				dataFieldValue = ctrl.SelectedValues.join('|');
		}
		else if ($(ctrl).attr('editor') == 'true') {
			dataFieldValue = $(ctrl).text();
		}
		else {
			dataFieldValue = $(ctrl).val();
		}
	}
	return dataFieldValue;
}

//old code
function onSaveSuccess(msg, args, setting, jqXHR) {
	if (!args || !msg) return;

	let mustRefresh = false;
	let obj = {};
	obj.message = msg.msg;
	if (msg.err == true) {
		obj.icon = "fa-times-circle";
		obj.color = "red";
		notify(obj, args);

		let errorMsg = jqXHR.getResponseHeader("IV-AsyncError");
		if (errorMsg) {
			ivMessage.clearMsg();
			ivMessage.AddErrorMsg(errorMsg);
		}
	}
	else if (msg.err == false) {
		obj.icon = "fa-check-circle";
		obj.color = "green";
		dataBind(msg.row, args);
		notify(obj, args);
	}
	else
		onSaveFailure(null, args);
}

