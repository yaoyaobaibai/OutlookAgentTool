		addNewField: function(data) {
			if (data.success) {
				let $lastOverlay = null;
				for (var i = 0, keys = Object.keys(data); i < keys.length; i++) {
					var key = keys[i];
					var $addedField = $('.design-field-added[data-iv-target=' + key + ']');
					let isTabControlAdded = false;
					$addedField.attr('data-iv-role', 'container');
					if ($addedField.length) {
						var $placeholder = $addedField.closest('table');
						var control = data[key];
						if (control.html) {
							var $html = $(control.html);
							var isColumn = $html.is('th');
							isTabControlAdded = $html.find('.design-tab-button').length > 0;

							$addedField
								.addClass('sortable_control is_sortable designable iv-phc-cell')
								.addClass(control.designSortableId)
								.removeClass('design-field-added dimmable dimmed');
							const placeholderSelector = ivClient.get($html, ivClient.properties.containerControl).data('placeholderSelector');

							// hook for datacollection in table render
							if ($addedField.hasClass('iv-dcc-table-item-header-wrapper')) {
								const attributes = $html.prop('attributes');
								// copy all attributes in $addedField
								$.each(attributes, function () {
									$addedField.attr(this.name, this.value);
								});
								$addedField.addClass('iv-dcc-table-item-header-wrapper');
								$addedField.attr('data-target-id', key);
								$addedField.html($html.html());
							}
							else {
								$addedField.html($html);
							if (isColumn) {
								$html.attr('data-placeholder-selector', placeholderSelector);
								$html.unwrap();
							}
							else {
								$addedField.find('[data-iv-role*=field]').attr('data-placeholder-selector', placeholderSelector);
							}
							}

							// refresh area
							refreshDesignAreas($placeholder);
							// if the control is a placeholder, refresh it too ...
							// remove overlay
							if (!isTabControlAdded && ivClient.get($html.not('.overlay'), ivClient.properties.controlTypeName) === 'placeHolderControl') {
								refreshDesignAreas($html.not('.overlay').find('table.phc'));
							}
						}
						if (control.js) {
							eval(control.js);
						}
						// selection of the control
						if (isTabControlAdded) {
							$lastOverlay = $addedField.find('.design-tab-button').closest('nav');
						}
						else {
							$lastOverlay = $addedField.find('.overlay').first();
						}
					}
				}
				// load design panel only for last added field if multiple fields
				if ($lastOverlay && $lastOverlay.length > 0) {
				ivDesignMode.loadDesignPanel(null, null, $lastOverlay);
				}
				ivGuidancePopup.show(ivScope.GetText('control_added_successfully'), 10000);
			}
			else {
				ivNotificationMessage.AddMsg(data.message, null, 'error', ivNotificationMessage.msgContainer.dialog);
			}
		},
		setClientVisibility: function(clientId, visible) {
			const
				$field = ivClient.get(clientId, ivClient.properties.role, ivClient.roles.field),
				$grid = $field.closest('.iv-grid-view'),
				$overlay = $field.prev('.overlay'),
				$implicitAreaForTab = $field.prev('.impl-area'),
				isInMasterDetails = $field.closest("tr.data-collection-object-master-detail").length > 0 ? true : false;
			let
				isGrid = false,
				colIndex,
				$cells,
				$cell = $field.closest('td');

			const $row = $cell.closest('tr');

			if (!$cell.length) {
				$cell = $field.closest('.tabcontrol');
			}
			// collIndex and cells are not relevant in a case of master details
			if ($grid.length && !isInMasterDetails) {
				isGrid = true;
				colIndex = $field.closest('th').get(0).cellIndex;
				$cells = $grid.find('> tbody > tr > td:nth-child(' + (colIndex + 1) + ')');
			}

			if ($implicitAreaForTab && $implicitAreaForTab.length) {
				const $fromTab = $('.overlay.active-design').closest(designActions.cutPaste.selectors.parentCell);
				const $nexTabs = $fromTab.nextAll('li.impl-area');

				if (visible) {
					$nexTabs.find('.dm-innerline').each(function() {
						$(this).attr('iv-area-tab-index', parseInt($(this).attr('iv-area-tab-index'), 10) + 1);
					});
					$implicitAreaForTab.removeClass('hidden');
				} else {
					$nexTabs.find('.dm-innerline').each(function() {
						$(this).attr('iv-area-tab-index', parseInt($(this).attr('iv-area-tab-index'), 10) - 1);
					});
					$implicitAreaForTab.addClass('hidden');
				}
			}

			if (visible) {
				$field.removeClass('hidden');
				$overlay.removeClass('hidden');
				$cell.removeClass('hidden');

				// grid
				if (isGrid) {
					$cells.removeClass('hidden');
				}

				if ($row.children('.designable:not(.hidden)').length > 0) {
					$row.removeClass('hidden');
				}
			} else {
				$field.addClass('hidden');
				$overlay.addClass('hidden');

				//If it's not a column, hide the main cell, instead it will hide the grid
				if (!ivClient.is.role($('#' + clientId), ivClient.roles.header))
				$cell.addClass('hidden');

				// grid
				if (isGrid) {
					$cells.addClass('hidden');
				}

				let $tableToRefresh = $field.closest('table.phc');
				if ($tableToRefresh.length) {
					const visibleRows = $tableToRefresh.find('> tbody > tr[data-iv-coord-y]:not(.hidden)').filter((node) => {
						return $(node).children('td.hidden').length < $(node).children('td').length;
					});
					//hide the placeholder row when there is no more visible cell
					if ($row.children('td.designable:not(.hidden)').length === 0
						&& visibleRows.length > 1
						&& isGrid === false // do not hide row in case the control is a grid cell
						&& isInMasterDetails === false) 
					{
						$row.addClass('hidden');
					}
					refreshDesignAreas($tableToRefresh);
				}
			}
		},
