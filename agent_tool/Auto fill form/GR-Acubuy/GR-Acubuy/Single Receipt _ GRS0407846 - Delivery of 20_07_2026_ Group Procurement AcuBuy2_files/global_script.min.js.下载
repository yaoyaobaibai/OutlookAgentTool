			};
			var $tagValuesToDelete = $filterSummary
				.find(ivFilter.selector.summary.tag + '[data-id="' + controlId + '"]')
				.find(ivFilter.selector.summary.tagValue)
				.filter(filterValues);
			$tagValuesToDelete.remove();
		},
		addTagValues: function (controlId, $filterSummary, values) {
			var
				data = ivClient.get(controlId, ivClient.properties.data),
				$tag = $filterSummary.find(ivFilter.selector.summary.tag + '[data-id="' + controlId+'"]').first(),
				$tagValues = $tag.find(ivFilter.selector.summary.tagValue),
