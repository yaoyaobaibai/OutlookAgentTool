	function closeViewer() {
		// Test if viewer has been created
		if (!$overlay || !($overlay instanceof jQuery)) return;

		// Remove event listeners by namespace
		$overlay.off('.' + EVT_NS);
		$(document).off('.' + EVT_NS);

		// Remove overlay and its content
		$overlay.remove();
