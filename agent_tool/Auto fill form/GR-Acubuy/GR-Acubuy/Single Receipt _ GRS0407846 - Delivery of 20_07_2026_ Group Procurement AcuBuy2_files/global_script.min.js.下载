		RollBackRuleToStandard: {
			success: function(result) {
				if (!result.success) {
					ajaxMethods.UpdateAutosave(result);
					return;
				}

				var data = result.content;
				var script = result.script;
				var propertyName = data ? data['propertyName'] : null;
				var $field = propertyName ? $('.design-panel').find('[data-iv-design-property=' + propertyName + ']') : null;
				if ($field.length > 1) { //special case for orga/date/... selectors with two choices (like "default value" OR "today")
					$field = $field.closest('[data-iv-role="group field"]');
				}

				var propertyField = data ? data['propertyField'] : null;

				if ($field === null) {
					ajaxMethods.UpdateAutosave(result);
					return;
				}

				if (propertyField !== null) {
					$field.replaceWith(propertyField);
					$field = $('.design-panel').find('[data-iv-design-property=' + propertyName + ']');
					ivDesignMode.toggleAutoSaveIcon($field);

					if (script !== null) {
						eval(script);
					}
					initPropertyControl($field.parent());
				}
				ajaxMethods.UpdateAutosave(result);

				//When rollback rule is done, change the icon visibility of hidden controls on the selected field
				if (propertyName === 'Visible') {
					let $designField = GetDesignField($('.desactivated-overlay'));
					const arrayClassesToggleVisibility = [designSettingsPanel.displayHiddenControls.dmClassDisabled, designSettingsPanel.displayHiddenControls.dmClassEnabled];
					const selectorClassesToggleVisibility = designSettingsPanel.displayHiddenControls.controlClassDisabled + ', ' + designSettingsPanel.displayHiddenControls.controlClassEnabled;
					$designField = $designField.find(selectorClassesToggleVisibility).addBack(selectorClassesToggleVisibility);
					$designField.removeClass(arrayClassesToggleVisibility);
				}
			}
		},

