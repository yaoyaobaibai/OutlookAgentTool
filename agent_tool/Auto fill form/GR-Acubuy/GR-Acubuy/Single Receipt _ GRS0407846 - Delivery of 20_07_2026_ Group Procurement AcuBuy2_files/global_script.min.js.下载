		return $(topWindow().document).find('iframe#' + currentModalId).parent()[0];
	} else {
		//navigation from window.parent to be able to select the iframe (top-down), we cannot perform a bottom-up navigation to find the iframe
		return $(window.parent.document).find('iframe#' + currentModalId).parent()[0];
	}
}

function modalOnHiddenCallBack(event, DOMElementToRemove, currentModalId) {
	var fields = {};
	var modalId = $('#_hdnModalId').val();

	if (!modalId) {
		// if we are here it means the modal did not close properly, so close it and display previous one if there is
		if (DOMElementToRemove && $(DOMElementToRemove).length) {
			if ($(DOMElementToRemove).hasClass('iv-modal-content') && $(DOMElementToRemove).children().first().attr('id') == currentModalId) {
				var $previousFrameContent = $(DOMElementToRemove).prevAll('.iv-modal-content');
				if ($previousFrameContent && $previousFrameContent.length > 0) {
					var $previousFrame = $previousFrameContent.first().children().first();
					if ($previousFrame.is(':hidden')) {
						$previousFrame.show();
					}
				}

				removeDOMElement(DOMElementToRemove);
				return;
			}
		}
	}
	
	var $modal = $('#' + modalId);

	// Search the modal in case of multi modals
	if ($modal.length === 0 && modalId) {
		$modal = $(mainWindow().document).find("body").find('#' + modalId);
	}

	var returnValues = $modal.attr('data-list-column');

	///todo: make it work...
	if (returnValues && $modal.contents().find('#listColumn_objectID').length) {
		fields['objectID'] = $modal.contents().find('#listColumn_objectID').val();
		var values = returnValues.split(',');
		for (index in values) {
			var value = returnValues.split(',')[index];
			if (value.indexOf(';') === -1) {
				fields[value] = $modal.contents().find('#listColumn_' + value).val();
			}
		}

		const selId = $modal.attr('src').substring($modal.attr('src').indexOf('gridId') + 7).split('&')[0];
		const selector = __ivCtrl[selId];

		if (selector && fields['objectID']) {
			ivEllipsisSelector.addValue(fields['objectID'],
				null,
				$(document).find('#' + selId).parent().closest('[data-iv-control]'),
				null,
				$(document));
		}
	}
    if ($modal.attr('onCloseScript'))
        eval($modal.attr('onCloseScript'));
	var self = this;
	$.when(modalOnClose(event)).then(function () {
		$(upperDocument).find('#mainForm').removeAttr('aria-hidden');
		upperWindow.$('#ui-datepicker-div').hide();
		callModalCloseEvent($(self).attr("id"));
		//point back the focus on the triggering element
		var triggeredByObj = $(self).data('triggeredByObj');
		if (triggeredByObj && triggeredByObj.nodeType !== undefined)
			triggeredByObj.focus();

		if (DOMElementToRemove && $(DOMElementToRemove).length) {
			var $domIFrame = $(DOMElementToRemove).find('iframe');
			if ($domIFrame.length
				&& $($domIFrame[0].contentDocument).find('.ui.modal:first').length
				&& $($domIFrame[0].contentDocument).find('.ui.modal:first').transition('is animating')) {
				$($domIFrame[0].contentDocument).find('.ui.modal:first').transition({
					onComplete: function () {
						removeDOMElement(DOMElementToRemove);
					}
				});
			}
			else {
				removeDOMElement(DOMElementToRemove);
			}
		}
	});
	}

	function removeDOMElement(element) {
		let elementToRemove = element;
		if (element instanceof jQuery) {
			elementToRemove = element.get(0);
		}
		// make sure hasModal method returns false
		const hdnHasModal = elementToRemove.ownerDocument.getElementById('_hdnHasModal');
		if (hdnHasModal) {
			hdnHasModal.value = '';
		}
		elementToRemove.remove();
	}

function hashCode (str) {
	var hash = 0, i, chr, len;
	if (!str || str.length == 0) return hash;
	for (i = 0, len = str.length; i < len; i++) {
		chr = str.charCodeAt(i);
		hash = ((hash << 5) - hash) + chr;
		hash |= 0; // Convert to 32bit integer
	}
	return hash;
};
	
function createModal(url, post, postValues, opts) {
	ivMessage.displayLoadMsg({
		class: 'dimmer-modal-light'
	});
	//generate unique but constant id in a given state
	var modalId = 'f' + hashCode(url).toString(16).replace(".", "").replace("-", "");
	var mid = $('#' + modalId + '-VIEW');
	while (mid && mid.length > 0) {
		modalId += '_';
		mid = $('#' + modalId + '-VIEW');
	}
	var animate = false;// (navigator.userAgent.indexOf('Edge/') < 0 && navigator.userAgent.indexOf('Trident/') < 0);
	// add modals in the main window (case of QST iframes)
	var $body = $(topWindow().document).find('body');
	var $modalContainer = $('<div class="iv-modal-content"></div>');
	$modalContainer.appendTo($body);
	var $iframe = $('<iframe />')
		.attr("id", modalId + "-VIEW")
		.attr("name", modalId + "-VIEW")
		.css('width', '100%')
		.css('height', '100%')
		.css("border", "0")
		.css("top", "0")
		.css('position', 'absolute')
		.css('background', 'transparent')
		.css('z-index', '2000')
		.appendTo($modalContainer)
		.load(function () {
			var $ghost = $(this).parent().find('.ghost');

			var ghostClass = $ghost.find('.ui.modal').attr('class');
			if (ghostClass && ghostClass.length > 0)
				var keepFullscreen = ghostClass.includes('fullscreen');

			hideModalLoadMessage();
			
			var duration = (animate ? 150 : 0);
			if ($(this).data("isLoaded"))
				duration = 0;
			var modalSize = opts['size'];
			var isFullScreen = $(this).data('fullscreen_onload');
			if (!isFullScreen && !modalSize && ($(this.contentDocument).find('body').hasClass('iv-manage') || $(this.contentDocument).find('body').hasClass('iv-browse')))
				modalSize = 'large';
			var $modal = $(this.contentDocument).find('.ui.modal:first');
			if (modalSize) {
				$modal.addClass(modalSize);
			}
			var onHidden = opts['onHidden'];
			if (onHidden) {
				var scopeArr = onHidden.split('.');
				var onHiddenMethod = scopeArr[scopeArr.length - 1];
				if (scopeArr[0] == 'window') {
					scopeArr.splice(index, 1);
				}
				var scope = window;
				for (i = 0; i < scopeArr.length - 1; i++) {
					scope = scope[scopeArr[i]];
				}
				onHiddenMethod = scope[onHiddenMethod];
			}
			if ($modal.parents('body:first').hasClass('design-mode')) {
				$modal.addClass('fullscreen');
			}
			$modal.attr('data-modal-id', $(this).attr('id'));
			var centered = true;
