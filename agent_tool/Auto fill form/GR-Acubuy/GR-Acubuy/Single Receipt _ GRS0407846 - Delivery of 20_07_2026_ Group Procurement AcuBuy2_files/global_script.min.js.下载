			if (this.isGrid && (!__ivCtrl[this.GridClientID].allowPaging || ($("#" + this.GridClientID + "> tbody > tr:not(.PowerGridHeaderClass):not(.PowerGridPagerClass)").length < __ivCtrl[this.GridClientID].pageSize))) {
