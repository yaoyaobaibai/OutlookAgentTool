};
Favorites.init = function (items, url, objectId) {
	Favorites._url = url;
	Favorites._objectId = objectId;
	Favorites.create(items);
};

Favorites.onkeypress = function (e) {
	if (e.keyCode == KEYS.ENTER) {
		Favorites.save($(e.target));
		return false;
	}
};
Favorites.onAdd = function (e) {
	if (e.keyCode === KEYS.ENTER) {
		Favorites.add();
		$('.iv-icon-favorite').focus();
		return false;
	}
	else {
		return true;
	}
};
Favorites.actualize = function (data, state) {
	if (state) {
		if (state[0] !== 'remove') {
			$('.iv-icon-page-title.iv-icon-favorite').removeClass('regular').removeClass('iv-icon-favorite-off');
			$('.iv-icon-page-title.iv-icon-favorite').addClass('iv-icon-favorite-on');
		}
		else {
			if (state[1]) {
				$('.iv-icon-page-title.iv-icon-favorite').removeClass('iv-icon-favorite-on');
				$('.iv-icon-page-title.iv-icon-favorite').addClass('regular').addClass('iv-icon-favorite-off');
			}
		}
	}
	if (Favorites._instance) {
		Favorites._instance.hide();
		if (state[0] === "add") {
			$('#add-favorite-popup').slideUp();
			$('.iv-icon-favorite').attr('aria-expanded', 'false');
		}
		else if (state[0] === "remove" && state[1]) {
			$('#add-favorite-popup').slideDown();
			$('.iv-icon-favorite').attr('aria-expanded', 'true');
		}
	}
	$('#added-favorites').html(data);
	$('#added-favorites').find('.accordion-control').accordion();
	if (Favorites._objectId == null) {
		var j = $('#fgroup-selected').find('.fitem').length;
		var i = (j === 0 ? $('#fgroup-selected').length : 0);
		$('.favorite-label input').val('#' + (i + j + 1));
	}
	//TODO:revoir (attention, sur suppression d'un favoris qui n'est pas la page courante)
	if (Favorites._currentFavorite == null)
		Favorites._currentFavorite = location.href.substr((location.protocol + "//" + location.hostname + (location.port.length > 0 && location.port != 80 ? (":" + location.port) : "")).length);
	$('#added-favorites').find('.fitem').each(function () {
		if ($(this).data('url') == Favorites._currentFavorite) {
			$(this).addClass('fitem-selected');
			return false;
		}
	});
	if (typeof Favorites.onAdded === 'function')
		Favorites.onAdded();
};
Favorites.redirect = function (node) {
	if (!ivCallMethod.favIdInSession) {
		ivCallMethodHandler.prototype.favIdInSession = function (favId) {
			this.invoke(ivScope.AjaxUrl("usr", "favorites", null, "methodname=FavIdInSession"), { id: favId },
				function () {
					var url = $(node).parents('.fitem:first').data('url');
					var separator = url.includes('?') ? '&' : '?';
					window.location.href = url + separator + 'favoriteid=' + favId;
				}, null, null);
		};
	}

	var _favId = $(node).parents('.fitem:first').attr('favId');
	if (_favId)
		ivCallMethod.favIdInSession(_favId);
	else
		window.location.href = $(node).parents('.fitem:first').data('url');
};
Favorites.create = function (data, state) {
	var $favoriteModal = $('.favorite-modal');
	$favoriteModal.modal({
		onHidden: function (e) {
			updateBodyAriaHiddenAttribute(false);
		}
	});
	$favoriteModal.off('keydown.favorite-modal').on('keydown.favorite-modal', function (event) {
		var
			$focusableEls = ivAccessibility.get.focussable($favoriteModal),
			firstFocusable = $focusableEls.first().get(0),
			lastFocusable = $focusableEls.last().get(0),
			keycode = event.which || event.keyCode;
		if (keycode === KEYS.TAB) {
			if (event.shiftKey) {
				// Shift + Tab, backward
				if (event.target === firstFocusable) {
					event.preventDefault();
					$(lastFocusable).focus();
				}
			}
			else {
				if (event.target === lastFocusable) {
					event.preventDefault();
					$(firstFocusable).focus();
				}
			}
		}
	});
};
