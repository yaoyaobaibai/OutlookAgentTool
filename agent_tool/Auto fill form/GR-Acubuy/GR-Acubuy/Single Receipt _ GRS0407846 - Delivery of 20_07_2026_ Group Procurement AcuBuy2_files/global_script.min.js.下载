		addMessageType: function (typeCode, typeLabel) {
			if (this.config.messageTypes[typeCode])
				return;

			var msgType = {
				code: typeCode,
				label: typeLabel
			};
			this.config.messageTypes.push(msgType);
			return msgType;
		},
		addMessage: function (msg, insertBefore, newMsg) {
			newMsg = typeof newMsg !== "undefined" ? newMsg : false;

			if (!msg.messageId || !msg.messageId.length || this.containsMessage(msg.messageId))
				return;

			if (typeof msg.date === 'string')
				msg.date = new Date(msg.date);
			if (typeof msg.files === "string")
				msg.files = eval(msg.files);

			this._messages.push(msg);

			if (!this.config)
				return;

			// Render reply only if parent message is already rendered
			if (!msg.parentId || (msg.parentId && this._renderedMessages[msg.parentId]))
				this.renderMessages(insertBefore);

			// Switch from "No message yet" panel to message list when message is added
			var msgType = this.findMsgType(msg.typeCode);
			if (msgType.$msgListEmpty) {
				msgType.$msgListEmpty.addClass("hidden");
				msgType.$msgList.removeClass("hidden");
			}
		},
		updateMessage: function (msg) {
			var msgTarget = this.findMessage(msg.messageId);
			if (!msgTarget)
				return;

			var $msgContent = msgTarget.htmlRendering.find("." + this.cssClass.comment.messageContent).first();

			msgTarget.content = msg.content;
			$msgContent.text(msg.content);
			$msgContent.removeAttr("contenteditable");
			msgTarget.files = typeof msg.files === "string" ? eval(msg.files) : msg.files;
			$msgContent.append(this.renderMessageFiles(msgTarget));
			this.renderMessageAssignment(msg);
		},
		removeMessage: function (deleteMsg) {
			var msg = this.findMessage(deleteMsg.messageId);
			if (!msg)
				return;
			msg.htmlRendering.addClass('hidden');

			if (!msg.parentId || !this._renderedMessages[msg.parentId]) return;

			const target = this._renderedMessages[msg.parentId].htmlRendering;
			const activeChilds = target.find(".iv-blog-msg.msg-me:not(.hidden)");

			if (activeChilds.length > 0) return;

			// Enable edit & delete action if the message has replies
			target.find("." + this.cssClass.comment.btnOtherActionEditMessage).removeClass('disabled');
			target.find("." + this.cssClass.comment.btnOtherActionDeleteMessage).removeClass('disabled');
		},
		containsMessage: function (messageId) {
			return !!this.findMessage(messageId);
		},
		findMessage: function (messageId) {
			return this._messages.find(msg =>
				(typeof msg !== 'undefined') &&
				(typeof msg !== 'function') &&
				msg.messageId == messageId
			);
		},
		renderMessageType: function (typeCode, open) {
			if (!typeCode || typeCode.length == 0)
				return;

			var msgType = this.findMsgType(typeCode);
			const isChatMsgType = msgType.code === 'chat';

			if (msgType.isRendered)
				return msgType;

			var me = this;

			// Container
			msgType.blockContainerHtmlRendering = $('<div/>', {
				class: 'iv-blog-type-container',
				'data-id': msgType.code
			})

			// Bind container to navbar
			if (!this.config.messageCenterMode) {
				msgType.blockContainerHtmlRendering
					.addClass('iv-blog-navbar-navigable hidden')
					.attr('data-blog-nav-id', msgType.code);
			}

			// Header
			msgType.headerHtmlRendering = me.newMsgTypeHeaderContainer(msgType);

			// Body
			msgType.htmlRendering = $('<div/>', { class: 'iv-blog-type' })
				.attr('data-id', msgType.code)
				.data('blog-type', msgType);

			msgType.blockContainerHtmlRendering
				.append(msgType.headerHtmlRendering)
				.append(msgType.htmlRendering);

			// Message list
			msgType.$msgList = me.newMsgList(msgType);
			msgType.htmlRendering.append(msgType.$msgList);

			// Empty state
			msgType.$msgListEmpty = me.newMsgListEmpty(msgType.code).addClass("hidden");
			msgType.htmlRendering.append(msgType.$msgListEmpty);

			me._$panel.append(msgType.blockContainerHtmlRendering);

			// Render conversation list
			if (this.config.showChat && isChatMsgType && !me.config.messageCenterMode) {
				me.renderConversationPanel(msgType.blockContainerHtmlRendering);
				me.setChatOpenedBlock('conversation');
			}

			msgType.isRendered = true;
			msgType.messageCount = 0;

			if (isChatMsgType) {
				msgType.allUnreadContainer = me.newAllUnreadChatContainer();
				msgType.moreContainer = me.newMoreMsgChatContainer();
				msgType.searchingContainer = me.getSearchingContainer();
				msgType.viewModeContainer = me.getViewModeContainer();

				msgType.htmlRendering
					.prepend(msgType.allUnreadContainer)
					.prepend(msgType.moreContainer)
					.prepend(msgType.searchingContainer)
					.prepend(msgType.viewModeContainer);

				me.showMessageEditor(null, msgType);

				msgType.$searchBox = msgType.headerHtmlRendering.find('.iv-blog-search input');

				if (me.config.messageCenterMode)
					me.focusNewMsgTextarea();
			}

			return msgType;
		},
		renderConversationPanel: function ($chatContainer) {
			if (!this.config.showChat || this.conversationPanel.isRendered)
				return;

			var $convPanelHeaderContainer = this.newConversationPanelHeader();
			$chatContainer.prepend($convPanelHeaderContainer);

