		updateComment: function (message) {
			let $msgEditor = message.htmlRendering.find(`.iv-blog-msg-editor`).first();
			let $textarea = $msgEditor.find(`.${this.cssClass.msgEditor.textarea}`);

			// Content
			let messageContent = ivFormat.formatStartTag($textarea.val());

			// If message is empty, display error and return
			if (messageContent.trim().length == 0) {
				message.htmlRendering.find(`.${this.cssClass.comment.messageContent}`).first()
					.addClass('error')
					.attr('old-placeholder', $messageContent.attr('placeholder'))
					.attr('placeholder', ivScope.GetText('blog_panel_comment_required'))
				return;
			}

			// Attachments
			let attachmentsToAdd = $msgEditor.find(`#hdnIvBlogAddFileUploadedIds_${$msgEditor.attr('id')}`).val();
			let attachmentsToRemove = message.htmlRendering.find('.iv-blog-msg-files .file-to-remove').map(function () { return $(this).attr('fileguid') }).get().join(';');

			// Pings
			var newPingeesList = [];
			$textarea.ping('getPings', function (pings) {
				$.each(pings, function (index, item) {
					newPingeesList.push(new ivJsBlogSubscriber(item.id, item.value));
				});
			});

			// Assignment status
			var assignmentStatusCode = null;
			var mainMsg = !message.parentId ? message : this.findMessage(message.parentId);
			if (mainMsg.assignmentStatusCode && mainMsg.assignmentStatusCode !== 'val') {
				var $chkMarkDone = $msgEditor.find(`.${this.cssClass.msgEditor.chkMarkDone}`);
				if ($chkMarkDone.length && $chkMarkDone.prop('checked'))
					assignmentStatusCode = 'val';
			}

			var blogPanel = this;
			ivBlogAjaxHandler.updateMessage(
				message.groupName,
				message.messageId,
				message.parentId,
				messageContent,
				attachmentsToAdd,
				attachmentsToRemove,
				newPingeesList,
				assignmentStatusCode,
				function (args) {
					blogPanel.reload('chat');
				},
				function (args) {
					ivBlogUtil.showToastMessage(ivScope.GetText('error_msg_not_modified'), 'icon fa-exclamation-circle', 'red', message.htmlRendering);
				}
			);
		},
