				path += table;
				return path;
			});

			if (typeof fields !== 'undefined') {
				for (i = 0; i < fields.length; i++) {
					dataFields.push({
						fieldName: fields[i],
						tableName: path,
						dataTablePath: path.replace(/;/g, ','),
						fieldCode: ivDesignMode.generateFieldCode(fields[i]),
						createColumn: false
						// obsolete ???
						// originalfield: 'exists',
						// fieldType: ''
					});
				}
			}

			if (typeof relationTables !== 'undefined') {
				for (i = 0; i < relationTables.length; i++) {
					dataFields.push({
						tableName: relationTables[i].tableName,
						dataTablePath: (path + relationTables[i].dataTablePath).replace(/;/g, ','),
						fieldCode: ivDesignMode.generateFieldCode(relationTables[i].column),
						createColumn: false
						// obsolete ???
						// originalfield: 'exists',
						// fieldType: ''
					});
				}
