				if ($modal.find('.params').length > 0) {
					params['additionalParameters'] = {};
					$modal.find('.params').find('input').each(function() {
						if ($(this).is(':radio')) {
							if ($(this).is(':checked')) {
								params['additionalParameters'][$(this).attr('name')] = $(this).val();
