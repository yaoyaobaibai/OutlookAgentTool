	function pasteField(e) {
		e.preventDefault();
		e.stopPropagation();

		const $button = $(e.target).closest('button');

		if ($button.hasClass('paste-field')) {
			const $optionsDialog = $('#paste_options');
			const directionParam = $optionsDialog.find('input[name="paste_direction"]:checked').val();
