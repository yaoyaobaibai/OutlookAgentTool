	/**
	 * Display a document file (docx / pdf / ...).
	 * @param {string} fileId file identifier.
	 * @param {string} fileExtension file extension (which will determine the category).
	 */
	function displayDocument(fileId, fileExtension) {
		var baseUrl = getImageRelativePath(fileId);
		var url = baseUrl + '?content_disposition=inline';

		// If document is not a PDF, we have to convert it first
		if (fileExtension !== 'pdf') url += '&to=pdf';

		// Create the object which will display the built-in PDF viewer
		var docViewer = document.createElement('iframe');
		docViewer.src = url;
		docViewer.type = 'application/pdf';
		docViewer.width = '100%';
		docViewer.height = '100%';
		docViewer.innerHTML = ivScope.GetText('browser_no_pdf_viewer');
		docViewer.className = 'out-of-view';
		$overlay.find('.viewer-content').append(docViewer);
		docViewer.addEventListener('load', finalizeDocumentDisplay);
