				if (this.ShowColumnDelete && gridAllowDeleteColumn) {
					const $button = $('<button type="button" data-iv-role="field control" data-iv-control-type-name="buttonControl" class= "ui button iv-button borderless" tabindex="0" data-iv-usage="del" ></button>');
