			// add dcc pfield_code if necessary
			if (ivClient.get($field, ivClient.properties.controlTypeName) == 'dataCollectionDisplay') {
				const control = __ivHtmlControls[ivClient.get($field, ivClient.properties.id)];
				const dccId = control.dataCollection.controlID;

				if (typeof dccId !== 'undefined') {
					designFieldInfos['dccFieldCode'] = dccId;
				}
			}

			return designFieldInfos;
