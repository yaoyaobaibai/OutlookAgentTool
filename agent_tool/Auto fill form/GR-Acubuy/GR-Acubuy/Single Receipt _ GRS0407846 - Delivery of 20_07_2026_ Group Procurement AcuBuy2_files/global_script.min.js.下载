		},

		initDropdowns: function (scope) {
			scope = scope.get ? scope.get(0) : scope;
			Array.from(scope.querySelectorAll('.dropdown-selector')).forEach(function (e) { ivDropdownSelector.initDropdown(e) });
		},
		initDropdown: function ($dropdown) {
			$dropdown = $($dropdown);			
			if ($dropdown.length > 1) {
				$dropdown = $dropdown.first();
			}

			if (!$dropdown.length || $dropdown.data('initialized'))
				return;

			var
				isMultiple = ivSelector.is.multiple($dropdown),
				settings = $.extend({
					action: ivDropdownSelector.onChange,
					onRemove: ivDropdownSelector.onRemove,
					onShow: handlers.onShowHandler,
					onHide: handlers.onHideHandler,
					onLabelSelect: handlers.onLabelSelectHandler,
					direction: $dropdown.hasClass('downward') ? 'downward' : 'upward',
				}, defaultSettings);

			if (!isMultiple) {
				$.extend(settings, { forceSelection: false });
			}

			$dropdown.dropdown(settings);

			if ($dropdown.get(0).hasAttribute('data-grid')) {
				var grid = $dropdown.find('[data-grid]');
				if (grid.length && grid.get(0).hasAttribute('data-grid') && __ivCtrl[grid.attr('data-grid')])
					__ivCtrl[grid.attr('data-grid')].selector = __ivCtrl[grid.attr('data-selector')];
			}
			$dropdown.data('initialized', true);
			updateGroupItemsVisibility({ target: $dropdown.get(0) });
		},
		hideAllDropdown: function (exclude) {
			Array.from(document.querySelectorAll('.ui.dropdown.visible, .ui.dropdown.active')).forEach(function (dropdown) {
				if (exclude !== dropdown) {
					ivDropdownSelector.hideSuggestion(dropdown);
					$(dropdown).dropdown('hide');
				}
			});
		},
		dropdownFocusHandler: function (e) {
			var
				$dropdown = ivDropdownSelector.getDropdown(e.target),
				isOpen = $dropdown.dropdown('is visible');
			if (ivClient.is.readonly(e.target)) {
				return true;
			}
			ivDropdownSelector.hideAllDropdown($dropdown.get(0));
			if ($dropdown.is('.autocompletion')) {
				if (!isOpen) {
					ivAutocompletionSelector.autocomplete(e);
				}
				return true;
			}
			else {
				ivDropdownSelector.initDropdown($dropdown);
			}
			return true;
		},

		dropdownFocusOutHandler: function (e) {
			let $dropdown = ivDropdownSelector.getDropdown(e.target);
			$dropdown.scrollTop(0);
			$dropdown.children('.text.filtered').removeClass('filtered');
		},

		containerFocusOutHandler: function (e) {
			const $dropdown = ivDropdownSelector.getDropdown(e.target);
			const dropdown = $dropdown.get(0);

			// check if the focus is not inside the list
			if (e.relatedTarget && !dropdown.contains(e.relatedTarget)) {
				$dropdown.dropdown('hide');
			}
		},
		excludedIconClickHandler: function (e) {
			var $icon = $(e.target).closest('.exclude'),
				$dropdown = ivDropdownSelector.getDropdown($icon),
				$hiddenFied = $dropdown.find(ivDropdownSelector.selector.inputHiddenExcluded),
				values = $hiddenFied.val().split(',').filter(function (e) { return e !== null && e !== ''; }),
				value = $icon.data('value'),
				index = values.indexOf(value),
				arr = $icon.find('.sr-only').text().split(' ');

			if ($icon.hasClass(ivDropdownSelector.CssClass.active)) {
				arr[0] = ivScope.GetText('exclude');
				values.splice(index, 1);
			}
			else {
				arr[0] = ivScope.GetText('include');
				values.splice(values.length, 0, value);
			}
			$icon.find('.sr-only').text(arr.join(' '));

			$icon.toggleClass(ivDropdownSelector.CssClass.active);
			ivClient.set($dropdown, ivSelector.properties.exclude, values);
		},

		dropdownCheckTags: function (event) {
			// encapsulate this
			var $dropdown = ivClient.get(event.target, ivClient.properties.field);
			if ($dropdown.find('.has-value'))
				ivDropdownSelector.toggleOverflowingValuesDisplay($dropdown);

			$dropdown = ivClient.get(event.target, ivClient.properties.role, ivClient.roles.control);
			if (!$dropdown || $dropdown.length === 0) {
				return;
			}

			var hiddenTagLength = $dropdown.find(ivDropdownSelector.CssClass.hiddenTag).length;
			if (hiddenTagLength > 0) {
				$dropdown.find(ivDropdownSelector.selector.dropdownSeeAllHidden).addClass(ivDropdownSelector.CssClass.active);
			}
		},

		getDataSource: function (dropdown) {
			var items = dropdown.find(ivDropdownSelector.selector.menuItem);
			var i = 0;
			var datasource = [];
			var data = ivDropdownSelector.getFormControl(dropdown);

			if (data.dataSource) {
				datasource = data.dataSource;
			}
			else {
				while (i < items.length) {
					var item = {};
					item[data.dataValueField] = $(items[i]).data('value');
					item[data.dataTextField] = $(items[i]).text();
					if (data.dataGroupField)
						item[data.dataGroupField] = $(items[i]).data('group');
					datasource.push(item);
					i++;
				}
			}
			return datasource;
		},

		setDatasource: function (dropdown, items, groups) {
			var
				$dropdown = ivDropdownSelector.getDropdown(dropdown),
				data = ivFormControl.getData(dropdown),
				$field = ivClient.get(dropdown, ivClient.roles.field),
				values = $field.find(ivDropdownSelector.selector.inputHidden).val().split(ivDropdownSelector.separator),
				$menu = $(dropdown).find(ivDropdownSelector.selector.menuContainer).first(),
				$scrollingMenu = $menu.children('.scrolling.menu'),
				labelId = ivClient.get(dropdown, ivClient.properties.labelId),
				i,
				currentGroup = -1,
				repeatColumnsValue = ivClient.get(dropdown, 'data', 'repeatColumns');

			if ($scrollingMenu.length === 0) {
				$scrollingMenu = $('<ul/>', {
					class: 'scrolling menu',
					style: '--repeat-columns-value: ' + repeatColumnsValue,
					role: 'listbox',
					tabIndex: '-1',
					id: data.control.menuClientId
				});
				$menu.prepend($scrollingMenu);
			}
			$scrollingMenu.empty();

			groups = groups || data.optGroup;

			if (data.hasOptGroups && data.dataGroupField && items[0] && typeof items[0][data.dataGroupField] !== 'undefined') {
				// sort items
				items.sort(function (v1, v2) {
					return v1[data.dataGroupField] > v2[data.dataGroupField] ? 1 : v1[data.dataGroupField] < v2[data.dataGroupField] ? -1 : 0;
				});
			}

			values = ivClient.get(dropdown, ivClient.properties.value);

			if (values && !Array.isArray(values)) {
				values = values.split(ivDropdownSelector.separator);
			}
			var group = null;
			let isFirstItem = true;
			for (i in items) {
				var itemGroup = typeof items[i][data.dataGroupField] !== 'undefined' ? items[i][data.dataGroupField] : -1,
					value = items[i][ivDropdownSelector.getFormControl(dropdown).dataValueField];
				if (typeof value === 'undefined')
					continue;
				var selected = values.indexOf(value.toString()) !== -1,
					className = 'item';
				if (selected)
					className += ' filtered';
				if (isFirstItem) {
					className += ' selected';
					isFirstItem = false;
				}
				if (itemGroup >= 0 && itemGroup !== currentGroup && groups) {
					currentGroup = itemGroup;

					var group = $('<ul />', { class: 'dropdown-group-item-list' });
					$scrollingMenu.append($('<li />', { class: 'dropdown-list-item' })
						.append($('<span />', { class: 'ui horizontal divider optgroup' })
							.html(groups[currentGroup]))
						.append(group));
				}
				var div = $('<li/>',
					{
						class: className,
						'aria-selected': selected,
						'data-iv-role': 'item',
						'data-value': value,
						'data-group': itemGroup,
						'id': ivClient.get(dropdown, ivClient.properties.field).data('ivControl') + '_' + value,
						role: 'option'
					});
				if (data.showUrlLink) {
					// selectors use [data-url]. we need use $.attBr() instead $.data()
					div.attr('data-url', ivScope.ModalUrl(ivBaseHtmlControl.getNavigateUrl(data.navigateUrl, items[i])));
				}
				var suggestionTemplate = data.suggestionTemplate;

				var text = items[i][ivDropdownSelector.getFormControl(dropdown).dataTextField];
				if (typeof text !== 'string') {
					text = items[i]["label"];
				}
				if (text) {
					text = ivFunction.nl2Br(ivFunction.htmlEncode(text));
				}
				var description = null;
				if (items[i]['complement'] && !$.isEmptyObject(items[i]['complement'])) {
					description = items[i]['complement'];
				}
				if (suggestionTemplate) {
					text = suggestionTemplate;
					var reg = text.match('{{1}([a-z_]+)}{1}');
					while (reg) {
						text = text.replace(reg[0], ivFunction.nl2Br(ivFunction.htmlEncode(items[i][reg[1]])));
						reg = text.match('{{1}([a-z_]+)}{1}');
					}
					suggestionTemplate = $(text);

					var keys = [];
					for (var key in items[i])
						keys.push(key);
					for (var indexKey = 0; indexKey < keys.length; indexKey++) {
						if (items[i]["_label_" + keys[indexKey]])
							suggestionTemplate.find('[datafieldname=' + keys[indexKey] + ']').text(items[i]["_label_" + keys[indexKey]]);
						else {
							suggestionTemplate.find('[datafieldname=' + keys[indexKey] + ']').text(items[i][keys[indexKey]]);
							suggestionTemplate.find('[datafieldname=' + keys[indexKey] + '_]').text(items[i][keys[indexKey]]);
						}
						var html = $(suggestionTemplate).clone().wrap('<div>').parent().html();
						while (html.indexOf('{' + keys[indexKey] + '}') > -1 || html.indexOf('{' + keys[indexKey] + '_}') > -1) {
							html = html.replace('{' + keys[indexKey] + '}', ivFunction.nl2Br(ivFunction.htmlEncode(items[i][keys[indexKey]])));
							html = html.replace('{' + keys[indexKey] + '_}', ivFunction.nl2Br(ivFunction.htmlEncode(items[i][keys[indexKey]])));
						}
						suggestionTemplate = $(html);
					}
					text = $(suggestionTemplate).clone().wrap('<div>').parent().html();
				}
				if (typeof text !== 'string') {
					text = items[i] = value;
					text = ivFunction.nl2Br(ivFunction.htmlEncode(text));
				}
				text = $("<textarea/>")
					.html(text)
					.text();
				div.append($('<span/>').addClass('text').html(text));
				if (description) {
					div.append($('<span/>').addClass('description').html(ivFunction.nl2Br(ivFunction.htmlEncode(description))));
				}
				if (values && values.includes(items[i].pkval)) {
					div.addClass('filtered');
				}
				if (group) {
					group.append(div);
				}
				else {
					$scrollingMenu.append(div);
				}

			}
			ivAccessibility.clearLiveMessages();
			if ($dropdown.dropdown('is visible')) {
				promptResultCount(dropdown);
			}
		},

		deleteValueKeyDownHandler: function (e) {
			if (event.type === 'keydown' && event.which !== KEYS.ENTER) {
				return true;
			}
			var $dropdown = ivDropdownSelector.getDropdown($(this)),
				$btn = $(e.target).closest('.delete'),
				val = $(e.target).data('value');
			ivDropdownSelector.removeSelectedValue($btn, val);
			$dropdown.find('.search').trigger('focus');
			abort(e);
			return false;
		},

		deleteValuesKeyDownHandler: function (e) {
			if (event.type === 'keydown' && event.which !== KEYS.ENTER) {
				return true;
			}
			ivDropdownSelector.deleteValuesClickHandler(e);
		},
		onChangeMassive: function (values) {
			ivClient.set(this, ivClient.properties.value, Object.keys(values));
		},
		//to review
		onRemoveHandler: function (e) {
			var
				$field = $(e.target).parents('.field:first'),
				selectorData = ivClient.get($field, ivClient.properties.data) || [],
				selectedValues = ivClient.get($field, ivClient.properties.value) || [],
				$grid = ivClient.get($field, ivClient.properties.role, ivClient.roles.grid),
				$row = $(e.target).closest(ivDropdownSelector.selector.rows),
				value = $row.attr('data-id');
			ivDropdownSelector.removeSelectedValue($field, value);
			$row.remove();

			// If no remaining selected element, we hide the grid, except for ellipsis component
			if ($grid.length > 0 && selectedValues.length <= 1 && selectorData.selectorType !== 'ellipsis') {
				var $gridContainer = $grid.closest('.iv-grid');
				if ($gridContainer.length > 0) {
					$gridContainer.addClass('hidden');
				}
			}
		},

		urlLinkClickHandler: function (e) {
			const $target = $(e.target).closest('[data-url]'),
				navigateUrl = $target.attr('data-url'),
				targetMode = $target.attr('data-target'),
				data = ivFormControl.getData(e.target);

			if (data && data.showUrlLink && typeof navigateUrl === 'string') {

				if (targetMode) {
					if (targetMode == 'self') {
						window.open(navigateUrl, "_self");
						return false;
					}
				}

				modalPopup({ 'url': navigateUrl });
			}
			return false;
		},

		openSearchInput: function (e) {
			var
				dropdown = this,
				isMultiple = ivSelector.is.multiple(dropdown),
				$dropdown = ivDropdownSelector.getDropdown(dropdown),
				search = dropdown.querySelector('.search'),
				menu = dropdown.querySelector('div.menu'),
				isLink = ($(e.target).hasClass('link') || $(e.target).parent().hasClass('link'))

			if (ivClient.is.readonly(e.target) && !isLink) {
				return abort(e);
			}
			if (e.target.classList.contains('item') || e.target.classList.contains('clear-all')) {
				return false;
			}
			if (!isMultiple && menu.contains(e.target)) {
				return false;
			}
			if (search !== document.activeElement) {
				search.focus();
			}
			else {
				// autocompletion suggestions are bound in the focus
				$(search).trigger('focus');
			}
			if (!$dropdown.dropdown('is visible') && !isLink) {
				ivDropdownSelector.openDropdown.call(dropdown);
			}
			if (isMultiple) {
				ivDropdownSelector.toggleOverflowingValuesDisplay(dropdown);
			}
		},

		openDropdown: function (e) {
			const $dropdown = $(this);
			// force upward
			const inModal = $dropdown.closest('.modal');
			const inWebPart = $dropdown.closest('.webpart');
			const inBlogPanel = $dropdown.closest('.iv-blog-panel');
			const inCart = $dropdown.closest('.cart-container');
			let isDropdownScope = false;
			let isMultiDropdownScope = false;
			let $dropdownParent;
			const isLocal = ivClient.get($dropdown, ivClient.properties.data, 'isLocal');

			if (window.PullToRefresh) {
				window.PullToRefresh.disable();
			}

			if (inBlogPanel.length) {
				$dropdownParent = $dropdown.closest('.iv-blog-panel');
				isDropdownScope = true;
				isMultiDropdownScope = true;
			}
			else if (inModal.length) {
				$dropdownParent = $('.iv-content.popup_content_modal');

				if (!$dropdownParent.length) {
					$dropdownParent = $('.ui.modal.active > .content');
				}
				isDropdownScope = true;
			}
			else if (inWebPart.length) {
				var blogCheck = $dropdown.closest('.iv-blog-wall').length;
				if (blogCheck) {
					$dropdownParent = $dropdown.closest('.iv-blog-wall');
					isDropdownScope = true;
				}
				else {
					$dropdownParent = $dropdown.closest('.frame.content');
				}
				isMultiDropdownScope = true;
			}
			else if (inCart.length) {
				$dropdownParent = $dropdown.closest('.cart-container');
				isDropdownScope = true;
				isMultiDropdownScope = true;
			}

			if (isDropdownScope === true) {
