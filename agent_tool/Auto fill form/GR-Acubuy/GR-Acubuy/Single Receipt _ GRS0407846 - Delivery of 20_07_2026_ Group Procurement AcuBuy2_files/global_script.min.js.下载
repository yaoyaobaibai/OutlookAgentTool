				values = ivClient.get(selId, ivClient.properties.value),
				$grid = $($scope).find('#' + $button.data('grid')),
				isSingle = ivClient.get(selId, ivClient.properties.data, 'type') === 'single',
				_window = $scope.get(0).defaultView;

			$grid.find('tr[data-id=' + JQueryEscape(value) + ']').remove();
	
			// update hidden field
			if (isSingle && values === value) {
				values = '';
				ivClient.set(selId, ivClient.properties.value, values);
			}

			if (!isSingle && values.includes(value)) {
				values = values.filter(function (item) { return item !== value; });
				ivClient.set(selId, ivClient.properties.value, values);
			}

			// call onchange event on right scope
			_window.ivBaseHtmlControl.callEvent(selId, 'onChange');
			ivEllipsisSelector.AutoPostBack($control, _window);
		},
		deleteValues: function (values, $scope) {
			if (!$scope)
				$scope = $(document);

