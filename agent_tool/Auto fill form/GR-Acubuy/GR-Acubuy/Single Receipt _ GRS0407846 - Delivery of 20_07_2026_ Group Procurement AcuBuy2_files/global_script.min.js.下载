		var script = CADData[fileExt].loaderFilePath;
		var cb = onThreeLoaderJSScriptLoaded;

		// load recursively all files needed if loaderFilePath is an array
		iFile = iFile || 0;
		if (Array.isArray(CADData[fileExt].loaderFilePath) && CADData[fileExt].loaderFilePath.length > iFile) {
			script = CADData[fileExt].loaderFilePath[iFile];
			cb = function ($content, fileId, fileExt) {
				CADData[fileExt].loaderFilePath.length > iFile ?
					onThreeJSScriptLoaded($content, fileId, fileExt, iFile + 1) :
					onThreeLoaderJSScriptLoaded;
